# --- parse ---
ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --test) ARGS+=("$TEST_URL"); shift ;;
    --tokyvideo|--topvideos)
      eazy_wsl_setup
      need "$YTDLP" "yt-dlp"
      need "$PLAYER" "$PLAYER"
      video_action_menu "tokyvideo" "TokyVideo" "$TOKYVIDEO_URL"
      exit 0
      ;;
    --filmes|--filmes-gratis)
      eazy_wsl_setup
      need "$YTDLP" "yt-dlp"
      need "$PLAYER" "$PLAYER"
      menu_filmes_gratis
      exit 0
      ;;
    --tv|--tv-aberta)
      eazy_wsl_setup
      need "$YTDLP" "yt-dlp"
      need "$PLAYER" "$PLAYER"
      need whiptail "whiptail"
      menu_tv_aberta
      exit 0
      ;;
    --adulto|--adult|--18)
      eazy_wsl_setup
      need "$YTDLP" "yt-dlp"
      need "$PLAYER" "$PLAYER"
      need whiptail "whiptail"
      menu_adulto
      exit 0
      ;;
    -s|--search) SEARCH=1; shift ;;
    -a|--audio) AUDIO_ONLY=1; shift ;;
    -q|--quality) QUALITY="${2:-}"; shift 2 ;;
    --download|-d) DOWNLOAD=1; shift ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do ARGS+=("$1"); shift; done
      break
      ;;
    -*)
      printf '%s\n' "${RED}Opção desconhecida: $1${NC}"
      usage
      exit 1
      ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

