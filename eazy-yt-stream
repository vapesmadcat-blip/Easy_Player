#!/usr/bin/env bash
# eazy-yt-stream — streaming YouTube (yt-dlp + mpv/mplayer), script separado
# Otimizado para WSL2
#
# Uso:
#   ./eazy-yt-stream                         # menu
#   ./eazy-yt-stream "https://youtube.com/..."
#   ./eazy-yt-stream -s "lofi hip hop"
#   ./eazy-yt-stream -a "URL"
#   ./eazy-yt-stream -q 480 "URL"
#   ./eazy-yt-stream --download "URL"
#
set -euo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

PLAYER="${EAZY_YT_PLAYER:-mpv}"
YTDLP="${EAZY_YTDLP:-yt-dlp}"
OUT_DIR="${EAZY_YT_OUT:-$HOME/Downloads}"
DATA_DIR="${EAZY_YT_DATA:-$HOME/.config/eazy-yt-stream}"
SEARCH_INDEX="$DATA_DIR/searches.tsv"
FAVORITES_FILE="$DATA_DIR/favorites.tsv"
WATCH_HISTORY_FILE="$DATA_DIR/watch_history.tsv"
TV_FAVORITES_FILE="$DATA_DIR/tv_favorites.tsv"
YTDLP_AUTH_ARGS=()
if [ -n "${EAZY_YT_COOKIES:-}" ]; then
  YTDLP_AUTH_ARGS+=(--cookies "$EAZY_YT_COOKIES")
elif [ -n "${EAZY_YT_BROWSER_COOKIES:-}" ]; then
  YTDLP_AUTH_ARGS+=(--cookies-from-browser "$EAZY_YT_BROWSER_COOKIES")
fi

ytdlp() { "$YTDLP" "${YTDLP_AUTH_ARGS[@]}" "$@"; }
# Cache do MPlayer em KiB; pode ser ajustado sem editar o script.
# 64 MiB/30% reduz esvaziamentos em streams HTTP com bitrate variável.
MPLAYER_CACHE="${EAZY_MPLAYER_CACHE:-65536}"
MPLAYER_CACHE_MIN="${EAZY_MPLAYER_CACHE_MIN:-30}"
TOKYVIDEO_URL="https://www.tokyvideo.com/br/video/todo-mundo-em-panico-4"
TEST_URL="$TOKYVIDEO_URL"
QUALITY=""
AUDIO_ONLY=0
DOWNLOAD=0
SEARCH=0

usage() {
  cat <<'U'
eazy-yt-stream — stream YouTube com yt-dlp + mpv/mplayer

  ./eazy-yt-stream                  # menu interativo
  ./eazy-yt-stream URL
  ./eazy-yt-stream -s "termo"
  ./eazy-yt-stream -a URL           # só áudio
  ./eazy-yt-stream -q 480 URL       # limitar resolução
  ./eazy-yt-stream --download URL   # gravar em ~/Downloads e tocar
  ./eazy-yt-stream --test           # testar com o TokyVideo
  ./eazy-yt-stream --tokyvideo      # abrir a fonte Top Videos/TokyVideo
  ./eazy-yt-stream --tv             # menu TV Aberta (lives/canais)
  ./eazy-yt-stream --filmes         # pesquisar filmes completos gratuitos
  ./eazy-yt-stream --adulto         # menu Adulto 18+

Variáveis:
  EAZY_YT_PLAYER=mpv|mplayer|ffplay|cvlc
  EAZY_YT_VO=x11|gl|null (WSL: evita XV/BadMatch)
  EAZY_YT_OUT=~/Downloads
  EAZY_YTDLP=yt-dlp
  EAZY_MPLAYER_CACHE=65536          # cache do MPlayer em KiB
  EAZY_MPLAYER_CACHE_MIN=30         # percentual antes de iniciar
  EAZY_YT_SEARCH_COUNT=30           # resultados exibidos para escolher
  EAZY_YT_DATA=~/.config/eazy-yt-stream  # pesquisas, histórico e favoritos
  Histórico de filmes: $EAZY_YT_DATA/watch_history.tsv
  EAZY_YT_COOKIES=~/youtube-cookies.txt # cookies exportados do navegador
  EAZY_YT_BROWSER_COOKIES=chrome        # alternativa: chrome, firefox, edge
U
}

need() {
  local bin="$1" pkg="${2:-$1}"
  if ! command -v "$bin" >/dev/null 2>&1; then
    printf '%s\n' "${RED}Comando não encontrado: $bin${NC}"
    printf '%s\n' "Instale: sudo apt-get install -y $pkg"
    exit 1
  fi
}

eazy_is_wsl() {
  [ -n "${WSL_DISTRO_NAME:-}" ] && return 0
  [ -n "${WSL_INTEROP:-}" ] && return 0
  grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null && return 0
  return 1
}

eazy_wsl_setup() {
  eazy_is_wsl || return 0
  export EAZY_WSL=1
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    if [ -e /mnt/wslg/runtime-dir ]; then
      export DISPLAY="${DISPLAY:-:0}"
      export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
      export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}"
    else
      export DISPLAY="${DISPLAY:-:0}"
    fi
  fi
}

choose_fmt() {
  if [ "$AUDIO_ONLY" -eq 1 ]; then
    echo "bestaudio/best"
    return
  fi
  case "$PLAYER" in
    mplayer)
      # progressivo (1 URL) primeiro; senão DASH (2 URLs → -audiofile)
      if [ -n "$QUALITY" ]; then
        echo "18/22/best[height<=${QUALITY}]/bestvideo[height<=${QUALITY}]+bestaudio/best"
      else
        echo "18/22/best[height<=480]/bestvideo[height<=720]+bestaudio/best"
      fi
      ;;
    *)
      if [ -n "$QUALITY" ]; then
        echo "bestvideo[height<=${QUALITY}]+bestaudio/best[height<=${QUALITY}]/best"
      else
        echo "bestvideo[height<=720]+bestaudio/best[height<=720]/best"
      fi
      ;;
  esac
}

play_mplayer() {
  local target="$1" fmt="$2"
  local -a urls=()
  local url vurl aurl
  local -a vo=()
  local -a cache_args=(-cache "$MPLAYER_CACHE" -cache-min "$MPLAYER_CACHE_MIN")

  if eazy_is_wsl; then
    vo=(-vo "${EAZY_YT_VO:-x11,gl,null}")
  elif [ -n "${EAZY_YT_VO:-}" ]; then
    vo=(-vo "$EAZY_YT_VO")
  fi

  mapfile -t urls < <(ytdlp -f "$fmt" -g --no-playlist "$target" 2>/dev/null || true)
  if [ "${#urls[@]}" -eq 0 ]; then
    mapfile -t urls < <(ytdlp -f "18/22/best" -g --no-playlist "$target" 2>/dev/null || true)
  fi
  if [ "${#urls[@]}" -eq 0 ]; then
    printf '%s\n' "${RED}Não obteve URL de stream${NC}"
    return 1
  fi

  if [ "$AUDIO_ONLY" -eq 1 ]; then
    url="${urls[-1]}"
    printf '%s\n' "${GREEN}▶ mplayer só áudio${NC}"
    mplayer "${cache_args[@]}" -novideo -- "$url" || true
    return 0
  fi

  if [ "${#urls[@]}" -ge 2 ]; then
    vurl="${urls[0]}"
    aurl="${urls[-1]}"
    printf '%s\n' "${CYAN}  DASH: vídeo + áudio (2 URLs)${NC}"
    # -audiofile funciona com http em mplayer recente
    if mplayer "${cache_args[@]}" -audiofile "$aurl" "${vo[@]}" -- "$vurl"; then
      return 0
    fi
    printf '%s\n' "${YELLOW}  fallback: só vídeo (sem áudio separado)${NC}"
    mplayer "${cache_args[@]}" "${vo[@]}" -- "$vurl" || true
    return 0
  fi

  url="${urls[0]}"
  printf '%s\n' "${CYAN}  stream progressivo (1 URL)${NC}"
  mplayer "${cache_args[@]}" "${vo[@]}" -- "$url" || true
}

play_stream() {
  local target="$1"
  local title fmt

  eazy_wsl_setup
  need "$YTDLP" "yt-dlp"
  need "$PLAYER" "$PLAYER"

  printf '%s\n' "${CYAN}A obter título...${NC}"
  title=$(ytdlp --get-title --no-playlist "$target" 2>/dev/null | head -n1 || echo "YouTube")
  printf '%s\n' "${GREEN}▶ ${title}${NC}"

  fmt=$(choose_fmt)

  if [ "$DOWNLOAD" -eq 1 ]; then
    mkdir -p "$OUT_DIR"
    printf '%s\n' "${YELLOW}▶ download → $OUT_DIR${NC}"
    local out_tpl="$OUT_DIR/%(title).80B [%(id)s].%(ext)s"
    # merge para ficheiro completo
    ytdlp -f "bestvideo[height<=720]+bestaudio/best" --merge-output-format mp4 \
      -o "$out_tpl" --no-playlist "$target" || \
    ytdlp -f "18/22/best" -o "$out_tpl" --no-playlist "$target"
    local last
    last=$(find "$OUT_DIR" -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.m4a' -o -iname '*.opus' \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
    if [ -n "$last" ] && [ -f "$last" ]; then
      printf '%s\n' "${GREEN}✓ $last${NC}"
      "$PLAYER" -- "$last" || true
    fi
    return 0
  fi

  printf '%s\n' "${GREEN}▶ stream (sem gravar) player=$PLAYER fmt=$fmt${NC}"

  case "$PLAYER" in
    mplayer)
      play_mplayer "$target" "$fmt"
      ;;
    mpv)
      local -a vo_args=(--vo=x11 --cache=yes --ao=pulse --framedrop=vo)
      local -a mpv_args=(--ytdl --ytdl-format="$fmt")
      if [ -n "${EAZY_YT_COOKIES:-}" ]; then
        mpv_args+=(--ytdl-raw-options="cookies=$EAZY_YT_COOKIES")
      elif [ -n "${EAZY_YT_BROWSER_COOKIES:-}" ]; then
        mpv_args+=(--ytdl-raw-options="cookies-from-browser=$EAZY_YT_BROWSER_COOKIES")
      fi
      [ "$AUDIO_ONLY" -eq 1 ] && mpv_args+=(--vid=no)
      mpv "${mpv_args[@]}" "${vo_args[@]}" -- "$target" || true
      ;;
    ffplay)
      local url
      mapfile -t _u < <(ytdlp -f "$fmt" -g --no-playlist "$target" 2>/dev/null)
      url="${_u[0]:-}"
      [ -n "$url" ] || { printf '%s\n' "${RED}Sem URL${NC}"; return 1; }
      ffplay -autoexit -loglevel warning -i "$url" || true
      ;;
    cvlc|vlc)
      local url
      mapfile -t _u < <(ytdlp -f "$fmt" -g --no-playlist "$target" 2>/dev/null)
      url="${_u[0]:-}"
      [ -n "$url" ] || { printf '%s\n' "${RED}Sem URL${NC}"; return 1; }
      cvlc --play-and-exit "$url" || true
      ;;
    *)
      printf '%s\n' "${RED}Player não suportado: $PLAYER${NC}"
      return 1
      ;;
  esac
}

search_id() {
  printf '%s' "$1" | sha256sum | awk '{print substr($1,1,16)}'
}

save_search() {
  local query="$1" file="$2" id
  id=$(search_id "$query")
  mkdir -p "$DATA_DIR/searches"
  cp -- "$file" "$DATA_DIR/searches/$id.tsv"
  touch "$SEARCH_INDEX"
  grep -Fqx -- "$id|$query" "$SEARCH_INDEX" 2>/dev/null || printf '%s|%s\n' "$id" "$query" >> "$SEARCH_INDEX"
}

save_favorite() {
  local id="$1" title="$2" url="$3"
  mkdir -p "$DATA_DIR"
  touch "$FAVORITES_FILE"
  grep -Fq -- "$id|" "$FAVORITES_FILE" 2>/dev/null || printf '%s|%s|%s\n' "$id" "$title" "$url" >> "$FAVORITES_FILE"
  printf '%s\n' "${GREEN}✓ Favorito salvo${NC}"
}

save_watch_history() {
  local id="$1" title="$2" url="$3"
  mkdir -p "$DATA_DIR"
  touch "$WATCH_HISTORY_FILE"
  # Mantém cada reprodução/seleção como uma entrada; o histórico é cronológico.
  printf '%s|%s|%s|%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$id" "$title" "$url" >> "$WATCH_HISTORY_FILE"
}

ask_favorite_after_play() {
  local id="$1" title="$2" url="$3"
  [ -n "$id" ] || return 0
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    if whiptail --title "Filme terminado" --yesno "Quer guardar este filme nos favoritos?\n\n$title" 11 78; then
      save_favorite "$id" "$title" "$url"
    fi
  else
    printf '%s\n' "${YELLOW}Filme terminado: $title${NC}"
    printf 'Guardar nos favoritos? [s/N] '
    local answer
    read -r answer || answer=""
    case "$answer" in
      s|S|sim|SIM|y|Y|yes|YES) save_favorite "$id" "$title" "$url" ;;
    esac
  fi
}

choose_watch_history() {
  local selected index stamp id title url line
  local -a stamps=() ids=() titles=() urls=() menu=()
  [ -s "$WATCH_HISTORY_FILE" ] || { printf '%s\n' "${YELLOW}Nenhum filme no histórico.${NC}"; return 1; }
  while IFS='|' read -r stamp id title url; do
    [ -n "$id" ] || continue
    stamps+=("$stamp"); ids+=("$id"); titles+=("$title"); urls+=("$url")
  done < <(tail -n 100 "$WATCH_HISTORY_FILE" | tac)
  for index in "${!ids[@]}"; do
    menu+=("$((index+1))" "${stamps[$index]} — ${titles[$index]}")
  done
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "Histórico de filmes" --menu "Escolha um filme para assistir novamente:" 24 112 14 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  else
    for index in "${!ids[@]}"; do printf ' %2d) %s — %s\n' "$((index+1))" "${stamps[$index]}" "${titles[$index]}"; done
    printf 'Escolha: '; read -r selected || return 0
  fi
  [[ "$selected" =~ ^[0-9]+$ ]] && [ "$selected" -ge 1 ] && [ "$selected" -le "${#ids[@]}" ] || return 1
  index=$((selected-1))
  video_action_menu "${ids[$index]}" "${titles[$index]}" "${urls[$index]}"
}

video_action_menu() {
  local id="$1" title="$2" url="$3" action
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    action=$(whiptail --title "Vídeo selecionado" --menu \
      "${title}\n\nEscolha uma ação:" 16 86 8 \
      "play" "▶ Assistir agora" \
      "download" "⬇ Baixar e tocar" \
      "audio" "🎧 Baixar/tocar somente áudio" \
      "browser" "🌐 Abrir no navegador" \
      "favorite" "★ Salvar nos favoritos" \
      "back" "Voltar" 3>&1 1>&2 2>&3) || return 0
  else
    printf '\n%s\n' "${YELLOW}${title}${NC}"
    printf '%s\n' '1) Assistir agora' '2) Baixar e tocar' '3) Só áudio' '4) Abrir no navegador' '5) Favoritar' '0) Voltar'
    printf 'Escolha: '; read -r action || return 0
    case "$action" in 1) action=play;; 2) action=download;; 3) action=audio;; 4) action=browser;; 5) action=favorite;; *) action=back;; esac
  fi
  case "$action" in
    play) save_watch_history "$id" "$title" "$url"; AUDIO_ONLY=0; DOWNLOAD=0; play_stream "$url"; ask_favorite_after_play "$id" "$title" "$url" ;;
    download) save_watch_history "$id" "$title" "$url"; AUDIO_ONLY=0; DOWNLOAD=1; play_stream "$url"; DOWNLOAD=0; ask_favorite_after_play "$id" "$title" "$url" ;;
    audio) save_watch_history "$id" "$title" "$url"; AUDIO_ONLY=1; DOWNLOAD=1; play_stream "$url"; AUDIO_ONLY=0; DOWNLOAD=0; ask_favorite_after_play "$id" "$title" "$url" ;;
    browser) if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 & else printf '%s\n' "URL: $url"; fi ;;
    favorite) save_favorite "$id" "$title" "$url" ;;
  esac
}

choose_saved_result() {
  local query="$1" file="$2" selected index id title duration field3 url
  local -a ids=() titles=() durations=() menu=()
  [ -s "$file" ] || { printf '%s\n' "${RED}Nenhum resultado salvo.${NC}"; return 1; }
  while IFS='|' read -r id title field3; do
    [ -n "$id" ] || continue
    duration=""
    # Pesquisas salvas usam id|título|duração; favoritos antigos usam id|título|url.
    if [[ "$field3" =~ ^([0-9]{1,2}:)?[0-9]{1,2}:[0-9]{2}$ ]]; then duration="$field3"; fi
    ids+=("$id"); titles+=("$title"); durations+=("$duration")
    menu+=("${#ids[@]}" "${duration:+[$duration] }$title")
  done < "$file"
  [ "${#ids[@]}" -gt 0 ] || return 1
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "Resultados: $query" --menu "Escolha um vídeo — duração entre colchetes:" 22 110 12 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  else
    printf '%s\n' "${YELLOW}Resultados: $query${NC}"
    for index in "${!ids[@]}"; do printf ' %2d) [%s] %s\n' "$((index+1))" "${durations[$index]:-duração indisponível}" "${titles[$index]}"; done
    printf '%s' "Escolha: "; read -r selected || return 0
  fi
  [[ "$selected" =~ ^[0-9]+$ ]] && [ "$selected" -ge 1 ] && [ "$selected" -le "${#ids[@]}" ] || return 1
  index=$((selected-1)); id="${ids[$index]}"; title="${titles[$index]}"; url="https://www.youtube.com/watch?v=$id"
  video_action_menu "$id" "$title" "$url"
}

choose_saved_search() {
  local selected index id query
  local -a ids=() queries=() menu=()
  [ -s "$SEARCH_INDEX" ] || { printf '%s\n' "${YELLOW}Nenhuma pesquisa salva.${NC}"; return 1; }
  while IFS='|' read -r id query; do
    [ -n "$id" ] || continue
    ids+=("$id"); queries+=("$query"); menu+=("${#ids[@]}" "$query")
  done < "$SEARCH_INDEX"
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "Pesquisas salvas" --menu "Escolha uma pesquisa:" 20 90 12 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  else
    for index in "${!queries[@]}"; do printf ' %2d) %s\n' "$((index+1))" "${queries[$index]}"; done
    printf '%s' "Escolha: "; read -r selected || return 0
  fi
  [[ "$selected" =~ ^[0-9]+$ ]] && [ "$selected" -ge 1 ] && [ "$selected" -le "${#ids[@]}" ] || return 1
  index=$((selected-1)); choose_saved_result "${queries[$index]}" "$DATA_DIR/searches/${ids[$index]}.tsv"
}

choose_favorite() {
  [ -s "$FAVORITES_FILE" ] || { printf '%s\n' "${YELLOW}Nenhum favorito salvo.${NC}"; return 1; }
  choose_saved_result "Favoritos" "$FAVORITES_FILE"
}

search_and_play() {
  local query="$1"
  local page_size="${EAZY_YT_SEARCH_COUNT:-30}"
  local start_at=1 end_at line id title duration selected index target saved_results
  local -a page_results=() results=() menu=() ids=() titles=() durations=()

  need "$YTDLP" "yt-dlp"
  while true; do
    end_at=$((start_at + page_size - 1))
    printf '%s\n' "${CYAN}A pesquisando resultados $start_at–$end_at: $query${NC}"
    mapfile -t page_results < <(ytdlp --flat-playlist --playlist-start "$start_at" --playlist-end "$end_at" \
      --no-warnings --print '%(id)s|%(title)s|%(duration_string)s' "ytsearch${end_at}:${query}" 2>/dev/null || true)
    [ "${#page_results[@]}" -gt 0 ] || {
      [ "${#results[@]}" -gt 0 ] || printf '%s\n' "${RED}Nenhum vídeo encontrado.${NC}"
      return 1
    }
    for line in "${page_results[@]}"; do
      IFS='|' read -r id title duration <<< "$line"
      [ -n "$id" ] || continue
      results+=("$id|$title|${duration:-}")
      ids+=("$id"); titles+=("$title"); durations+=("${duration:-}")
    done
    [ "${#ids[@]}" -gt 0 ] || { printf '%s\n' "${RED}Nenhum resultado válido.${NC}"; return 1; }

    saved_results=$(mktemp)
    printf '%s\n' "${results[@]}" > "$saved_results"
    save_search "$query" "$saved_results"
    rm -f -- "$saved_results"

    menu=()
    for index in "${!ids[@]}"; do
      menu+=("$((index+1))" "[${durations[$index]:---:--}] ${titles[$index]}")
    done
    menu+=("more" "＋ Mostrar mais $page_size resultados")

    if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
      selected=$(whiptail --title "Resultados: $query" \
        --menu "Escolha um vídeo — duração entre colchetes:" 24 112 16 \
        "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
    else
      printf '%s\n' "${YELLOW}Resultados encontrados: $query${NC}"
      for index in "${!ids[@]}"; do printf ' %2d) [%s] %s\n' "$((index+1))" "${durations[$index]:-duração indisponível}" "${titles[$index]}"; done
      printf ' M) Mostrar mais %s resultados\nEscolha [1-%s/M/0]: ' "$page_size" "${#ids[@]}"
      read -r selected || return 0
      [ "$selected" != "0" ] || return 0
      [[ "$selected" =~ ^[Mm]$ ]] && selected=more
    fi

    if [ "$selected" = "more" ]; then
      start_at=$((end_at + 1))
      continue
    fi
    if ! [[ "$selected" =~ ^[0-9]+$ ]] || [ "$selected" -lt 1 ] || [ "$selected" -gt "${#ids[@]}" ]; then
      printf '%s\n' "${RED}Opção inválida.${NC}"
      return 1
    fi
    index=$((selected - 1))
    target="https://www.youtube.com/watch?v=${ids[$index]}"
    video_action_menu "${ids[$index]}" "${titles[$index]}" "$target"
    return 0
  done
}


open_web_source() {
  local url="$1" label="$2"
  printf '%s\n' "${CYAN}Abrindo $label:${NC} $url"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  else
    printf '%s\n' "Abra manualmente: $url"
  fi
}

search_free_movies() {
  local query="${1:-filmes completos grátis dublados}"
  AUDIO_ONLY=0 DOWNLOAD=0
  search_and_play "$query" || true
}

browse_video_source() {
  local label="$1" source_url="$2" count="${EAZY_YT_SEARCH_COUNT:-30}"
  local line id title duration selected index target
  local -a results=() ids=() titles=() durations=() menu=()
  need "$YTDLP" "yt-dlp"
  printf '%s\n' "${CYAN}Carregando $label...${NC}"
  mapfile -t results < <(ytdlp --flat-playlist --playlist-end "$count" \
    --no-warnings --print '%(id)s|%(title)s|%(duration_string)s' "$source_url" 2>/dev/null || true)
  for line in "${results[@]}"; do
    IFS='|' read -r id title duration <<< "$line"
    [ -n "$id" ] || continue
    ids+=("$id"); titles+=("$title"); durations+=("${duration:-}")
    menu+=("${#ids[@]}" "[${duration:---:--}] $title")
  done
  [ "${#ids[@]}" -gt 0 ] || { printf '%s\n' "${RED}Nenhum vídeo público encontrado em $label.${NC}"; return 1; }
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "$label" --menu \
      "Escolha um filme (até $count resultados):" 24 104 16 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
    index=$selected
  else
    printf '%s\n' "${YELLOW}$label${NC}"
    for index in "${!ids[@]}"; do printf ' %2d) [%s] %s\n' "$((index+1))" "${durations[$index]:-duração indisponível}" "${titles[$index]}"; done
    printf 'Escolha [1-%s] (0 cancela): ' "${#ids[@]}"; read -r index || return 0
    [ "$index" != 0 ] || return 0
  fi
  [[ "$index" =~ ^[0-9]+$ ]] && [ "$index" -ge 1 ] && [ "$index" -le "${#ids[@]}" ] || return 1
  target="https://www.youtube.com/watch?v=${ids[$((index-1))]}"
