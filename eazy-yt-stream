# --- TV Aberta: atalhos para lives/canais oficiais no YouTube ---
# Nota: Globo/SBT/Record oficiais usam apps com DRM; aqui vão fontes
# públicas/YouTube que o yt-dlp costuma abrir (TV pública, notícias, esporte).
play_channel_live() {
  local handle="$1" label="${2:-$1}"
  local url="https://www.youtube.com/${handle}/live"
  local ok=0
  printf '%s\n' "${CYAN}▶ TV Aberta: $label${NC}"
  printf '%s\n' "${YELLOW}  $url${NC}"
  if ytdlp --get-title --no-playlist "$url" >/dev/null 2>&1; then
    AUDIO_ONLY=0 DOWNLOAD=0
    play_stream "$url" || true
    ok=1
  fi
  if [ "$ok" -eq 0 ]; then
    printf '%s\n' "${YELLOW}Sem live em /live — a pesquisar: ${label} ao vivo${NC}"
    AUDIO_ONLY=0 DOWNLOAD=0
    search_and_play "${label} ao vivo" || true
  fi
  # Oferece marcar canal como favorito da TV Aberta
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    if whiptail --title "Favorito TV Aberta" --yesno \
"Marcar este canal como favorito?\n\n$label\n$handle" 11 60; then
      save_tv_favorite "$handle" "$label" "$url"
    fi
  fi
}

save_tv_favorite() {
  local handle="$1" label="$2" url="$3"
  mkdir -p "$DATA_DIR"
  touch "$TV_FAVORITES_FILE"
  # evita duplicar pelo handle
  if grep -Fq -- "${handle}|" "$TV_FAVORITES_FILE" 2>/dev/null; then
    printf '%s\n' "${YELLOW}Já está nos favoritos: $label${NC}"
    return 0
  fi
  printf '%s|%s|%s\n' "$handle" "$label" "$url" >> "$TV_FAVORITES_FILE"
  printf '%s\n' "${GREEN}✓ Canal favorito: $label${NC}"
}

remove_tv_favorite() {
  local handle="$1"
  [ -s "$TV_FAVORITES_FILE" ] || return 0
  grep -Fv -- "${handle}|" "$TV_FAVORITES_FILE" > "${TV_FAVORITES_FILE}.tmp" 2>/dev/null \
    && mv -f "${TV_FAVORITES_FILE}.tmp" "$TV_FAVORITES_FILE" || true
}

choose_tv_favorite() {
  local selected index handle label url
  local -a handles=() labels=() urls=() menu=()
  [ -s "$TV_FAVORITES_FILE" ] || {
    whiptail --title "Favoritos TV Aberta" --msgbox \
"Nenhum canal favorito ainda.

Abre um canal e responde Sim em
«Marcar como favorito», ou usa
«Adicionar aos favoritos»." 12 55
    return 1
  }
  while IFS='|' read -r handle label url; do
    [ -n "$handle" ] || continue
    handles+=("$handle"); labels+=("$label"); urls+=("$url")
    menu+=("${#handles[@]}" "$label  ($handle)")
  done < "$TV_FAVORITES_FILE"
  [ "${#handles[@]}" -gt 0 ] || return 1
  selected=$(whiptail --title "Favoritos TV Aberta" --menu \
"Escolha o canal:" 20 72 12 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  [[ "$selected" =~ ^[0-9]+$ ]] || return 1
  index=$((selected - 1))
  handle="${handles[$index]}"; label="${labels[$index]}"
  local acao
  acao=$(whiptail --title "$label" --menu "O que fazer?" 12 50 3 \
    "play" "▶ Tocar / live" \
    "del"  "🗑 Remover dos favoritos" \
    "voltar" "Cancelar" \
    3>&1 1>&2 2>&3) || return 0
  case "$acao" in
    play) play_channel_live "$handle" "$label" ;;
    del)
      remove_tv_favorite "$handle"
      whiptail --title "Favoritos" --msgbox "Removido: $label" 8 40
      ;;
  esac
}

