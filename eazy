                dest_label="$nome_lista"
            elif [[ "$dest_fila" == c:* ]]; then
                sql_table="${dest_fila#c:}"
                dest_label="$sql_table"
            else
                sql_table="temp_playlist_${dest_fila}"
                dest_label="Fila $dest_fila"
            fi
            paths_to_add=()
            while IFS= read -r item; do
                [ -z "$item" ] && continue
                [[ "$item" =~ \.\.$ ]] && continue
                paths_to_add+=("$(caminho_absoluto "$item")")
            done <<< "$itens_para_fila"
            quantidade_adicionada=$(eazy_sql_list_append_args "$sql_table" "${paths_to_add[@]}") || quantidade_adicionada=0
            total_fila=$(eazy_sql_list_indexer "--list-count=$sql_table" 2>/dev/null || echo 0)
            eazy_sql_list_refresh_view "$sql_table" || true
            case "$sql_table" in
                temp_playlist_1) FILA_ATUAL=1; atualizar_fila_atual ;;
                temp_playlist_2) FILA_ATUAL=2; atualizar_fila_atual ;;
                temp_playlist_3) FILA_ATUAL=3; atualizar_fila_atual ;;
            esac
        else
            n1=$(contar_fila 1); n2=$(contar_fila 2); n3=$(contar_fila 3)
            custom_menu_args=()
            while IFS= read -r custom_arq; do
                [ -f "$custom_arq" ] || continue
                custom_nome="${custom_arq##*temp_playlist_custom_}"
                custom_count=$(grep -c '^' "$custom_arq" 2>/dev/null || echo 0)
                custom_menu_args+=("c:$custom_nome" "$custom_count itens" OFF)
            done < <(find "$CUSTOM_LISTS_DIR" -maxdepth 1 -type f -name 'temp_playlist_custom_*' -print 2>/dev/null | sort)
            dest_fila=$(whiptail --title "INSERT → Fila temporária" --radiolist \
                "Para qual lista da sessão enviar os itens?" 18 72 8 \
                "1" "Fila 1  ($n1 itens)" $( [ "$FILA_ATUAL" = "1" ] && echo ON || echo OFF ) \
                "2" "Fila 2  ($n2 itens)" $( [ "$FILA_ATUAL" = "2" ] && echo ON || echo OFF ) \
                "3" "Fila 3  ($n3 itens)" $( [ "$FILA_ATUAL" = "3" ] && echo ON || echo OFF ) \
                "N" "Criar lista desta sessão..." OFF "${custom_menu_args[@]}" 3>&1 1>&2 2>&3) || continue
            [ -n "$dest_fila" ] || continue
            if [[ "$dest_fila" == c:* ]]; then
                nome_lista="${dest_fila#c:}"
                dest_file="$CUSTOM_LISTS_DIR/temp_playlist_custom_$nome_lista"
                dest_label="$nome_lista"
            elif [ "$dest_fila" = "N" ]; then
                nome_lista=$(whiptail --title "Nova lista temporária" --inputbox "Nome da lista:" 9 60 "lista-nova" 3>&1 1>&2 2>&3) || continue
                [ -n "$nome_lista" ] || continue
                nome_lista=$(printf '%s' "$nome_lista" | tr '/\\:*?"<>|' '_' | tr -s ' ' '_' | cut -c1-80)
                dest_file="$CUSTOM_LISTS_DIR/temp_playlist_custom_$nome_lista"
                dest_label="$nome_lista"
            else
                dest_file="$PLAYLIST_FILE"
                case "$dest_fila" in 2) dest_file="$PLAYLIST_2" ;; 3) dest_file="$PLAYLIST_3" ;; esac
                dest_label="Fila $dest_fila"
            fi
            touch "$dest_file"
            quantidade_adicionada=0
            while IFS= read -r item; do
                [ -z "$item" ] && continue
                [[ "$item" =~ \.\.$ ]] && continue
                item_abs=$(caminho_absoluto "$item")
                if ! grep -Fxq -- "$item_abs" "$dest_file" 2>/dev/null; then
                    printf '%s\n' "$item_abs" >> "$dest_file"
                    quantidade_adicionada=$((quantidade_adicionada + 1))
                fi
            done <<< "$itens_para_fila"
            total_fila=$(grep -c '^' "$dest_file" 2>/dev/null || echo 0)
            if [[ "$dest_fila" =~ ^[123]$ ]]; then FILA_ATUAL="$dest_fila"; atualizar_fila_atual; fi
        fi
        total_fila=$(printf '%s' "$total_fila" | tr -cd '0-9'); total_fila=${total_fila:-0}
        whiptail --title "✓ $dest_label" \
            --msgbox "Adicionados: $quantidade_adicionada\nTotal em $dest_label: $total_fila" 10 55
        continue
    elif [ "$tecla" = "ctrl-p" ]; then
        eazy_menu_listas_ctrlp || true
        continue
    fi
    if [ -z "$escolha" ]; then
        continue
    fi

    primeiro_caminho=$(printf '%s\n' "$escolha" | head -n 1 | awk -F '\t' '{print $NF}')
    # Enter abre o item sob o cursor; as demais marcas continuam globais.
    if [ -n "${cursor_raw:-}" ] && [ "${tecla:-}" != "alt-enter" ]; then
        cursor_caminho=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
        [ -n "$cursor_caminho" ] && primeiro_caminho="$cursor_caminho"
    fi

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_DOWNLOAD=0; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        link_alvo=$(echo "$escolha" | head -n 1 | awk -F '\t' '{print $NF}')
        linha_fila=$(grep "|$link_alvo|" "$DOWNLOAD_QUEUE" | head -n 1)
        engine=$(echo "$linha_fila" | cut -d'|' -f1)
        pass=$(echo "$linha_fila" | cut -d'|' -f3)
        tor_item=$(echo "$linha_fila" | cut -d'|' -f4)
        download_dir_item=$(echo "$linha_fila" | cut -d'|' -f5)
        # O checkbox do item tem prioridade: 0 desligado não herda Tor global.
        # Apenas filas antigas, sem quarto campo, usam o fallback global.
        if [ -z "$tor_item" ]; then
            tor_item="${DOWNLOAD_TOR:-0}"
        fi
        [ "$tor_item" = "1" ] || tor_item="0"

        if [ -z "$pass" ] && [ -f "$DOWNLOAD_PASSWORDS" ]; then
            pass=$(grep -F "$link_alvo|" "$DOWNLOAD_PASSWORDS" | tail -n1 | cut -d'|' -f2-)
        fi

        nome_esperado=$(obter_nome_do_link "$link_alvo")
        dir_antes=$(pwd)
        download_dir="${DOWNLOAD_DIR:-${HOME}/Downloads}"
        [ -n "$download_dir_item" ] && download_dir="$download_dir_item"
        tor_proxy="socks5://127.0.0.1:9050"
        read -r -a ARIA_EXTRA <<< "${DOWNLOAD_ARIA_ARGS:-}"
        read -r -a AXEL_EXTRA <<< "${DOWNLOAD_AXEL_ARGS:---insecure -n 4}"
        read -r -a WGET_EXTRA <<< "${DOWNLOAD_WGET_ARGS:---no-check-certificate}"
        read -r -a YTDLP_EXTRA <<< "${DOWNLOAD_YTDLP_ARGS:-}"
        TOR_PREFIX=()
        mkdir -p -- "$download_dir" || { echo "Não foi possível criar o destino: $download_dir"; read -p "Pressione Enter para continuar..."; continue; }

        # Enter no link da fila: stream ou download?
        _acao_link=$(whiptail --title "Link da fila" --menu "\n${link_alvo:0:64}\n" 14 72 3 \
            "stream"   "▶ Stream agora (play direto)" \
            "download" "📥 Download (escolher app)" \
            "cancel"   "Cancelar" \
            3>&1 1>&2 2>&3) || continue
        case "$_acao_link" in
            stream)
                eazy_stream_play_url "$link_alvo" ""
                continue
                ;;
            download) ;;
            *) continue ;;
        esac

        # Sempre pergunta o app. Não fixa na fila — só lembra para sugerir depois.
        last_eng=""
        [ -s "${LAST_DOWNLOAD_ENGINE_FILE:-}" ] && last_eng=$(head -n1 "$LAST_DOWNLOAD_ENGINE_FILE" 2>/dev/null | tr -d '\r')
        [ -z "$last_eng" ] && last_eng="${engine:-${DOWNLOAD_ENGINE:-aria}}"
        [ -z "$last_eng" ] && last_eng="aria"
        is_torrent=0
        case "$link_alvo" in
            magnet:*|*.torrent|*.TORRENT) is_torrent=1 ;;
        esac
        on_aria=OFF; on_axel=OFF; on_wget=OFF; on_ytdlp=OFF; on_torrent=OFF
        case "$last_eng" in
            aria) on_aria=ON ;;
            axel) on_axel=ON ;;
            wget) on_wget=ON ;;
            ytdlp) on_ytdlp=ON ;;
            torrent) on_torrent=ON ;;
            *) on_aria=ON ;;
        esac
        if [ "$is_torrent" -eq 1 ]; then
            # torrent: se última não era torrent, sugere torrent
            if [ "$last_eng" != "torrent" ]; then
                on_aria=OFF; on_axel=OFF; on_wget=OFF; on_ytdlp=OFF; on_torrent=ON
            fi
            engine_pick=$(whiptail --title "Download — escolher app" --radiolist \
                "Torrent/magnet:\n${link_alvo:0:58}\n\nSugestão em destaque. Pode mudar quando quiser." 17 74 5 \
                "torrent" "eazy-tor (recomendado)" "$on_torrent" \
                "aria" "aria2c" "$on_aria" \
                "axel" "Axel" "$on_axel" \
                "wget" "Wget" "$on_wget" \
                "ytdlp" "yt-dlp" "$on_ytdlp" \
                3>&1 1>&2 2>&3) || continue
        else
            engine_pick=$(whiptail --title "Download — escolher app" --radiolist \
                "Link (não torrent):\n${link_alvo:0:58}\n\nSempre pergunta. Sugestão: ${last_eng}" 17 74 4 \
                "aria" "aria2c (multi-conexão)" "$on_aria" \
                "axel" "Axel" "$on_axel" \
                "wget" "Wget" "$on_wget" \
                "ytdlp" "yt-dlp (YouTube/sites)" "$on_ytdlp" \
                3>&1 1>&2 2>&3) || continue
        fi
        [ -n "$engine_pick" ] || continue
        engine="$engine_pick"
        mkdir -p "$CONFIG_DIR" 2>/dev/null || true
        printf '%s\n' "$engine" > "${LAST_DOWNLOAD_ENGINE_FILE:-$CONFIG_DIR/last_download_engine}"

        # SEMPRE pergunta Tor ou não (sugere a última escolha)
        last_tor=""
        [ -s "${LAST_DOWNLOAD_TOR_FILE:-}" ] && last_tor=$(head -n1 "$LAST_DOWNLOAD_TOR_FILE" 2>/dev/null | tr -d '\r')
        [ -z "$last_tor" ] && last_tor="${tor_item:-${DOWNLOAD_TOR:-0}}"
        [ "$last_tor" = "1" ] || last_tor="0"
        on_tor_n=ON; on_tor_y=OFF
        [ "$last_tor" = "1" ] && on_tor_n=OFF && on_tor_y=ON
        tor_pick=$(whiptail --title "Download — usar rede Tor?" --radiolist \
            "Usar Tor neste download?\nsocks5://127.0.0.1:9050 (torsocks)\n\nSugestão: $([ "$last_tor" = 1 ] && echo SIM || echo NÃO) — pode mudar" 14 72 2 \
            "0" "Não — rede normal" "$on_tor_n" \
            "1" "Sim — via Tor" "$on_tor_y" \
            3>&1 1>&2 2>&3) || continue
        tor_item="${tor_pick:-0}"
        [ "$tor_item" = "1" ] || tor_item="0"
        printf '%s\n' "$tor_item" > "${LAST_DOWNLOAD_TOR_FILE:-$CONFIG_DIR/last_download_tor}"

        TOR_PREFIX=()
        if [ "$tor_item" = 1 ]; then
            if command -v torsocks >/dev/null 2>&1; then
                TOR_PREFIX=(torsocks)
                echo "   Rede: Tor via torsocks (aria2c/Axel/wget · 127.0.0.1:9050)"
            else
                echo "   Tor marcado, mas torsocks não está instalado — instale: sudo apt install torsocks"
            fi
        else
            echo "   Rede: normal (sem Tor)"
        fi

        # Downloads: tamanho remoto costuma ser desconhecido — exige folga mínima no disco
        {
            read -r _livre_dl _tot_dl < <(info_disco ".")
            _livre_dl=$(echo "${_livre_dl:-0}" | tr -cd '0-9'); _livre_dl=${_livre_dl:-0}
            # Reserva “virtual” de 1 GB para avisar; bloqueio se < mínimo seguro
            if ! verificar_espaco_disco "$((1024*1024*1024))" "$download_dir" "Download" \
                "$((1024*1024*1024))|${link_alvo} (estimativa mínima de reserva)"; then
                continue
            fi
        }

        echo -e "\n\033[1;32m⬇ Iniciando download com [$engine]\033[0m"
        echo -e "   URL : $link_alvo"
        if [ "$engine" = "ytdlp" ]; then
            echo -e "   Formato: ${pass:-best}"
        elif [ -n "$pass" ]; then
            echo -e "   Senha: (definida — será usada na extração)"
        fi
        echo ""

        status_dl=1
        case "$engine" in
            torrent)
                torrent_cmd="$EAZY_INSTALL_DIR/eazy-tor"
                [ -x "$torrent_cmd" ] || torrent_cmd="$(command -v eazy-tor 2>/dev/null || true)"
                if [ -z "$torrent_cmd" ]; then
                    echo -e "\033[1;31meazy-tor não encontrado. Instale o pacote eazy.\033[0m"
                    status_dl=1
                else
                    torrent_args=(--dir "$download_dir")
                    [ "$tor_item" = 1 ] && torrent_args+=(--tor)
                    "$torrent_cmd" "${torrent_args[@]}" "$link_alvo" && status_dl=0
                fi
                ;;
            ytdlp)
                YTDLP_BIN=$(encontrar_ytdlp 2>/dev/null || true)
                if [ -z "$YTDLP_BIN" ]; then
                    echo -e "\033[1;31myt-dlp não encontrado.\033[0m"
                    echo -e "Atualize SEM pip:  eazy --update-ytdlp"
                    status_dl=1
                else
                    # Limpa tracking (?si=...)
                    link_limpo="${link_alvo%%\?*}"
                    export PATH="$(dirname "$YTDLP_BIN"):$PATH"

                    fmt="${pass:-best}"
                    case "$fmt" in
                        best)  fmt_arg="bv*+ba/b" ;;
                        1080)  fmt_arg="bv*[height<=1080]+ba/b[height<=1080]/b" ;;
                        720)   fmt_arg="bv*[height<=720]+ba/b[height<=720]/b" ;;
                        480)   fmt_arg="bv*[height<=480]+ba/b[height<=480]/b" ;;
                        audio) fmt_arg="ba/b" ;;
                        mp4)   fmt_arg="bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b" ;;
                        *)     fmt_arg="$fmt" ;;
                    esac

                    out_tpl="%(title).200B [%(id)s].%(ext)s"
                    echo -e "   Binário: $YTDLP_BIN"
                    echo -e "   Versão:  $($YTDLP_BIN --version 2>/dev/null || echo '?')"
                    echo -e "   Se 403/400 →  eazy --update-ytdlp"

                    # aria2c como acelerador (não substitui o yt-dlp)
                    ARIA_ARGS=()
                    if command -v aria2c &>/dev/null && [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                        ARIA_ARGS=(--downloader aria2c --downloader-args "aria2c:-x 16 -s 16 -k 1M -j 16")
                        echo -e "   Acelerador: aria2c (multi-conexão)"
                    fi
                    echo ""

                    ytdlp_ok=0
                    if [ "$fmt" = "audio" ]; then
                        if [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                            $YTDLP_BIN "${YTDLP_EXTRA[@]}" ${tor_item:+$([ "$tor_item" = 1 ] && echo "--proxy=$tor_proxy")} -f "$fmt_arg" -x --audio-format mp3 --audio-quality 0 \
                                --extractor-args "youtube:player_client=android,web" \
                                --no-playlist --newline --retries 5 \
                                "${ARIA_ARGS[@]}" \
                                -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        else
                            $YTDLP_BIN -f "$fmt_arg" -x --audio-format mp3 \
                                --no-playlist -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        fi
                    else
                        if [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                            $YTDLP_BIN "${YTDLP_EXTRA[@]}" ${tor_item:+$([ "$tor_item" = 1 ] && echo "--proxy=$tor_proxy")} -f "$fmt_arg" --merge-output-format mp4 \
                                --extractor-args "youtube:player_client=android,web" \
                                --no-playlist --newline --retries 5 --fragment-retries 5 \
                                "${ARIA_ARGS[@]}" \
                                -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        else
                            $YTDLP_BIN -f "$fmt_arg" --merge-output-format mp4 \
                                --no-playlist -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        fi
                    fi

                    # Fallback se a 1ª tentativa falhar
                    if [ "$ytdlp_ok" -eq 0 ] && [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                        echo -e "\n\033[1;33mTentando fallback (client web + formato livre)...\033[0m"
                        if $YTDLP_BIN -f "b/bv+ba" --merge-output-format mp4 \
                            --extractor-args "youtube:player_client=web" \
                            --no-playlist --newline --retries 5 \
                            "${ARIA_ARGS[@]}" \
                            -o "$download_dir/$out_tpl" "$link_limpo"; then
                            ytdlp_ok=1
                        fi
                    fi

                    if [ "$ytdlp_ok" -eq 1 ]; then
                        status_dl=0
                    else
                        echo -e "\n\033[1;33mAtualize o yt-dlp SEM pip:\033[0m"
                        echo -e "  eazy --update-ytdlp"
                        echo -e "  # ou wget o binário do GitHub (ver --help)"
                        status_dl=1
                    fi
                fi
                ;;
            aria|axel|wget|*)
                if eh_url_video_online "$link_alvo"; then
                    echo -e "\033[1;31mEste link é de vídeo online (YouTube etc.).\033[0m"
                    echo -e "aria2c sozinho NÃO resolve a URL do YouTube."
                    echo -e "O eazy usa:  yt-dlp + aria2c (acelerador)."
                    echo -e "Remova este item e adicione de novo (força yt-dlp)."
                    echo -e "Atualize:  eazy --update-ytdlp"
                    status_dl=1
                elif [ "$engine" = "aria" ]; then
                    if ! command -v aria2c &>/dev/null; then
                        echo -e "\033[1;31maria2c não instalado.  sudo apt install aria2\033[0m"
                    elif "${TOR_PREFIX[@]}" aria2c "${ARIA_EXTRA[@]}" --allow-overwrite=true "$link_alvo"; then
                        status_dl=0
                    fi
                elif [ "$engine" = "axel" ]; then
                    if ! command -v axel &>/dev/null; then
                        echo -e "\033[1;31maxel não instalado.  sudo apt install axel\033[0m"
                    elif "${TOR_PREFIX[@]}" axel "${AXEL_EXTRA[@]}" -o "$download_dir/$nome_esperado" "$link_alvo"; then
                        status_dl=0
                    fi
                else
                    if ! command -v wget &>/dev/null; then
                        echo -e "\033[1;31mwget não instalado.  sudo apt install wget\033[0m"
                    elif "${TOR_PREFIX[@]}" wget "${WGET_EXTRA[@]}" "${WGET_TOR_ARGS[@]}" -O "$download_dir/$nome_esperado" "$link_alvo"; then
                        status_dl=0
                    fi
                fi
                ;;
        esac

        if [ "$status_dl" -ne 0 ]; then
            echo -e "\n\033[1;31m✗ Download falhou.\033[0m"
            read -p "Pressione Enter para continuar..."
            continue
        fi

        echo -e "\n\033[1;32m✓ Download concluído.\033[0m"

        arquivo_baixado=""
        if [ "$engine" = "ytdlp" ]; then
            # Pega o arquivo mais recente da pasta (yt-dlp define o nome)
            arquivo_baixado=$(find "$download_dir" -maxdepth 1 -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.webm" -o -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.opus" \) -printf '%T@ %p\n' 2>/dev/null \
                | sort -nr | head -n1 | cut -d' ' -f2-
            )
        elif [ -f "$download_dir/$nome_esperado" ]; then
            arquivo_baixado="$download_dir/$nome_esperado"
        else
            arquivo_baixado=$(find "$download_dir" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null \
                | sort -nr | head -n1 | cut -d' ' -f2-
            )
        fi

        if [ -n "$arquivo_baixado" ] && [ -f "$arquivo_baixado" ]; then
            echo -e "   Arquivo: $arquivo_baixado"

            # Oferece tocar o vídeo baixado com yt-dlp
            if [ "$engine" = "ytdlp" ]; then
                read -p "Tocar o arquivo agora? (s/N): " quer_tocar
                if [[ "$quer_tocar" =~ ^[Ss]$ ]]; then
                    tocar_arquivo "$arquivo_baixado"
                fi
            fi

            ext_baixado=$(echo "${arquivo_baixado##*.}" | tr '[:upper:]' '[:lower:]')
            if [[ "$ext_baixado" =~ ^(zip|rar|7z|gz|bz2|xz|tar)$ ]] || \
               [[ "$arquivo_baixado" == *.tar.gz ]] || [[ "$arquivo_baixado" == *.tgz ]] || \
               [[ "$arquivo_baixado" == *.tar.bz2 ]] || [[ "$arquivo_baixado" == *.tar.xz ]]; then

                if [ -n "$pass" ] && [ "$engine" != "ytdlp" ]; then
                    echo -e "\033[1;33mArquivo compactado detectado + senha disponível → extraindo...\033[0m"
                    extrair_com_senha "$arquivo_baixado" "$pass"
                else
                    read -p "Arquivo compactado detectado. Deseja extrair agora? (s/N): " quer_extrair
                    if [[ "$quer_extrair" =~ ^[Ss]$ ]]; then
                        extrair_com_senha "$arquivo_baixado" ""
                    fi
                fi
            fi
        else
            echo -e "\033[1;33mNão foi possível identificar o arquivo baixado automaticamente.\033[0m"
        fi

        read -p "Remover este item da fila de downloads? (S/n): " remover_fila
        if [[ ! "$remover_fila" =~ ^[Nn]$ ]]; then
            grep -v "|$link_alvo|" "$DOWNLOAD_QUEUE" > "${DOWNLOAD_QUEUE}.tmp" && mv "${DOWNLOAD_QUEUE}.tmp" "$DOWNLOAD_QUEUE"
            echo -e "\033[1;32mItem removido da fila.\033[0m"
        fi

        read -p "Pressione Enter para continuar..."
        continue
    fi

    if [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            salvar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"
            ULTIMO_ARQUIVO=""
            carregar_posicao_dir "$(pwd -P)"
            registrar_status; continue
        fi

        # Diretório dentro de qualquer lista: entra na pasta, não toca como arquivo.
        total_escolha_playlist=$(printf '%s\n' "$escolha" | grep -c '^' 2>/dev/null || echo 0)
        total_escolha_playlist=$(printf '%s' "$total_escolha_playlist" | tr -cd '0-9'); total_escolha_playlist=${total_escolha_playlist:-0}
        if [ "$total_escolha_playlist" -eq 1 ] && [ -d "$primeiro_caminho" ]; then
            salvar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO" "${TMP:-1}" "$primeiro_caminho"
            ARQUIVO_LISTA_ORIGEM="$ARQUIVO_PLAYLIST_ABERTO"
            DIR_LISTA_ORIGEM="$(readlink -f -- "$primeiro_caminho" 2>/dev/null || echo "$primeiro_caminho")"
            if cd -- "$primeiro_caminho"; then
                MODO_PLAYLIST=0
                ARQUIVO_PLAYLIST_ABERTO=""
                FZF_QUERY=""
                TMP=1; ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"; ULTIMO_ARQUIVO=""
                registrar_status
            else
                whiptail --title "Erro" --msgbox "Não foi possível entrar no diretório:\n$primeiro_caminho" 8 60
            fi
            continue
        fi
        # Enter → só o cursor. Alt+Enter → seleção inteira.
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ "${tecla:-}" = "alt-enter" ]; then
            printf '%s\n' "$escolha" | eazy_playlist_alt_enter "$playlist_sel"
        else
            if [ -n "${cursor_raw:-}" ]; then
                p=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
            else
                p="$primeiro_caminho"
            fi
            [ -n "$p" ] && [[ ! "$p" =~ \.\.$ ]] && [ ! -d "$p" ] && printf '%s\n' "$p" >> "$playlist_sel"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ] && [ "${tecla:-}" = "alt-enter" ]; then
            confirmar_alt_enter "$total_sel" || { rm -f "$playlist_sel"; continue; }
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -ge 1 ]; then
            tocado=$(head -n1 "$playlist_sel")
            ULTIMO_ARQUIVO="$tocado"
            registrar_status
            if [ -f "$tocado" ]; then
                eazy_abrir_arquivo_enter "$tocado"
            else
                whiptail --title "Arquivo ausente" --msgbox "Arquivo não encontrado:\n$tocado" 9 60
            fi
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_DUP=0; rm -f "$DUP_MANUAL_FILE" "$DUP_SELECTED_FILE" "$SELECTED_FILE"; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        # A lista temporária persistente é a fonte da seleção para todas as ações.
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ -s "$DUP_SELECTED_FILE" ]; then
            cp -- "$DUP_SELECTED_FILE" "$playlist_sel"
        else
            : > "$DUP_SELECTED_FILE"
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$p" ] && continue
                p_abs=$(caminho_absoluto "$p")
                printf '%s\n' "$p_abs" >> "$playlist_sel"
                printf '%s\n' "$p_abs" >> "$DUP_SELECTED_FILE"
            done <<< "$escolha"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ]; then
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -eq 1 ] && [ -f "$(head -n1 "$playlist_sel")" ]; then
            ULTIMO_ARQUIVO=$(head -n1 "$playlist_sel")
            registrar_status
            eazy_abrir_arquivo_enter "$ULTIMO_ARQUIVO"
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            # Único sítio que ENCERRA a pesquisa de propósito
            MODO_BUSCA=0
            EAZY_VOLTAR_PARA_BUSCA=0
            BUSCA_TAM_MIN=""; BUSCA_TAM_MAX=""; BUSCA_TAM_LABEL=""; BUSCA_CONTEUDO=""
            BUSCA_SNAPSHOT_FILE=""
            TMP=1; ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
            registrar_status
            eazy_lista_cache_invalidate 2>/dev/null || true
            continue
        fi
        # Em busca: NUNCA faz cd. Só abre ficheiros reais.
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ "${tecla:-}" = "alt-enter" ]; then
            printf '%s\n' "$escolha" | eazy_playlist_alt_enter "$playlist_sel"
        else
            if [ -n "${cursor_raw:-}" ]; then
                p=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
            else
                p="$primeiro_caminho"
            fi
            p_abs=$(caminho_absoluto "$p")
            # Só ficheiro regular. Dir/symlink-para-dir/inexistente → ignora (não trava, não cd)
            if [ -f "$p_abs" ] && [ ! -d "$p_abs" ]; then
                printf '%s\n' "$p_abs" >> "$playlist_sel"
            fi
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ] && [ "${tecla:-}" = "alt-enter" ]; then
            confirmar_alt_enter "$total_sel" || { rm -f "$playlist_sel"; continue; }
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -ge 1 ] && [ -f "$(head -n1 "$playlist_sel")" ] && [ ! -d "$(head -n1 "$playlist_sel")" ]; then
            ULTIMO_ARQUIVO=$(head -n1 "$playlist_sel")
            registrar_status
            eazy_abrir_arquivo_enter "$ULTIMO_ARQUIVO"
        else
            # path inválido ou não é ficheiro — não tenta entrar como pasta
            eazy_beep 2>/dev/null || true
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [[ "$primeiro_caminho" =~ \.\.$ ]]; then
        if [ -n "${DIR_LISTA_ORIGEM:-}" ] && [ "$(readlink -f -- "$(pwd -P)" 2>/dev/null || pwd -P)" = "$DIR_LISTA_ORIGEM" ] && [ -f "${ARQUIVO_LISTA_ORIGEM:-}" ]; then
            MODO_PLAYLIST=1
            ARQUIVO_PLAYLIST_ABERTO="$ARQUIVO_LISTA_ORIGEM"
            DIR_LISTA_ORIGEM=""
            ARQUIVO_LISTA_ORIGEM=""
            FZF_QUERY=""
            TMP=1; ULTIMO_ARQUIVO=""
            carregar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO"
            ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
            registrar_status
            salvar_sessao
            continue
        fi
        # Salva posição e filtro desta pasta; sobe; restaura ambos no pai.
        rm -f "$DUP_MANUAL_FILE" 2>/dev/null || true
        eazy_ler_cursor_fzf 2>/dev/null || true
        local_dir_antes=$(pwd -P 2>/dev/null || pwd)
        # grava cursor dentro da pasta actual
        salvar_posicao_dir "$local_dir_antes" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
        salvar_filtro_dir "$local_dir_antes" "${FZF_QUERY:-}"
        DIRETORIO_ANTERIOR="$local_dir_antes"
        if ! cd ..; then
            eazy_beep_dir
            continue
        fi
        eazy_beep_dir
        parent_dir=$(pwd -P 2>/dev/null || pwd)
        # FORÇA o pai a focar a pasta de onde saímos (caminho absoluto)
        ULTIMO_ARQUIVO="$local_dir_antes"
        salvar_posicao_dir "$parent_dir" "1" "$local_dir_antes"
        carregar_filtro_dir "$parent_dir"
        # TMP será resolvido por encontrar_posicao via ULTIMO_ARQUIVO
        TMP=1
        ALVO="$parent_dir"
        ULTIMO_DIR="$parent_dir"
        registrar_status
        salvar_sessao
        # NÃO invalida cache: pasta pai/filhas ficam em cache até mtime mudar
        continue
    fi

    if [ -d "$primeiro_caminho" ]; then
        # Salva posição e filtro atuais; ao avançar, o filtro da nova pasta começa vazio.
        rm -f "$DUP_MANUAL_FILE" 2>/dev/null || true
        eazy_ler_cursor_fzf
        # Se estavas numa lista, Alt+V volta a ela
        if [ "${MODO_BUSCA:-0}" -eq 1 ] || [ "${MODO_PLAYLIST:-0}" -eq 1 ] || [ "${MODO_DUP:-0}" -eq 1 ] || [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
            eazy_capturar_contexto_volta "${primeiro_caminho}"
        fi
        dir_atual_antes="$(pwd -P)"
        # Sempre o path da pasta em que se ENTRA (não o ULTIMO_ARQUIVO velho)
        _item_save=$(readlink -f -- "$primeiro_caminho" 2>/dev/null || printf '%s' "$primeiro_caminho")
        eazy_ler_cursor_fzf 2>/dev/null || true
        salvar_posicao_dir "$dir_atual_antes" "${TMP:-1}" "$_item_save"
        salvar_filtro_dir "$dir_atual_antes" "${FZF_QUERY:-}"
        FZF_QUERY=""
        DIRETORIO_ANTERIOR="$dir_atual_antes"
        if ! cd -- "$_item_save" 2>/dev/null && ! cd -- "$primeiro_caminho"; then
            eazy_beep_dir
            continue
        fi
        eazy_beep_dir
        # Filho: carrega posição interna; limpa item do pai
        ULTIMO_ARQUIVO=""
        carregar_posicao_dir "$(pwd -P)"
        ALVO="$(pwd -P)"
        ULTIMO_DIR="$(pwd -P)"
        registrar_status
        salvar_sessao
        # NÃO invalida cache: reentrar pastas pesadas usa cache por mtime
        continue
    fi

    if [ -f "$primeiro_caminho" ]; then
        # Enter → só o cursor. Alt+Enter → seleção inteira (com confirmação).
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ "${tecla:-}" = "alt-enter" ]; then
            printf '%s\n' "$escolha" | eazy_playlist_alt_enter "$playlist_sel"
        else
            if [ -n "${cursor_raw:-}" ]; then
                p=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
            else
                p="$primeiro_caminho"
            fi
            p_abs=$(caminho_absoluto "$p")
            [ -f "$p_abs" ] && printf '%s\n' "$p_abs" >> "$playlist_sel"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ] && [ "${tecla:-}" = "alt-enter" ]; then
            confirmar_alt_enter "$total_sel" || { rm -f "$playlist_sel"; continue; }
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -ge 1 ]; then
            tocado=$(head -n1 "$playlist_sel")
            ULTIMO_ARQUIVO="$tocado"
            registrar_status
            eazy_abrir_arquivo_enter "$tocado"
        fi
        rm -f "$playlist_sel"
    fi
done
