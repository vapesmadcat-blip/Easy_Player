        lista_preparada=$(eazy_lista_ordenar "$dados_brutos")
        if [ "$_force_sql_refresh" -ne 1 ] && [ "${MODO_DUP:-0}" -ne 1 ]; then
            eazy_lista_cache_save "$_ck" "$lista_preparada"
        fi
        eazy_status_file "lista pronta" "ok" 2>/dev/null || true
    fi


    TOTAL_PLAYLIST=$(grep -c '^' "$PLAYLIST_FILE" 2>/dev/null || echo 0)
    TOTAL_PLAYLIST=$(echo "$TOTAL_PLAYLIST" | LC_ALL=C tr -cd '0-9')
    TOTAL_PLAYLIST=${TOTAL_PLAYLIST:-0}

    # Status permanente: HD livre/total + Sel (atualiza ao marcar)
    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        TOTAL_DL=$(grep -c '^' "$DOWNLOAD_QUEUE" 2>/dev/null || echo 0)
        TOTAL_DL=$(echo "$TOTAL_DL" | LC_ALL=C tr -cd '0-9')
        TOTAL_DL=${TOTAL_DL:-0}
        TEXTO_PROMPT=" 📥 FILA DE DOWNLOADS ($TOTAL_DL itens) ❯ "
        EAZY_HEADER_HINT=" [ENTER]: Baixar | [CTRL-A/X/R]: Marcar | [CTRL-B]: Sair | [DEL]: Remover | [F10]: Ajuda "
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        _active_sql_table=$(eazy_sql_list_table_for_view "${ARQUIVO_PLAYLIST_ABERTO:-}" 2>/dev/null || true)
        if [ "${EAZY_IGNORE:-0}" = "1" ]; then
            case "$ARQUIVO_PLAYLIST_ABERTO" in
                "$PLAYLIST_1") _active_sql_table="temp_playlist_1" ;;
                "$PLAYLIST_2") _active_sql_table="temp_playlist_2" ;;
                "$PLAYLIST_3") _active_sql_table="temp_playlist_3" ;;
            esac
        fi
        if [ -n "$_active_sql_table" ]; then
            if [ "${EAZY_IGNORE:-0}" != "1" ] && [ "${EAZY_SQL_LISTS_READY:-0}" = "1" ]; then
                TOTAL_FILA=$(eazy_sql_list_indexer "--list-count=$_active_sql_table" 2>/dev/null || echo 0)
            else
                TOTAL_FILA=$(grep -c '^' "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || echo 0)
            fi
            TOTAL_FILA=$(echo "$TOTAL_FILA" | tr -cd '0-9')
            TOTAL_FILA=${TOTAL_FILA:-0}
            case "$_active_sql_table" in
                temp_playlist_1)
                    FILA_ATUAL=1
                    TEXTO_PROMPT=" 📋 FILA 1 ($TOTAL_FILA) [1:$TOTAL_FILA|2:$(contar_fila 2)|3:$(contar_fila 3)] ❯ "
                    EAZY_HEADER_HINT=" [ENTER]: Tocar | [F12]: Tocar lista | [CTRL-E]: Shuffle | [DEL]: Só da fila SQL | [ALT+D]: Apaga do DISCO | [CTRL-P]: Próx. fila "
                    ;;
                temp_playlist_2)
                    FILA_ATUAL=2
                    TEXTO_PROMPT=" 📋 FILA 2 ($TOTAL_FILA) [1:$(contar_fila 1)|2:$TOTAL_FILA|3:$(contar_fila 3)] ❯ "
                    EAZY_HEADER_HINT=" [ENTER]: Tocar | [F12]: Tocar lista | [CTRL-E]: Shuffle | [DEL]: Só da fila SQL | [ALT+D]: Apaga do DISCO | [CTRL-P]: Próx. fila "
                    ;;
                temp_playlist_3)
                    FILA_ATUAL=3
                    TEXTO_PROMPT=" 📋 FILA 3 ($TOTAL_FILA) [1:$(contar_fila 1)|2:$(contar_fila 2)|3:$TOTAL_FILA] ❯ "
                    EAZY_HEADER_HINT=" [ENTER]: Tocar | [F12]: Tocar lista | [CTRL-E]: Shuffle | [DEL]: Só da fila SQL | [ALT+D]: Apaga do DISCO | [CTRL-P]: Próx. fila "
                    ;;
                eazy_internal_last_search)
                    TEXTO_PROMPT=" 🔎 ÚLTIMA PESQUISA ($TOTAL_FILA itens) ❯ "
                    EAZY_HEADER_HINT=" [ENTER]: Tocar | [F12]: Tocar lista | [CTRL-E]: Shuffle | [DEL]: Só da lista SQL | [ALT+D]: Apaga do DISCO | [CTRL-P]: Listas "
                    ;;
                *)
                    TEXTO_PROMPT=" 📋 $_active_sql_table ($TOTAL_FILA itens) [CTRL-P]: Próx. lista ❯ "
                    EAZY_HEADER_HINT=" [ENTER]: Tocar | [F12]: Tocar lista | [CTRL-E]: Shuffle | [DEL]: Só da lista SQL | [ALT+D]: Apaga do DISCO | [CTRL-P]: Próx. lista "
                    ;;
            esac
        elif [ "$ARQUIVO_PLAYLIST_ABERTO" = "$HISTORY_FILE" ]; then
            TOTAL_HIST=$(eazy_history_db_count 2>/dev/null || echo 0)
            TOTAL_HIST=$(echo "$TOTAL_HIST" | tr -cd '0-9')
            TOTAL_HIST=${TOTAL_HIST:-0}
            TEXTO_PROMPT=" 🕐 HISTÓRICO ($TOTAL_HIST) ❯ "
        EAZY_HEADER_HINT=" [ENTER]: Tocar | [TAB]: Marcar | [DEL/ALT+D/SHIFT+DEL]: Só histórico | [F12]: Tocar lista | [CTRL-E]: Shuffle | [CTRL-G]: Fechar "
        else
            TEXTO_PROMPT=" 📜 PLAYLIST: $(basename "$ARQUIVO_PLAYLIST_ABERTO") ❯ "
            EAZY_HEADER_HINT=" [TAB/ESPACO]: Marcar | [ENTER]: Tocar | [F12]: Tocar lista | [CTRL-E]: Shuffle | [DEL]: Remover | [INSERT]: Fila | [CTRL-O]: Fechar "
        fi
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        TOTAL_DUP=$(grep -c '^' "$DUP_FILE" 2>/dev/null || echo 0)
        TOTAL_DUP=$(echo "$TOTAL_DUP" | LC_ALL=C tr -cd '0-9')
        TOTAL_DUP=${TOTAL_DUP:-0}
        TEXTO_PROMPT=" 🔁 DUPLICADOS (tmp) [${EXT_DUP:-lista salva}] — $TOTAL_DUP arq. | limpar: Alt-X ❯ "
        IFS=$'\t' read -r DUP_SEL_COUNT DUP_SEL_BYTES < <(eazy_dup_db --dup-marks-stats 2>/dev/null)
        DUP_SEL_COUNT=$(printf '%s' "${DUP_SEL_COUNT:-0}" | tr -cd '0-9'); DUP_SEL_COUNT=${DUP_SEL_COUNT:-0}
        DUP_SEL_BYTES=$(printf '%s' "${DUP_SEL_BYTES:-0}" | tr -cd '0-9'); DUP_SEL_BYTES=${DUP_SEL_BYTES:-0}
        DUP_SEL_LABEL=$(formatar_bytes_label "$DUP_SEL_BYTES")
        DUP_SEL_INFO=" | [SEL: ${DUP_SEL_COUNT} item(ns) / ${DUP_SEL_LABEL}]"
        EAZY_HEADER_HINT=" [F12]: ●verm amostra | [CTRL-T]: ●→✓ amar | [CTRL-A]: ✓ todos | [CTRL-R]: invert ✓ | [CTRL-X]: limpa ✓ | [TAB]: ✓ | [ENTER/DEL]: usa ✓$DUP_SEL_INFO "
    elif [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        extra_lbl=""
        [ -n "${BUSCA_TAM_LABEL:-}" ] && extra_lbl=" tam:$BUSCA_TAM_LABEL"
        [ -n "${BUSCA_CONTEUDO:-}" ] && extra_lbl="$extra_lbl txt:«${BUSCA_CONTEUDO:0:20}»"
        TEXTO_PROMPT=" 🔎 BUSCA [${EXT_BUSCA:-todas}]$extra_lbl ❯ "
        EAZY_HEADER_HINT=" [TAB]: Marcar | [ENTER]: Tocar | [ALT+ENTER]: Executar selecionados | [CTRL-K]: Acoes | [CTRL-L]: Pasta | [INSERT]: Fila | [DEL]: HD | [CTRL-P]: Listas/Última pesquisa | [CTRL-F]: Sair "
    else
        TEXTO_PROMPT=" 📂 [$(eazy_filtro_label "$FILTRO_ATUAL")] $PASTA_ATUAL ❯ "
        EAZY_HEADER_HINT=" [TAB]: Marcar | [ENTER]: Tocar | [CTRL-K]: Acoes | [CTRL-L]: Pasta | [CTRL-/]: Preview | [INSERT]: Fila | [DEL]: HD | [F10]: Ajuda "
    fi
    if [ -n "${EAZY_SQL_QUERY_ERROR:-}" ]; then
        EAZY_HEADER_HINT=" ⚠ FALHA SQLite: ${EAZY_SQL_QUERY_ERROR} "
    elif [ "${EAZY_IGNORE:-0}" != "1" ] && [ "${MODO_PLAYLIST:-0}" -eq 0 ] && \
         [ "${MODO_DOWNLOAD:-0}" -eq 0 ] && [ "${MODO_DUP:-0}" -eq 0 ] && \
         [ "${MODO_BUSCA:-0}" -eq 0 ]; then
        EAZY_HEADER_HINT=" [FONTE: SQLite direto] $EAZY_HEADER_HINT"
    fi
    export EAZY_HEADER_HINT
    # Os comandos transform-header do fzf rodam em subprocessos; passe a pasta
    # navegada explicitamente para que df consulte o mount correto, não o cwd inicial.
    EAZY_HEADER_DISK_PATH="${PASTA_ATUAL:-$(pwd -P 2>/dev/null || pwd)}"
    export EAZY_HEADER_DISK_PATH
    EAZY_HEADER_CACHE_FILE="${EAZY_TMP_DIR}/eazy_header_stats_$$"
    rm -f -- "$EAZY_HEADER_CACHE_FILE" 2>/dev/null || true
    export EAZY_HEADER_CACHE_FILE
    TEXTO_HEADER=$(eazy_status_header)

    TOTAL_LINHAS=$(echo "$lista_preparada" | grep -c '^')
    TOTAL_LINHAS=$(echo "$TOTAL_LINHAS" | LC_ALL=C tr -cd '0-9')
    TOTAL_LINHAS=${TOTAL_LINHAS:-1}

    if [ -f "$TMP_FILE" ]; then
        IFS='|' read -r TMP_READ ALVO_READ ULTIMO_ARQUIVO_READ ULTIMO_DIR_READ MODO_PL_READ < "$TMP_FILE"

        if [ "${MODO_PLAYLIST:-0}" -eq 1 ] || [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
            TMP="${TMP_READ:-2}"
            [ -n "${ULTIMO_ARQUIVO_READ:-}" ] && ULTIMO_ARQUIVO="$ULTIMO_ARQUIVO_READ"
        else
            _ud=$(readlink -f -- "${ULTIMO_DIR_READ:-}" 2>/dev/null || printf '%s' "${ULTIMO_DIR_READ:-}")
            _pa=$(readlink -f -- "$PASTA_ATUAL" 2>/dev/null || printf '%s' "$PASTA_ATUAL")
            if [ -n "$_ud" ] && [ -n "$_pa" ] && [ "$_ud" != "$_pa" ]; then
                # mudou de pasta: índice numérico não serve — item salvo manda
                TMP=1
                ALVO="$PASTA_ATUAL"
                # ULTIMO_ARQUIVO já veio de carregar_posicao_dir; senão do TMP_FILE
                if [ -z "${ULTIMO_ARQUIVO:-}" ] && [ -n "${ULTIMO_ARQUIVO_READ:-}" ]; then
                    ULTIMO_ARQUIVO="$ULTIMO_ARQUIVO_READ"
                fi
            else
                TMP="${TMP_READ:-1}"
                ALVO="${ALVO_READ:-$PASTA_ATUAL}"
                # se carregar_posicao já definiu item, não sobrescreve com vazio
                if [ -n "${ULTIMO_ARQUIVO_READ:-}" ]; then
                    if [ -z "${ULTIMO_ARQUIVO:-}" ] || [ "$ULTIMO_ARQUIVO" = "$ULTIMO_ARQUIVO_READ" ]; then
                        ULTIMO_ARQUIVO="$ULTIMO_ARQUIVO_READ"
                    fi
                fi
            fi
        fi

        TMP=$(echo "$TMP" | LC_ALL=C tr -cd '0-9')
        TMP=${TMP:-1}
        [ "$TMP" -lt 1 ] && TMP=1
        [ "$TOTAL_LINHAS" -gt 0 ] && [ "$TMP" -gt "$TOTAL_LINHAS" ] && TMP="$TOTAL_LINHAS"
    fi

    # Grava lista ANTES de calcular posição
    # Busca: evita cursor no “fundo” da lista (efeito vácuo após parcial)
    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        lista_preparada=$(printf '%s
' "$lista_preparada" | awk -F '\t' 'NF>=2 && $NF!="" && $NF!="."')
        TMP=1
        ULTIMO_ARQUIVO=""
    fi
    printf '%s
' "$lista_preparada" > "$LISTA_FZF_FILE"

    # Posição: ULTIMO_ARQUIVO (path absoluto) tem prioridade sobre índice
    lista_para_posicao="$lista_preparada"
    if [ -n "${FZF_QUERY:-}" ] && [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ]; then
        lista_filtrada_posicao=$(eazy_lista_filtrada "$FZF_QUERY")
        [ -n "$lista_filtrada_posicao" ] && lista_para_posicao="$lista_filtrada_posicao"
    fi
    if [ -n "${ULTIMO_ARQUIVO:-}" ] && [ -n "$lista_para_posicao" ]; then
        pos_ultimo=$(encontrar_posicao "$ULTIMO_ARQUIVO" "$lista_para_posicao")
        if [ -n "$pos_ultimo" ] && [ "$pos_ultimo" -ge 1 ]; then
            TMP="$pos_ultimo"
        fi
    fi

    TMP=$(echo "${TMP:-1}" | LC_ALL=C tr -cd '0-9'); TMP=${TMP:-1}
    [ "$TMP" -lt 1 ] && TMP=1
    TOTAL_LINHAS=$(printf '%s\n' "$lista_para_posicao" | grep -c '^' 2>/dev/null || echo 1)
    TOTAL_LINHAS=$(echo "$TOTAL_LINHAS" | tr -cd '0-9'); TOTAL_LINHAS=${TOTAL_LINHAS:-1}
    [ "$TMP" -gt "$TOTAL_LINHAS" ] && TMP="$TOTAL_LINHAS"

    registrar_status

    # Rodapé dinâmico do FZF (v0.63+). Em versões antigas, usa uma faixa-preview
    # de uma linha no rodapé, ou mantém o preview detalhado à direita se estiver ativo.
    if [ -z "${EAZY_FZF_HAS_FOOTER+x}" ]; then
        _eazy_fzf_help=$(fzf --help 2>&1 || true)
        case "$_eazy_fzf_help" in *--footer*) EAZY_FZF_HAS_FOOTER=1 ;; *) EAZY_FZF_HAS_FOOTER=0 ;; esac
        export EAZY_FZF_HAS_FOOTER
    fi
    if [ -z "${EAZY_FZF_HAS_LISTEN+x}" ]; then
        [ -n "${_eazy_fzf_help:-}" ] || _eazy_fzf_help=$(fzf --help 2>&1 || true)
        case "$_eazy_fzf_help" in *--listen*) EAZY_FZF_HAS_LISTEN=1 ;; *) EAZY_FZF_HAS_LISTEN=0 ;; esac
        export EAZY_FZF_HAS_LISTEN
    fi
    EAZY_FZF_LISTEN_SUPPORTED="${EAZY_FZF_HAS_LISTEN:-0}"
    FZF_FOOTER_ARGS=()
    FZF_FOCUS_ARGS=()
    FZF_PREVIEW_ARGS=()
    FZF_BORDER_LABEL_ARGS=()
    FZF_BORDER_LABEL_COLOR=""
    EAZY_PREVIEW_ACTIVE="${PREVIEW_ATIVO:-0}"
    export EAZY_PREVIEW_ACTIVE
    export EAZY_VERSION_LABEL
    if [ -z "${EAZY_FZF_HAS_BORDER_LABEL+x}" ]; then
        [ -n "${_eazy_fzf_help:-}" ] || _eazy_fzf_help="$(fzf --help 2>&1 || true)"
        if [[ "$_eazy_fzf_help" == *--border-label* && "$_eazy_fzf_help" == *--border-label-pos* ]]; then
            EAZY_FZF_HAS_BORDER_LABEL=1
        else
            EAZY_FZF_HAS_BORDER_LABEL=0
        fi
        export EAZY_FZF_HAS_BORDER_LABEL
    fi
    if [ "${EAZY_FZF_HAS_BORDER_LABEL:-0}" = "1" ]; then
        FZF_BORDER_LABEL_ARGS=(--border-label=" $EAZY_VERSION_LABEL " --border-label-pos=-3:bottom)
        FZF_BORDER_LABEL_COLOR=",label:#5eacd3"
    fi
    if [ "${EAZY_FZF_HAS_FOOTER:-0}" = "1" ]; then
        FZF_FOOTER_ARGS=(--footer= --footer-border=line)
        # Uma ação de foco salva cursor/item e atualiza o caminho no rodapé.
        FZF_FOCUS_ARGS=(--bind="focus:transform-footer:bash -c 'eazy_focus_update \"\$1\" \"\$2\"' -- {n} {}")
        if [ "${PREVIEW_ATIVO:-0}" = "1" ]; then
            PREVIEW_WIN="right:40%:wrap:border-left"
            FZF_PREVIEW_COMMAND='bash -c "eazy_preview \"\$1\"" -- {}'
            FZF_PREVIEW_ARGS=(--preview="${FZF_PREVIEW_COMMAND}" --preview-window="${PREVIEW_WIN}")
        else
            # Sem preview: não passe --preview; a janela oculta não deve fazer trabalho.
            FZF_PREVIEW_COMMAND=""
            PREVIEW_WIN=""
        fi
    else
        # Fzf antigo não tem rodapé nativo; sincroniza o cursor no comando que
        # já atualiza a faixa de caminho/preview, evitando uma segunda ação de foco.
        if [ "${PREVIEW_ATIVO:-0}" = "1" ]; then
            PREVIEW_WIN="right:40%:wrap:border-left"
            FZF_PREVIEW_COMMAND='bash -c "eazy_focus_preview \"\$1\" \"\$2\"" -- {n} {}'
        else
            FZF_PREVIEW_COMMAND='bash -c "eazy_focus_update \"\$1\" \"\$2\"" -- {n} {}'
            PREVIEW_WIN="down:1:wrap:border-top"
        fi
        FZF_PREVIEW_ARGS=(--preview="${FZF_PREVIEW_COMMAND}" --preview-window="${PREVIEW_WIN}")
    fi


    # Filtro digitado persiste; navegação nunca some e nunca entra nas ações
    # --disabled: o fzf NÃO filtra de novo (senão esconde o ..); quem filtra é eazy_lista_filtrada
    export MODO_BUSCA MODO_PLAYLIST
    EAZY_CTRL_A_RESULT_FILE="$EAZY_TMP_DIR/eazy_ctrl_a_result_$$"
    rm -f "$EAZY_CTRL_A_RESULT_FILE"
    export EAZY_CTRL_A_RESULT_FILE
    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        # Ctrl-R: inverte só ✓ AMARELO; ● VERMELHO (F12) permanece. Reload redesenha marcas.
        CTRL_R_BIND='ctrl-r:execute-silent(eazy_dup_invert)+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+transform-header(eazy_status_header)'
        # Ctrl-A: marca TODOS os arquivos de amarelo (não mexe no vermelho)
        CTRL_A_BIND='ctrl-a:execute-silent(eazy_dup_select_all)+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+transform-header(eazy_status_header)'
        # Ctrl-X: limpa só AMARELO; vermelho fixo permanece
        CTRL_X_BIND='ctrl-x:execute-silent(eazy_dup_clear_all)+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+transform-header(eazy_status_header)'
        # Ctrl-T: marca de AMARELO todas as VERMELHAS (união)
        CTRL_T_BIND='ctrl-t:execute-silent(eazy_dup_select_fixed)+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+transform-header(eazy_status_header)'
    else
        # Ctrl-R: inverte a persistência dos itens visíveis E as marcas do fzf.
        # A marcação original deixa de ir para a persistência — o estado invertido é salvo.
        # first+deselect tira o .. da multi-seleção. Sem reload para não apagar as marcas do fzf.
        CTRL_R_BIND='ctrl-r:execute-silent(bash -c '\''eazy_invert_visible_global "$1"'\'' -- {q})+toggle-all+first+deselect+transform-header(eazy_status_header)'
        CTRL_A_BIND='ctrl-a:execute-silent(bash -c '\''eazy_select_visible_global "$1"'\'' -- {q})+transform(eazy_ctrl_a_fzf_action)+transform-header(eazy_status_header)'
        CTRL_X_BIND='ctrl-x:execute-silent(bash -c '\''eazy_clear_local_selection'\'')+reload(eazy_lista_filtrada_live '\''{q}'\'')+first+transform-header(eazy_status_header)'
        CTRL_T_BIND=''
    fi
    # Ctrl-T: em duplicados é bind (●→✓); fora, --expect altera ordenação por data
    EAZY_CURSOR_ITEM_FILE="$EAZY_TMP_DIR/eazy_cursor_item_$$"
    rm -f "$EAZY_CURSOR_ITEM_FILE"
    export EAZY_CURSOR_ITEM_FILE
    FZF_ENTER_BIND="enter:execute-silent(bash -c 'printf \"%s\\n\" \"\$1\" > \"\$2\"' -- {} \"$EAZY_CURSOR_ITEM_FILE\")+accept"
    EAZY_ALT_ENTER_FILE="$EAZY_TMP_DIR/eazy_alt_enter_$$"
    rm -f -- "$EAZY_ALT_ENTER_FILE"
    export EAZY_ALT_ENTER_FILE
    eazy_keys_set_defaults
    FZF_EXPECT="f1,f2,f3,f4,f5,f6,f7,f8,f12,ctrl-h,alt-v,alt-x,alt-q,${EAZY_FZF_BACKSPACE_EXPECT}${EAZY_FZF_TERM_KEY:+${EAZY_FZF_TERM_KEY},}X"
    for _k in "$KEY_DELETE" "$KEY_DELETE_DISK" "$KEY_INSERT" "$KEY_SAVE" "$KEY_PLAYLIST" \
              "$KEY_SEARCH" "$KEY_QUEUES" "$KEY_DUPES" "$KEY_DOWNLOADS" "$KEY_NOTES" \
              "$KEY_QUIT2" "$KEY_COPY" "$KEY_MOVE" "$KEY_HISTORY" "$KEY_EXPORT" \
              "$KEY_ACTIONS" "$KEY_GOTO" "$KEY_PREVIEW" "$KEY_CONFIG" "$KEY_HELP" "$KEY_QUIT" "$KEY_VOICE" "$KEY_EXEC" "$KEY_HTML"; do
        [ -n "$_k" ] && FZF_EXPECT="${FZF_EXPECT},${_k}"
    done
    if [ "${MODO_DUP:-0}" -ne 1 ]; then
        FZF_EXPECT="${FZF_EXPECT},ctrl-t"
    fi
    FZF_EXPECT=$(echo "$FZF_EXPECT" | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -)

    # Remove teclas que o fzf rejeita (evita spam "unsupported key")
    FZF_EXPECT=$(printf '%s' "$FZF_EXPECT" | tr ',' '\n' | grep -Ev '^(ctrl-backspace|ctrl-bs|alt-f10)$' | paste -sd, -)
    # alt-0 = tela terminal; alt-q = read sem limpar a tela
    case ",$FZF_EXPECT," in *,alt-0,*) ;; *) FZF_EXPECT="${FZF_EXPECT},alt-0" ;; esac
    case ",$FZF_EXPECT," in *,alt-q,*) ;; *) FZF_EXPECT="${FZF_EXPECT},alt-q" ;; esac
    for _dk in shift-delete; do
        case ",$FZF_EXPECT," in *",${_dk},"*) ;; *) FZF_EXPECT="${FZF_EXPECT},${_dk}" ;; esac
    done

    FZF_BIND_T=()
    [ -n "${CTRL_T_BIND:-}" ] && FZF_BIND_T=(--bind="$CTRL_T_BIND")
    FZF_BIND_ESC=()
    FZF_SEARCH_ESC_BIND=()
    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        FZF_EXPECT="${FZF_EXPECT},esc,alt-r"
        # O fzf recebe Esc, grava o sinal e aborta; a busca detecta o arquivo e mata find/grep.
        EAZY_BUSCA_CANCEL_FILE="${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}"
        FZF_SEARCH_ESC_BIND=(--bind="esc:execute-silent(touch -- ${EAZY_BUSCA_CANCEL_FILE})+abort")
    fi

    FZF_DUP_SELECT_BINDS=()
    FZF_ALT_ENTER_BIND=()
    FZF_NORMAL_SELECT_BINDS=()
    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        FZF_DUP_SELECT_BINDS=(
            --bind='tab:execute-silent(bash -c '\''eazy_dup_toggle_path "$1"'\'' -- {})+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+down+transform-header(eazy_status_header)'
            --bind='shift-tab:execute-silent(bash -c '\''eazy_dup_toggle_path "$1"'\'' -- {})+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+up+transform-header(eazy_status_header)'
            --bind='space:execute-silent(bash -c '\''eazy_dup_toggle_path "$1"'\'' -- {})+reload(eazy_dup_refresh_lista '\''{q}'\'')+deselect-all+transform-header(eazy_status_header)'
        )
    else
        # Alt+Enter aceita a seleção múltipla; não depende de --expect.
        FZF_ALT_ENTER_BIND=(--bind="alt-enter:execute-silent(touch -- $EAZY_ALT_ENTER_FILE)+accept" --bind="ctrl-space:execute-silent(touch -- $EAZY_ALT_ENTER_FILE)+accept" --bind="f6:execute-silent(touch -- $EAZY_ALT_ENTER_FILE)+accept")
        # Seleção normal: Espaço/Tab marcam arquivos ou diretórios e atualizam Sel.
        FZF_NORMAL_SELECT_BINDS=(
            --bind='space:execute-silent(bash -c '\''eazy_toggle_global_item "$1"'\'' -- {})+toggle+transform-header(eazy_status_header)'
            --bind='home:first'
            --bind='end:last'
            --bind='tab:execute-silent(bash -c '\''eazy_toggle_global_item "$1"'\'' -- {})+toggle+down+transform-header(eazy_status_header)'
            --bind='shift-tab:execute-silent(bash -c '\''eazy_toggle_global_item "$1"'\'' -- {})+toggle+up+transform-header(eazy_status_header)'
        )
    fi
    # F12: pré-seleciona no load os itens já persistentes (fora de Duplicados).
    # Cursor: load:pos usa índice 1-based na lista filtrada
    TMP=$(echo "${TMP:-1}" | LC_ALL=C tr -cd '0-9'); TMP=${TMP:-1}
    [ "$TMP" -lt 1 ] && TMP=1
    EAZY_LOAD_BIND="load:pos($TMP)"
    if [ "${EAZY_PRESELECT_PERSIST:-0}" = "1" ] && [ "${MODO_DUP:-0}" -ne 1 ]; then
        # pré-seleção + no fim reposiciona no cursor guardado
        _pre=$(eazy_build_preselect_load_bind "$FZF_QUERY" "$TMP")
        # garante pos(TMP) no final
        EAZY_LOAD_BIND="${_pre%+pos(*}"
        EAZY_LOAD_BIND=$(printf '%s' "$_pre" | sed "s/pos([0-9]*)/pos($TMP)/g")
        case "$EAZY_LOAD_BIND" in
            *pos\("$TMP"\)*|*pos\($TMP\)*) ;;
            load:*) EAZY_LOAD_BIND="${EAZY_LOAD_BIND}+pos($TMP)" ;;
            *) EAZY_LOAD_BIND="load:pos($TMP)" ;;
        esac
        EAZY_PRESELECT_PERSIST=0
        export EAZY_PRESELECT_PERSIST
    fi
    export EAZY_LOAD_BIND

    # Índice (cursor) válido para a lista atual — pasta, playlist, histórico, temporárias, etc.
    TMP=$(echo "${TMP:-1}" | LC_ALL=C tr -cd '0-9'); TMP=${TMP:-1}
    [ "$TMP" -lt 1 ] && TMP=1
    if [ -n "${TOTAL_LINHAS:-}" ] && [ "$TOTAL_LINHAS" -gt 0 ] 2>/dev/null; then
        [ "$TMP" -gt "$TOTAL_LINHAS" ] && TMP="$TOTAL_LINHAS"
    fi

    # Garante o snapshot local correto no primeiro conteúdo enviado ao fzf.
    # Alterações seguintes invalidam o snapshot e o filtro atualiza-o uma única vez.
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ] && [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DUP:-0}" -eq 0 ]; then
        eazy_sql_selection_refresh_local "$(pwd -P)"
    fi

    if [ "${EAZY_STARTUP_NOTICE_ACTIVE:-0}" = "1" ]; then
        printf '\r\033[2K\n' > /dev/tty 2>/dev/null || true
        EAZY_STARTUP_NOTICE_ACTIVE=0
    fi
    eazy_status_file_clear 2>/dev/null || true
    EAZY_WATCH_SESSION_DIR=$(eazy_live_watch_sessions_dir 2>/dev/null || true)
    [ -n "$EAZY_WATCH_SESSION_DIR" ] || EAZY_WATCH_SESSION_DIR="${EAZY_TMP_DIR}/live-watch-sessions"
    EAZY_WATCH_REFRESH_FILE="${EAZY_WATCH_SESSION_DIR}/live-refresh_$$"
    EAZY_WATCH_SESSION_FILE="${EAZY_WATCH_SESSION_DIR}/eazy_$$.session"
    FZF_LISTEN_ARGS=()
    export EAZY_WATCH_SESSION_DIR EAZY_WATCH_REFRESH_FILE EAZY_WATCH_SESSION_FILE
    export MODO_DOWNLOAD MODO_DUP MODO_BUSCA MODO_PLAYLIST
    export EAZY_TMP_DIR PYTHON_CMD MODO_ATUAL FILTRO_ATUAL SHOW_DELETED
    if [ "${EAZY_IGNORE:-0}" != "1" ] && [ "${MODO_PLAYLIST:-0}" -eq 0 ] && \
       [ "${MODO_DOWNLOAD:-0}" -eq 0 ] && [ "${MODO_DUP:-0}" -eq 0 ] && \
       [ "${MODO_BUSCA:-0}" -eq 0 ]; then
        mkdir -p "$EAZY_WATCH_SESSION_DIR" 2>/dev/null || true
        chmod 700 "$EAZY_WATCH_SESSION_DIR" 2>/dev/null || true
        rm -f -- "$EAZY_WATCH_REFRESH_FILE" 2>/dev/null || true
        EAZY_FZF_PORT=0
        if [ "${EAZY_FZF_LISTEN_SUPPORTED:-0}" = "1" ]; then
            EAZY_FZF_PORT=$("${PYTHON_CMD:-python3}" -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()' 2>/dev/null || printf '0')
            case "$EAZY_FZF_PORT" in *[!0-9]*|'') EAZY_FZF_PORT=0 ;; esac
            [ "$EAZY_FZF_PORT" -gt 0 ] 2>/dev/null && FZF_LISTEN_ARGS=(--listen="$EAZY_FZF_PORT")
        fi
        EAZY_WATCH_SESSION_TMP="${EAZY_WATCH_SESSION_FILE}.tmp"
        if printf '%s\0%s\0%s\0' "${EAZY_FZF_PORT:-0}" "$(pwd -P 2>/dev/null || pwd)" "$EAZY_WATCH_REFRESH_FILE" > "$EAZY_WATCH_SESSION_TMP" && \
           mv -f -- "$EAZY_WATCH_SESSION_TMP" "$EAZY_WATCH_SESSION_FILE"; then
            :
        else
            rm -f -- "$EAZY_WATCH_SESSION_TMP" "$EAZY_WATCH_SESSION_FILE" 2>/dev/null || true
            FZF_LISTEN_ARGS=()
        fi
    else
        rm -f -- "$EAZY_WATCH_SESSION_FILE" "$EAZY_WATCH_REFRESH_FILE" 2>/dev/null || true
    fi
    saida_fzf=$(eazy_lista_filtrada "$FZF_QUERY" | fzf --multi --ansi \
        "${FZF_LISTEN_ARGS[@]}" \
        --disabled \
        --print-query \
        --query="$FZF_QUERY" \
        --expect="$FZF_EXPECT" \
        --delimiter='\t' \
        --with-nth=2,3 \
        --layout=reverse \
        --border=rounded \
        --margin=1,2 \
        --padding=1 \
        --info=inline \
        --pointer="▶" \
        --marker="✓" \
        --color="bg+:#2b2b2b,border:#5eacd3,header:#85c1dc,prompt:#98c379,pointer:#ffd700,marker:#ffd700,hl:#000000:reverse,hl+:#000000:reverse,info:#5eacd3,preview-fg:#d4d4d4,preview-bg:#1e1e1e${FZF_BORDER_LABEL_COLOR}" \
        --header="$TEXTO_HEADER" \
        --prompt="$TEXTO_PROMPT" \
        --no-sort \
        "${FZF_BORDER_LABEL_ARGS[@]}" \
        "${FZF_PREVIEW_ARGS[@]}" \
        "${FZF_FOOTER_ARGS[@]}" \
        --bind="change:reload:eazy_lista_filtrada_live '{q}'" \
        "${FZF_DUP_SELECT_BINDS[@]}" \
        "${FZF_NORMAL_SELECT_BINDS[@]}" \
        --bind="$CTRL_A_BIND" \
        --bind="$CTRL_X_BIND" \
        --bind="$CTRL_R_BIND" \
        --bind="$FZF_ENTER_BIND" \
        "${FZF_ALT_ENTER_BIND[@]}" \
        "${FZF_BIND_T[@]}" \
        "${FZF_BIND_ESC[@]}" \
        "${FZF_SEARCH_ESC_BIND[@]}" \
        --bind="home:first" \
        --bind="end:last" \
        --bind="${EAZY_LOAD_BIND:-load:pos($TMP)}" \
        "${FZF_FOCUS_ARGS[@]}")
    rm -f -- "$EAZY_WATCH_SESSION_FILE" 2>/dev/null || true

    # --print-query + --expect: linha1=query, linha2=tecla, resto=seleção
    FZF_QUERY=$(printf '%s\n' "$saida_fzf" | sed -n '1p' | sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g; s/\r//g')
    tecla=$(printf '%s\n' "$saida_fzf" | sed -n '2p')
    tecla=$(eazy_normalize_tecla "$tecla")
    cursor_raw=$(cat "$EAZY_CURSOR_ITEM_FILE" 2>/dev/null || true)
    rm -f "$EAZY_CURSOR_ITEM_FILE"
    if [ -e "$EAZY_ALT_ENTER_FILE" ]; then
        tecla="alt-enter"
        rm -f -- "$EAZY_ALT_ENTER_FILE"
    fi
    escolha_raw=$(printf '%s\n' "$saida_fzf" | tail -n +3)
    # Alt+Enter: só remarca a persistência se o fzf devolveu multi-seleção real.
    # (reload apaga marcas do fzf; remarcar com 0/1 item apagaria a seleção persistente.)
    if [ "${tecla:-}" = "alt-enter" ] && [ "${MODO_DUP:-0}" -eq 0 ] && [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ]; then
        _ae_n=$(printf '%s\n' "$escolha_raw" | eazy_sem_navegacao | grep -c '^' 2>/dev/null || echo 0)
        _ae_n=$(echo "$_ae_n" | tr -cd '0-9'); _ae_n=${_ae_n:-0}
        if [ "$_ae_n" -gt 1 ]; then
            eazy_remark_local_selection <<< "$escolha_raw"
        fi
        unset _ae_n
    fi
    # Enter (tecla vazia): SOMENTE o item sob o cursor — nunca a multi-seleção.
    # Alt+Enter: mantém escolha_raw completa (seleção inteira).
    if [ -z "${tecla:-}" ]; then
        if [ -n "${cursor_raw:-}" ]; then
            escolha_raw="$cursor_raw"
        else
            escolha_raw=$(printf '%s\n' "$escolha_raw" | head -n1)
        fi
    fi
    # Remove .. / Voltar de seleções múltiplas (Ctrl-A, TAB, espaço…)
    # Mas preserva se for SÓ navegação (Enter em ".." / Voltar deve funcionar)
    escolha=$(printf '%s\n' "$escolha_raw" | eazy_sem_navegacao)
    if [ -e "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" ]; then
        # Sinal residual do monitor — só limpa; NÃO esvaziar resultados já listados
        rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true
    fi
    if [ -z "$escolha" ] && [ -n "$escolha_raw" ]; then
        n_raw=$(printf '%s\n' "$escolha_raw" | grep -c '^' 2>/dev/null || echo 0)
        n_raw=$(echo "$n_raw" | tr -cd '0-9'); n_raw=${n_raw:-0}
        if [ "$n_raw" -ge 1 ]; then
            so_nav=1
            while IFS= read -r _ln; do
                [ -z "$_ln" ] && continue
                eazy_eh_navegacao "$_ln" || { so_nav=0; break; }
            done <<< "$escolha_raw"
            [ "$so_nav" -eq 1 ] && escolha=$(printf '%s\n' "$escolha_raw" | head -n1)
        fi
    fi

    EAZY_PRESERVE_LOCAL_SELECTION_FOR_COPY_MOVE=0
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ] && [ "${EAZY_IGNORE:-0}" != 1 ] && \
       [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ] && \
       [ "${MODO_DUP:-0}" -eq 0 ] && [ "${MODO_BUSCA:-0}" -eq 0 ] && \
       { [ "${tecla:-}" = "ctrl-y" ] || [ "${tecla:-}" = "ctrl-u" ]; }; then
        EAZY_PRESERVE_LOCAL_SELECTION_FOR_COPY_MOVE=1
    fi

    # Ao deixar a lista para uma ação/navegação, amarelos (selected=1) do
    # diretório atual tornam-se globais (selected=2) numa única transação.
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ] && [ "${tecla:-}" != "esc" ] && \
       [ "${tecla:-}" != "f12" ] && ! [[ "${tecla:-}" =~ ^f[1-8]$ ]] && \
       [ "${tecla:-}" != "alt-0" ] && [ "${tecla:-}" != "alt-q" ] && [ "${tecla:-}" != "ctrl-/" ] && \
       [ "${tecla:-}" != "ctrl-k" ] && \
       [ "${EAZY_PRESERVE_LOCAL_SELECTION_FOR_COPY_MOVE:-0}" != 1 ] && \
       { [ "${MODO_PLAYLIST:-0}" -ne 1 ] || [ "${tecla:-}" != "ctrl-e" ]; } && \
       { [ -n "${tecla:-}" ] || [ -n "${escolha:-}" ]; }; then
        "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-promote --selection-root "$(pwd -P)" >/dev/null 2>&1 || true
        eazy_sql_selection_refresh "$(pwd -P)"
    fi

    if [ -f "$TMP_FILE" ]; then
        IFS='|' read -r TMP ALVO ULTIMO_ARQUIVO ULTIMO_DIR MODO_PLAYLIST < "$TMP_FILE"
        TMP=$(echo "$TMP" | LC_ALL=C tr -cd '0-9')
        TMP=${TMP:-1}
    fi

    if [ "$tecla" = "alt-r" ] && [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        # Refaz com os MESMOS parâmetros
        BUSCA_SNAPSHOT_FILE=""
        BUSCA_REMAKE=1
        EAZY_BUSCA_NOME_ATUAL=""
        TMP=1
        ULTIMO_ARQUIVO=""
        rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" 2>/dev/null || true
        if type chave_cache_busca >/dev/null 2>&1; then
            _ckb=$(chave_cache_busca 2>/dev/null || true)
            [ -n "$_ckb" ] && rm -f "${BUSCA_CACHE_DIR}/${_ckb}.tsv" 2>/dev/null || true
        fi
        eazy_lista_cache_invalidate 2>/dev/null || true
        whiptail --title "Pesquisa — Alt+R" --msgbox "A refazer a pesquisa com os mesmos parâmetros.\n\nExtensão: ${EXT_BUSCA:-todas}\nTamanho: ${BUSCA_TAM_LABEL:-qualquer}\nConteúdo: ${BUSCA_CONTEUDO:-—}" 12 60
        continue
    fi

    if [ "$tecla" = "esc" ] && [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        MODO_BUSCA=0
        BUSCA_TAM_MIN=""; BUSCA_TAM_MAX=""; BUSCA_TAM_LABEL=""
        BUSCA_CONTEUDO=""
        TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"
        registrar_status
        continue
    fi

    if [ "$tecla" = "f12" ]; then
        if [ "${MODO_DUP:-0}" -eq 1 ]; then
            # Amostragem: primeiro item existente de cada grupo → só VERMELHO fixo.
            # O AMARELO é independente e muda com Ctrl-T, Espaço, Ctrl-A/R/X.
            DUP_SEL_COUNT=$(eazy_dup_amostra_f12)
            DUP_SEL_COUNT=$(echo "$DUP_SEL_COUNT" | tr -cd '0-9')
            DUP_SEL_COUNT=${DUP_SEL_COUNT:-0}
            [ "$DUP_SEL_COUNT" -gt 0 ] || eazy_beep 2>/dev/null || true
            continue
        fi
        if [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
            eazy_ler_cursor_fzf 2>/dev/null || true
            _f12_playlist="$EAZY_TMP_DIR/eazy_f12_play_$$"
            if eazy_montar_playlist_contexto "$_f12_playlist"; then
                salvar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
                tocar_lista "$_f12_playlist"
            else
                whiptail --title "Reprodução da lista" --msgbox "Esta lista não contém arquivos disponíveis para tocar." 8 60 2>/dev/null || true
            fi
            rm -f -- "$_f12_playlist"
            continue
        fi
        # Fora de duplicados: reaplica persistência como multi-select manual do fzf.
        if [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ]; then
            reconstruir_selecao_local
            EAZY_PRESELECT_PERSIST=1
            export EAZY_PRESELECT_PERSIST
            continue
        fi
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        case "$tecla" in
            ""|alt-d|ctrl-k|ctrl-y|ctrl-u|ctrl-e|insert) eazy_dup_refresh_selection_views ;;
        esac
    fi
    if [ "${MODO_DUP:-0}" -eq 1 ] && [ -s "$DUP_SELECTED_FILE" ]; then
        case "$tecla" in
            ""|alt-d|ctrl-k|ctrl-y|ctrl-u|ctrl-e|insert)
                # Snapshot efêmero carregado do SQLite; não é fonte persistente.
                escolha=$(cat "$DUP_SELECTED_FILE" 2>/dev/null || true)
                ;;
        esac
    fi

    # Fora de Duplicados: INSERT / Del / ações = mesma seleção do Alt+Enter
    # (multi-select do fzf + persistência em SELECTED_FILE).
    if [ "${MODO_DUP:-0}" -ne 1 ]; then
        case "$tecla" in
            insert|alt-d|ctrl-k|ctrl-y|ctrl-u|ctrl-e)
                if [ "${EAZY_PRESERVE_LOCAL_SELECTION_FOR_COPY_MOVE:-0}" != 1 ]; then
                    escolha=$(eazy_expandir_escolha_acoes "$escolha")
                fi
                ;;
        esac
    fi

    if [ "$tecla" = "ctrl-n" ]; then
        abrir_editor_notas
        continue
    elif [ "$tecla" = "alt-m" ]; then
        eazy_gravar_memo_voz
        continue
    elif [ "$tecla" = "alt-e" ]; then
        eazy_executar_programa
        continue
    elif [ "$tecla" = "X" ] || [ "$tecla" = "ctrl-q" ] || [ "$tecla" = "q" ]; then
        # X / Q / CTRL-Q = sair — salva sessão + diretório de saída
        salvar_sessao
        rm -f "$TMP_FILE" "$DUP_FILE" "$DUP_SELECTED_FILE" "$DUP_MANUAL_FILE" 2>/dev/null
        # NÃO apagar SELECTED_FILE (seleção global persistente)
        clear
        echo -e "\033[1;32m${EAZY_VERSION_LABEL}\033[0m — sessão salva."
        echo -e "Filas: 1=$(contar_fila 1) · 2=$(contar_fila 2) · 3=$(contar_fila 3)"
        eazy_aplicar_dir_saida
        exit 0
    elif [ "$tecla" = "ctrl-/" ] || [ "$tecla" = "ctrl-_" ]; then
        # CTRL-/ (alguns terminais enviam ctrl-_) — liga/desliga preview e persiste
        toggle_preview_persistente
        salvar_sessao
        continue
    elif [ "$tecla" = "ctrl-h" ]; then
        # Ctrl-H: galeria de vídeos (thumbnails) OU export HTML da tela
        _h=$(whiptail --title "Ctrl-H — HTML" --menu "O que gerar?" 20 70 9 \
            "tudo"    "Tudo nesta pasta (video+img+html+outros)" \
            "videos"  "So videos (thumbs + play)" \
            "imagens" "So imagens (thumbs + lightbox)" \
            "pastas"  "So pastas (subdiretorios)" \
            "listas"  "Listas: filas 1-3 / historico / atual" \
            "tela"    "Exportar tela / selecao (tabela + links)" \
            "0"       "Cancelar" \
            3>&1 1>&2 2>&3) || true
        case "$_h" in
            tudo) eazy_gerar_html_tudo ;;
            videos) eazy_gerar_html_videos ;;
            imagens) eazy_gerar_html_imagens ;;
            pastas) eazy_gerar_html_dirs ;;
            listas) eazy_menu_exportar_listas ;;
            tela) exportar_tela_html ;;
        esac
        continue
        elif [ "$tecla" = "alt-v" ] || [ "$tecla" = "ctrl-backspace" ] || [ "$tecla" = "ctrl-bs" ] || [ "$tecla" = "bspace" ]; then
        # Alt+V: volta à ÚLTIMA LISTA (pesquisa, histórico, fila 1–3, dup, downloads) ou pasta
        eazy_ler_cursor_fzf 2>/dev/null || true
        dir_atual="$(pwd -P)"
        # grava onde estamos agora (para a próxima volta)
        if [ -n "${EAZY_VOLTA_KIND:-}" ]; then
            if eazy_aplicar_contexto_volta; then
                eazy_beep_dir
                registrar_status
                continue
            fi
        fi
        # fallback: DIRETORIO_ANTERIOR clássico
        destino_anterior="${DIRETORIO_ANTERIOR:-}"
        [ "$destino_anterior" = "__BUSCA__" ] && destino_anterior="${BUSCA_ORIGEM:-}"
        if [ -n "$destino_anterior" ] && [ -d "$destino_anterior" ] && [ "$destino_anterior" != "$dir_atual" ]; then
            salvar_posicao_dir "$dir_atual" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
            salvar_filtro_dir "$dir_atual" "${FZF_QUERY:-}"
            DIRETORIO_ANTERIOR="$dir_atual"
            MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
            if cd -- "$destino_anterior" 2>/dev/null; then
                eazy_beep_dir
                carregar_filtro_dir "$(pwd -P)"
                carregar_posicao_dir "$(pwd -P)"
                ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
                registrar_status
            else
                eazy_beep_dir
            fi
        else
            eazy_beep_dir
        fi
        continue
    elif [ "$tecla" = "ctrl-l" ]; then
        eazy_ir_para_pasta "${escolha:-${cursor_raw:-}}" || true
        continue
    elif [ "$tecla" = "ctrl-]" ] || [ "$tecla" = "ctrl-plus" ] || [ "$tecla" = "ctrl-*" ] || [ "$tecla" = "alt-plus" ]; then
        # Ctrl++ / atalhos alternativos: adicionar pasta atual aos favoritos
        eazy_dir_fav_add "$(pwd -P)" || true
        continue
    elif [ "$tecla" = "f1" ]; then
        MODO_ATUAL="tamanho"
        eazy_beep_dir 2>/dev/null || true
        continue
    elif [ "$tecla" = "f2" ]; then
        MODO_ATUAL="nome"
        eazy_beep_dir 2>/dev/null || true
        continue
    elif [ "$tecla" = "ctrl-t" ]; then
        # Em duplicados: Ctrl-T = marcar de amarelo todas as vermelhas (F12)
        if [ "${MODO_DUP:-0}" -eq 1 ]; then
            eazy_dup_select_fixed
            continue
        fi
        MODO_ATUAL="data"
        eazy_beep_dir 2>/dev/null || true
        continue
    elif [ "$tecla" = "f3" ]; then
        [ "$TELA_ATUAL" = "fs" ] && TELA_ATUAL="janela" || TELA_ATUAL="fs"; continue
    elif [ "$tecla" = "f4" ]; then
        FILTRO_ATUAL="audios"; TMP=1; continue
    elif [ "$tecla" = "f5" ]; then
        FILTRO_ATUAL="videos"; TMP=1; continue
    elif [ "$tecla" = "f6" ]; then
        FILTRO_ATUAL="imgs"; TMP=1; continue
    elif [ "$tecla" = "f7" ]; then
        FILTRO_ATUAL="compactados"; TMP=1; continue
    elif [ "$tecla" = "f8" ]; then
        if [ "$FILTRO_ATUAL" = "todos" ]; then
            FILTRO_ATUAL="${FILTRO_ANTERIOR:-ambos}"
        else
            FILTRO_ANTERIOR="$FILTRO_ATUAL"
            FILTRO_ATUAL="todos"
        fi
        TMP=1; continue
    elif [ "$tecla" = "f9" ]; then
        configurar_defaults
        # F9 não é refazer pesquisa: só relê cache se estiver em MODO_BUSCA
        BUSCA_REMAKE=0
        continue
    elif [ "$tecla" = "alt-f10" ] || [ "$tecla" = "alt-0" ]; then
        # Mostra o que rolou por trás do fzf (log de erros/avisos da sessão)
        eazy_ensure_tmp
        EAZY_TERM_LOG="${EAZY_TERM_LOG:-$EAZY_TMP_DIR/terminal.log}"
        clear 2>/dev/null || true
        printf '\033[1;36m════════ eazy — terminal (por trás do fzf) ════════\033[0m\n'
        printf '\033[0;90mLog: %s\033[0m\n\n' "$EAZY_TERM_LOG"
        if [ -s "$EAZY_TERM_LOG" ]; then
            # últimas ~120 linhas do que aconteceu de verdade
            tail -n 120 "$EAZY_TERM_LOG" 2>/dev/null || cat "$EAZY_TERM_LOG" 2>/dev/null
        else
            printf '\033[0;90m(ainda sem mensagens nesta sessão)\033[0m\n'
            printf 'Pasta: %s\n' "$(pwd -P 2>/dev/null || pwd)"
            [ "${MODO_PLAYLIST:-0}" -eq 1 ] && printf 'Playlist: %s\n' "${ARQUIVO_PLAYLIST_ABERTO:-—}"
        fi
