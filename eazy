declare -gA EAZY_SQL_LIST_VIEW_TABLE=()
EAZY_SQL_LISTS_READY=0
EAZY_SQL_LISTS_ERROR=""
EAZY_SQL_VIEW_DIR=""

eazy_sql_list_indexer() {
    "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" "$@"
}

eazy_sql_list_view_path() {
    local table="$1" hash path
    hash=$(printf '%s' "$table" | sha256sum | awk '{print $1}') || return 1
    path="$EAZY_SQL_VIEW_DIR/list-${hash}.txt"
    EAZY_SQL_LIST_VIEW_TABLE["$path"]="$table"
    printf '%s\n' "$path"
}

eazy_sql_list_table_for_view() {
    local wanted="$1" path
    for path in "${!EAZY_SQL_LIST_VIEW_TABLE[@]}"; do
        if [ "$path" = "$wanted" ]; then
            printf '%s\n' "${EAZY_SQL_LIST_VIEW_TABLE[$path]}"
            return 0
        fi
    done
    return 1
}

eazy_sql_list_refresh_view() {
    local table="$1" view tmp
    view=$(eazy_sql_list_view_path "$table") || return 1
    tmp="${view}.tmp.$$"
    if ! eazy_sql_list_indexer "--list-export=$table" > "$tmp"; then
        rm -f -- "$tmp"
        return 1
    fi
    mv -f -- "$tmp" "$view"
}

eazy_sql_list_append_args() {
    local table="$1"; shift
    [ "$#" -gt 0 ] || { printf '0\n'; return 0; }
    printf '%s\0' "$@" | eazy_sql_list_indexer "--list-append0=$table"
}

eazy_sql_list_save_last_search() {
    local source="$1" bytes mtime kind name path extra min max
    [ "${EAZY_IGNORE:-0}" != "1" ] || return 0
    [ "${EAZY_SQL_LISTS_READY:-0}" = "1" ] || return 1
    [ -f "$source" ] || return 1
    min="${BUSCA_TAM_MIN:-0}"; max="${BUSCA_TAM_MAX:-0}"
    [[ "$min" =~ ^[0-9]+$ ]] || min=0
    [[ "$max" =~ ^[0-9]+$ ]] || max=0
    {
        while IFS=$'\t' read -r bytes mtime kind name path extra; do
            [ -n "${path:-}" ] || continue
            [ "$kind" != "d" ] || continue
            [[ "$bytes" =~ ^[0-9]+$ ]] || continue
            if (( min > 0 && bytes <= min )); then continue; fi
            if (( max > 0 && bytes >= max )); then continue; fi
            printf '%s\0' "$path"
        done < "$source"
    } | eazy_sql_list_indexer --list-last-search-replace0 >/dev/null
}

