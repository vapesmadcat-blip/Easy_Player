# Linha de navegação (.. / Voltar) — nunca filtrada, nunca selecionável nas ações
eazy_eh_navegacao() {
    local linha="$1"
    local campo2 campo_fim
    campo2=$(printf '%s\n' "$linha" | awk -F '\t' '{print $2}')
    campo_fim=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    case "$campo_fim" in
        ..|./..|.) return 0 ;;
    esac
    # Voltar / Sair (qualquer variante do rótulo)
    case "$campo2" in
        *Voltar*) return 0 ;;
    esac
    case "$campo2" in
        *Sair*) return 0 ;;
    esac
    return 1
}

eazy_sem_navegacao() {
    local linha
    while IFS= read -r linha || [ -n "$linha" ]; do
        [ -z "$linha" ] && continue
        eazy_eh_navegacao "$linha" && continue
        printf '%s\n' "$linha"
    done
}

# Seleção normal persistente entre diretórios.
# SELECTED_FILE contém arquivos absolutos; SELECTED_DIRS_FILE contém diretórios
# escolhidos diretamente e serve para distinguir Enter simples de seleção explícita.
SELECTED_DIRS_FILE="${SELECTED_FILE}.dirs"
SELECTED_LOCAL_FILE="${SELECTED_FILE}.local"
eazy_ensure_selection
export EAZY_INDEX_DB EAZY_INDEXER SELECTED_FILE SELECTED_DIRS_FILE SELECTED_LOCAL_FILE EAZY_SQL_SELECTION
eazy_sql_selection_mark_dirty() {
    [ "${EAZY_SQL_SELECTION:-0}" = 1 ] || return 0
    [ -n "${EAZY_SELECTION_VIEW_DIRTY_FILE:-}" ] || return 0
    : > "$EAZY_SELECTION_VIEW_DIRTY_FILE" 2>/dev/null || true
    [ -z "${EAZY_HEADER_CACHE_FILE:-}" ] || rm -f -- "$EAZY_HEADER_CACHE_FILE" 2>/dev/null || true
}
eazy_sql_selection_set() {
    [ "${EAZY_SQL_SELECTION:-0}" = 1 ] || return 1
    if "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-set "$1" "$2" >/dev/null; then
        eazy_sql_selection_mark_dirty
    else
        return $?
    fi
}
eazy_sql_selection_refresh() {
    [ "${EAZY_SQL_SELECTION:-0}" = 1 ] || return 0
    local path root="${1:-$(pwd -P)}"
    : > "$SELECTED_FILE"; : > "$SELECTED_LOCAL_FILE"; : > "$SELECTED_DIRS_FILE"
    while IFS= read -r -d '' path; do printf '%s\n' "$path" >> "$SELECTED_FILE"; done \
        < <("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-list0 --selection-state 2 2>/dev/null)
    eazy_sql_selection_refresh_local "$root"
}
eazy_sql_selection_refresh_local() {
    [ "${EAZY_SQL_SELECTION:-0}" = 1 ] || return 0
    local state path root="${1:-$(pwd -P)}"
    local local_tmp="${SELECTED_LOCAL_FILE}.refresh.$$" dirs_tmp="${SELECTED_DIRS_FILE}.refresh.$$"
    : > "$local_tmp"; : > "$dirs_tmp"
    while IFS= read -r -d '' state && IFS= read -r -d '' path; do
        printf '%s\n' "$path" >> "$local_tmp"
        [ -d "$path" ] && [ "$state" = 2 ] && printf '%s\n' "$path" >> "$dirs_tmp"
    done < <("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-local-view0 --selection-root "$root" 2>/dev/null)
    if ! cmp -s "$local_tmp" "$SELECTED_LOCAL_FILE" 2>/dev/null; then mv -f -- "$local_tmp" "$SELECTED_LOCAL_FILE"; else rm -f "$local_tmp"; fi
    if ! cmp -s "$dirs_tmp" "$SELECTED_DIRS_FILE" 2>/dev/null; then mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"; else rm -f "$dirs_tmp"; fi
    [ -n "${EAZY_SELECTION_VIEW_DIRTY_FILE:-}" ] && rm -f -- "$EAZY_SELECTION_VIEW_DIRTY_FILE" 2>/dev/null || true
}

# Atualiza SELECTED_FILE.bytes (soma acumulada da seleção global)
eazy_refresh_sel_bytes() {
    local p t sum=0
    eazy_ensure_selection
    [ -f "${SELECTED_FILE:-}" ] || { printf '0' > "${SELECTED_FILE}.bytes" 2>/dev/null; return 0; }
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        t=$(tamanho_caminho "$p" 2>/dev/null || echo 0)
        t=$(printf '%s' "$t" | tr -cd '0-9'); t=${t:-0}
        sum=$((sum + t))
    done < "$SELECTED_FILE"
    printf '%s' "$sum" > "${SELECTED_FILE}.bytes" 2>/dev/null || true
}


arquivo_selecao_global() {
    local linha="$1" p
    p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    [ -n "$p" ] || return 1
    eazy_eh_navegacao "$linha" && return 1
    caminho_absoluto "$p"
}

adicionar_selecao_global() {
    local p="$1"
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        eazy_sql_selection_set "$p" 2 || return 1
        grep -Fxq -- "$p" "$SELECTED_FILE" 2>/dev/null || printf '%s\n' "$p" >> "$SELECTED_FILE"
        grep -Fxq -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null || printf '%s\n' "$p" >> "$SELECTED_LOCAL_FILE"
        return 0
    fi
    eazy_ensure_selection
    [ -e "$p" ] || return 0
    if ! grep -Fxq -- "$p" "$SELECTED_FILE" 2>/dev/null; then
        printf '%s\n' "$p" >> "$SELECTED_FILE"
        local t cur=0
        t=$(tamanho_caminho "$p" 2>/dev/null || echo 0)
        t=$(printf '%s' "$t" | tr -cd '0-9'); t=${t:-0}
        [ -f "${SELECTED_FILE}.bytes" ] && cur=$(tr -cd '0-9' < "${SELECTED_FILE}.bytes" 2>/dev/null || echo 0)
        cur=${cur:-0}
        printf '%s' "$((cur + t))" > "${SELECTED_FILE}.bytes" 2>/dev/null || true
    fi
}

remover_selecao_global() {
    local p="$1" tmp
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        eazy_sql_selection_set "$p" 0 || return 1
        grep -Fxv -- "$p" "$SELECTED_FILE" > "${SELECTED_FILE}.tmp" 2>/dev/null || :
        mv -f -- "${SELECTED_FILE}.tmp" "$SELECTED_FILE"
        grep -Fxv -- "$p" "$SELECTED_LOCAL_FILE" > "${SELECTED_LOCAL_FILE}.tmp" 2>/dev/null || :
        mv -f -- "${SELECTED_LOCAL_FILE}.tmp" "$SELECTED_LOCAL_FILE"
        return 0
    fi
    eazy_ensure_selection
    tmp="${SELECTED_FILE}.tmp"
    grep -Fxv -- "$p" "$SELECTED_FILE" 2>/dev/null > "$tmp" || : > "$tmp"
    mv -f -- "$tmp" "$SELECTED_FILE"
    eazy_refresh_sel_bytes 2>/dev/null || true
}

expandir_diretorio_selecao() {
    local dir="$1" p n=0 tmp_new
    [ -d "$dir" ] || return 0
    eazy_ensure_selection
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        eazy_sql_selection_set "$dir" 2 || return 1
        find "$dir" -type f -print0 2>/dev/null | "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-set0 2 >/dev/null || return 1
        eazy_sql_selection_refresh "$(pwd -P)"
        return 0
    fi
    grep -Fxq -- "$dir" "$SELECTED_DIRS_FILE" 2>/dev/null || printf '%s\n' "$dir" >> "$SELECTED_DIRS_FILE"
    tmp_new="${SELECTED_FILE}.new_$$"
    : > "$tmp_new"
    while IFS= read -r -d '' p; do
        [ -z "$p" ] && continue
        n=$((n + 1))
        printf '%s\n' "$p" >> "$tmp_new"
        [ $((n % 30)) -eq 0 ] && eazy_sel_progress "$n" "$n" "0" "$p" "expandir"
    done < <(find "$dir" -type f -print0 2>/dev/null)
    if [ -s "$tmp_new" ]; then
        cat "$SELECTED_FILE" "$tmp_new" 2>/dev/null | awk 'NF && !seen[$0]++' > "${SELECTED_FILE}.tmp"
        mv -f -- "${SELECTED_FILE}.tmp" "$SELECTED_FILE"
    fi
    rm -f "$tmp_new"
    eazy_sel_progress "$n" "$n" "0" "$dir" "expandir"
    eazy_sel_progress_end
    eazy_refresh_sel_bytes 2>/dev/null || true
    adicionar_selecao_local "$dir" 2>/dev/null || true
}

remover_selecao_diretorio() {
    local dir="$1" tmp="${SELECTED_FILE}.tmp" dirs_tmp="${SELECTED_DIRS_FILE}.tmp"
    local n=0 kept=0 total=0 p
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-clear --selection-state 2 --selection-root "$dir" >/dev/null 2>&1 || true
        eazy_sql_selection_refresh "$(pwd -P)"
        return 0
    fi
    grep -Fxv -- "$dir" "$SELECTED_DIRS_FILE" 2>/dev/null > "$dirs_tmp" || : > "$dirs_tmp"
    mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"
    total=$(grep -cve '^[[:space:]]*$' "$SELECTED_FILE" 2>/dev/null || echo 0)
    total=$(printf '%s' "$total" | tr -cd '0-9'); total=${total:-0}
    : > "$tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        n=$((n + 1))
        if [[ "$p" == "$dir"/* ]]; then
            : # removido da seleção
        else
            printf '%s\n' "$p" >> "$tmp"
            kept=$((kept + 1))
        fi
        if [ "${EAZY_VERBOSE:-0}" = "1" ] && { [ $((n % 50)) -eq 0 ] || [ "$n" -eq "$total" ]; }; then
            eazy_sel_progress "$n" "$total" "0" "" "limpar-dir" 2>/dev/null || true
        fi
    done < "$SELECTED_FILE"
    mv -f -- "$tmp" "$SELECTED_FILE"
    eazy_sel_progress_end 2>/dev/null || true
    eazy_refresh_sel_bytes 2>/dev/null || true
}

adicionar_selecao_local() {
    local p="$1" tmp="${SELECTED_LOCAL_FILE}.tmp"
    [ -z "$p" ] && return 0
    p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    grep -Fxq -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null || printf '%s\n' "$p" >> "$SELECTED_LOCAL_FILE"
}

remover_selecao_local() {
    local p="$1" tmp="${SELECTED_LOCAL_FILE}.tmp"
    p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    grep -Fxv -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null > "$tmp" || : > "$tmp"
    mv -f -- "$tmp" "$SELECTED_LOCAL_FILE"
}

reconstruir_selecao_local() {
    # Rápido: localiza só entradas deste dir em selected_paths (cache) — sem du/stat global
    local dir p rest
    eazy_ensure_selection
    dir=$(pwd -P 2>/dev/null || pwd)
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        eazy_sql_selection_refresh_local "$dir"
        return 0
    fi
    : > "$SELECTED_LOCAL_FILE"
    [ -n "$dir" ] || return 0
    if [ -s "${SELECTED_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            case "$p" in
                "${dir}/"*)
                    rest="${p#"${dir}/"}"
                    case "$rest" in
                        */*) ;;
                        *) printf '%s\n' "$p" ;;
                    esac
                    ;;
            esac
        done < "$SELECTED_FILE" >> "$SELECTED_LOCAL_FILE"
    fi
    if [ -s "${SELECTED_DIRS_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            case "$p" in
                "${dir}/"*)
                    rest="${p#"${dir}/"}"
                    case "$rest" in
                        */*) ;;
                        *) printf '%s\n' "$p" ;;
                    esac
                    ;;
                "$dir")
                    printf '%s\n' "$p"
                    ;;
            esac
        done < "$SELECTED_DIRS_FILE" >> "$SELECTED_LOCAL_FILE"
    fi
    if [ -s "$SELECTED_LOCAL_FILE" ]; then
        sort -u "$SELECTED_LOCAL_FILE" -o "$SELECTED_LOCAL_FILE" 2>/dev/null || true
    fi
}

eazy_selection_scope_roots0() {
    local candidate canonical existing skip
    local -a raw_roots=() roots=() kept=()
    if [ "${EAZY_SQL_SELECTION:-0}" = "1" ] && [ -f "${EAZY_INDEXER:-}" ] && [ -f "${EAZY_INDEX_DB:-}" ]; then
        mapfile -d '' -t raw_roots < <("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-roots0 2>/dev/null)
    else
        while IFS= read -r candidate || [ -n "$candidate" ]; do
            [ -n "$candidate" ] && raw_roots+=("$candidate")
        done < "${SELECTED_DIRS_FILE:-/dev/null}"
    fi
    for candidate in "${raw_roots[@]}"; do
        [ -n "$candidate" ] || continue
        [[ "$candidate" == /* ]] || candidate="$(pwd -P 2>/dev/null || pwd)/$candidate"
        canonical=$(readlink -m -- "$candidate" 2>/dev/null || readlink -f -- "$candidate" 2>/dev/null || printf '%s' "$candidate")
        skip=0
        for existing in "${roots[@]}"; do
            if [ "$canonical" = "$existing" ] || [ "$existing" = "/" ] || [[ "$canonical" == "$existing/"* ]]; then
                skip=1
                break
            fi
        done
        [ "$skip" -eq 1 ] && continue
        kept=()
        for existing in "${roots[@]}"; do
            if [ "$canonical" = "/" ] || [[ "$existing" == "$canonical/"* ]]; then
                continue
            fi
            kept+=("$existing")
        done
        roots=("${kept[@]}" "$canonical")
    done
    for candidate in "${roots[@]}"; do
        printf '%s\0' "$candidate"
    done
}

eazy_selection_scope_signature() {
    if command -v sha256sum >/dev/null 2>&1; then
        eazy_selection_scope_roots0 | sha256sum | awk '{print $1}'
    else
        eazy_selection_scope_roots0 | cksum | awk '{print $1}'
    fi
}

eazy_toggle_global_item() {
    local linha="$1" p
    [ "${EAZY_SQL_SELECTION:-0}" = 1 ] || eazy_ensure_selection
    p=$(arquivo_selecao_global "$linha") || return 0
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        local result state sel_count sel_bytes global_dirs atual_count atual_bytes local_dirs
        local header_free="" header_total="" header_cache_tmp
        if [ -n "${EAZY_HEADER_CACHE_FILE:-}" ] && [ -s "$EAZY_HEADER_CACHE_FILE" ]; then
            IFS=$'\t' read -r header_free header_total _ _ _ _ < "$EAZY_HEADER_CACHE_FILE"
        fi
        if [ -d "$p" ]; then
            result=$({ find "$p" -type f -print0 2>/dev/null || true; } | \
                "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
                    --selection-toggle-directory-ui "$p" --selection-root "$(pwd -P)" 2>/dev/null) || return 1
        else
            result=$("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
                --selection-toggle-ui "$p" --selection-root "$(pwd -P)" 2>/dev/null) || return 1
        fi
        IFS=$'\t' read -r state sel_count sel_bytes global_dirs atual_count atual_bytes local_dirs <<< "$result"
        eazy_sql_selection_mark_dirty
        if [ -n "${EAZY_HEADER_CACHE_FILE:-}" ] && [ -n "$header_free" ] && [ -n "$header_total" ] && \
           [[ "$sel_count" =~ ^[0-9]+$ && "$sel_bytes" =~ ^[0-9]+$ && "$atual_count" =~ ^[0-9]+$ && "$atual_bytes" =~ ^[0-9]+$ ]]; then
            header_cache_tmp="${EAZY_HEADER_CACHE_FILE}.tmp.$$"
            if printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$header_free" "$header_total" \
                "$sel_count" "$sel_bytes" "$atual_count" "$atual_bytes" > "$header_cache_tmp"; then
                mv -f -- "$header_cache_tmp" "$EAZY_HEADER_CACHE_FILE" 2>/dev/null || rm -f -- "$header_cache_tmp"
            else
                rm -f -- "$header_cache_tmp" 2>/dev/null || true
            fi
        fi
        return 0
    fi
    if [ -d "$p" ]; then
        p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        if grep -Fxq -- "$p" "$SELECTED_DIRS_FILE" 2>/dev/null; then
            remover_selecao_diretorio "$p"
            remover_selecao_local "$p"
        else
            expandir_diretorio_selecao "$p"
            adicionar_selecao_local "$p"
        fi
    elif [ -f "$p" ]; then
        if grep -Fxq -- "$p" "$SELECTED_FILE" 2>/dev/null; then
            remover_selecao_global "$p"
            remover_selecao_local "$p"
        else
            adicionar_selecao_global "$p"
            adicionar_selecao_local "$p"
        fi
    fi
}

# Varre cada linha que o fzf devolveu como selecionada.
# Exclusivo da seleção normal: não usa nem toca em DUP_SELECTED_FILE.
eazy_commit_fzf_selected() {
    local linha p
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        if [ -d "$p" ]; then
            expandir_diretorio_selecao "$p"
        elif [ -f "$p" ]; then
            adicionar_selecao_global "$p"
        fi
    done
}

eazy_select_visible_global() {
    local linha p q="${1:-${FZF_QUERY:-}}" toggle_result
    [ -n "${EAZY_CTRL_A_RESULT_FILE:-}" ] && : > "$EAZY_CTRL_A_RESULT_FILE"
    [ -f "${LISTA_FZF_FILE:-}" ] || return 0
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        toggle_result=$({
            while IFS= read -r linha; do
                [ -n "$linha" ] || continue
                p=$(arquivo_selecao_global "$linha") || continue
                printf '%s\0' "$p"
                if [ -d "$p" ]; then find "$p" -type f -print0 2>/dev/null; fi
            done < <(eazy_lista_filtrada "$q")
        } | "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-toggle-all0) || return 1
        eazy_sql_selection_mark_dirty
        if [ -n "${EAZY_CTRL_A_RESULT_FILE:-}" ]; then
            printf '%s\n' "$toggle_result" > "$EAZY_CTRL_A_RESULT_FILE" 2>/dev/null || true
        fi
        if [ "$toggle_result" = cleared ] || [ "${MODO_BUSCA:-0}" = 1 ] || [ "${MODO_PLAYLIST:-0}" = 1 ]; then
            # Atualiza a projeção visual; selected=1 só vira global na saída/execução.
            eazy_sql_selection_refresh "$(pwd -P)"
        fi
        return 0
    fi
    # LISTA_FZF_FILE contém a lista completa; Ctrl+A deve respeitar o filtro
    # atual, portanto percorre a mesma saída filtrada exibida pelo fzf.
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        if [ -d "$p" ]; then
            expandir_diretorio_selecao "$p"
        elif [ -f "$p" ]; then
            adicionar_selecao_global "$p"
        fi
    done < <(eazy_lista_filtrada "$q")
    [ -n "${EAZY_CTRL_A_RESULT_FILE:-}" ] && printf 'selected\n' > "$EAZY_CTRL_A_RESULT_FILE"
}

eazy_ctrl_a_fzf_action() {
    local state
    state=$(cat "${EAZY_CTRL_A_RESULT_FILE:-/dev/null}" 2>/dev/null || true)
    case "$state" in
        selected) printf 'select-all' ;;
        cleared) printf 'deselect-all' ;;
        *) : ;;
    esac
}

eazy_clear_local_selection() {
    local dir="$(pwd -P)" tmp="${SELECTED_FILE}.tmp" p
    eazy_ensure_selection
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-clear --selection-state 1 --selection-root "$dir" >/dev/null 2>&1 || true
        eazy_sql_selection_mark_dirty
        return 0
    fi
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [ "$(dirname -- "$p")" = "$dir" ] || printf '%s\n' "$p"
    done < "$SELECTED_FILE" > "$tmp"
    mv -f -- "$tmp" "$SELECTED_FILE"
    local dirs_tmp="${SELECTED_DIRS_FILE}.tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [[ "$p" == "$dir" || "$p" == "$dir"/* ]] || printf '%s\n' "$p"
    done < "$SELECTED_DIRS_FILE" > "$dirs_tmp"
    mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"
    : > "$SELECTED_LOCAL_FILE"
    eazy_refresh_sel_bytes 2>/dev/null || true
}

# Reconstrói a seleção do diretório atual a partir do conjunto devolvido pelo fzf.
# Preserva seleções de outras pastas e não acessa o estado de duplicados.
eazy_remark_local_selection() {
    local linha p p_abs dir
    dir=$(pwd -P)
    eazy_clear_local_selection
    : > "$SELECTED_LOCAL_FILE"
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        if [ -d "$p_abs" ]; then
            [ "$(dirname -- "$p_abs")" = "$dir" ] || continue
            expandir_diretorio_selecao "$p_abs"
            adicionar_selecao_local "$p_abs"
        elif [ -f "$p_abs" ]; then
            [ "$(dirname -- "$p_abs")" = "$dir" ] || continue
            adicionar_selecao_global "$p_abs"
            adicionar_selecao_local "$p_abs"
        fi
    done
}

# Monta lista de reprodução para Alt+Enter:
# usa a multi-seleção do fzf + seleção persistente do SQLite,
# porque reload (Ctrl-A/X etc.) apaga as marcas do fzf mas mantém a persistência.
eazy_playlist_alt_enter() {
    local dest="$1" linha p p_abs
    : > "$dest"
    [ -n "$dest" ] || return 1
    # 1) itens devolvidos pelo fzf (multi-select da sessão)
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
        [ -z "$p" ] && continue
        eazy_eh_navegacao "$linha" 2>/dev/null && continue
        [[ "$p" =~ \.\.$ ]] && continue
        p_abs=$(caminho_absoluto "$p" 2>/dev/null || printf '%s' "$p")
        p_abs=$(readlink -f -- "$p_abs" 2>/dev/null || printf '%s' "$p_abs")
        [ -f "$p_abs" ] || continue
        grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
    done
    # 2) seleção persistente global (SQLite é a fonte da verdade)
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        while IFS= read -r -d '' p; do
            p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
            [ -f "$p_abs" ] || continue
            grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
        done < <("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-list0 --selection-state 2 2>/dev/null)
    elif [ -f "${SELECTED_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
            [ -f "$p_abs" ] || continue
            grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
        done < "$SELECTED_FILE"
    fi
}

# Expande a seleção com a persistência (mesma regra do Alt+Enter).
# INSERT, Del, Ctrl-K/Y/U/E usam isto — não altera Duplicados.
eazy_expandir_escolha_acoes() {
    local entrada="$1" tmp
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-sel-acoes.XXXXXX") || {
        printf '%s\n' "$entrada"
        return 1
    }
    printf '%s\n' "$entrada" | eazy_playlist_alt_enter "$tmp"
    if [ -s "$tmp" ]; then
        cat "$tmp"
    else
