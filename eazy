chave_cache_busca() {
    # chave estável: pasta + extensões + tamanho + conteúdo
    local base
    base="$(pwd)|${EXT_BUSCA:-}|${BUSCA_TAM_MIN:-}|${BUSCA_TAM_MAX:-}|${BUSCA_CONTEUDO:-}"
    if command -v md5sum &>/dev/null; then
        printf '%s' "$base" | md5sum | awk '{print $1}'
    elif command -v sha256sum &>/dev/null; then
        printf '%s' "$base" | sha256sum | awk '{print $1}'
    else
        # fallback simples
        printf '%s' "$base" | cksum | awk '{print $1}'
    fi
}

# Restaura sessão anterior (cwd, filtro, preview, cursor)
# Prioridade: argumento de caminho > sessão > DIR_PADRAO
# Uso: eazy /mnt/videos   |   eazy ~/Downloads   |   eazy ./pasta   |   eazy filme.mp4
ARG_CAMINHO=""
ARG_ERRO=""
if [ -n "${1:-}" ] && [[ "$1" != --* ]]; then
    _arg="$1"
    # Expande ~ no início
    case "$_arg" in
        "~/"*) _arg="$HOME/${_arg#~/}" ;;
        "~")   _arg="$HOME" ;;
    esac
    # Resolve relativo → absoluto quando existir
    if [ -d "$_arg" ]; then
        ARG_CAMINHO=$(cd -- "$_arg" 2>/dev/null && pwd -P || readlink -f -- "$_arg" 2>/dev/null || echo "$_arg")
    elif [ -f "$_arg" ]; then
        ARG_CAMINHO=$(readlink -f -- "$_arg" 2>/dev/null || echo "$_arg")
        # se readlink falhar, monta abs a partir do dir
        if [ ! -e "$ARG_CAMINHO" ]; then
            _dir=$(cd -- "$(dirname -- "$_arg")" 2>/dev/null && pwd -P)
            ARG_CAMINHO="${_dir}/$(basename -- "$_arg")"
        fi
    elif [ -e "$_arg" ]; then
        ARG_CAMINHO=$(readlink -f -- "$_arg" 2>/dev/null || echo "$_arg")
    else
        ARG_ERRO="$_arg"
    fi
fi

if [ -n "$ARG_CAMINHO" ]; then
    # Caminho na linha de comando tem prioridade sobre a sessão
    if [ -d "$ARG_CAMINHO" ]; then
        cd -- "$ARG_CAMINHO" || {
            echo -e "\033[1;31meazy: não foi possível entrar em:\033[0m $ARG_CAMINHO" >&2
            ARG_CAMINHO=""
        }
        ULTIMO_ARQUIVO=""
    elif [ -f "$ARG_CAMINHO" ]; then
        cd -- "$(dirname -- "$ARG_CAMINHO")" || true
        ULTIMO_ARQUIVO=$(basename -- "$ARG_CAMINHO")
    fi
    # Preferências da sessão (filtro/preview), sem sobrescrever o cwd
    if [ -n "$ARG_CAMINHO" ] && [ -f "$SESSION_FILE" ]; then
        # shellcheck disable=SC1090
        source "$SESSION_FILE" 2>/dev/null || true
        PREVIEW_ATIVO="${PREVIEW_ATIVO:-0}"
        MODO_ATUAL="${MODO_ATUAL:-tamanho}"
        FILTRO_ATUAL="${FILTRO_ATUAL:-ambos}"
        TELA_ATUAL="${TELA_ATUAL:-$TELA_PADRAO}"
    fi
elif [ -n "$ARG_ERRO" ]; then
    echo -e "\033[1;31meazy: caminho não encontrado:\033[0m $ARG_ERRO" >&2
    echo -e "\033[0;90mAbrindo sessão/pasta padrão…\033[0m" >&2
    if ! carregar_sessao; then
        [ -d "$DIR_PADRAO" ] && cd -- "$DIR_PADRAO" || true
    fi
elif ! carregar_sessao; then
    if [ -d "$DIR_PADRAO" ]; then
        cd -- "$DIR_PADRAO" || true
    fi
fi

