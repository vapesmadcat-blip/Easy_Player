# --- Streams (Ctrl+B → 7) ---
# Formato: url|quality|title|ts
eazy_stream_queue_add() {
    local url="${1:-}" quality="${2:-}" title="${3:-}" ts
    [ -n "$url" ] || return 1
    mkdir -p "${CONFIG_DIR:-$HOME/.config/eazy}" 2>/dev/null || true
    touch "${STREAM_QUEUE:-$CONFIG_DIR/stream_queue}"
    ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "?")
    if [ -s "$STREAM_QUEUE" ]; then
        awk -F'|' -v u="$url" '$1 != u { print }' "$STREAM_QUEUE" > "${STREAM_QUEUE}.tmp" 2>/dev/null \
            && mv -f "${STREAM_QUEUE}.tmp" "$STREAM_QUEUE" || true
    fi
    title=$(printf '%s' "${title:-$url}" | tr '|' '/' | tr '\n' ' ' | cut -c1-120)
    printf '%s|%s|%s|%s\n' "$url" "${quality:-}" "$title" "$ts" >> "$STREAM_QUEUE"
}

eazy_stream_play_url() {
    local url="${1:-}" quality="${2:-}" audio_only=0
    [ -n "$url" ] || return 1
    [ "$quality" = "audio" ] && audio_only=1
    eazy_stream_queue_add "$url" "$quality" "" 2>/dev/null || true
    clear 2>/dev/null || true
    eazy_yt_stream "$url" "$audio_only" "$quality"
    eazy_pausa_terminal 2>/dev/null || true
}

eazy_stream_escolher_item() {
    local prompt="${1:-Streams ❯ }" tmp escolhido num
    mkdir -p "${CONFIG_DIR:-$HOME/.config/eazy}" 2>/dev/null || true
    touch "${STREAM_QUEUE:-$CONFIG_DIR/stream_queue}"
    if [ ! -s "$STREAM_QUEUE" ]; then
        whiptail --title "Streams" --msgbox "Fila de streams vazia.\nUse Adicionar ou Incluir+PLAY." 9 55
        return 1
    fi
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-stream.XXXXXX") || return 1
    awk -F'|' '{
        n=NR; url=$1; q=$2; title=$3; ts=$4
        if (title=="") title=url
        printf "%3d  [%s] %s\n     %s  (%s)\n", n, (q==""?"auto":q), title, url, ts
    }' "$STREAM_QUEUE" > "$tmp"
    escolhido=$(fzf --prompt="$prompt" --header="ENTER confirma · ESC cancela" --ansi < "$tmp") || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    [ -z "$escolhido" ] && return 1
    num=$(printf '%s' "$escolhido" | head -n1 | awk '{print $1}' | tr -cd '0-9')
    [ -n "$num" ] || return 1
    sed -n "${num}p" "$STREAM_QUEUE"
}

eazy_stream_add_dialog() {
    local link quality title play_now="${1:-0}" ytdlp
    link=$(whiptail --title "Stream — adicionar" --inputbox "URL:" 10 72 "https://" 3>&1 1>&2 2>&3) || return 1
    [ -n "$link" ] || return 1
    [[ "$link" == "https://" ]] && return 1
    quality=$(whiptail --title "Resolução" --radiolist "Qualidade:" 14 55 5 \
        "auto" "Padrão do eazy" ON \
        "480" "480p" OFF \
        "720" "720p" OFF \
        "1080" "1080p" OFF \
        "audio" "Só áudio" OFF \
        3>&1 1>&2 2>&3) || return 1
    [ "$quality" = "auto" ] && quality=""
    title=""
    if type encontrar_ytdlp >/dev/null 2>&1; then
        ytdlp=$(encontrar_ytdlp 2>/dev/null || true)
        [ -n "$ytdlp" ] && title=$("$ytdlp" --get-title --no-playlist "$link" 2>/dev/null | head -n1 || true)
    fi
    eazy_stream_queue_add "$link" "$quality" "${title:-$link}"
    if [ "$play_now" = "1" ]; then
        eazy_stream_play_url "$link" "$quality"
    else
        whiptail --title "Streams" --msgbox "Adicionado:\n\n${title:-$link}" 10 70
    fi
}

eazy_stream_edit_item() {
    local line num url quality title novo_url novo_q
    line=$(eazy_stream_escolher_item "Editar stream ❯ ") || return 0
    num=$(awk -F'|' -v u="$(printf '%s' "$line" | cut -d'|' -f1)" '$1==u {print NR; exit}' "$STREAM_QUEUE")
    url=$(printf '%s' "$line" | cut -d'|' -f1)
    quality=$(printf '%s' "$line" | cut -d'|' -f2)
    title=$(printf '%s' "$line" | cut -d'|' -f3)
    novo_url=$(whiptail --title "Editar URL" --inputbox "URL:" 10 72 "$url" 3>&1 1>&2 2>&3) || return 0
    [ -z "$novo_url" ] && return 0
    novo_q=$(whiptail --title "Resolução" --radiolist "Qualidade:" 14 55 5 \
        "auto" "Padrão" $( [ -z "$quality" ] && echo ON || echo OFF ) \
        "480" "480p" $( [ "$quality" = 480 ] && echo ON || echo OFF ) \
        "720" "720p" $( [ "$quality" = 720 ] && echo ON || echo OFF ) \
        "1080" "1080p" $( [ "$quality" = 1080 ] && echo ON || echo OFF ) \
        "audio" "Só áudio" $( [ "$quality" = audio ] && echo ON || echo OFF ) \
        3>&1 1>&2 2>&3) || return 0
    [ "$novo_q" = "auto" ] && novo_q=""
    awk -F'|' -v n="$num" -v u="$novo_url" -v q="$novo_q" -v t="$title" 'BEGIN{OFS="|"}
        NR==n { print u,q,t,$4; next }
        { print }
    ' "$STREAM_QUEUE" > "${STREAM_QUEUE}.tmp" && mv -f "${STREAM_QUEUE}.tmp" "$STREAM_QUEUE"
    whiptail --title "Streams" --msgbox "Item #$num atualizado." 8 40
}

eazy_stream_delete_item() {
    local line url
    line=$(eazy_stream_escolher_item "Apagar stream ❯ ") || return 0
    url=$(printf '%s' "$line" | cut -d'|' -f1)
    if ! whiptail --title "Apagar stream" --yesno "Remover?\n\n$url" 11 70; then
        return 0
    fi
    awk -F'|' -v u="$url" '$1 != u { print }' "$STREAM_QUEUE" > "${STREAM_QUEUE}.tmp" && mv -f "${STREAM_QUEUE}.tmp" "$STREAM_QUEUE"
    whiptail --title "Streams" --msgbox "Removido." 7 30
}


