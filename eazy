eazy_editar_fila_downloads() {
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    touch "$DOWNLOAD_QUEUE"
    if [ ! -s "$DOWNLOAD_QUEUE" ]; then
        whiptail --title "Downloads" --msgbox "Fila de downloads vazia.\nUse Ctrl+B → Adicionar link." 9 55
        return 0
    fi
    local tmp escolhido linha engine url rest novo novo_engine tor_item
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-dl-edit.XXXXXX") || return 1
    # mostra linhas numeradas
    nl -ba "$DOWNLOAD_QUEUE" > "$tmp"
    escolhido=$(fzf --prompt="Editar download ❯ " --header="ENTER editar · ESC cancelar" < "$tmp") || { rm -f "$tmp"; return 0; }
    rm -f "$tmp"
    [ -z "$escolhido" ] && return 0
    # extrai número da linha
    local num
    num=$(printf "%s" "$escolhido" | awk "{print \$1}")
    linha=$(sed -n "${num}p" "$DOWNLOAD_QUEUE")
    [ -z "$linha" ] && return 0
    engine=$(printf "%s" "$linha" | cut -d"|" -f1)
    url=$(printf "%s" "$linha" | cut -d"|" -f2)
    rest=$(printf "%s" "$linha" | cut -d"|" -f3-)
    tor_item=$(printf "%s" "$linha" | cut -d"|" -f4)
    [ "$tor_item" != "1" ] && tor_item="0"
    novo_engine=$(whiptail --title "Editar downloader #$num" --radiolist "Escolha o aplicativo para este item:" 13 65 4 \
        "aria" "aria2c" $( [ "$engine" = aria ] && echo ON || echo OFF ) \
        "axel" "Axel" $( [ "$engine" = axel ] && echo ON || echo OFF ) \
        "wget" "Wget" $( [ "$engine" = wget ] && echo ON || echo OFF ) \
        "ytdlp" "yt-dlp" $( [ "$engine" = ytdlp ] && echo ON || echo OFF ) \
        3>&1 1>&2 2>&3) || return 0
    [ -z "$novo_engine" ] && novo_engine="$engine"
    novo=$(whiptail --title "Editar link download #$num" --inputbox "URL / link:\nMotor: $novo_engine" 12 78 "$url" 3>&1 1>&2 2>&3) || return 0
    [ -z "$novo" ] && return 0
    # reescreve linha
    local out="${DOWNLOAD_QUEUE}.tmp"
    awk -v n="$num" -v eng="$novo_engine" -v u="$novo" -v r="$rest" -v tor="$tor_item" -F"|" "
        NR==n { print eng \"|\" u \"|\" r \"|\" tor; next }
        { print }
    " "$DOWNLOAD_QUEUE" > "$out" && mv -f "$out" "$DOWNLOAD_QUEUE"
    whiptail --title "Downloads" --msgbox "Link #$num atualizado.\n$novo" 10 70
}

eazy_gerenciar_torrents() {
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    touch "$TORRENT_QUEUE" "$DOWNLOAD_QUEUE"
    local acao
    acao=$(whiptail --title "Torrents · Ctrl+B" --menu "Escolha a ação:" 16 72 5 \
        "1" "Ver torrents cadastrados" \
        "2" "Incluir torrent (magnet/.torrent)" \
        "3" "Deletar torrent cadastrado" \
        "4" "Voltar" \
        3>&1 1>&2 2>&3) || return 0
    case "$acao" in
        1)
            local texto="" n=0 linha engine link pass tor
            while IFS='|' read -r engine link pass tor; do
                [ "$engine" = "torrent" ] || continue
                [ -n "$link" ] || continue
                n=$((n + 1))
                texto+=$(printf '%d. %s%s\n' "$n" "$link" "$( [ "$tor" = 1 ] && printf '  [TOR]' )")
            done < "$DOWNLOAD_QUEUE"
            if [ "$n" -eq 0 ]; then
                whiptail --title "Torrents" --msgbox "Nenhum torrent cadastrado.\n\nUse Ctrl+B → Torrents → Incluir." 9 62
            else
                whiptail --title "Torrents cadastrados ($n)" --scrolltext --textbox <(printf '%s' "$texto") 20 90
            fi
            ;;
        2)
            local alvo tor_opt destino
            alvo=$(whiptail --title "Incluir torrent" --inputbox "Cole um magnet ou informe o caminho de um arquivo .torrent:" 10 82 "magnet:?xt=urn:btih:" 3>&1 1>&2 2>&3) || return 0
            [ -n "$alvo" ] || return 0
            if [[ "$alvo" != magnet:* && ! -f "$alvo" && "$alvo" != *.torrent ]]; then
                whiptail --title "Torrent" --msgbox "Informe um magnet válido ou um arquivo .torrent existente." 9 70
                return 1
            fi
            destino=$(whiptail --title "Destino do torrent" --inputbox "Diretório de destino:" 10 75 "${TORRENT_DIR:-${DOWNLOAD_DIR:-$HOME/Downloads}/Torrents}" 3>&1 1>&2 2>&3) || return 0
            [ -n "$destino" ] || destino="${TORRENT_DIR:-${DOWNLOAD_DIR:-$HOME/Downloads}/Torrents}"
            tor_opt=0
            if whiptail --title "Rede" --yesno "Usar Tor neste torrent?\n\nO serviço Tor/torsocks precisa estar ativo." 10 65; then tor_opt=1; fi
            printf 'torrent|%s||%s\n' "$alvo" "$tor_opt" >> "$DOWNLOAD_QUEUE"
            printf 'torrent|%s||%s|%s\n' "$alvo" "$tor_opt" "$destino" >> "$TORRENT_QUEUE"
            whiptail --title "Torrent" --msgbox "Torrent incluído na fila.\n\nSerá baixado pela opção Ver fila de downloads." 10 65
            ;;
        3)
            local opcoes=() idx=0 escolha remove_line
            while IFS= read -r linha; do
                [[ "$linha" == torrent\|* ]] || continue
                idx=$((idx + 1))
                link=$(printf '%s' "$linha" | cut -d'|' -f2)
                opcoes+=("$idx" "$link")
            done < "$DOWNLOAD_QUEUE"
            [ "$idx" -gt 0 ] || { whiptail --title "Torrents" --msgbox "Nenhum torrent cadastrado." 8 50; return 0; }
            escolha=$(whiptail --title "Deletar torrent" --menu "Selecione o torrent a remover:" 18 90 8 "${opcoes[@]}" 3>&1 1>&2 2>&3) || return 0
            [ -n "$escolha" ] || return 0
            remove_line=$(awk -F'|' -v wanted="$escolha" '$1 == "torrent" { n++; if (n == wanted) print; }' "$DOWNLOAD_QUEUE")
            [ -n "$remove_line" ] || return 1
            if whiptail --title "Confirmar exclusão" --yesno "Deletar este torrent da fila?\n\n$(printf '%s' "$remove_line" | cut -d'|' -f2)\n\nO arquivo .torrent no disco não será apagado." 12 78; then
                awk -F'|' -v wanted="$escolha" 'BEGIN { OFS="|" } $1 == "torrent" { n++; if (n == wanted) next } { print }' "$DOWNLOAD_QUEUE" > "$DOWNLOAD_QUEUE.tmp" && mv -f "$DOWNLOAD_QUEUE.tmp" "$DOWNLOAD_QUEUE"
                grep -Fv -- "|$(printf '%s' "$remove_line" | cut -d'|' -f2)|" "$TORRENT_QUEUE" > "$TORRENT_QUEUE.tmp" 2>/dev/null || :
                mv -f "$TORRENT_QUEUE.tmp" "$TORRENT_QUEUE"
                whiptail --title "Torrents" --msgbox "Torrent removido da fila." 8 50
            fi
            ;;
    esac
}

