    exit 0

elif [ "$1" = "--uninstall" ]; then
    echo -e "\033[1;36m=== ${EAZY_NAME} — desinstalação ===\033[0m"
    REMOVIDO=0
    if [ -f /usr/local/bin/eazy ]; then
        sudo rm -f /usr/local/bin/eazy && echo -e "\033[1;32m✓\033[0m /usr/local/bin/eazy" && REMOVIDO=1
    fi
    if [ -f /usr/bin/eazy ]; then
        sudo rm -f /usr/bin/eazy && echo -e "\033[1;32m✓\033[0m /usr/bin/eazy" && REMOVIDO=1
    fi
    if [ -f /usr/lib/eazy/eazy ]; then
        sudo rm -f /usr/lib/eazy/eazy && echo -e "\033[1;32m✓\033[0m /usr/lib/eazy/eazy" && REMOVIDO=1
    fi
    if [ -f /usr/lib/eazy/eazy-ai.py ]; then
        sudo rm -f /usr/lib/eazy/eazy-ai.py && echo -e "\033[1;32m✓\033[0m /usr/lib/eazy/eazy-ai.py" && REMOVIDO=1
    fi
    INSTALL_USER="${SUDO_USER:-${USER:-$(id -un)}}"
    INSTALL_HOME="$(getent passwd "$INSTALL_USER" 2>/dev/null | cut -d: -f6)"
    [ -n "$INSTALL_HOME" ] || INSTALL_HOME="$HOME"
    if [ -f "$INSTALL_HOME/.local/bin/eazy" ] || [ -L "$INSTALL_HOME/.local/bin/eazy" ]; then
        rm -f "$INSTALL_HOME/.local/bin/eazy" && echo -e "\033[1;32m✓\033[0m $INSTALL_HOME/.local/bin/eazy" && REMOVIDO=1
    fi
    DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    [ -f "$DESKTOP_DIR/eazy.desktop" ] && rm -f "$DESKTOP_DIR/eazy.desktop" && echo -e "\033[1;32m✓\033[0m launcher local"
    [ -f /usr/share/applications/eazy.desktop ] && sudo rm -f /usr/share/applications/eazy.desktop && echo -e "\033[1;32m✓\033[0m launcher sistema"
    if [ -f /usr/share/man/man1/eazy.1 ] || [ -f /usr/share/man/man1/eazy.1.gz ]; then
        sudo rm -f /usr/share/man/man1/eazy.1 /usr/share/man/man1/eazy.1.gz
        echo -e "\033[1;32m✓\033[0m man page (/usr/share/man/man1/eazy.1.gz)"
        command -v mandb &>/dev/null && sudo mandb -q 2>/dev/null || true
    fi
    # Pacote .deb / rpm instalado
    if command -v dpkg &>/dev/null && dpkg -l eazy &>/dev/null; then
        echo -e "Pacote deb detectado: \033[1;33msudo apt remove eazy\033[0m"
    fi
    if command -v pacman &>/dev/null && pacman -Q eazy &>/dev/null; then
        echo -e "Pacote arch detectado: \033[1;33msudo pacman -R eazy\033[0m"
    fi
    if command -v rpm &>/dev/null && rpm -q eazy &>/dev/null; then
        echo -e "Pacote rpm detectado: \033[1;33msudo dnf remove eazy\033[0m"
    fi
    echo -e "\033[0;90mConfig em ~/.config/eazy/ preservada (remova manualmente se quiser).\033[0m"
    [ "$REMOVIDO" -eq 0 ] && echo -e "Nada encontrado em /usr/local/bin ou /usr/bin."
