eazy_criar_arquivo() {
    local tipo nome caminho editor_ok=0
    tipo=$(whiptail --title "Criar no diretório atual" --menu \
"Pasta: $(pwd -P)

O que criar?" 14 64 4 \
        "txt"  "Arquivo de texto (.txt)" \
        "vazio" "Arquivo vazio (qualquer nome)" \
        "dir"  "Pasta / diretório" \
        "0"    "Cancelar" \
        3>&1 1>&2 2>&3) || return 0
    [ -z "$tipo" ] || [ "$tipo" = "0" ] && return 0

    case "$tipo" in
        txt)
            nome=$(whiptail --title "Novo arquivo .txt" --inputbox \
"Nome do arquivo (sem caminho):\nEx: nota, ideias, lista.txt" \
                11 60 "nota.txt" 3>&1 1>&2 2>&3) || return 0
            nome=$(printf '%s' "$nome" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            [ -z "$nome" ] && return 0
            # impede path traversal
            nome=$(basename -- "$nome")
            case "$nome" in
                *.txt|*.md|*.text) ;;
                *) nome="${nome}.txt" ;;
            esac
            ;;
        vazio)
            nome=$(whiptail --title "Novo arquivo" --inputbox \
"Nome do arquivo (com extensão se quiser):\nEx: script.sh, dados.csv" \
                11 60 "novo.txt" 3>&1 1>&2 2>&3) || return 0
            nome=$(printf '%s' "$nome" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            [ -z "$nome" ] && return 0
            nome=$(basename -- "$nome")
            ;;
        dir)
            nome=$(whiptail --title "Nova pasta" --inputbox \
"Nome da pasta:" 10 60 "nova_pasta" 3>&1 1>&2 2>&3) || return 0
            nome=$(printf '%s' "$nome" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            [ -z "$nome" ] && return 0
            nome=$(basename -- "$nome")
            ;;
        *) return 0 ;;
    esac

    caminho="$(pwd -P)/$nome"
    if [ -e "$caminho" ]; then
        if ! whiptail --title "Já existe" --yesno \
"Já existe:\n$caminho\n\nAbrir / usar mesmo assim?" 11 60; then
            return 0
        fi
    fi

    case "$tipo" in
        dir)
            if mkdir -p -- "$caminho" 2>/dev/null; then
                ULTIMO_ARQUIVO="$nome"
                eazy_lista_cache_invalidate 2>/dev/null || true
                whiptail --title "Pasta criada" --msgbox "Criada:\n$caminho" 9 60
            else
                whiptail --title "Erro" --msgbox "Não foi possível criar a pasta:\n$caminho" 9 60
            fi
            ;;
        *)
            if : > "$caminho" 2>/dev/null; then
                ULTIMO_ARQUIVO="$nome"
                eazy_lista_cache_invalidate 2>/dev/null || true
                if [ "$tipo" = "txt" ] || [[ "$nome" == *.txt || "$nome" == *.md ]]; then
                    if whiptail --title "Arquivo criado" --yesno \
"Criado:\n$caminho\n\nEditar agora?" 11 60; then
                        if [ -x "${EAZY_NOTES_EDITOR:-}" ]; then
                            "$EAZY_NOTES_EDITOR" "$caminho" || true
                        elif command -v nano >/dev/null 2>&1; then
                            nano -- "$caminho"
                        elif command -v vi >/dev/null 2>&1; then
                            vi -- "$caminho"
                        else
                            whiptail --title "Editor" --msgbox "Nenhum editor disponível." 8 45
                        fi
                    fi
                else
                    whiptail --title "Arquivo criado" --msgbox "Criado:\n$caminho" 9 60
                fi
            else
                whiptail --title "Erro" --msgbox "Não foi possível criar:\n$caminho" 9 60
            fi
            ;;
    esac
    return 0
}

menu_acoes_selecao() {
    local selecao="${1:-}" cursor="${2:-}"
