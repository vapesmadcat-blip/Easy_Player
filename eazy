}

# --- Exportar lista atual (tela / pesquisa / filtro) para HTML ---
# Se houver seleção (global ou duplicados), exporta só ela; senão, o conteúdo da tela.
eazy_html_escape() {
    printf '%s' "${1:-}" | sed 's/&/\&amp;/g;s/</\&lt;/g;s/>/\&gt;/g;s/"/\&quot;/g'
}

eazy_html_file_url() {
    # URL para browser Windows/WSL. Nunca file:///mnt/wsl/... cru.
    local caminho="$1" u p abs win distro drive rest
    [ -z "$caminho" ] && return 1

    if type eazy_caminho_para_url_local >/dev/null 2>&1; then
        u=$(eazy_caminho_para_url_local "$caminho" 2>/dev/null || true)
        case "$u" in
            file:///mnt/*|file://mnt/*|file:///home/*|file:///usr/*) u="" ;;
        esac
        if [ -n "$u" ]; then
            printf '%s' "$u"
            return 0
        fi
    fi

    p="$caminho"
    if [[ "$p" != /* ]]; then
        p="$(pwd -P)/${p#./}"
    fi
    abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    p="$abs"
    win=""

    if command -v wslpath >/dev/null 2>&1; then
        win=$(wslpath -w -- "$p" 2>/dev/null || true)
        case "$win" in
            /mnt/*|/home/*|/usr/*) win="" ;;
        esac
    fi

    if [ -z "$win" ]; then
        case "$p" in
            /mnt/[a-zA-Z]/*)
                drive=$(printf '%s' "${p:5:1}" | tr '[:lower:]' '[:upper:]')
                rest="${p:7}"
                rest="${rest#/}"
                # C:\path\...
                win=$(printf '%s:\\%s' "$drive" "${rest//\//\\}")
                ;;
            *)
                distro="${WSL_DISTRO_NAME:-Ubuntu}"
                # \\wsl.localhost\Ubuntu\path
                win=$(printf '\\\\wsl.localhost\\%s%s' "$distro" "${p//\//\\}")
                ;;
        esac
    fi

    # barras normais no URL
    win=${win//\\//}
    win=${win// /%20}
    win=${win//#/%23}
    win=${win//\?/%3F}

    case "$win" in
        //*|wsl.localhost/*|wsl\$/*)
            win=${win#/}
            win=${win#/}
            printf 'file://%s' "$win"
            ;;
        *)
            printf 'file:///%s' "$win"
            ;;
    esac
}

eazy_html_folder_url() {
    # URI do diretório que contém o arquivo; diretórios apontam para si próprios.
    # Reutiliza a conversão file:// compatível com WSL/Windows.
    local item="$1" folder url
    [ -n "$item" ] || return 1
    if [ -d "$item" ]; then folder="$item"; else folder=$(dirname -- "$item"); fi
    url=$(eazy_html_file_url "$folder") || return 1
    case "$url" in */) ;; *) url="$url/" ;; esac
    printf '%s' "$url"
}

eazy_html_folder_link() {
    # $1 caminho de arquivo/pasta; $2=1 interrompe o clique do cartão de imagem.
    local url stop="${2:-0}"
    url=$(eazy_html_escape "$(eazy_html_folder_url "$1")") || return 1
    if [ "$stop" = 1 ]; then
        printf '<a class="btn folder-link" href="%s" target="_blank" rel="noopener" onclick="event.stopPropagation()">Ir para a pasta</a>' "$url"
    else
        printf '<a class="btn folder-link" href="%s" target="_blank" rel="noopener">Ir para a pasta</a>' "$url"
    fi
}

eazy_html_ext_badge() {
