        "anterior"  "Pasta de onde o eazy foi iniciado" $( [ "$atual" = "anterior" ] && echo ON || echo OFF ) \
        3>&1 1>&2 2>&3) || return 0
    [ -z "$escolha" ] && return 0
    EXIT_DIR_MODE="$escolha"
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    if [ -f "$CONFIG_FILE" ]; then
        if grep -q '^EXIT_DIR_MODE=' "$CONFIG_FILE" 2>/dev/null; then
