eazy_aplicar_dir_saida() {
    local modo="${EXIT_DIR_MODE:-navegador}" alvo
    case "$modo" in
        anterior|start|inicio)
            alvo="${EAZY_START_DIR:-$PWD}"
            ;;
        *)
            # navegador (padrão): pasta atual do eazy
            alvo="$(pwd -P 2>/dev/null || pwd)"
            ;;
    esac
    [ -d "$alvo" ] || alvo="${EAZY_START_DIR:-$HOME}"
    mkdir -p "${CONFIG_DIR:-$HOME/.config/eazy}" 2>/dev/null || true
    printf '%s\n' "$alvo" > "${EAZY_EXIT_CD_FILE:-$HOME/.config/eazy/exit_cd}"
    # Cópia auxiliar em ~/.config/eazy/tmp (wrappers)
    printf '%s\n' "$alvo" > "$EAZY_TMP_DIR/eazy_exit_cd_${USER:-user}" 2>/dev/null || true
    echo -e "Diretório ao sair (\033[1;33m${modo}\033[0m): \033[1;32m$alvo\033[0m"
    echo -e "\033[0;90mPara o terminal ir para lá, use a função shell (eazy --shell-init) ou:\033[0m"
    echo -e "  \033[1;37mcd \"\$(cat ${EAZY_EXIT_CD_FILE:-~/.config/eazy/exit_cd})\"\033[0m"
}

configurar_dir_saida() {
