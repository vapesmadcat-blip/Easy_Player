}

eazy_prune_selecao_global() {
    local tmp p
    [ -f "${SELECTED_FILE:-}" ] || return 0
    tmp="${SELECTED_FILE}.prune.tmp"
    : > "$tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [ -e "$p" ] || continue
        printf '%s\n' "$p" >> "$tmp"
    done < "$SELECTED_FILE"
    mv -f -- "$tmp" "$SELECTED_FILE"
    if [ -f "${SELECTED_DIRS_FILE:-}" ]; then
        tmp="${SELECTED_DIRS_FILE}.prune.tmp"
        : > "$tmp"
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            [ -d "$p" ] || continue
            printf '%s\n' "$p" >> "$tmp"
        done < "$SELECTED_DIRS_FILE"
        mv -f -- "$tmp" "$SELECTED_DIRS_FILE"
    fi
}

eazy_prune_lista_arquivo() {
    local lista="$1" tmp linha res
    [ -n "$lista" ] && [ -f "$lista" ] || return 0
    tmp="${lista}.prune.tmp"
    : > "$tmp"
    while IFS= read -r linha || [ -n "$linha" ]; do
        linha="${linha%$'\r'}"
        if [ -z "$linha" ] || [[ "$linha" =~ ^# ]]; then
            printf '%s\n' "$linha" >> "$tmp"
            continue
        fi
        res="$linha"
        if [[ "$linha" != /* ]] && [[ ! "$linha" =~ ^https?:// ]]; then
            res="$(dirname -- "$lista")/$linha"
        fi
        if [[ "$linha" =~ ^https?:// ]]; then
            printf '%s\n' "$linha" >> "$tmp"
            continue
        fi
        if [ -e "$linha" ] || [ -e "$res" ]; then
            printf '%s\n' "$linha" >> "$tmp"
        fi
    done < "$lista"
    mv -f -- "$tmp" "$lista"
}



# --- Executar programa (campo + checkbox root) ---
eazy_executar_programa() {
    local cmd opts as_root=0 last_file last="" rc=0
    eazy_ensure_tmp
    last_file="${CONFIG_DIR}/last_exec_cmd"
    [ -s "$last_file" ] && last=$(head -n1 "$last_file" 2>/dev/null | tr -d '\r')

    cmd=$(whiptail --title "Executar programa" --inputbox \
"Digite o nome do programa ou o comando completo.

Exemplos:
  htop
  ls -la
  systemctl status ssh

Diretorio atual: $(pwd -P)" \
        15 72 "$last" 3>&1 1>&2 2>&3) || return 0

    cmd=$(printf '%s' "$cmd" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$cmd" ] && return 0

    opts=$(whiptail --title "Executar programa" --checklist \
"Como executar?

Comando:
  $cmd

Espaco marca, Enter confirma" 14 70 2 \
        "root" "Executar como root (sudo)" OFF \
        "term" "Mostrar saida e pausar no fim" ON \
        3>&1 1>&2 2>&3) || return 0

    case "$opts" in *root*) as_root=1 ;; esac

    printf '%s\n' "$cmd" > "$last_file" 2>/dev/null || true

    clear 2>/dev/null || true
    echo -e "\033[1;36m━━━ Executar programa ━━━\033[0m"
    echo -e "Dir:  \033[1;33m$(pwd -P)\033[0m"
    if [ "$as_root" -eq 1 ]; then
        echo -e "Modo: \033[1;31mroot (sudo)\033[0m"
    else
        echo -e "Modo: \033[1;32mutilizador ($USER)\033[0m"
    fi
    echo -e "Cmd:  \033[1;37m$cmd\033[0m"
    echo -e "\033[0;90m────────────────────────────────\033[0m\n"

    if [ "${DRY_RUN:-0}" = "1" ]; then
        echo -e "\033[1;33m[DRY RUN] Nao executado.\033[0m"
        echo "  $cmd"
        eazy_pausa_terminal "Enter para voltar..."
        return 0
    fi

    if [ "$as_root" -eq 1 ]; then
        if ! solicitar_senha_sudo; then
            echo -e "\033[1;31mSudo cancelado ou senha invalida.\033[0m"
            eazy_pausa_terminal "Enter para voltar..."
            return 1
        fi
        sudo -n bash -c "cd -- $(printf '%q' "$(pwd -P)") && $cmd"
        rc=$?
    else
        bash -c "cd -- $(printf '%q' "$(pwd -P)") && $cmd"
        rc=$?
    fi

    echo ""
    if [ "$rc" -eq 0 ]; then
        echo -e "\033[1;32mOK concluido (codigo $rc)\033[0m"
    else
        echo -e "\033[1;31mFalhou (codigo $rc)\033[0m"
    fi
    eazy_pausa_terminal "Enter para voltar ao eazy..."
    return "$rc"
}

