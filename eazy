                # tenta primeiro .py da seleção
                _found=""
                while IFS= read -r _l; do
                    [ -z "$_l" ] && continue
                    _p=$(printf '%s\n' "$_l" | awk -F '\t' '{print $NF}')
                    _p=$(caminho_absoluto "$_p" 2>/dev/null || echo "$_p")
                    if eh_arquivo_python "$_p"; then _found="$_p"; break; fi
