eazy_sel_progress() {
    local n="${1:-0}" total="${2:-0}" bytes="${3:-0}" arq="${4:-}" rotulo="${5:-sel}"
    local lab short cols lines msg
    lab=$(formatar_bytes_label "$bytes" 2>/dev/null || echo "${bytes} B")
    cols=$( { tput cols 2>/dev/null || echo 80; } | tr -cd '0-9' ); cols=${cols:-80}
    lines=$( { tput lines 2>/dev/null || echo 24; } | tr -cd '0-9' ); lines=${lines:-24}
    short="$arq"
    if [ -n "$short" ] && [ ${#short} -gt $((cols - 36)) ] && [ $((cols - 36)) -gt 10 ]; then
        short="…${short: -$((cols - 38))}"
    fi
    msg=$(printf '▶ %s  %s/%s  %s  %s' "$rotulo" "$n" "$total" "$lab" "$short")
    [ ${#msg} -gt "$cols" ] && msg="${msg:0:$((cols-1))}…"
    {
        printf '\033[s\033[%s;1H\033[2K\033[1;33m%s\033[0m\033[u' "$lines" "$msg"
    } > /dev/tty 2>/dev/null || printf '\r\033[K%s' "$msg" >&2
}
eazy_sel_progress_end() {
    local lines
    lines=$( { tput lines 2>/dev/null || echo 24; } | tr -cd '0-9' ); lines=${lines:-24}
    { printf '\033[s\033[%s;1H\033[2K\033[u' "$lines"; } > /dev/tty 2>/dev/null || true
}
eazy_playlist_cache_invalidate() {
    local pl="${1:-$ARQUIVO_PLAYLIST_ABERTO}" h c
    [ -z "$pl" ] && return 0
    h=$(printf '%s' "$pl" | md5sum 2>/dev/null | awk '{print $1}')
    c="${EAZY_TMP_DIR}/pl_view_${h}.cache"
    rm -f "$c" "${c}.meta" 2>/dev/null || true
    eazy_lista_cache_invalidate 2>/dev/null || true
}

eazy_status_file() {
    # Default silencioso; só com --verbose / EAZY_VERBOSE=1
    [ "${EAZY_VERBOSE:-0}" = "1" ] || return 0
    local acao="${1:-…}"
    local arq="${2:-}"
    local extra="${3:-}"
    local cols lines short msg
    cols=$( { tput cols 2>/dev/null || echo 80; } | tr -cd '0-9' )
    lines=$( { tput lines 2>/dev/null || echo 24; } | tr -cd '0-9' )
    cols=${cols:-80}
    lines=${lines:-24}
    short="$arq"
    if [ -n "$short" ] && [ ${#short} -gt $((cols - 28)) ] && [ $((cols - 28)) -gt 12 ]; then
        short="…${short: -$((cols - 30))}"
    fi
    if [ -n "$extra" ]; then
        msg=$(printf '▶ %s  %s  %s' "$acao" "$short" "$extra")
    elif [ -n "$short" ]; then
        msg=$(printf '▶ %s  %s' "$acao" "$short")
    else
        msg=$(printf '▶ %s' "$acao")
    fi
    if [ -n "${EAZY_STATUS_FILE:-}" ]; then
        printf '%s\t%s\n' "$acao" "$arq" > "$EAZY_STATUS_FILE" 2>/dev/null || true
    fi
    # 1) linha fixa no fundo (cursor salvo)
    # 2) também eco visível no stderr (abre na 1ª carga mesmo se /dev/tty falhar)
    {
        printf '\033[s\033[%s;1H\033[2K\033[1;33m%s\033[0m\033[u' "$lines" "$msg"
    } > /dev/tty 2>/dev/null || true
    {
        # linha “viva” no fim do ecrã — sem \r só (para a abertura ser legível)
        printf '\r\033[K\033[1;33m%s\033[0m' "$msg"
    } > /dev/tty 2>/dev/null || printf '\r\033[K\033[1;33m%s\033[0m' "$msg" >&2
}

eazy_status_file_clear() {
    local lines
    lines=$( { tput lines 2>/dev/null || echo 24; } | tr -cd '0-9' )
    lines=${lines:-24}
    {
        printf '\033[s\033[%s;1H\033[2K\033[u' "$lines"
        printf '\r\033[K'
    } > /dev/tty 2>/dev/null || printf '\r\033[K' >&2
    [ -n "${EAZY_STATUS_FILE:-}" ] && rm -f "$EAZY_STATUS_FILE" 2>/dev/null || true
}

eazy_busca_progresso() {
    local pct="$1" letra="$2" hits="$3" total="$4" status="${5:-}"
    local c_t=$'\033[1;33m'
    local c_w=$'\033[1;37m'
    local c_g=$'\033[1;32m'
    local c_d=$'\033[0;90m'
    local c_r=$'\033[0m'
    local out
    out=$(printf "\r\033[K%s  %sletra %s%-6s%s  %s+%s%s  %stotal: %s%s  %s%s%s" \
        "$(barra_progresso "$pct")" \
        "$c_t" "$c_w" "$letra" "$c_r" \
        "$c_g" "$hits" "$c_r" \
        "$c_d" "$total" "$c_r" \
        "$c_d" "$status" "$c_r")
    # Preferir /dev/tty; se falhar, stderr (nunca stdout — polui a lista)
    { printf "%s" "$out" > /dev/tty; } 2>/dev/null || printf "%s" "$out" >&2
}

# Helper: mensagem de busca só no tty/stderr
eazy_busca_msg() {
    local msg="$1"
    { printf "%s\n" "$msg" > /dev/tty; } 2>/dev/null || printf "%s\n" "$msg" >&2
}

# Monitor de cancelamento: Esc cria sinal em ~/.config/eazy/tmp.
eazy_busca_cancelar_iniciar() {
    EAZY_BUSCA_CANCEL_FILE="${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}"
    EAZY_BUSCA_CANCEL_PID_FILE="${EAZY_BUSCA_CANCEL_PID_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_pid_$$}"
    rm -f "$EAZY_BUSCA_CANCEL_FILE" "$EAZY_BUSCA_CANCEL_PID_FILE"
    (
        [ -r /dev/tty ] || exit 0
        old_stty=$(stty -g < /dev/tty 2>/dev/null || true)
        stty -icanon -echo min 0 time 1 < /dev/tty 2>/dev/null || exit 0
        trap '[ -n "$old_stty" ] && stty "$old_stty" < /dev/tty 2>/dev/null || true' EXIT HUP INT TERM
        while :; do
            tecla=""
            IFS= read -r -n1 -s -t 0.10 tecla < /dev/tty || true
            if [ "$tecla" = $'\e' ]; then
                : > "$EAZY_BUSCA_CANCEL_FILE"
                break
            fi
        done
    ) &
    printf '%s\n' "$!" > "$EAZY_BUSCA_CANCEL_PID_FILE"
}

eazy_busca_cancelar_parar() {
    local pid
    pid=$(cat "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true)
    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>/dev/null || true
        # Não usar wait aqui: o monitor pode estar bloqueado na leitura do tty
        # e prender a entrega dos resultados até o usuário pressionar Esc.
        sleep 0.12
    fi
    rm -f "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true
    # O trap do monitor restaura o terminal; esta chamada apenas garante o modo normal.
    stty sane < /dev/tty 2>/dev/null || true
}

eazy_busca_cancelada() {
    [ -e "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" ]
}

eazy_busca_esperar_pid() {
    local pid="$1"
    while kill -0 "$pid" 2>/dev/null; do
        if eazy_busca_cancelada; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 130
        fi
        sleep 0.08
    done
    wait "$pid" 2>/dev/null
}

# Linha de status: HD livre/total + seleção (para header do fzf)
# Uso: eazy_status_header [caminho1 caminho2 ...]
# Preserva atalhos em EAZY_HEADER_HINT (exportado antes do fzf)
eazy_status_header() {
    local livre total livre_h total_h sel_bytes sel_h sel_count=0
    read -r livre total < <(info_disco)
    livre=${livre:-0}; total=${total:-0}
    livre_h=$(formatar_bytes_label "$livre")
    total_h=$(formatar_bytes_label "$total")

    sel_bytes=0
    if [ "${MODO_DUP:-0}" -eq 1 ] && [ -f "${DUP_SELECTED_FILE:-}" ]; then
        local p t
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            t=$(tamanho_caminho "$p")
            t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
            sel_bytes=$((sel_bytes + t))
            sel_count=$((sel_count + 1))
        done < "$DUP_SELECTED_FILE"
    elif [ "$#" -gt 0 ]; then
        local p t
        for p in "$@"; do
            [ -z "$p" ] && continue
            # fzf pode passar linha completa com tabs
            p=$(printf '%s\n' "$p" | awk -F '\t' '{print $NF}')
            [[ "$p" =~ \.\.$ ]] && continue
            t=$(tamanho_caminho "$p")
            t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
            sel_bytes=$((sel_bytes + t))
            sel_count=$((sel_count + 1))
        done
    fi
    if [ "$#" -eq 0 ] && [ "${MODO_DUP:-0}" -ne 1 ] && [ -f "${SELECTED_FILE:-}" ]; then
        # Contagem rápida do cache — NÃO relê/du cada ficheiro da seleção global
        sel_count=$(grep -cve '^[[:space:]]*$' "$SELECTED_FILE" 2>/dev/null || echo 0)
        sel_count=$(printf '%s' "$sel_count" | tr -cd '0-9')
        sel_count=${sel_count:-0}
        # bytes: usa cache lateral se existir; senão "—"
        if [ -f "${SELECTED_FILE}.bytes" ]; then
            sel_bytes=$(tr -cd '0-9' < "${SELECTED_FILE}.bytes" 2>/dev/null || echo 0)
            sel_bytes=${sel_bytes:-0}
        else
            sel_bytes=0
        fi
    fi
    local atual_dir atual_count=0 atual_bytes=0 ap at
    atual_dir=$(pwd -P)
    if [ "$#" -eq 0 ] && [ "${MODO_DUP:-0}" -ne 1 ]; then
        reconstruir_selecao_local
    fi
    if [ "$#" -eq 0 ] && [ "${MODO_DUP:-0}" -ne 1 ]; then
        while IFS= read -r ap; do
            [ -f "$ap" ] || continue
            ap=$(readlink -f -- "$ap" 2>/dev/null || printf '%s' "$ap")
            if [ "$(dirname -- "$ap")" = "$atual_dir" ]; then
                at=$(tamanho_caminho "$ap"); at=$(echo "$at" | tr -cd '0-9'); at=${at:-0}
                atual_bytes=$((atual_bytes + at)); atual_count=$((atual_count + 1))
            fi
        done < "${SELECTED_LOCAL_FILE:-/dev/null}"
        while IFS= read -r ap; do
            [ -d "$ap" ] || continue
            ap=$(readlink -f -- "$ap" 2>/dev/null || printf '%s' "$ap")
            if [ "$(dirname -- "$ap")" = "$atual_dir" ]; then
                at=$(tamanho_caminho "$ap"); at=$(echo "$at" | tr -cd '0-9'); at=${at:-0}
                atual_bytes=$((atual_bytes + at)); atual_count=$((atual_count + 1))
            fi
        done < "/dev/null"
    fi
    sel_h=$(formatar_bytes_label "$sel_bytes")
    atual_h=$(formatar_bytes_label "$atual_bytes")
    local agora op_s ia_s
    agora=$(date "+%H:%M:%S")
    op_s="$([ "${SEL_GLOBAL_OP:-1}" = "1" ] && echo OP || echo sess)"
    ia_s="$([ "${IA_ATIVA:-0}" = "1" ] && echo "IA:${IA_NOME:-smithi}" || echo "")"
    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        printf "[%s] DRY:%s | HD %s/%s | Sel %s (%s) %s %s" "$agora" "$([ "${DRY_RUN:-0}" = "1" ] && echo ON || echo off)" "$livre_h" "$total_h" "$sel_h" "$sel_count" "$op_s" "$ia_s"
    else
        printf "[%s] DRY:%s | HD %s/%s | Global %s (%s) [%s] | Dir %s (%s) %s" "$agora" "$([ "${DRY_RUN:-0}" = "1" ] && echo ON || echo off)" "$livre_h" "$total_h" "$sel_h" "$sel_count" "$op_s" "$atual_h" "$atual_count" "$ia_s"
    fi
    if [ -n "${EAZY_HEADER_HINT:-}" ]; then
        printf "\n%s" "$EAZY_HEADER_HINT"
    fi
    # Legenda de cores (linha inferior da janela / header)
    # Separadores ASCII 195 (0xC3) e 180 (0xB4) — abrem espaço visual (├ … ┤ em CP437)
    # Em UTF-8 usamos os box-drawing equivalentes para legibilidade.
    local leg_l=$'\u251c' leg_r=$'\u2524'
    # Fallback se o shell não expandir \u: bytes ASCII 195/180
    if [ "${#leg_l}" -ne 1 ] && [ "${#leg_l}" -ne 3 ]; then
        leg_l=$(printf '\303')  # 195
        leg_r=$(printf '\264')  # 180
    fi
    printf "\n%s \033[1;34m[D]DIR\033[0m \033[1;36m[V]VID\033[0m \033[1;33m[A]AUD\033[0m \033[1;35m[I]IMG\033[0m \033[1;31m[Z]ZIP\033[0m \033[0;32m[F]DOC\033[0m \033[0;90m· idx=ordem\033[0m %s" "$leg_l" "$leg_r"
}

# Pergunta filtro de tamanho para a busca recursiva
selecionar_tamanho_busca() {
    BUSCA_TAM_MIN=""
    BUSCA_TAM_MAX=""
    BUSCA_TAM_LABEL=""

    local modo
    modo=$(whiptail --title "Filtro de Tamanho" --radiolist \
        "Filtrar arquivos por tamanho?\n(Exemplos: 10M, 1G, 500K, 1024)" 16 60 5 \
        "nenhum" "Sem filtro de tamanho" "ON" \
        "maior" "Maior que X  ( > X )" "OFF" \
        "menor" "Menor que Y  ( < Y )" "OFF" \
        "entre" "Entre X e Y  ( > X e < Y )" "OFF" \
        "exato" "Aproximadamente X (±10%)" "OFF" \
        3>&1 1>&2 2>&3)
    [ -z "$modo" ] && modo="nenhum"

    local min_in max_in
    case "$modo" in
        maior)
            min_in=$(whiptail --title "Tamanho mínimo" \
                --inputbox "Arquivos MAIORES que:\n(ex: 100M, 1G, 500K)" 11 55 "100M" \
                3>&1 1>&2 2>&3)
            [ -z "$min_in" ] && return 1
            BUSCA_TAM_MIN=$(parse_tamanho_humano "$min_in")
            if [ -z "$BUSCA_TAM_MIN" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido: $min_in" 8 40
                return 1
            fi
            BUSCA_TAM_LABEL=">$(formatar_bytes_label "$BUSCA_TAM_MIN")"
            ;;
        menor)
            max_in=$(whiptail --title "Tamanho máximo" \
                --inputbox "Arquivos MENORES que:\n(ex: 50M, 1G)" 11 55 "50M" \
                3>&1 1>&2 2>&3)
            [ -z "$max_in" ] && return 1
            BUSCA_TAM_MAX=$(parse_tamanho_humano "$max_in")
            if [ -z "$BUSCA_TAM_MAX" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido: $max_in" 8 40
                return 1
            fi
            BUSCA_TAM_LABEL="<$(formatar_bytes_label "$BUSCA_TAM_MAX")"
            ;;
        entre)
            min_in=$(whiptail --title "Tamanho mínimo" \
                --inputbox "Maior que (mínimo):\n(ex: 10M)" 11 55 "10M" \
                3>&1 1>&2 2>&3)
            [ -z "$min_in" ] && return 1
            max_in=$(whiptail --title "Tamanho máximo" \
                --inputbox "Menor que (máximo):\n(ex: 500M)" 11 55 "500M" \
                3>&1 1>&2 2>&3)
            [ -z "$max_in" ] && return 1
            BUSCA_TAM_MIN=$(parse_tamanho_humano "$min_in")
            BUSCA_TAM_MAX=$(parse_tamanho_humano "$max_in")
            if [ -z "$BUSCA_TAM_MIN" ] || [ -z "$BUSCA_TAM_MAX" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido." 8 40
                return 1
            fi
            if [ "$BUSCA_TAM_MIN" -ge "$BUSCA_TAM_MAX" ] 2>/dev/null; then
                whiptail --title "Erro" --msgbox "O mínimo deve ser menor que o máximo." 8 45
                return 1
            fi
            BUSCA_TAM_LABEL=">$(formatar_bytes_label "$BUSCA_TAM_MIN") <$(formatar_bytes_label "$BUSCA_TAM_MAX")"
            ;;
        exato)
            min_in=$(whiptail --title "Tamanho aproximado" \
                --inputbox "Tamanho aproximado (±10%):\n(ex: 700M)" 11 55 "700M" \
                3>&1 1>&2 2>&3)
            [ -z "$min_in" ] && return 1
            local centro
            centro=$(parse_tamanho_humano "$min_in")
            if [ -z "$centro" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido: $min_in" 8 40
                return 1
            fi
            BUSCA_TAM_MIN=$(awk -v c="$centro" 'BEGIN {printf "%.0f", c * 0.9}')
            BUSCA_TAM_MAX=$(awk -v c="$centro" 'BEGIN {printf "%.0f", c * 1.1}')
            BUSCA_TAM_LABEL="~$(formatar_bytes_label "$centro")"
            ;;
        *)
            BUSCA_TAM_MIN=""
            BUSCA_TAM_MAX=""
            BUSCA_TAM_LABEL=""
            ;;
    esac
    return 0
}

