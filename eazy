diagnostico_rapido() {
    {
        echo "╔════════════════════════════════════════════════════════════════╗"
        echo "║              DIAGNÓSTICO RÁPIDO DO SISTEMA                     ║"
        echo "╚════════════════════════════════════════════════════════════════╝"
