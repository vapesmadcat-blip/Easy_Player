extrair_com_senha() {
    local arquivo="$1"
    local senha="$2"
    local sucesso=0

    [ ! -f "$arquivo" ] && return 1

    local ext
    ext=$(echo "${arquivo##*.}" | tr '[:upper:]' '[:lower:]')
    local nome_base
    nome_base=$(basename "$arquivo")

    echo -e "\n\033[1;36m📦 Tentando extrair: $nome_base\033[0m"

    case "$ext" in
        zip)
            if command -v unzip &>/dev/null; then
                if [ -n "$senha" ]; then
                    unzip -o -P "$senha" "$arquivo" && sucesso=1
                else
                    unzip -o "$arquivo" && sucesso=1
                fi
            else
                echo -e "\033[1;31mFerramenta 'unzip' não encontrada.\033[0m"
            fi
            ;;
        rar)
            # Preferir o RAR oficial (WinRAR/rarlab). unrar de terceiros não é confiável.
            if command -v rar &>/dev/null; then
                if [ -n "$senha" ]; then
                    rar x -o+ -p"$senha" -- "$arquivo" && sucesso=1
                else
                    rar x -o+ -- "$arquivo" && sucesso=1
                fi
            elif command -v 7z &>/dev/null; then
                echo -e "\033[0;90m'rar' não encontrado — tentando 7z…\033[0m"
                if [ -n "$senha" ]; then
                    7z x -y -p"$senha" -- "$arquivo" && sucesso=1
                else
                    7z x -y -- "$arquivo" && sucesso=1
                fi
            else
                echo -e "\033[1;31mNenhuma ferramenta RAR encontrada.\033[0m"
                echo -e "Instale o RAR oficial:  \033[1;37msudo apt install rar\033[0m"
                echo -e "(pacote non-free; evite 'unrar' de fontes duvidosas)"
            fi
            ;;
        7z)
            if command -v 7z &>/dev/null; then
                if [ -n "$senha" ]; then
                    7z x -y -p"$senha" "$arquivo" && sucesso=1
                else
                    7z x -y "$arquivo" && sucesso=1
                fi
            else
                echo -e "\033[1;31mFerramenta '7z' não encontrada.\033[0m"
            fi
            ;;
        gz|bz2|xz|tar)
            if [[ "$arquivo" == *.tar.gz ]] || [[ "$arquivo" == *.tgz ]]; then
                tar -xzf "$arquivo" && sucesso=1
            elif [[ "$arquivo" == *.tar.bz2 ]] || [[ "$arquivo" == *.tbz2 ]]; then
                tar -xjf "$arquivo" && sucesso=1
            elif [[ "$arquivo" == *.tar.xz ]]; then
                tar -xJf "$arquivo" && sucesso=1
            elif [ "$ext" = "gz" ]; then
                gunzip -k "$arquivo" 2>/dev/null && sucesso=1
            elif [ "$ext" = "bz2" ]; then
                bunzip2 -k "$arquivo" 2>/dev/null && sucesso=1
            elif [ "$ext" = "xz" ]; then
                unxz -k "$arquivo" 2>/dev/null && sucesso=1
            else
                tar -xf "$arquivo" && sucesso=1
            fi
            ;;
        *)
            echo -e "\033[1;33mExtensão .$ext não suportada para extração automática.\033[0m"
            return 1
            ;;
    esac

    if [ "$sucesso" -eq 1 ]; then
        echo -e "\033[1;32m✓ Extração concluída com sucesso!\033[0m"
        read -p "Deseja apagar o arquivo compactado original? (s/N): " apagar
        if [[ "$apagar" =~ ^[Ss]$ ]]; then
            rm -f -- "$arquivo"
            echo -e "\033[1;32mArquivo compactado removido.\033[0m"
        fi
        return 0
    else
        echo -e "\033[1;31m✗ Falha na extração (senha incorreta ou arquivo corrompido?).\033[0m"
        return 1
    fi
}

