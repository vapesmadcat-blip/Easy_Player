mostrar_selecao_global() {
    local n=0 bytes=0 p sz tmp
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-sel-global.XXXXXX") || return 1
    {
        printf 'eazy — SELEÇÃO GLOBAL\n'
        printf '========================================\n'
        printf 'Arquivo: %s\n' "${SELECTED_FILE:-}"
        printf 'Persistente (OP): %s\n' "$([ "${SEL_GLOBAL_OP:-1}" = "1" ] && echo SIM || echo NÃO — só sessão)"
        printf 'Gerado em: %s\n\n' "$(date "+%Y-%m-%d %H:%M:%S")"
        if [ ! -s "${SELECTED_FILE:-}" ]; then
            printf '(vazia)\n'
        else
            printf "%-12s  %-8s  %s\n" "TAMANHO" "EXT" "CAMINHO"
            printf "%-12s  %-8s  %s\n" "------------" "--------" "--------"
            while IFS= read -r p || [ -n "$p" ]; do
                [ -z "$p" ] && continue
                n=$((n + 1))
                sz=0
                if [ -e "$p" ]; then
                    sz=$(du -sb -- "$p" 2>/dev/null | awk "{print \$1}")
                    bytes=$((bytes + ${sz:-0}))
                fi
                ext="${p##*.}"
                [ "$ext" = "$p" ] && ext="—"
                ext=$(printf "%s" "$ext" | tr "[:upper:]" "[:lower:]" | cut -c1-8)
                printf "%-12s  %-8s  %s\n" "$(formatar_bytes_label "${sz:-0}" 2>/dev/null || echo "${sz:-0}")" "$ext" "$p"
            done < "$SELECTED_FILE"
            printf "\nTotal: %s item(ns) · %s\n" "$n" "$(formatar_bytes_label "$bytes" 2>/dev/null || echo "$bytes bytes")"
        fi
    } > "$tmp"
    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "Seleção global ($n · $(formatar_bytes_label "$bytes" 2>/dev/null || echo "$bytes B"))" --textbox "$tmp" 28 100 --scrolltext
    else
        cat "$tmp"
    fi
    rm -f "$tmp"
}

