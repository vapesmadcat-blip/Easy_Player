        "sel_op" "Alternar seleção global OP (persistente/sessão)" \
        "overview" "Overview do sistema (completo)" \
        "sound" "Teste de som" \
        "shell" "Shell do sistema (neste diretório)" \
        "exitdir" "Ao sair: dir do navegador ou o anterior" \
        "download" "Downloads — downloader/Tor/parâmetros" \
        "dirs" "Diretórios — downloads, torrents, notas, HTML…" \
        "lixeira" "Abrir lixeira do sistema" \
