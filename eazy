# Linha de navegação (.. / Voltar) — nunca filtrada, nunca selecionável nas ações
eazy_eh_navegacao() {
    local linha="$1"
    local campo2 campo_fim
    campo2=$(printf '%s\n' "$linha" | awk -F '\t' '{print $2}')
    campo_fim=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    case "$campo_fim" in
        ..|./..|.) return 0 ;;
    esac
    # Voltar / Sair (qualquer variante do rótulo)
    case "$campo2" in
        *Voltar*) return 0 ;;
    esac
    case "$campo2" in
        *Sair*) return 0 ;;
    esac
    return 1
}

eazy_sem_navegacao() {
    local linha
    while IFS= read -r linha || [ -n "$linha" ]; do
        [ -z "$linha" ] && continue
        eazy_eh_navegacao "$linha" && continue
        printf '%s\n' "$linha"
    done
}

