                HTML_EXPORT_DIR="$novo"
                ;;
            config)
                whiptail --title "Config interna" --msgbox \
"Pasta de configuração do eazy (não costuma mudar):\n\n$CONFIG_DIR\n\nTemporários: $EAZY_TMP_DIR\nNotas internas: $NOTES_DIR\nPesquisas salvas: $SAVED_SEARCHES_DIR\nArquivo config: $CONFIG_FILE" 14 72
                ;;
            abrir_dl)
                mkdir -p "${DOWNLOAD_DIR:-$HOME/Downloads}" 2>/dev/null || true
                xdg-open "${DOWNLOAD_DIR:-$HOME/Downloads}" 2>/dev/null || true
                ;;
            abrir_tor)
                mkdir -p "${TORRENT_DIR:-$HOME/Downloads/Torrents}" 2>/dev/null || true
                xdg-open "${TORRENT_DIR:-$HOME/Downloads/Torrents}" 2>/dev/null || true
                ;;
            abrir_pl)
                mkdir -p "${PLAYLIST_DIR_PADRAO:-$HOME/Playlists}" 2>/dev/null || true
                xdg-open "${PLAYLIST_DIR_PADRAO:-$HOME/Playlists}" 2>/dev/null || true
                ;;
            salvar)
                eazy_salvar_diretorios_config
