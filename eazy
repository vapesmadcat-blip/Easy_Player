obter_lista_rapida() {
    local C_DIR='\033[1;34m'
    local C_VID='\033[1;36m'
    local C_AUD='\033[1;33m'
    local C_IMG='\033[1;35m'
    local C_ZIP='\033[1;31m'
    local C_SIZE='\033[0;32m'
    local C_RESET='\033[0m'

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar aos Arquivos" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        if [ -s "$DOWNLOAD_QUEUE" ]; then
            while IFS='|' read -r engine link pass; do
                [ -z "$link" ] && continue
                local exib_link="$link"
                [ ${#exib_link} -gt 35 ] && exib_link="${exib_link:0:35}.."
                local exib_pass="Nenhuma"
                if [ -n "$pass" ]; then
                    exib_pass="••••••"
                fi
                printf "000000000000001\t%b📥 [%s] %-30s%b\t%b[Senha: %s]%b\t%s\n" \
                    "$C_VID" "$engine" "$exib_link" "$C_RESET" "$C_AUD" "$exib_pass" "$C_RESET" "$link"
            done < "$DOWNLOAD_QUEUE"
        fi
        return
    fi

    if [ "$MODO_PLAYLIST" -eq 1 ] && [ -f "$ARQUIVO_PLAYLIST_ABERTO" ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar aos Arquivos" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        # Diretório base da playlist (para resolver caminhos relativos)
        local pl_dir
        pl_dir=$(dirname "$ARQUIVO_PLAYLIST_ABERTO")

        while IFS= read -r item || [ -n "$item" ]; do
            [ -z "$item" ] && continue
            [[ "$item" =~ ^# ]] && continue
            # Remove \r de arquivos Windows
            item="${item%$'\r'}"

            # Resolve caminho: absoluto fica, relativo resolve a partir da pasta do .m3u
            local item_res="$item"
            if [[ "$item" != /* ]]; then
                item_res="$pl_dir/$item"
            fi
            # Normaliza ./
            item_res="${item_res//\/\.\//\/}"

            local tamanho=0
            local mb="-- MB"
            local tipo_icone="🎬"
            local existe=0

            if [ -e "$item_res" ]; then
                existe=1
                tamanho=$(stat -c%s "$item_res" 2>/dev/null || echo 0)
                mb=$(awk -v b="$tamanho" 'BEGIN {printf "%.1f", b / 1048576}')
            else
                mb="?"
            fi

            local nome_exib
            nome_exib=$(basename "$item_res")
            if [ ${#nome_exib} -gt 38 ]; then
                nome_exib="${nome_exib:0:38}.."
            fi
            # Indica arquivo ausente
            if [ "$existe" -eq 0 ]; then
                nome_exib="⚠ $nome_exib"
            fi

            local ext="${item_res##*.}"
            ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

            if [[ "$ext" =~ ^(mp3|m4a|wav|flac)$ ]]; then
                tipo_icone="🎵"
            elif [[ "$ext" =~ ^(webp|jpg|jpeg|png|gif)$ ]]; then
                tipo_icone="🖼️"
            elif [[ "$ext" =~ ^(zip|tar|gz|bz2|xz|rar|7z)$ ]]; then
                tipo_icone="📦"
            fi

            # Guarda o caminho resolvido (absoluto) no campo final para play/delete
            printf "%015d\t%b%s %-40s%b\t%b[%s MB]%b\t%s\n" \
                "$tamanho" "$C_VID" "$tipo_icone" "$nome_exib" "$C_RESET" "$C_SIZE" "$mb" "$C_RESET" "$item_res"
        done < "$ARQUIVO_PLAYLIST_ABERTO"
        return
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar (Sair de Duplicados)" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        if [ -s "$DUP_FILE" ]; then
            awk -F'\t' -v c_zip="$C_ZIP" -v c_size="$C_SIZE" -v c_reset="$C_RESET" '
            BEGIN { grupo = 0; anterior = "" }
            {
                hash = $1; tam = $2; caminho = $3
                if (hash != anterior) { grupo++; anterior = hash }

                nome_exib = caminho
                if (length(nome_exib) > 40) {
                    nome_exib = "..." substr(nome_exib, length(nome_exib) - 37)
                }
                mb = sprintf("%.1f", tam / 1048576)

                printf "%015d\t%s🔁 G%02d %-36s%s\t%s[%s MB]%s\t%s\n",
                    tam, c_zip, grupo, nome_exib, c_reset, c_size, mb, c_reset, caminho
            }' "$DUP_FILE"
        fi
        return
    fi

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar (Sair da Busca)" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        local -a ext_arr_busca
        construir_iname_array ext_arr_busca "$EXT_BUSCA"

        local tmp_busca cache_key cache_file
        cache_key=$(chave_cache_busca)
        cache_file="${BUSCA_CACHE_DIR}/${cache_key}.tsv"
        tmp_busca="/tmp/eazy_busca_raw_$$"

        # Buffer de busca: reutiliza resultado enquanto o eazy estiver aberto
        if [ -s "$cache_file" ]; then
            local n_cache
            n_cache=$(wc -l < "$cache_file" 2>/dev/null | tr -cd '0-9')
            n_cache=${n_cache:-0}
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;32m'"⚡ Cache de busca — $n_cache arquivo(s) (instantâneo)"$'\033[0m'
            eazy_busca_msg ""
            cp -f "$cache_file" "$tmp_busca" 2>/dev/null || cat "$cache_file" > "$tmp_busca"
        else
            : > "$tmp_busca"

            # Segmentos: 0-9, A-Z, outros — barra atualiza ANTES e DEPOIS de cada um
            local letras=({0..9} {A..Z})
            local total_seg=$((${#letras[@]} + 1))
            local idx=0 total_achados=0
            local let seg_tmp n_seg pct
            local size_args=()
            [ -n "${BUSCA_TAM_MIN:-}" ] && size_args+=("-size" "+${BUSCA_TAM_MIN}c")
            [ -n "${BUSCA_TAM_MAX:-}" ] && size_args+=("-size" "-${BUSCA_TAM_MAX}c")

            local titulo="🔍 Busca segmentada [${EXT_BUSCA:-todas}]"
            [ -n "${BUSCA_TAM_LABEL:-}" ] && titulo="$titulo  tam:$BUSCA_TAM_LABEL"
            [ -n "${BUSCA_CONTEUDO:-}" ] && titulo="$titulo  txt:«${BUSCA_CONTEUDO:0:16}»"
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;36m'"$titulo"$'\033[0m'
            eazy_busca_msg $'\033[0;90m'"   segmentos: 0-9 → A-Z → outros"$'\033[0m'

            for let in "${letras[@]}"; do
                pct=$((idx * 100 / total_seg))
                eazy_busca_progresso "$pct" "$let" "..." "$total_achados" "scan..."
                seg_tmp="/tmp/eazy_busca_seg_$$"
                find . -type f \( "${ext_arr_busca[@]}" \) "${size_args[@]}" \
                    -iname "${let}*" -printf "%s\t%T@\t%y\t%f\t%p\n" 2>/dev/null > "$seg_tmp"
                n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9')
                n_seg=${n_seg:-0}
                cat "$seg_tmp" >> "$tmp_busca"
                rm -f "$seg_tmp"
                total_achados=$((total_achados + n_seg))
                idx=$((idx + 1))
                pct=$((idx * 100 / total_seg))
                eazy_busca_progresso "$pct" "$let" "$n_seg" "$total_achados" "ok"
            done

            pct=$((idx * 100 / total_seg))
            eazy_busca_progresso "$pct" "outros" "..." "$total_achados" "scan..."
            seg_tmp="/tmp/eazy_busca_seg_$$"
            find . -type f \( "${ext_arr_busca[@]}" \) "${size_args[@]}" \
                ! -iname "[0-9]*" ! -iname "[A-Za-z]*" \
                -printf "%s\t%T@\t%y\t%f\t%p\n" 2>/dev/null > "$seg_tmp"
            n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9')
            n_seg=${n_seg:-0}
            cat "$seg_tmp" >> "$tmp_busca"
            rm -f "$seg_tmp"
            total_achados=$((total_achados + n_seg))
            eazy_busca_progresso 100 "outros" "$n_seg" "$total_achados" "ok"
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;32m'"✓ Busca concluída — $total_achados arquivo(s)"$'\033[0m'
            eazy_busca_msg ""

            # Filtro por conteúdo (grep) com barra própria
            if [ -n "${BUSCA_CONTEUDO:-}" ]; then
                local tmp_filtro="/tmp/eazy_busca_grep_$$"
                : > "$tmp_filtro"
                local n_grep=0 n_total gi=0
                n_total=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9')
                n_total=${n_total:-1}
                [ "$n_total" -lt 1 ] && n_total=1
                while IFS=$'\t' read -r bytes mtime tipo nome caminho; do
                    gi=$((gi + 1))
                    [ -z "$caminho" ] && continue
                    if grep -ilFq -- "$BUSCA_CONTEUDO" "$caminho" 2>/dev/null; then
                        printf "%s\t%s\t%s\t%s\t%s\n" "$bytes" "$mtime" "$tipo" "$nome" "$caminho" >> "$tmp_filtro"
                        n_grep=$((n_grep + 1))
                    fi
                    if [ $((gi % 15)) -eq 0 ] || [ "$gi" -eq "$n_total" ]; then
                        eazy_busca_progresso "$((gi * 100 / n_total))" "grep" "$n_grep" "$gi" "/$n_total"
                    fi
                done < "$tmp_busca"
                mv "$tmp_filtro" "$tmp_busca"
                eazy_busca_msg ""
                eazy_busca_msg $'\033[1;32m'"✓ Conteúdo — $n_grep hit(s)"$'\033[0m'
                eazy_busca_msg ""
            fi

            # Grava no buffer da sessão
            mkdir -p "$BUSCA_CACHE_DIR" 2>/dev/null || true
            cp -f "$tmp_busca" "$cache_file" 2>/dev/null || cat "$tmp_busca" > "$cache_file"
        fi

        awk -F'\t' \
            -v c_vid="$C_VID" -v c_aud="$C_AUD" -v c_img="$C_IMG" -v c_zip="$C_ZIP" \
            -v c_size="$C_SIZE" -v c_reset="$C_RESET" -v modo="$MODO_ATUAL" \
            -v tmin="${BUSCA_TAM_MIN:-0}" -v tmax="${BUSCA_TAM_MAX:-0}" '
        {
            bytes = $1 + 0
            if (tmin > 0 && bytes <= tmin) next
            if (tmax > 0 && bytes >= tmax) next

            mtime = $2
            nome = $4
            caminho = $5
            sub(/^\.\//, "", caminho)

            nome_exib = caminho
            if (length(nome_exib) > 45) {
                nome_exib = "..." substr(nome_exib, length(nome_exib) - 41)
            }
            mb = sprintf("%.1f", bytes / 1048576)
            chave = (modo == "data") ? int(mtime) : bytes
            info = (modo == "data") ? strftime("%d/%m/%y %H:%M", int(mtime)) : mb " MB"

            n = split(nome, ext_arr, ".")
            ext = tolower(ext_arr[n])

            if (ext ~ /^(m3u|pls)$/) {
                printf "%015d\t%s📜 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(mp3|m4a|wav|flac)$/) {
                printf "%015d\t%s🎵 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(webp|jpg|jpeg|png|gif)$/) {
                printf "%015d\t%s🖼️ %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_img, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(zip|tar|gz|bz2|xz|rar|7z)$/) {
                printf "%015d\t%s📦 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_zip, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else {
                printf "%015d\t%s🎬 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_vid, nome_exib, c_reset, c_size, info, c_reset, caminho
            }
        }' "$tmp_busca"
        rm -f "$tmp_busca"
        return
    fi

    if [ "$(pwd)" != "/" ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" ".." "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"
    fi

    local -a find_args=("." "-maxdepth" "1" "-mindepth" "1" "(" "-type" "d")

    case "$FILTRO_ATUAL" in
        videos)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp4" "-o" "-iname" "*.mp3" "-o" "-iname" "*.wmv" "-o" "-iname" "*.flv" "-o" "-iname" "*.mkv" "-o" \
                "-iname" "*.avi" "-o" "-iname" "*.mov" "-o" "-iname" "*.webm" "-o" "-iname" "*.m4v" ")")
            ;;
        audios)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp3" "-o" "-iname" "*.m4a" "-o" "-iname" "*.wav" "-o" \
                "-iname" "*.flac" ")")
            ;;
        imgs)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.webp" "-o" "-iname" "*.jpg" "-o" "-iname" "*.jpeg" "-o" \
                "-iname" "*.png" "-o" "-iname" "*.gif" ")")
            ;;
        compactados)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.zip" "-o" "-iname" "*.tar" "-o" "-iname" "*.gz" "-o" \
                "-iname" "*.bz2" "-o" "-iname" "*.xz" "-o" "-iname" "*.rar" "-o" \
                "-iname" "*.7z" ")")
            ;;
        todos)
            find_args+=("-o" "-type" "f")
            ;;
        ambos|*)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp4" "-o" "-iname" "*.mp3" "-o" "-iname" "*.wmv" "-o" "-iname" "*.flv" "-o" \
                "-iname" "*.mkv" "-o" "-iname" "*.mov" "-o" \
                "-iname" "*.m4v" "-o" "-iname" "*.m4a" "-o" "-iname" "*.avi" "-o" "-iname" "*.wav" "-o" \
                "-iname" "*.flac" "-o" "-iname" "*.webm" "-o" "-iname" "*.webp" "-o" \
                "-iname" "*.jpg" "-o" "-iname" "*.jpeg" "-o" "-iname" "*.png" "-o" \
                "-iname" "*.gif" "-o" "-iname" "*.zip" "-o" "-iname" "*.tar" "-o" \
                "-iname" "*.gz" "-o" "-iname" "*.bz2" "-o" "-iname" "*.xz" "-o" \
                "-iname" "*.rar" "-o" "-iname" "*.7z" "-o" "-iname" "*.m3u" "-o" \
                "-iname" "*.pls" "-o" "-iname" "*.txt" ")")
            ;;
    esac
    find_args+=(")")

    find "${find_args[@]}" -printf "%s\t%T@\t%y\t%f\t%p\n" 2>/dev/null | awk -F'\t' \
        -v c_dir="$C_DIR" -v c_vid="$C_VID" -v c_aud="$C_AUD" -v c_img="$C_IMG" -v c_zip="$C_ZIP" \
        -v c_size="$C_SIZE" -v c_reset="$C_RESET" -v modo="$MODO_ATUAL" '
    {
        bytes = $1
        mtime = $2
        tipo = $3
        nome = $4
        caminho = $5

        sub(/^\.\//, "", caminho)
        nome_exib = (length(nome) > 38) ? substr(nome, 1, 38) ".." : nome
        mb = sprintf("%.1f", bytes / 1048576)

        chave = (modo == "data") ? int(mtime) : bytes
        info = (modo == "data") ? strftime("%d/%m/%y %H:%M", int(mtime)) : mb " MB"

        n = split(nome, ext_arr, ".")
        ext = tolower(ext_arr[n])

        if (tipo == "d") {
            printf "%015d\t%s📁 %-40s%s\t%s[%-9s]%s\t%s\n",
                chave, c_dir, nome_exib "/", c_reset, c_size, (modo == "data" ? info : "-- MB"), c_reset, caminho
        } else if (ext ~ /^(m3u|pls)$/) {
            printf "%015d\t%s📜 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else if (ext ~ /^(mp3|m4a|wav|flac)$/) {
            printf "%015d\t%s🎵 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else if (ext ~ /^(webp|jpg|jpeg|png|gif)$/) {
            printf "%015d\t%s🖼️ %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_img, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else if (ext ~ /^(zip|tar|gz|bz2|xz|rar|7z)$/) {
            printf "%015d\t%s📦 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_zip, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else {
            printf "%015d\t%s🎬 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_vid, nome_exib, c_reset, c_size, info, c_reset, caminho
        }
    }'
}

# Converte caminho relativo para absoluto (robusto)
caminho_absoluto() {
    local p="$1"
    [ -z "$p" ] && return
    # Já é absoluto?
    if [[ "$p" == /* ]]; then
        printf '%s\n' "$p"
        return
    fi
    # realpath se existir, senão fallback
    if command -v realpath &>/dev/null; then
        realpath -m -- "$p" 2>/dev/null || printf '%s/%s\n' "$(pwd)" "${p#./}"
    else
        local base
        base=$(pwd)
        p="${p#./}"
        printf '%s/%s\n' "$base" "$p"
    fi
}

# --- Detecta se arquivo é texto (para visualização read-only) ---
eh_arquivo_texto() {
    local f="$1"
    [ ! -f "$f" ] && return 1
    local ext
    ext=$(echo "${f##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        txt|md|log|conf|cfg|ini|json|xml|csv|sh|bash|py|c|h|cpp|hpp|js|ts|html|htm|css|yaml|yml|toml|nfo|srt|ass|ssa|cue|m3u|pls|lst|org|rst|tex|sql|r|rb|go|rs|java|kt|swift|php|pl|lua|vim|diff|patch|gitignore|dockerfile|makefile|readme|license|changelog)
            return 0
            ;;
    esac
    # Fallback: MIME text/*
    if command -v file &>/dev/null; then
        local mime
        mime=$(file -b --mime-type -- "$f" 2>/dev/null)
        [[ "$mime" == text/* ]] && return 0
        [[ "$mime" == application/json ]] && return 0
        [[ "$mime" == application/xml ]] && return 0
        [[ "$mime" == application/javascript ]] && return 0
    fi
    return 1
}

mostrar_texto() {
    local f="$1"
    [ ! -f "$f" ] && return 1
    clear
    echo -e "\033[1;36m═══ $(basename "$f") ═══\033[0m  (somente leitura — q para sair)\n"
    if command -v less &>/dev/null; then
        less -R -FX -- "$f"
    elif command -v more &>/dev/null; then
        more -- "$f"
    else
        cat -- "$f"
        echo ""
        read -p "Pressione Enter para voltar..."
    fi
}

# Preview do fzf (caminho = último campo da linha TAB)
eazy_preview() {
    local linha="$1"
    local path
    path=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    path="${path#./}"

    # Linha de voltar / vazia
    if [ -z "$path" ] || [[ "$path" =~ \.\.$ ]] || [[ "$path" == ".." ]]; then
        printf "📁 Diretório pai / voltar\n"
        return
    fi

    # URL (fila de download)
    if [[ "$path" =~ ^https?:// ]]; then
        printf "🔗 LINK\n\n%s\n" "$path"
        return
    fi

    if [ -d "$path" ]; then
        printf "📁 PASTA\n%s\n\n" "$path"
        printf "Conteúdo (até 20 itens):\n"
        ls -lah -- "$path" 2>/dev/null | head -n 21
        return
    fi

    if [ ! -e "$path" ]; then
        printf "⚠ Arquivo não encontrado:\n%s\n" "$path"
        return
    fi

    if [ ! -f "$path" ]; then
        printf "❓ %s\n" "$path"
        return
    fi

    local nome tamanho human tipo ext
    nome=$(basename -- "$path")
    tamanho=$(stat -c%s -- "$path" 2>/dev/null || echo 0)
    human=$(awk -v b="$tamanho" 'BEGIN {
        if (b>=1073741824) printf "%.2f GB", b/1073741824
        else if (b>=1048576) printf "%.2f MB", b/1048576
        else if (b>=1024) printf "%.1f KB", b/1024
        else printf "%d B", b
    }')
    tipo=$(file -b -- "$path" 2>/dev/null | head -c 80)
    ext=$(echo "${nome##*.}" | tr '[:upper:]' '[:lower:]')

    printf "📄 %s\n" "$nome"
    printf "━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "Caminho : %s\n" "$path"
    printf "Tamanho : %s (%s bytes)\n" "$human" "$tamanho"
    printf "Tipo    : %s\n" "$tipo"

    # Mídia: duração, resolução, codec
    if command -v ffprobe &>/dev/null; then
        if [[ "$ext" =~ ^(mp4|mkv|avi|webm|mov|m4v|wmv|flv|mp3|m4a|wav|flac|ogg|opus|aac)$ ]]; then
            local dur w h vcodec acodec br
            dur=$(ffprobe -v quiet -show_entries format=duration -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            br=$(ffprobe -v quiet -show_entries format=bit_rate -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            w=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=width -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            h=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=height -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            vcodec=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=codec_name -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            acodec=$(ffprobe -v quiet -select_streams a:0 -show_entries stream=codec_name -of default=nk=1:nw=1 -- "$path" 2>/dev/null)

            printf "\n🎬 MÍDIA\n"
            if [ -n "$dur" ] && [ "$dur" != "N/A" ]; then
                awk -v d="$dur" 'BEGIN {
                    s=int(d); h=int(s/3600); m=int((s%3600)/60); sec=s%60
                    if (h>0) printf "Duração : %d:%02d:%02d\n", h, m, sec
                    else printf "Duração : %d:%02d\n", m, sec
                }'
            fi
            [ -n "$w" ] && [ -n "$h" ] && [ "$w" != "N/A" ] && printf "Res     : %sx%s\n" "$w" "$h"
            [ -n "$vcodec" ] && [ "$vcodec" != "N/A" ] && printf "Vídeo   : %s\n" "$vcodec"
            [ -n "$acodec" ] && [ "$acodec" != "N/A" ] && printf "Áudio   : %s\n" "$acodec"
            if [ -n "$br" ] && [ "$br" != "N/A" ]; then
                awk -v b="$br" 'BEGIN {printf "Bitrate : %.0f kbps\n", b/1000}'
            fi
        fi
    fi

    # Texto: primeiras linhas
    if [[ "$ext" =~ ^(txt|md|log|json|xml|csv|sh|py|c|h|js|html|css|yml|yaml|toml|conf|cfg|ini|nfo|srt|ass)$ ]]; then
        printf "\n📝 PRÉVIA\n"
        head -n 25 -- "$path" 2>/dev/null
    elif [[ "$ext" =~ ^(jpg|jpeg|png|gif|webp|bmp|tiff|tif|svg)$ ]]; then
        printf "\n🖼  IMAGEM\n"
        if command -v identify &>/dev/null; then
            identify -format "Res: %wx%h  |  %m  |  %b\n" -- "$path" 2>/dev/null
        elif command -v ffprobe &>/dev/null; then
            w=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=width -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            h=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=height -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            [ -n "$w" ] && printf "Res: %sx%s\n" "$w" "$h"
        fi
        # Miniatura no terminal (chafa > viu > catimg > convert)
        local cols="${FZF_PREVIEW_COLUMNS:-40}"
        local lines="${FZF_PREVIEW_LINES:-20}"
        if command -v chafa &>/dev/null; then
            chafa -f symbols --symbols vhalf --size "${cols}x${lines}" -- "$path" 2>/dev/null
        elif command -v viu &>/dev/null; then
            viu -w "$cols" -h "$lines" -- "$path" 2>/dev/null
        elif command -v catimg &>/dev/null; then
            catimg -w "$cols" -- "$path" 2>/dev/null
        elif command -v convert &>/dev/null; then
            convert -- "$path" -resize "${cols}x${lines}" -colors 16 sixel:- 2>/dev/null \
                || printf "(instale 'chafa' para miniatura: sudo apt install chafa)\n"
        else
            printf "(instale 'chafa' para miniatura no preview)\n"
        fi
    fi
}

# Script Lua do mpv: marcar / apagar durante a reprodução
preparar_script_mpv_exclusao() {
    mkdir -p "$MPV_SCRIPT_DIR" 2>/dev/null || true
    local script="$MPV_SCRIPT_DIR/eazy_mark_delete.lua"
    cat > "$script" <<'LUA'
-- eazy: marcar / excluir durante a reprodução (mpv)
local mark_file = os.getenv("EAZY_MARK_DELETE") or ""

local function append_mark(path)
    if not path or path == "" or mark_file == "" then return false end
    -- evita duplicata
    local exists = false
    local rf = io.open(mark_file, "r")
    if rf then
        for line in rf:lines() do
            if line == path then exists = true; break end
        end
        rf:close()
    end
    if exists then
        mp.osd_message("EAZY: já marcado para exclusão", 1.5)
        return true
    end
    local f = io.open(mark_file, "a")
    if not f then
        mp.osd_message("EAZY: falha ao marcar", 2)
        return false
    end
    f:write(path .. "\n")
    f:close()
    return true
end

local function current_path()
    return mp.get_property("path")
end

-- d = marcar para exclusão (apaga depois, ao sair do player)
mp.add_key_binding("d", "eazy-mark-delete", function()
    local path = current_path()
    if append_mark(path) then
        mp.osd_message("EAZY: marcado para exclusão\n" .. (path or ""), 2)
    end
end)

-- D (Shift+d) = marcar e ir para o próximo da playlist
mp.add_key_binding("D", "eazy-mark-and-next", function()
    local path = current_path()
    if append_mark(path) then
