eazy_player_extra_preview() {
    local value="${1//$'\n'/ }"
    if [ -z "$value" ]; then
        printf '(sem parâmetros)'
        return 0
    fi
    if [ "${#value}" -gt 38 ]; then
        value="${value:0:35}..."
    fi
    printf '%s' "$value"
}

eazy_configurar_parametros_players() {
    local player key current title prompt novo action edit_current
    while true; do
        player=$(whiptail --title 'F9 — Parâmetros extras dos players' --menu \
            'Escolha o player para editar. Os parâmetros atuais aparecem ao lado:' 18 78 5 \
            'mpv'     "mpv     | $(eazy_player_extra_preview "${PLAYER_EXTRA_MPV:-}")" \
            'mplayer' "MPlayer | $(eazy_player_extra_preview "${PLAYER_EXTRA_MPLAYER:-}")" \
            'cvlc'    "VLC     | $(eazy_player_extra_preview "${PLAYER_EXTRA_CVLC:-}")" \
            'ffplay'  "ffplay  | $(eazy_player_extra_preview "${PLAYER_EXTRA_FFPLAY:-}")" \
            '0'       'Voltar' 3>&1 1>&2 2>&3) || return 0
        case "$player" in
            mpv)
                key=PLAYER_EXTRA_MPV; current="${PLAYER_EXTRA_MPV:-}"
                title='Parâmetros extras — mpv'
                ;;
            mplayer)
                key=PLAYER_EXTRA_MPLAYER; current="${PLAYER_EXTRA_MPLAYER:-}"
                title='Parâmetros extras — MPlayer'
                ;;
            cvlc)
                key=PLAYER_EXTRA_CVLC; current="${PLAYER_EXTRA_CVLC:-}"
                title='Parâmetros extras — VLC/cvlc'
                ;;
            ffplay)
                key=PLAYER_EXTRA_FFPLAY; current="${PLAYER_EXTRA_FFPLAY:-}"
                title='Parâmetros extras — ffplay'
                ;;
            *) return 0 ;;
        esac
        action=$(whiptail --title "$title" --menu \
            "Valor atual: $(eazy_player_extra_preview "$current")\nEscolha editar/substituir ou remover o parâmetro salvo." 13 76 4 \
            'edit' 'Editar o valor atual (campo preenchido)' \
            'replace' 'Substituir por uma nova linha (campo vazio)' \
            'clear' 'Remover todos os parâmetros deste player' \
            'back' 'Voltar à lista de players' 3>&1 1>&2 2>&3) || continue
        case "$action" in
            clear)
                if ! eazy_config_unset_value "$key"; then
                    whiptail --title 'Erro ao remover parâmetros' --msgbox "Não foi possível atualizar:\n$CONFIG_FILE" 9 68
                    continue
                fi
                case "$key" in
                    PLAYER_EXTRA_MPV) PLAYER_EXTRA_MPV='' ;;
                    PLAYER_EXTRA_MPLAYER) PLAYER_EXTRA_MPLAYER='' ;;
                    PLAYER_EXTRA_CVLC) PLAYER_EXTRA_CVLC='' ;;
                    PLAYER_EXTRA_FFPLAY) PLAYER_EXTRA_FFPLAY='' ;;
                esac
                whiptail --title 'Parâmetros removidos' --msgbox "Os parâmetros de $player foram removidos." 8 62
                continue
                ;;
            back) continue ;;
            edit) edit_current="$current" ;;
            replace) edit_current='' ;;
            *) continue ;;
        esac
        if [ "$action" = replace ]; then
            prompt="Digite a linha completa de novos parâmetros. O campo começa vazio; para apagar tudo sem digitar, use a ação 'Remover todos os parâmetros'."
        else
            prompt="O valor atual está preenchido. Edite o que desejar e confirme. Para trocar tudo sem apagar caractere por caractere, use 'Substituir por uma nova linha'."
        fi
        if novo=$(whiptail --title "$title" --inputbox "$prompt" 11 72 "$edit_current" 3>&1 1>&2 2>&3); then
            if [ -z "$novo" ]; then
                if ! eazy_config_unset_value "$key"; then
                    whiptail --title 'Erro ao salvar parâmetros' --msgbox "Não foi possível atualizar:\n$CONFIG_FILE" 9 68
                    continue
                fi
            else
                if ! eazy_config_set_value "$key" "$novo"; then
                    whiptail --title 'Erro ao salvar parâmetros' --msgbox "Não foi possível atualizar:\n$CONFIG_FILE" 9 68
                    continue
                fi
            fi
            case "$key" in
                PLAYER_EXTRA_MPV) PLAYER_EXTRA_MPV="$novo" ;;
                PLAYER_EXTRA_MPLAYER) PLAYER_EXTRA_MPLAYER="$novo" ;;
                PLAYER_EXTRA_CVLC) PLAYER_EXTRA_CVLC="$novo" ;;
                PLAYER_EXTRA_FFPLAY) PLAYER_EXTRA_FFPLAY="$novo" ;;
            esac
            whiptail --title 'Parâmetros salvos' --msgbox "Valor atualizado para $player:\n$(eazy_player_extra_preview "$novo")" 9 68
        fi
    done
}

