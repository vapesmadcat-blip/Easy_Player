eazy_browser_resolve() {
    # imprime path absoluto do exe se existir
    local id="$1"
    case "$id" in
        chrome)
            for c in chrome.exe \
                "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe" \
                "/mnt/c/Program Files (x86)/Google/Chrome/Application/chrome.exe" \
                google-chrome google-chrome-stable chromium chromium-browser; do
                if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return 0; fi
                [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
            done
            ;;
        edge)
            for c in msedge.exe \
                "/mnt/c/Program Files/Microsoft/Edge/Application/msedge.exe" \
                "/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe" \
                microsoft-edge; do
                if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return 0; fi
                [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
            done
            ;;
        brave)
            for c in brave.exe \
                "/mnt/c/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe" \
                "/mnt/c/Program Files (x86)/BraveSoftware/Brave-Browser/Application/brave.exe" \
                brave-browser brave; do
                if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return 0; fi
                [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
            done
            ;;
        firefox)
            for c in firefox.exe \
                "/mnt/c/Program Files/Mozilla Firefox/firefox.exe" \
                "/mnt/c/Program Files (x86)/Mozilla Firefox/firefox.exe" \
                firefox; do
                if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return 0; fi
                [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
            done
            ;;
        default)
            if command -v wslview >/dev/null 2>&1; then printf '%s\n' "wslview"; return 0; fi
            if command -v xdg-open >/dev/null 2>&1; then printf '%s\n' "xdg-open"; return 0; fi
            if command -v explorer.exe >/dev/null 2>&1; then printf '%s\n' "explorer.exe"; return 0; fi
            ;;
    esac
    return 1
}

eazy_abrir_html_browser() {
    # $1 = ficheiro html (path Linux)
    local html="$1" escolha last_file last="" cmd win_html url arg
    [ -f "$html" ] || return 1
    last_file="${CONFIG_DIR}/last_html_browser"
    [ -s "$last_file" ] && last=$(head -n1 "$last_file" 2>/dev/null | tr -d '\r')

    local menu_args=()
    local id label cmd_found
    for id in brave chrome edge firefox default; do
        cmd_found=$(eazy_browser_resolve "$id" 2>/dev/null || true)
        [ -n "$cmd_found" ] || continue
        case "$id" in
            brave)   label="Brave" ;;
            chrome)  label="Google Chrome" ;;
            edge)    label="Microsoft Edge" ;;
            firefox) label="Firefox" ;;
            default) label="Padrao do sistema (wslview/xdg-open)" ;;
        esac
        # marca ultimo usado
        if [ "$id" = "$last" ]; then
            label="$label  [ultimo]"
        fi
        menu_args+=("$id" "$label")
    done
    menu_args+=("nenhum" "Nao abrir (so gerar o ficheiro)")

    if [ "${#menu_args[@]}" -lt 2 ]; then
        # nada detectado
        if command -v xdg-open >/dev/null 2>&1; then xdg-open "$html" 2>/dev/null; fi
        return 0
    fi

    escolha=$(whiptail --title "Abrir HTML — escolher browser" --menu \
"Qual browser usar?

HTML: $(basename -- "$html")
(Firefox pode bloquear video em file://; Brave/Chrome costumam funcionar melhor.)" \
        18 72 8 \
        "${menu_args[@]}" \
        3>&1 1>&2 2>&3) || return 0

    [ "$escolha" = "nenhum" ] && return 0
    printf '%s\n' "$escolha" > "$last_file" 2>/dev/null || true

    cmd=$(eazy_browser_resolve "$escolha" 2>/dev/null || true)
    [ -n "$cmd" ] || {
        whiptail --title "Browser" --msgbox "Browser nao encontrado: $escolha" 8 45
        return 1
    }

    # Argumento: no Windows preferir path Windows; no Linux path Unix
    arg="$html"
    if [[ "$cmd" == *.exe ]] || [[ "$cmd" == /mnt/c/* ]]; then
        if command -v wslpath >/dev/null 2>&1; then
            win_html=$(wslpath -w -- "$html" 2>/dev/null || true)
            [ -n "$win_html" ] && arg="$win_html"
        fi
    fi

    case "$cmd" in
        wslview|xdg-open|explorer.exe)
            "$cmd" "$arg" >/dev/null 2>&1 &
            ;;
        *)
            # chrome/edge/brave/firefox: abrir URL/ficheiro
            "$cmd" "$arg" >/dev/null 2>&1 &
            ;;
    esac
    return 0
}


