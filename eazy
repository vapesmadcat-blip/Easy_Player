    [ ! -f "$f" ] && return 1
    local ext
    ext=$(echo "${f##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        txt|md|log|conf|cfg|ini|json|xml|csv|c|h|cpp|hpp|js|ts|css|yaml|yml|toml|nfo|srt|ass|ssa|cue|m3u|pls|lst|org|rst|tex|sql|r|rb|go|rs|java|kt|swift|php|pl|lua|vim|diff|patch|gitignore|dockerfile|makefile|readme|license|changelog)
