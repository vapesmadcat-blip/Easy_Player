# Base: DIRLOCAL; cálculo de status global: eazy_global_correto_PERSISTENCIA_CALCULO_QUANTIDADE
#  eazy 5.0.0 — navegador e reprodutor multimídia no terminal
#  Revisão 4.2.2 — tmp em ~/.config/eazy/tmp; export HTML (Ctrl-H) seleção|tela; caches/listas no config
#  https://github.com/vapesmadcat-blip/Easy_Player
#  fzf + mpv/mplayer/cvlc/ffplay | seleção persistente | manutenção do sistema
#
#  Licença: uso livre. Sem garantias.
#
set -o pipefail

# --- Flags de arranque (antes de tudo) ---
# Default: silencioso (sem barra de ficheiros). --verbose mostra o processamento.
EAZY_VERBOSE="${EAZY_VERBOSE:-0}"
EAZY_IGNORE="${EAZY_IGNORE:-0}"   # --ignore: anónimo — não carrega nem grava persistências
EAZY_UNSELECT="${EAZY_UNSELECT:-0}"  # --unselect: limpa seleção global e local
_eazy_args=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --verbose|-v)
            EAZY_VERBOSE=1
            shift
            ;;
        --silent|-q)
            EAZY_VERBOSE=0
            shift
            ;;
        --ignore|--anonymous|--anon)
            EAZY_IGNORE=1
            EAZY_VERBOSE="${EAZY_VERBOSE:-0}"
            shift
            ;;
        --unselect|--noselect|--no-select|--clear-selection)
            EAZY_UNSELECT=1
            shift
            ;;
        --)
            shift
            _eazy_args+=("$@")
            break
            ;;
        *)
            _eazy_args+=("$1")
            shift
            ;;
    esac
done
set -- "${_eazy_args[@]}"
export EAZY_VERBOSE EAZY_IGNORE EAZY_UNSELECT


# --- Não rodar o navegador como root ---
# Flags só de info/instalação podem rodar como root; o UI não.
case "${1:-}" in
    --help|-h|--version|-V|--shell-init|--install|--update-all|--update-ytdlp|--uninstall|--restore-keys|--backup|--restore-backup) ;;
    *)
        if [ "$(id -u)" -eq 0 ]; then
            if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && id "$SUDO_USER" >/dev/null 2>&1; then
                exec sudo -u "$SUDO_USER" -H -- "$0" "$@"
            fi
            printf '%s\n' "eazy: não use root/sudo para abrir o navegador." >&2
            printf '%s\n' "Rode apenas: eazy" >&2
            printf '%s\n' "Se ~/.config/eazy ficou dono root, corrija:" >&2
            printf '%s\n' "  sudo chown -R \$USER:\$USER ~/.config/eazy" >&2
            exit 1
        fi
        ;;
esac

