# --- Pastas favoritas (Ctrl+L lista / Ctrl++ adiciona) ---
eazy_dir_fav_file() {
    printf '%s\n' "${DIR_FAVORITES_FILE:-$CONFIG_DIR/dir_favorites}"
}

eazy_dir_fav_ensure() {
    local f
    f=$(eazy_dir_fav_file)
    mkdir -p "$(dirname -- "$f")" 2>/dev/null || true
    if [ ! -s "$f" ]; then
        {
            printf '%s\n' "$HOME"
            [ -d /etc ] && printf '%s\n' /etc
            [ -d /mnt ] && printf '%s\n' /mnt
            [ -d /mnt/c ] && printf '%s\n' /mnt/c
            [ -d /media ] && printf '%s\n' /media
            printf '%s\n' "${DOWNLOAD_DIR:-$HOME/Downloads}"
        } > "$f" 2>/dev/null || true
    fi
}

eazy_dir_fav_add() {
    local d="${1:-$(pwd -P 2>/dev/null || pwd)}" f
    d=$(readlink -f -- "$d" 2>/dev/null || printf '%s' "$d")
    [ -d "$d" ] || { whiptail --title "Favoritos" --msgbox "Não é pasta:\n$d" 9 55; return 1; }
    eazy_dir_fav_ensure
    f=$(eazy_dir_fav_file)
    if grep -Fxq -- "$d" "$f" 2>/dev/null; then
        whiptail --title "Favoritos" --msgbox "Já está na lista:\n$d" 9 60
        return 0
    fi
    printf '%s\n' "$d" >> "$f"
    whiptail --title "Favoritos · Ctrl++" --msgbox "Pasta adicionada:\n$d\n\nCtrl+L mostra a lista." 10 60
}

eazy_dir_fav_pick() {
    local f selected n=0
    local -a paths=() menu=()
    eazy_dir_fav_ensure
    f=$(eazy_dir_fav_file)
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        paths+=("$line")
        n=$((n+1))
        if [ -d "$line" ]; then
            menu+=("$n" "$line")
        else
            menu+=("$n" "$line  (ausente)")
        fi
    done < "$f"
    if [ "$n" -eq 0 ]; then
        whiptail --title "Favoritos" --msgbox "Lista vazia.\n\nCtrl++ adiciona a pasta atual." 9 55
        return 1
    fi
    selected=$(whiptail --title "Ctrl+L — Pastas favoritas" --menu \
"Pastas frequentes.\nCtrl++ = adicionar pasta atual\nF9 liga/desliga este menu" 22 78 12 \
        "${menu[@]}" \
        "add" "＋ Adicionar pasta atual" \
        "edit" "✏️  Editar lista (texto)" \
        3>&1 1>&2 2>&3) || return 1
    case "$selected" in
        add) eazy_dir_fav_add "$(pwd -P)"; return 1 ;;
        edit)
            local editor="${EDITOR:-nano}"
            command -v "$editor" >/dev/null 2>&1 || editor=vi
            "$editor" "$f"
            return 1
            ;;
        *)
            if [[ "$selected" =~ ^[0-9]+$ ]] && [ "$selected" -ge 1 ] && [ "$selected" -le "${#paths[@]}" ]; then
                printf '%s\n' "${paths[$((selected-1))]}"
                return 0
            fi
            return 1
            ;;
    esac
}

eazy_ir_para_pasta() {
    local modo alvo_l dest_dir dest_item caminho dir_atual_antes origem_posicao
    if [ "${DIR_FAVORITES_MENU:-1}" = "1" ]; then
        modo=$(whiptail --title "Ctrl-L — Ir para pasta" --menu "Como navegar?" 16 72 6 \
            "fav" "★ Pastas favoritas (Ctrl++ adiciona atual)" \
            "item" "Pasta do item sob o cursor" \
            "escrever" "Escrever caminho do diretorio" \
            "add" "＋ Adicionar pasta atual aos favoritos" \
            "cancel" "Cancelar" 3>&1 1>&2 2>&3) || return 1
    else
        modo=$(whiptail --title "Ctrl-L — Ir para pasta" --menu "Como navegar?" 13 68 3 \
            "item" "Pasta do item sob o cursor" \
            "escrever" "Escrever caminho do diretorio" \
            "cancel" "Cancelar" 3>&1 1>&2 2>&3) || return 1
    fi
    case "$modo" in
        fav)
            caminho=$(eazy_dir_fav_pick) || return 1
            [ -z "$caminho" ] && return 1
            if [ ! -d "$caminho" ]; then
                whiptail --title "Ir" --msgbox "Diretório não existe:\n$caminho" 9 55; return 1
            fi
            dest_dir=$(readlink -f -- "$caminho" 2>/dev/null || printf '%s' "$caminho")
            dest_item=""
            ;;
        add)
            eazy_dir_fav_add "$(pwd -P)"
            return 0
            ;;
        item)
            alvo_l=$(printf '%s\n' "${1:-}" | head -n1 | awk -F '\t' '{print $NF}')
            [ -z "$alvo_l" ] && { whiptail --title "Ir" --msgbox "Nenhum item sob o cursor." 8 40; return 1; }
            alvo_l=$(caminho_absoluto "$alvo_l")
            if [ -d "$alvo_l" ]; then dest_dir="$alvo_l"; dest_item=""
            elif [ -e "$alvo_l" ]; then dest_dir=$(dirname -- "$alvo_l"); dest_item=$(basename -- "$alvo_l")
            else whiptail --title "Ir" --msgbox "Nao encontrado:\n$alvo_l" 9 55; return 1; fi
            ;;
        escrever)
            caminho=$(whiptail --title "Ir para diretorio" --inputbox \
                "Caminho (~ e \$HOME expandem):" 10 72 "$(pwd -P)" 3>&1 1>&2 2>&3) || return 1
            caminho="${caminho/#\~/$HOME}"
            if [ ! -d "$caminho" ]; then
                whiptail --title "Ir" --msgbox "Diretorio nao existe:\n$caminho" 9 55; return 1
            fi
            dest_dir=$(readlink -f -- "$caminho" 2>/dev/null || printf '%s' "$caminho")
            dest_item=""
            ;;
        *) return 1 ;;
    esac
    eazy_ler_cursor_fzf 2>/dev/null || true
    eazy_capturar_contexto_volta "${ULTIMO_ARQUIVO:-$dest_item}" 2>/dev/null || true
    dir_atual_antes="$(pwd -P)"
    origem_posicao="$dir_atual_antes"
    [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -f "${ARQUIVO_PLAYLIST_ABERTO:-}" ] && origem_posicao="$ARQUIVO_PLAYLIST_ABERTO"
    [ "${MODO_BUSCA:-0}" -eq 1 ] && origem_posicao="busca"
    salvar_posicao_dir "$origem_posicao" "${TMP:-1}" "${ULTIMO_ARQUIVO:-$dest_item}"
    DIRETORIO_ANTERIOR="$dir_atual_antes"
    MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0; MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
    rm -f "$DUP_SELECTED_FILE" "$DUP_MANUAL_FILE" 2>/dev/null || true
    dest_dir=$(readlink -f -- "$dest_dir" 2>/dev/null || printf '%s' "$dest_dir")
    cd -- "$dest_dir" 2>/dev/null || { whiptail --title "Ir" --msgbox "Falha ao entrar:\n$dest_dir" 9 55; return 1; }
    ULTIMO_ARQUIVO="$dest_item"
    carregar_posicao_dir "$(pwd -P)"
    [ -n "$dest_item" ] && ULTIMO_ARQUIVO="$dest_item"
    ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"; TMP=1
    registrar_status 2>/dev/null || true
    salvar_sessao 2>/dev/null || true
    eazy_lista_cache_invalidate 2>/dev/null || true
    return 0
}

abrir_editor_notas() {
    local nota ext
    mkdir -p "$NOTES_DIR" 2>/dev/null || {
        whiptail --title "Notas" --msgbox "Não foi possível criar: $NOTES_DIR" 8 60
        return 1
    }
    # SEMPRE preferir nota.txt como padrão de texto.
    # Nunca abrir áudio (.ogg/.wav), .org, binários, etc. no mini-editor.
    nota=""
    if [ -s "$LAST_NOTE_FILE" ]; then
        nota=$(head -n1 "$LAST_NOTE_FILE" 2>/dev/null | tr -d '\r')
    fi
    ext="${nota##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        txt|md|text|markdown) ;;
        *)
            # .ogg, .wav, .org, .mp3, vazio, path inválido → força nota.txt
            nota=""
            ;;
    esac
    if [ -z "$nota" ] || [ ! -f "$nota" ]; then
        nota="$NOTES_DIR/nota.txt"
    fi
    # path relativo ou fora de NOTES_DIR → ainda assim usa nota.txt se não for texto
    case "$nota" in
        *.txt|*.md|*.text|*.markdown) ;;
        *) nota="$NOTES_DIR/nota.txt" ;;
    esac
    touch "$nota" 2>/dev/null || {
        nota="$NOTES_DIR/nota.txt"
        touch "$nota" 2>/dev/null || return 1
    }
    printf '%s\n' "$nota" > "$LAST_NOTE_FILE"
    if [ ! -x "$EAZY_NOTES_EDITOR" ]; then
        # fallback: editor do sistema para não ficar trancado
        if command -v nano >/dev/null 2>&1; then
            ( cd "$NOTES_DIR" && nano -- "$nota" )
            return $?
        fi
        if command -v vi >/dev/null 2>&1; then
            ( cd "$NOTES_DIR" && vi -- "$nota" )
            return $?
        fi
        whiptail --title "Editor de notas" --msgbox "Mini editor não encontrado:\n$EAZY_NOTES_EDITOR" 8 70
        return 1
    fi
    (
        cd "$NOTES_DIR" || exit 1
        EAZY_NOTES_DIR="$NOTES_DIR" EAZY_LAST_NOTE="$LAST_NOTE_FILE" EAZY_EXPORT_DIR="$(eazy_dir_notas_export)"             "$EAZY_NOTES_EDITOR" "$nota"
    )
    # Após fechar: só grava LAST_NOTE se for ficheiro de texto
    local ultima_salva
    ultima_salva=""
    [ -s "$LAST_NOTE_FILE" ] && ultima_salva=$(head -n1 "$LAST_NOTE_FILE" 2>/dev/null | tr -d '\r')
    ext="${ultima_salva##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        txt|md|text|markdown)
            [ -f "$ultima_salva" ] || printf '%s\n' "$nota" > "$LAST_NOTE_FILE"
            ;;
        *)
            printf '%s\n' "$nota" > "$LAST_NOTE_FILE"
            ;;
    esac
}

