                    link_limpo="${link_alvo%%\?*}"
                    export PATH="$(dirname "$YTDLP_BIN"):$PATH"

                    fmt="${pass:-best}"
                    case "$fmt" in
                        best)  fmt_arg="bv*+ba/b" ;;
                        1080)  fmt_arg="bv*[height<=1080]+ba/b[height<=1080]/b" ;;
                        720)   fmt_arg="bv*[height<=720]+ba/b[height<=720]/b" ;;
                        480)   fmt_arg="bv*[height<=480]+ba/b[height<=480]/b" ;;
                        audio) fmt_arg="ba/b" ;;
                        mp4)   fmt_arg="bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b" ;;
                        *)     fmt_arg="$fmt" ;;
                    esac

                    out_tpl="%(title).200B [%(id)s].%(ext)s"
                    echo -e "   Binário: $YTDLP_BIN"
                    echo -e "   Versão:  $($YTDLP_BIN --version 2>/dev/null || echo '?')"
                    echo -e "   Se 403/400 →  eazy --update-ytdlp"

                    # aria2c como acelerador (não substitui o yt-dlp)
                    ARIA_ARGS=()
                    if command -v aria2c &>/dev/null && [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                        ARIA_ARGS=(--downloader aria2c --downloader-args "aria2c:-x 16 -s 16 -k 1M -j 16")
                        echo -e "   Acelerador: aria2c (multi-conexão)"
                    fi
                    echo ""

                    ytdlp_ok=0
                    if [ "$fmt" = "audio" ]; then
                        if [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                            $YTDLP_BIN "${YTDLP_EXTRA[@]}" ${tor_item:+$([ "$tor_item" = 1 ] && echo "--proxy=$tor_proxy")} -f "$fmt_arg" -x --audio-format mp3 --audio-quality 0 \
                                --extractor-args "youtube:player_client=android,web" \
                                --no-playlist --newline --retries 5 \
                                "${ARIA_ARGS[@]}" \
                                -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        else
                            $YTDLP_BIN -f "$fmt_arg" -x --audio-format mp3 \
                                --no-playlist -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        fi
                    else
                        if [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                            $YTDLP_BIN "${YTDLP_EXTRA[@]}" ${tor_item:+$([ "$tor_item" = 1 ] && echo "--proxy=$tor_proxy")} -f "$fmt_arg" --merge-output-format mp4 \
                                --extractor-args "youtube:player_client=android,web" \
                                --no-playlist --newline --retries 5 --fragment-retries 5 \
                                "${ARIA_ARGS[@]}" \
                                -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        else
                            $YTDLP_BIN -f "$fmt_arg" --merge-output-format mp4 \
                                --no-playlist -o "$download_dir/$out_tpl" "$link_limpo" && ytdlp_ok=1
                        fi
                    fi

                    # Fallback se a 1ª tentativa falhar
                    if [ "$ytdlp_ok" -eq 0 ] && [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                        echo -e "\n\033[1;33mTentando fallback (client web + formato livre)...\033[0m"
                        if $YTDLP_BIN -f "b/bv+ba" --merge-output-format mp4 \
                            --extractor-args "youtube:player_client=web" \
                            --no-playlist --newline --retries 5 \
                            "${ARIA_ARGS[@]}" \
                            -o "$download_dir/$out_tpl" "$link_limpo"; then
                            ytdlp_ok=1
                        fi
                    fi

                    if [ "$ytdlp_ok" -eq 1 ]; then
                        status_dl=0
                    else
                        echo -e "\n\033[1;33mAtualize o yt-dlp SEM pip:\033[0m"
                        echo -e "  eazy --update-ytdlp"
                        echo -e "  # ou wget o binário do GitHub (ver --help)"
                        status_dl=1
                    fi
                fi
                ;;
            aria|axel|wget|*)
                if eh_url_video_online "$link_alvo"; then
                    echo -e "\033[1;31mEste link é de vídeo online (YouTube etc.).\033[0m"
                    echo -e "aria2c sozinho NÃO resolve a URL do YouTube."
                    echo -e "O eazy usa:  yt-dlp + aria2c (acelerador)."
                    echo -e "Remova este item e adicione de novo (força yt-dlp)."
                    echo -e "Atualize:  eazy --update-ytdlp"
                    status_dl=1
                elif [ "$engine" = "aria" ]; then
                    if ! command -v aria2c &>/dev/null; then
                        echo -e "\033[1;31maria2c não instalado.  sudo apt install aria2\033[0m"
                    elif "${TOR_PREFIX[@]}" aria2c "${ARIA_EXTRA[@]}" --allow-overwrite=true "$link_alvo"; then
                        status_dl=0
                    fi
                elif [ "$engine" = "axel" ]; then
                    if ! command -v axel &>/dev/null; then
                        echo -e "\033[1;31maxel não instalado.  sudo apt install axel\033[0m"
                    elif "${TOR_PREFIX[@]}" axel "${AXEL_EXTRA[@]}" -o "$download_dir/$nome_esperado" "$link_alvo"; then
                        status_dl=0
                    fi
                else
                    if ! command -v wget &>/dev/null; then
                        echo -e "\033[1;31mwget não instalado.  sudo apt install wget\033[0m"
                    elif "${TOR_PREFIX[@]}" wget "${WGET_EXTRA[@]}" "${WGET_TOR_ARGS[@]}" -O "$download_dir/$nome_esperado" "$link_alvo"; then
                        status_dl=0
                    fi
                fi
                ;;
        esac

        if [ "$status_dl" -ne 0 ]; then
            echo -e "\n\033[1;31m✗ Download falhou.\033[0m"
            read -p "Pressione Enter para continuar..."
            continue
        fi

        echo -e "\n\033[1;32m✓ Download concluído.\033[0m"

        arquivo_baixado=""
        if [ "$engine" = "ytdlp" ]; then
            # Pega o arquivo mais recente da pasta (yt-dlp define o nome)
            arquivo_baixado=$(find "$download_dir" -maxdepth 1 -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.webm" -o -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.opus" \) -printf '%T@ %p\n' 2>/dev/null \
                | sort -nr | head -n1 | cut -d' ' -f2-
            )
        elif [ -f "$download_dir/$nome_esperado" ]; then
            arquivo_baixado="$download_dir/$nome_esperado"
        else
            arquivo_baixado=$(find "$download_dir" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null \
                | sort -nr | head -n1 | cut -d' ' -f2-
            )
        fi

        if [ -n "$arquivo_baixado" ] && [ -f "$arquivo_baixado" ]; then
            echo -e "   Arquivo: $arquivo_baixado"

            # Oferece tocar o vídeo baixado com yt-dlp
            if [ "$engine" = "ytdlp" ]; then
                read -p "Tocar o arquivo agora? (s/N): " quer_tocar
                if [[ "$quer_tocar" =~ ^[Ss]$ ]]; then
                    tocar_arquivo "$arquivo_baixado"
                fi
            fi

            ext_baixado=$(echo "${arquivo_baixado##*.}" | tr '[:upper:]' '[:lower:]')
            if [[ "$ext_baixado" =~ ^(zip|rar|7z|gz|bz2|xz|tar)$ ]] || \
               [[ "$arquivo_baixado" == *.tar.gz ]] || [[ "$arquivo_baixado" == *.tgz ]] || \
               [[ "$arquivo_baixado" == *.tar.bz2 ]] || [[ "$arquivo_baixado" == *.tar.xz ]]; then

                if [ -n "$pass" ] && [ "$engine" != "ytdlp" ]; then
                    echo -e "\033[1;33mArquivo compactado detectado + senha disponível → extraindo...\033[0m"
                    extrair_com_senha "$arquivo_baixado" "$pass"
                else
                    read -p "Arquivo compactado detectado. Deseja extrair agora? (s/N): " quer_extrair
                    if [[ "$quer_extrair" =~ ^[Ss]$ ]]; then
                        extrair_com_senha "$arquivo_baixado" ""
                    fi
                fi
            fi
        else
            echo -e "\033[1;33mNão foi possível identificar o arquivo baixado automaticamente.\033[0m"
        fi

        read -p "Remover este item da fila de downloads? (S/n): " remover_fila
        if [[ ! "$remover_fila" =~ ^[Nn]$ ]]; then
            grep -v "|$link_alvo|" "$DOWNLOAD_QUEUE" > "${DOWNLOAD_QUEUE}.tmp" && mv "${DOWNLOAD_QUEUE}.tmp" "$DOWNLOAD_QUEUE"
            echo -e "\033[1;32mItem removido da fila.\033[0m"
        fi

        read -p "Pressione Enter para continuar..."
        continue
    fi

    if [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            salvar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"
            ULTIMO_ARQUIVO=""
            carregar_posicao_dir "$(pwd -P)"
            registrar_status; continue
        fi

        # Diretório dentro de qualquer lista: entra na pasta, não toca como arquivo.
        total_escolha_playlist=$(printf '%s\n' "$escolha" | grep -c '^' 2>/dev/null || echo 0)
        total_escolha_playlist=$(printf '%s' "$total_escolha_playlist" | tr -cd '0-9'); total_escolha_playlist=${total_escolha_playlist:-0}
        if [ "$total_escolha_playlist" -eq 1 ] && [ -d "$primeiro_caminho" ]; then
            salvar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO" "${TMP:-1}" "$primeiro_caminho"
            ARQUIVO_LISTA_ORIGEM="$ARQUIVO_PLAYLIST_ABERTO"
            DIR_LISTA_ORIGEM="$(readlink -f -- "$primeiro_caminho" 2>/dev/null || echo "$primeiro_caminho")"
            if cd -- "$primeiro_caminho"; then
                MODO_PLAYLIST=0
                ARQUIVO_PLAYLIST_ABERTO=""
                FZF_QUERY=""
                TMP=1; ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"; ULTIMO_ARQUIVO=""
                registrar_status
            else
                whiptail --title "Erro" --msgbox "Não foi possível entrar no diretório:\n$primeiro_caminho" 8 60
            fi
            continue
        fi
        # Enter → só o cursor. Alt+Enter → seleção inteira.
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ "${tecla:-}" = "alt-enter" ]; then
            printf '%s\n' "$escolha" | eazy_playlist_alt_enter "$playlist_sel"
        else
            if [ -n "${cursor_raw:-}" ]; then
                p=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
            else
                p="$primeiro_caminho"
            fi
            [ -n "$p" ] && [[ ! "$p" =~ \.\.$ ]] && [ ! -d "$p" ] && printf '%s\n' "$p" >> "$playlist_sel"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ] && [ "${tecla:-}" = "alt-enter" ]; then
            confirmar_alt_enter "$total_sel" || { rm -f "$playlist_sel"; continue; }
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -ge 1 ]; then
            tocado=$(head -n1 "$playlist_sel")
            ULTIMO_ARQUIVO="$tocado"
            registrar_status
            if [ -f "$tocado" ]; then
                eazy_abrir_arquivo_enter "$tocado"
            else
                whiptail --title "Arquivo ausente" --msgbox "Arquivo não encontrado:\n$tocado" 9 60
            fi
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_DUP=0; rm -f "$DUP_MANUAL_FILE" "$DUP_SELECTED_FILE" "$SELECTED_FILE"; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        # A lista temporária persistente é a fonte da seleção para todas as ações.
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ -s "$DUP_SELECTED_FILE" ]; then
            cp -- "$DUP_SELECTED_FILE" "$playlist_sel"
        else
            : > "$DUP_SELECTED_FILE"
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$p" ] && continue
                p_abs=$(caminho_absoluto "$p")
                printf '%s\n' "$p_abs" >> "$playlist_sel"
                printf '%s\n' "$p_abs" >> "$DUP_SELECTED_FILE"
            done <<< "$escolha"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ]; then
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -eq 1 ] && [ -f "$(head -n1 "$playlist_sel")" ]; then
            ULTIMO_ARQUIVO=$(head -n1 "$playlist_sel")
            registrar_status
            eazy_abrir_arquivo_enter "$ULTIMO_ARQUIVO"
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            # Único sítio que ENCERRA a pesquisa de propósito
            MODO_BUSCA=0
            EAZY_VOLTAR_PARA_BUSCA=0
            BUSCA_TAM_MIN=""; BUSCA_TAM_MAX=""; BUSCA_TAM_LABEL=""; BUSCA_CONTEUDO=""
            BUSCA_SNAPSHOT_FILE=""
            TMP=1; ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
            registrar_status
            eazy_lista_cache_invalidate 2>/dev/null || true
            continue
        fi
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ "${tecla:-}" = "alt-enter" ]; then
            printf '%s\n' "$escolha" | eazy_playlist_alt_enter "$playlist_sel"
        else
            if [ -n "${cursor_raw:-}" ]; then
                p=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
            else
                p="$primeiro_caminho"
            fi
            p_abs=$(caminho_absoluto "$p")
            [ -f "$p_abs" ] && printf '%s\n' "$p_abs" >> "$playlist_sel"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ] && [ "${tecla:-}" = "alt-enter" ]; then
            confirmar_alt_enter "$total_sel" || { rm -f "$playlist_sel"; continue; }
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -ge 1 ] && [ -f "$(head -n1 "$playlist_sel")" ]; then
            ULTIMO_ARQUIVO=$(head -n1 "$playlist_sel")
            registrar_status
            eazy_abrir_arquivo_enter "$ULTIMO_ARQUIVO"
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [[ "$primeiro_caminho" =~ \.\.$ ]]; then
        if [ -n "${DIR_LISTA_ORIGEM:-}" ] && [ "$(readlink -f -- "$(pwd -P)" 2>/dev/null || pwd -P)" = "$DIR_LISTA_ORIGEM" ] && [ -f "${ARQUIVO_LISTA_ORIGEM:-}" ]; then
            MODO_PLAYLIST=1
            ARQUIVO_PLAYLIST_ABERTO="$ARQUIVO_LISTA_ORIGEM"
            DIR_LISTA_ORIGEM=""
            ARQUIVO_LISTA_ORIGEM=""
            FZF_QUERY=""
            TMP=1; ULTIMO_ARQUIVO=""
            carregar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO"
            ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
            registrar_status
            salvar_sessao
            continue
        fi
        # Salva posição e filtro desta pasta; sobe; restaura ambos no pai.
        rm -f "$DUP_MANUAL_FILE" 2>/dev/null || true
        eazy_ler_cursor_fzf 2>/dev/null || true
        local_dir_antes=$(pwd -P 2>/dev/null || pwd)
        # grava cursor dentro da pasta actual
        salvar_posicao_dir "$local_dir_antes" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
        salvar_filtro_dir "$local_dir_antes" "${FZF_QUERY:-}"
        DIRETORIO_ANTERIOR="$local_dir_antes"
        if ! cd ..; then
            eazy_beep
            continue
        fi
        eazy_beep
        parent_dir=$(pwd -P 2>/dev/null || pwd)
        # FORÇA o pai a focar a pasta de onde saímos (caminho absoluto)
        ULTIMO_ARQUIVO="$local_dir_antes"
        salvar_posicao_dir "$parent_dir" "1" "$local_dir_antes"
        carregar_filtro_dir "$parent_dir"
        # TMP será resolvido por encontrar_posicao via ULTIMO_ARQUIVO
        TMP=1
        ALVO="$parent_dir"
        ULTIMO_DIR="$parent_dir"
        registrar_status
        salvar_sessao
        eazy_lista_cache_invalidate 2>/dev/null || true
        continue
    fi

    if [ -d "$primeiro_caminho" ]; then
        # Salva posição e filtro atuais; ao avançar, o filtro da nova pasta começa vazio.
        rm -f "$DUP_MANUAL_FILE" 2>/dev/null || true
        eazy_ler_cursor_fzf
        # Se estavas numa lista, Alt+V volta a ela
        if [ "${MODO_BUSCA:-0}" -eq 1 ] || [ "${MODO_PLAYLIST:-0}" -eq 1 ] || [ "${MODO_DUP:-0}" -eq 1 ] || [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
            eazy_capturar_contexto_volta "${primeiro_caminho}"
        fi
        dir_atual_antes="$(pwd -P)"
        # Sempre o path da pasta em que se ENTRA (não o ULTIMO_ARQUIVO velho)
        _item_save=$(readlink -f -- "$primeiro_caminho" 2>/dev/null || printf '%s' "$primeiro_caminho")
        eazy_ler_cursor_fzf 2>/dev/null || true
        salvar_posicao_dir "$dir_atual_antes" "${TMP:-1}" "$_item_save"
        salvar_filtro_dir "$dir_atual_antes" "${FZF_QUERY:-}"
        FZF_QUERY=""
        DIRETORIO_ANTERIOR="$dir_atual_antes"
        if ! cd -- "$_item_save" 2>/dev/null && ! cd -- "$primeiro_caminho"; then
            eazy_beep
            continue
        fi
        eazy_beep
        # Filho: carrega posição interna; limpa item do pai
        ULTIMO_ARQUIVO=""
        carregar_posicao_dir "$(pwd -P)"
        ALVO="$(pwd -P)"
        ULTIMO_DIR="$(pwd -P)"
        registrar_status
        salvar_sessao
        eazy_lista_cache_invalidate 2>/dev/null || true
        continue
    fi

    if [ -f "$primeiro_caminho" ]; then
        # Enter → só o cursor. Alt+Enter → seleção inteira (com confirmação).
        playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
        : > "$playlist_sel"
        if [ "${tecla:-}" = "alt-enter" ]; then
            printf '%s\n' "$escolha" | eazy_playlist_alt_enter "$playlist_sel"
        else
            if [ -n "${cursor_raw:-}" ]; then
                p=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
            else
                p="$primeiro_caminho"
            fi
            p_abs=$(caminho_absoluto "$p")
            [ -f "$p_abs" ] && printf '%s\n' "$p_abs" >> "$playlist_sel"
        fi
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ] && [ "${tecla:-}" = "alt-enter" ]; then
            confirmar_alt_enter "$total_sel" || { rm -f "$playlist_sel"; continue; }
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -ge 1 ]; then
            tocado=$(head -n1 "$playlist_sel")
            ULTIMO_ARQUIVO="$tocado"
            registrar_status
            eazy_abrir_arquivo_enter "$tocado"
        fi
        rm -f "$playlist_sel"
    fi
done
