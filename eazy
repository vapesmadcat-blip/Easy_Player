            return ;;
        busca_live)
            if [ "${BUSCA_LIVE_STATUS:-1}" = "1" ]; then BUSCA_LIVE_STATUS=0; else BUSCA_LIVE_STATUS=1; fi
            if [ -f "$CONFIG_FILE" ]; then
                if grep -q "^BUSCA_LIVE_STATUS=" "$CONFIG_FILE" 2>/dev/null; then
                    sed -i "s|^BUSCA_LIVE_STATUS=.*|BUSCA_LIVE_STATUS=\"$BUSCA_LIVE_STATUS\"|" "$CONFIG_FILE"
                else
                    echo "BUSCA_LIVE_STATUS=\"$BUSCA_LIVE_STATUS\"" >> "$CONFIG_FILE"
                fi
            fi
            whiptail --title "Busca ao vivo" --msgbox "Barra + cache progressivo: $([ "$BUSCA_LIVE_STATUS" = "1" ] && echo LIGADO || echo DESLIGADO)\n\nCom LIGADO: ao achar ficheiros grava o cache e mostra o nome em baixo." 12 65
            return ;;
        dir_fav)
            if [ "${DIR_FAVORITES_MENU:-1}" = "1" ]; then DIR_FAVORITES_MENU=0; else DIR_FAVORITES_MENU=1; fi
            if [ -f "$CONFIG_FILE" ]; then
                if grep -q "^DIR_FAVORITES_MENU=" "$CONFIG_FILE" 2>/dev/null; then
                    sed -i "s|^DIR_FAVORITES_MENU=.*|DIR_FAVORITES_MENU=\"$DIR_FAVORITES_MENU\"|" "$CONFIG_FILE"
                else
                    echo "DIR_FAVORITES_MENU=\"$DIR_FAVORITES_MENU\"" >> "$CONFIG_FILE"
                fi
            fi
            whiptail --title "Favoritos Ctrl+L" --msgbox "Menu de pastas favoritas: $([ "$DIR_FAVORITES_MENU" = "1" ] && echo LIGADO || echo DESLIGADO)\n\nCtrl++ adiciona a pasta atual.\nLista: ~/.config/eazy/dir_favorites" 12 65

            return
            ;;
        beep_dir)
            if [ "${BEEP_DIR:-1}" = "1" ]; then BEEP_DIR=0; else BEEP_DIR=1; fi
            if [ -f "$CONFIG_FILE" ]; then
                if grep -q "^BEEP_DIR=" "$CONFIG_FILE" 2>/dev/null; then
                    sed -i "s|^BEEP_DIR=.*|BEEP_DIR="$BEEP_DIR"|" "$CONFIG_FILE"
                else
                    echo "BEEP_DIR="$BEEP_DIR"" >> "$CONFIG_FILE"
                fi
            fi
