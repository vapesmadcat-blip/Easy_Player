# Verificação de proteção com senha (ao iniciar)
if [ -f "$PASTA_PROTEGIDA_CONFIG" ] 2>/dev/null; then
    pasta_atual="$(pwd -P)"
    while IFS=: read -r pasta_protegida senha_hash 2>/dev/null; do
        [ -z "$pasta_protegida" ] && continue
        if [[ "$pasta_atual" == "$pasta_protegida"* ]]; then
            tentativas=3
            while [ $tentativas -gt 0 ]; do
                if command -v whiptail &>/dev/null; then
                    senha_inserida=$(whiptail --title "🔒 Pasta Protegida" --passwordbox "Senha:" 8 50 3>&1 1>&2 2>&3)
                else
                    echo "Pasta protegida. Digite a senha:"
                    read -sp "Senha: " senha_inserida
                    echo ""
                fi
                if [ "$(echo -n "$senha_inserida" | sha256sum | cut -d' ' -f1)" = "$senha_hash" ]; then
                    break 2
                else
                    ((tentativas--))
                    [ $tentativas -gt 0 ] && whiptail --title "❌" --msgbox "Incorreta. Tentativas: $tentativas" 7 50
                fi
            done
            whiptail --title "Acesso Negado" --msgbox "Limite excedido." 7 50
            exit 1
        fi
    done < "$PASTA_PROTEGIDA_CONFIG"
fi

if [ "$1" = "--install" ]; then
    echo -e "\033[1;36m=== ${EAZY_NAME} ${EAZY_VERSION} — instalador ===\033[0m"

    # Mapa pacote → binário (quando diferem)
    bin_do_pkg() {
        case "$1" in
            gawk) echo awk ;;
            findutils) echo find ;;
            aria2) echo aria2c ;;
            p7zip-full|p7zip) echo 7z ;;
            libnewt|newt) echo whiptail ;;
            *) echo "$1" ;;
        esac
    }

    instalar_pkgs() {
        local mgr="$1"; shift
        local -a pkgs=("$@") falt=()
        local p b
        for p in "${pkgs[@]}"; do
            b=$(bin_do_pkg "$p")
            command -v "$b" &>/dev/null || falt+=("$p")
        done
        if [ ${#falt[@]} -eq 0 ]; then
            echo -e "\033[1;32m✓ Dependências principais OK\033[0m"
            return 0
        fi
        echo -e "\033[1;33mAusentes: ${falt[*]}\033[0m"
        case "$mgr" in
            apt)
                echo -e "  \033[0;90msudo apt update && sudo apt install -y ${falt[*]}\033[0m"
                sudo apt update && sudo apt install -y "${falt[@]}"
                ;;
            pacman)
                echo -e "  \033[0;90msudo pacman -S --needed ${falt[*]}\033[0m"
                sudo pacman -S --needed --noconfirm "${falt[@]}"
                ;;
            dnf)
                echo -e "  \033[0;90msudo dnf install -y ${falt[*]}\033[0m"
                sudo dnf install -y "${falt[@]}"
                ;;
            zypper)
                echo -e "  \033[0;90msudo zypper install -y ${falt[*]}\033[0m"
                sudo zypper install -y "${falt[@]}"
                ;;
            apk)
                echo -e "  \033[0;90msudo apk add ${falt[*]}\033[0m"
                sudo apk add "${falt[@]}"
                ;;
        esac
    }

    # Detecta desktop (GNOME / KDE / outro) para deps e integração de menu
    DESKTOP_ENV="outro"
    case "${XDG_CURRENT_DESKTOP:-}${DESKTOP_SESSION:-}${XDG_SESSION_DESKTOP:-}" in
        *[Kk][Dd][Ee]*|*[Pp]lasma*) DESKTOP_ENV="kde" ;;
        *[Gg][Nn][Oo][Mm][Ee]*|*[Cc]innamon*|*Unity*) DESKTOP_ENV="gnome" ;;
    esac
    [ -n "${KDE_FULL_SESSION:-}" ] && DESKTOP_ENV="kde"
    [ -n "${GNOME_DESKTOP_SESSION_ID:-}" ] && DESKTOP_ENV="gnome"
    echo -e "Desktop detectado: \033[1;37m${DESKTOP_ENV}\033[0m"

    if command -v apt-get &>/dev/null || command -v apt &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mapt\033[0m"
        # Core + player + utilitários de mídia
        instalar_pkgs apt fzf mpv mplayer gawk sed findutils whiptail wget curl file axel aria2 tor torsocks unzip p7zip-full yt-dlp ffmpeg imagemagick poppler-utils img2pdf chafa xdg-utils vlc python3 python3-urllib3
        # Diagnóstico / sistema
        instalar_pkgs apt inxi lm-sensors smartmontools pciutils usbutils lshw dmidecode iw network-manager upower x11-xserver-utils mesa-utils vulkan-tools alsa-utils pulseaudio-utils
        # PipeWire (comum em GNOME e KDE modernos)
        instalar_pkgs apt pipewire pipewire-pulse wireplumber 2>/dev/null || true
        case "$DESKTOP_ENV" in
            kde)
                echo -e "\033[0;90mIntegrando KDE (opcional)…\033[0m"
                instalar_pkgs apt konsole dolphin kate kio-extras breeze-icon-theme 2>/dev/null || true
                ;;
            gnome)
                echo -e "\033[0;90mIntegrando GNOME (opcional)…\033[0m"
                instalar_pkgs apt gnome-terminal nautilus gedit evince 2>/dev/null || true
                ;;
        esac
        echo -e "\033[0;90mRAR oficial é opcional (repo non-free); leitura de .rar continua via p7zip.\033[0m"
    elif command -v pacman &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mpacman\033[0m"
        instalar_pkgs pacman fzf mpv mplayer gawk sed findutils libnewt wget axel aria2 tor torsocks unzip p7zip yt-dlp ffmpeg imagemagick poppler chafa xdg-utils
        case "$DESKTOP_ENV" in
            kde) instalar_pkgs pacman konsole dolphin kate 2>/dev/null || true ;;
            gnome) instalar_pkgs pacman gnome-terminal nautilus gedit 2>/dev/null || true ;;
        esac
    elif command -v dnf &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mdnf\033[0m"
        instalar_pkgs dnf fzf mpv mplayer gawk sed findutils newt wget axel aria2 tor torsocks unzip p7zip p7zip-plugins yt-dlp ffmpeg ImageMagick poppler-utils chafa xdg-utils
        case "$DESKTOP_ENV" in
            kde) instalar_pkgs dnf konsole dolphin kate 2>/dev/null || true ;;
            gnome) instalar_pkgs dnf gnome-terminal nautilus gedit 2>/dev/null || true ;;
        esac
    elif command -v zypper &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mzypper\033[0m"
        instalar_pkgs zypper fzf mpv mplayer gawk sed findutils newt wget axel aria2 tor torsocks unzip p7zip yt-dlp
        case "$DESKTOP_ENV" in
            kde) instalar_pkgs zypper konsole dolphin kate 2>/dev/null || true ;;
            gnome) instalar_pkgs zypper gnome-terminal nautilus gedit 2>/dev/null || true ;;
        esac
    elif command -v apk &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mapk\033[0m (Alpine)"
        instalar_pkgs apk fzf mpv mplayer gawk sed findutils newt wget axel aria2 tor torsocks unzip p7zip yt-dlp
    else
        echo -e "\033[1;31mNenhum gerenciador conhecido (apt/pacman/dnf/zypper/apk).\033[0m" >&2
        echo -e "Instale manualmente: fzf mpv whiptail gawk findutils wget xdg-utils" >&2
        exit 1
    fi

    SCRIPT_ATUAL="$(readlink -f "$0")"
    SCRIPT_DIR="$(dirname -- "$SCRIPT_ATUAL")"
    DEST_USR_BIN="/usr/bin/eazy"
    DEST_USR_LIB="/usr/lib/eazy/eazy"
    DEST_USR_LOCAL="/usr/local/bin/eazy"
    INSTALL_USER="${SUDO_USER:-${USER:-$(id -un)}}"
    INSTALL_HOME="$(getent passwd "$INSTALL_USER" 2>/dev/null | cut -d: -f6)"
    [ -n "$INSTALL_HOME" ] || INSTALL_HOME="$HOME"
    DEST_USER_LOCAL="$INSTALL_HOME/.local/bin/eazy"
    DESKTOP_SRC="$SCRIPT_DIR/eazy.desktop"
    [ -f "$DESKTOP_SRC" ] || DESKTOP_SRC="$(dirname -- "$SCRIPT_ATUAL")/../share/applications/eazy.desktop"
    EDITOR_SRC="$SCRIPT_DIR/eazy-notes-editor"
    [ -f "$EDITOR_SRC" ] || EDITOR_SRC="/usr/lib/eazy/eazy-notes-editor"
    AI_SRC="$SCRIPT_DIR/eazy-ai.py"
    [ -f "$AI_SRC" ] || AI_SRC="/usr/lib/eazy/eazy-ai.py"
    TOR_SRC="$SCRIPT_DIR/eazy-tor"
    [ -f "$TOR_SRC" ] || TOR_SRC="/usr/lib/eazy/eazy-tor"
    [ -f "$TOR_SRC" ] || TOR_SRC="$(command -v eazy-tor 2>/dev/null || true)"
    DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    # Estrutura completa de dados do usuário; o cache de busca continua temporário.
    mkdir -p "$CONFIG_DIR" "$EAZY_TMP_DIR" "$NOTES_DIR" "$SAVED_SEARCHES_DIR" "$MPV_SCRIPT_DIR" "$SCRIPTS_DIR" "$BACKUPS_DIR" "$PLAYLIST_DIR_PADRAO" "$(eazy_dir_notas_export)" "$(eazy_dir_html_export)" "${TORRENT_DIR:-$HOME/Downloads/Torrents}"
    touch "$PLAYLIST_1" "$PLAYLIST_2" "$PLAYLIST_3" "$DUP_LISTA" "$HISTORY_FILE" "$DOWNLOAD_QUEUE" "$TORRENT_QUEUE"
    eazy_instalar_script_manut_completa >/dev/null 2>&1 || true

    echo -e "\033[1;34mInstalando eazy ${EAZY_VERSION} nos destinos compatíveis...\033[0m"
    sudo install -Dm755 "$SCRIPT_ATUAL" "$DEST_USR_BIN"
    sudo install -Dm755 "$SCRIPT_ATUAL" "$DEST_USR_LIB"
    sudo ln -sfn "$DEST_USR_BIN" "$DEST_USR_LOCAL"
    mkdir -p "$(dirname -- "$DEST_USER_LOCAL")"
    install -Dm755 "$SCRIPT_ATUAL" "$DEST_USER_LOCAL"
    printf '%s\n' "  ✓ $DEST_USR_BIN" "  ✓ $DEST_USR_LIB" "  ✓ $DEST_USR_LOCAL -> $DEST_USR_BIN" "  ✓ $DEST_USER_LOCAL"
    if [ -f "$EDITOR_SRC" ]; then
        if sudo install -Dm755 "$EDITOR_SRC" /usr/lib/eazy/eazy-notes-editor \
            && sudo install -Dm755 "$EDITOR_SRC" /usr/bin/eazy-notes-editor; then
            echo -e "\033[1;32m✓\033[0m Editor de notas: /usr/lib/eazy/eazy-notes-editor (+ /usr/bin)"
        else
            echo -e "\033[1;31m✗\033[0m Falha ao instalar o editor de notas" >&2
            exit 1
        fi
    else
        echo -e "\033[1;33m!\033[0m Editor de notas não encontrado ao lado do script (eazy-notes-editor)"
    fi
    if [ -f "$AI_SRC" ]; then
        if sudo install -Dm755 "$AI_SRC" /usr/lib/eazy/eazy-ai.py \
            && sudo install -Dm755 "$AI_SRC" /usr/bin/eazy-ai.py; then
            echo -e "\033[1;32m✓\033[0m Cliente de IA: /usr/lib/eazy/eazy-ai.py (+ /usr/bin)"
        else
            echo -e "\033[1;31m✗\033[0m Falha ao instalar o cliente de IA" >&2
            exit 1
        fi
    else
        echo -e "\033[1;33m!\033[0m Cliente de IA não encontrado (eazy-ai.py)"
    fi
    if [ -n "$TOR_SRC" ] && [ -f "$TOR_SRC" ]; then
        if sudo install -Dm755 "$TOR_SRC" /usr/lib/eazy/eazy-tor \
            && sudo install -Dm755 "$TOR_SRC" /usr/bin/eazy-tor; then
            echo -e "\033[1;32m✓\033[0m eazy-tor: /usr/lib/eazy/eazy-tor (+ /usr/bin)"
        else
            echo -e "\033[1;31m✗\033[0m Falha ao instalar eazy-tor" >&2
            exit 1
        fi
    else
        echo -e "\033[1;33m!\033[0m eazy-tor não encontrado ao lado do script"
    fi
    if [ -f "$DESKTOP_SRC" ]; then
        mkdir -p "$DESKTOP_DIR"
        cp "$DESKTOP_SRC" "$DESKTOP_DIR/eazy.desktop"
        # Cópia no sistema (menu GNOME/KDE de todos os usuários)
        if sudo install -Dm644 "$DESKTOP_SRC" /usr/share/applications/eazy.desktop 2>/dev/null; then
            echo -e "\033[1;32m✓\033[0m Launcher sistema: /usr/share/applications/eazy.desktop"
        fi
        echo -e "\033[1;32m✓\033[0m Launcher: $DESKTOP_DIR/eazy.desktop"
        command -v update-desktop-database &>/dev/null && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
        command -v update-desktop-database &>/dev/null && sudo update-desktop-database /usr/share/applications 2>/dev/null || true
        # KDE: regenera cache do menu
        command -v kbuildsycoca6 &>/dev/null && kbuildsycoca6 --noincremental 2>/dev/null || true
        command -v kbuildsycoca5 &>/dev/null && kbuildsycoca5 --noincremental 2>/dev/null || true
        # GNOME: atualiza cache de apps se disponível
        command -v glib-compile-schemas &>/dev/null && true
    fi

    # Man page embutida (não depende de eazy.1 ao lado do script)
    MAN_TMP=$(mktemp "${TMPDIR:-/tmp}/eazy-man.XXXXXX")
    cat > "$MAN_TMP" <<'EAZY_MAN_EOF'
.TH EAZY 1 "September 2026" "eazy 4.2.3" "User Commands"
.SH NAME
eazy \- terminal media browser, player and download manager
.SH SYNOPSIS
.B eazy
[\fIOPTIONS\fR] [\fIPATH\fR]
.br
.B eazy \-\-install
.br
.B eazy \-\-torrent
[\fIargs\fR]
.SH DESCRIPTION
.B eazy
is a keyboard-driven terminal media browser built around
.BR fzf (1)
and players such as
.BR mpv (1).
It browses folders, playlists, temporary queues, history, finds duplicates,
exports HTML, and manages downloads (optional Tor) via companions
.BR eazy\-tor ,
.BR eazy\-ai.py
and
.BR eazy\-notes\-editor .
.SH OPTIONS
.TP
.B \-h, \-\-help
Short CLI help.
.TP
.B \-V, \-\-version
Print version.
.TP
.B \-\-install
Install dependencies (fzf, mpv, aria2, axel, wget, yt\-dlp, ffmpeg, tor,
torsocks, python3, \.\.\.), install
.B eazy
and companions to
.IR /usr/bin ,
desktop launcher and this man page.
.TP
.B \-\-shell\-init
Print a bash function so quitting eazy can
.B cd
to the last folder.
.TP
.B \-\-torrent
Forward to
.BR eazy\-tor
(magnet / \.torrent).
.TP
.B \-\-update\-ytdlp
Install/update the official yt\-dlp binary.
.SH KEY BINDINGS
.TP
.B F1 / F2 / Ctrl\-T
Sort by size / name / date. Works in folders, history, playlists, queues and temp lists.
.TP
.B F3
Toggle fullscreen / windowed player hints.
.TP
.B F9
Config, hardware, sound, AI chat.
.TP
.B F10
Full help (HTML, terminal, or by section).
.TP
.B Alt\-+0
Terminal log behind fzf.
.TP
.B Enter
Play / open. In the download queue: always ask which app and whether to use Tor
(last choices are only suggested next time).
.TP
.B Ctrl\-B
Download queue.
.TP
.B Ctrl\-D
Duplicates.
.TP
.B Ctrl\-F
Recursive search.
.TP
.B Ctrl\-G
Play history.
.TP
.B Ctrl\-H
Export HTML (selection or current screen).
.TP
.B Ctrl\-P
Cycle: dir → queues 1–3 → temp lists → history → duplicates → dir.
.TP
.B Q / Ctrl\-Q
Save session and quit.
.SH FILES
.TP
.I ~/.config/eazy/
Config, queues, session, selection.
.TP
.I ~/.config/eazy/tmp/
Temporary files (not system /tmp).
.TP
.I ~/.config/eazy/last_download_engine
Last download app (suggestion only).
.TP
.I ~/.config/eazy/last_download_tor
Last Tor yes/no (suggestion only).
.TP
.I /usr/share/man/man1/eazy.1.gz
This manual page.
.SH COMPANIONS
.TP
.B eazy\-tor
Magnet and \.torrent (optional \-\-tor).
.TP
.B eazy\-ai.py
AI chat (F9 → IA).
.TP
.B eazy\-notes\-editor
Quick notes (Ctrl\-N).
.SH SEE ALSO
.BR fzf (1),
.BR mpv (1),
.BR aria2c (1),
.BR yt\-dlp (1),
.BR torsocks (1).
.SH AUTHOR
John B Kersting

EAZY_MAN_EOF
    if sudo install -Dm644 "$MAN_TMP" /usr/share/man/man1/eazy.1; then
        sudo gzip -n -9 -f /usr/share/man/man1/eazy.1 2>/dev/null || true
        echo -e "\033[1;32m✓\033[0m Man page: /usr/share/man/man1/eazy.1.gz"
        command -v mandb &>/dev/null && sudo mandb -q 2>/dev/null || true
        # também deixa eazy.1 no doc do pacote se existir
