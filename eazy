    [ -n "$motor" ] && DOWNLOAD_ENGINE="$motor"
    tor=$(whiptail --title "Rede Tor" --radiolist "Tor deve estar ativo em 127.0.0.1:9050:" 10 70 2 "0" "Desligado (padrão)" $( [ "${DOWNLOAD_TOR:-0}" = 0 ] && echo ON || echo OFF ) "1" "Usar Tor SOCKS5" $( [ "${DOWNLOAD_TOR:-0}" = 1 ] && echo ON || echo OFF ) 3>&1 1>&2 2>&3) || return
    DOWNLOAD_TOR="${tor:-0}"
    aria=$(whiptail --title "Parâmetros aria2c" --inputbox "Parâmetros extras:" 9 75 "${DOWNLOAD_ARIA_ARGS:-}" 3>&1 1>&2 2>&3) || return
    axel=$(whiptail --title "Parâmetros Axel" --inputbox "Default: --insecure -n 4" 9 75 "${DOWNLOAD_AXEL_ARGS:---insecure -n 4}" 3>&1 1>&2 2>&3) || return
    wget=$(whiptail --title "Parâmetros Wget" --inputbox "Parâmetros extras:" 9 75 "${DOWNLOAD_WGET_ARGS:---no-check-certificate}" 3>&1 1>&2 2>&3) || return
    ytdlp=$(whiptail --title "Parâmetros yt-dlp" --inputbox "Parâmetros extras:" 9 75 "${DOWNLOAD_YTDLP_ARGS:-}" 3>&1 1>&2 2>&3) || return
    DOWNLOAD_ARIA_ARGS="$aria"; DOWNLOAD_AXEL_ARGS="$axel"; DOWNLOAD_WGET_ARGS="$wget"; DOWNLOAD_YTDLP_ARGS="$ytdlp"
    cat >> "$CONFIG_FILE" <<EOF
DOWNLOAD_ENGINE="$DOWNLOAD_ENGINE"
DOWNLOAD_TOR="$DOWNLOAD_TOR"
DOWNLOAD_ARIA_ARGS="$DOWNLOAD_ARIA_ARGS"
DOWNLOAD_AXEL_ARGS="$DOWNLOAD_AXEL_ARGS"
DOWNLOAD_WGET_ARGS="$DOWNLOAD_WGET_ARGS"
DOWNLOAD_YTDLP_ARGS="$DOWNLOAD_YTDLP_ARGS"
EOF
    whiptail --title "Downloads" --msgbox "Salvo.
Downloader: $DOWNLOAD_ENGINE
Tor: $([ "$DOWNLOAD_TOR" = 1 ] && echo ATIVO || echo desligado)" 9 60
}


