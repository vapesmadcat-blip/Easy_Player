# --- árvore HTML (expand all) ---
eazy_html_build_tree() {
    local tsv="$1" line path folder_url
    # Acrescenta a URI da pasta de cada item sem modificar o TSV original.
    while IFS= read -r line || [[ -n "$line" ]]; do
        [ -n "$line" ] || continue
        path="${line##*$'\t'}"
        folder_url=$(eazy_html_folder_url "$path" 2>/dev/null || true)
        printf '%s\t%s\n' "$line" "$folder_url"
    done < "$tsv" | awk -F '\t' '
    function esc(s,  t) {
        t = s
        gsub(/&/, "\\&amp;", t); gsub(/</, "\\&lt;", t); gsub(/>/, "\\&gt;", t); gsub(/"/, "\\&quot;", t)
        return t
    }
    function file_url(p,  u) {
        u = p
        gsub(/%/, "%25", u); gsub(/ /, "%20", u)
        return "file://" u
    }
    {
        bytes = $1 + 0
        # caminho: última coluna não vazia
        path = $(NF-1)
        folder_url = $NF
        if (path == "" || path == ".." || path ~ /Voltar/) next
        # tamanho legível simples
        if (bytes >= 1073741824) sz = sprintf("%.1f GB", bytes/1073741824)
        else if (bytes >= 1048576) sz = sprintf("%.1f MB", bytes/1048576)
        else if (bytes >= 1024) sz = sprintf("%.0f KB", bytes/1024)
        else sz = bytes " B"
        n = split(path, parts, "/")
        # paths absolutos começam com "" parts[1]
        key = ""
        for (i = 1; i <= n; i++) {
            if (parts[i] == "" && i == 1) continue
            parent = key
            if (key == "") key = "/" parts[i]
            else key = key "/" parts[i]
            if (!(key in seen_dir) && i < n) {
                seen_dir[key] = 1
                parent_of[key] = parent
                name_of[key] = parts[i]
                is_dir[key] = 1
                order[++nd] = key
            }
            if (i == n) {
                files[key] = 1
                f_parent[key] = parent
                f_name[key] = parts[i]
                f_sz[key] = sz
                f_url[key] = file_url(path)
                f_folder_url[key] = folder_url
                forder[++nf] = key
            }
        }
    }
    function emit_dir(d,    i, k, children) {
        if (emitted[d]++) return
        print "<details open class=\"tdir\">"
        print "<summary>" esc(name_of[d] == "" ? d : name_of[d]) "</summary>"
        for (i = 1; i <= nd; i++) {
            k = order[i]
            if (parent_of[k] == d) emit_dir(k)
        }
        for (i = 1; i <= nf; i++) {
            k = forder[i]
            if (f_parent[k] == d) {
                print "<div class=\"file\"><a href=\"" f_url[k] "\">" esc(f_name[k]) "</a>" \
                      "<a class=\"tree-folder-link\" target=\"_blank\" rel=\"noopener\" href=\"" esc(f_folder_url[k]) "\">Ir para a pasta</a>" \
                      "<span class=\"sz\">" f_sz[k] "</span></div>"
            }
        }
        print "</details>"
    }
    END {
        # raízes: dirs cujo parent não está em seen_dir (ou parent vazio)
        for (i = 1; i <= nd; i++) {
            k = order[i]
            p = parent_of[k]
            if (p == "" || !(p in seen_dir)) roots[++nr] = k
        }
        if (nr == 0) {
            # só ficheiros na raiz
            for (i = 1; i <= nf; i++) {
                k = forder[i]
                print "<div class=\"file\"><a href=\"" f_url[k] "\">" esc(f_name[k]) "</a>" \
                      "<a class=\"tree-folder-link\" target=\"_blank\" rel=\"noopener\" href=\"" esc(f_folder_url[k]) "\">Ir para a pasta</a>" \
                      "<span class=\"sz\">" f_sz[k] "</span></div>"
            }
        } else {
            for (i = 1; i <= nr; i++) emit_dir(roots[i])
        }
    }
    ' 2>/dev/null
}

