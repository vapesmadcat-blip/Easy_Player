                tor torsocks ffmpeg python3 xdg-utils yt-dlp 2>/dev/null || true
        # upgrade só dos que estão instalados
        instalados=()
        for p in "${PKGS_APT[@]}"; do
            dpkg -s "$p" &>/dev/null && instalados+=("$p")
        done
        if [ ${#instalados[@]} -gt 0 ]; then
            sudo apt-get install --only-upgrade -y "${instalados[@]}" 2>/dev/null || \
                sudo apt install --only-upgrade -y "${instalados[@]}" 2>/dev/null || true
        fi
        atualizou=1
    elif command -v pacman &>/dev/null; then
