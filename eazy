        whiptail --title "$(basename "$f") — leitura" --textbox "$f" 28 100 --scrolltext
        rc=$?
        restaurar_terminal
        return "$rc"
    fi
    cat -- "$f"
    printf '\nPressione Enter para voltar ou Esc para cancelar... '
    local tecla
    IFS= read -r -n1 -s tecla || true
    printf '\n'
    [ "$tecla" = $'\e' ] && return 1
    return 0
}

# Caminho completo do item sob o cursor (caminho = último campo da linha TAB).
eazy_path_from_row() {
    local row="${1:-}" path
    [ -n "$row" ] || return 0
    path="${row##*$'\t'}"
    [ "$path" = "$row" ] && path="$row"
    case "$path" in
        http://*|https://*) printf '%s\n' "$path"; return 0 ;;
        /*) printf '%s\n' "$path"; return 0 ;;
    esac
    readlink -f -- "$path" 2>/dev/null || printf '%s\n' "$path"
}

# Une o salvamento do cursor à atualização do rodapé para usar uma ação de foco só.
eazy_focus_update() {
    local idx="${1:-}" row="${2:-}"
    eazy_sync_cursor "$idx" "$row"
    eazy_path_from_row "$row"
}

