# Garante ~/.config/eazy/tmp — NUNCA /tmp do sistema
eazy_ensure_tmp() {
    local base="${CONFIG_DIR:-$HOME/.config/eazy}"
    local d="${base}/tmp"
    case "${EAZY_TMP_DIR:-}" in
        /tmp|/tmp/*|/var/tmp|/var/tmp/*) EAZY_TMP_DIR="" ;;
    esac
    case "${EAZY_TMP_DIR:-}" in
        "${base}"/*) d="$EAZY_TMP_DIR" ;;
    esac
    EAZY_TMP_DIR="$d"
    mkdir -p "$base" "$d" 2>/dev/null || true
    TMP_FILE="$d/fzf_tmp_$$"
    DUP_FILE="$d/fzf_dup_$$"
    DUP_SELECTED_FILE="$d/fzf_dup_selected_$$"
    DUP_FIXED_FILE="$d/fzf_dup_fixed_$$"
    DUP_MANUAL_FILE="$d/fzf_dup_manual_$$"
    LISTA_FZF_FILE="$d/eazy_lista_fzf_$$"
    EAZY_TERM_LOG="${EAZY_TERM_LOG:-$d/terminal.log}"
}

# selected_paths + .dirs + .local — nunca falhar com "Arquivo ou diretório inexistente"
eazy_ensure_selection() {
    local base="${CONFIG_DIR:-$HOME/.config/eazy}"
    mkdir -p "$base" "${EAZY_TMP_DIR:-$base/tmp}" 2>/dev/null || true
    if [ -z "${SELECTED_FILE:-}" ]; then
        if [ "${EAZY_IGNORE:-0}" = "1" ] || [ "${SEL_GLOBAL_OP:-1}" = "0" ]; then
            SELECTED_FILE="${EAZY_TMP_DIR:-$base/tmp}/eazy_selected_$$"
        else
            SELECTED_FILE="${base}/selected_paths"
        fi
    fi
    # se alguém apontou para path cujo pai não existe
    mkdir -p -- "$(dirname -- "$SELECTED_FILE")" 2>/dev/null || true
    SELECTED_DIRS_FILE="${SELECTED_FILE}.dirs"
    SELECTED_LOCAL_FILE="${SELECTED_FILE}.local"
    : >> "$SELECTED_FILE" 2>/dev/null || : > "$SELECTED_FILE" 2>/dev/null || true
    : >> "$SELECTED_DIRS_FILE" 2>/dev/null || : > "$SELECTED_DIRS_FILE" 2>/dev/null || true
    : >> "$SELECTED_LOCAL_FILE" 2>/dev/null || : > "$SELECTED_LOCAL_FILE" 2>/dev/null || true
}

