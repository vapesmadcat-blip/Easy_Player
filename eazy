                [ -n "$novo" ] && DOWNLOAD_DIR="$novo"
                ;;
            torrent)
                novo=$(whiptail --title "Pasta de Torrents" --inputbox \
                    "Destino padrão de .torrent e magnets (eazy-tor):" 10 72 "${TORRENT_DIR:-$HOME/Downloads/Torrents}" 3>&1 1>&2 2>&3) || continue
                [ -n "$novo" ] && TORRENT_DIR="$novo"
                ;;
            playlist)
                novo=$(whiptail --title "Pasta de Playlists" --inputbox \
                    "Onde salvar playlists permanentes (.m3u):" 10 72 "${PLAYLIST_DIR_PADRAO:-$HOME/Playlists}" 3>&1 1>&2 2>&3) || continue
                [ -n "$novo" ] && PLAYLIST_DIR_PADRAO="$novo"
