copiar_arquivos() {
    local selecao="$1"
    eazy_prepare_copy_move_selection "Copiar" "$selecao" || return 0
    selecao="$EAZY_PREPARED_SELECTION"
    local dest item linha item_abs existing duplicate source_real raw_items
    local detalhe necessario
    local -a sources=() filtered=()

    raw_items=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$' || true)
    while IFS= read -r item; do
        [ -z "$item" ] && continue
        item_abs=$(caminho_absoluto "$item")
        [ -n "$item_abs" ] || continue
        duplicate=0
        for existing in "${sources[@]}"; do
            if [ "$item_abs" = "$existing" ]; then
                duplicate=1
                break
            fi
            if [ -d "$existing" ] && [ ! -L "$existing" ] && eazy_copy_path_within "$item_abs" "$existing"; then
                duplicate=1
                break
            fi
        done
        [ "$duplicate" -eq 1 ] && continue

        # Se uma pasta pai também foi marcada, copiar só essa árvore uma vez.
        if [ -d "$item_abs" ] && [ ! -L "$item_abs" ]; then
            filtered=()
            for existing in "${sources[@]}"; do
                if eazy_copy_path_within "$existing" "$item_abs"; then
                    continue
                fi
                filtered+=("$existing")
            done
            sources=("${filtered[@]}")
        fi
        sources+=("$item_abs")
    done <<< "$raw_items"

    [ "${#sources[@]}" -gt 0 ] || {
        whiptail --title "Copiar" --msgbox "Nenhum arquivo ou diretório selecionado.\nUse TAB/ESPAÇO para marcar." 8 56
        return
    }
    local n="${#sources[@]}"
    local ultimo_destino=""
    [ -s "$LAST_COPY_DEST_FILE" ] && ultimo_destino=$(head -n1 "$LAST_COPY_DEST_FILE")
    dest=$(escolher_destino "Copiar" "$n" "$ultimo_destino") || return
    [ -z "$dest" ] || [ ! -d "$dest" ] && return
    dest=$(cd -- "$dest" 2>/dev/null && pwd -P) || return
    printf '%s\n' "$dest" > "$LAST_COPY_DEST_FILE"

    # Evita que uma cópia recursiva crie a saída dentro da própria origem.
    for item_abs in "${sources[@]}"; do
        if [ -d "$item_abs" ] && [ ! -L "$item_abs" ]; then
            source_real=$(cd -- "$item_abs" 2>/dev/null && pwd -P) || continue
            if eazy_copy_path_within "$dest" "$source_real"; then
                whiptail --title "Destino inválido" --msgbox \
                    "O destino está dentro de uma das pastas de origem.\n\nOrigem:\n$source_real\n\nDestino:\n$dest\n\nEscolha outra pasta para evitar uma cópia recursiva." 14 72
                return
            fi
        fi
    done

    detalhe=$(printf '%s\n' "${sources[@]}" | montar_detalhe_espaco)
    necessario=$(printf '%s\n' "${sources[@]}" | somar_selecao_bytes)
    verificar_espaco_disco "$necessario" "$dest" "Copiar" "$detalhe" || return
    if [ "${EAZY_NORMAL_COPY_MOVE:-0}" = 1 ]; then
        eazy_copy_preflight_conflicts "$dest" "${sources[@]}" || return
        eazy_copy_preflight_confirm "$dest" "$necessario" "$EAZY_COPY_PREFLIGHT_CONFLICTS" \
            "$EAZY_COPY_PREFLIGHT_SAMPLE" "$n" || return
    fi

    echo -e "\n\033[1;36m📋 Copiando $n item(ns) → $dest\033[0m"
    eazy_copy_selected_paths "$dest" "${sources[@]}"
    eazy_status_file_clear 2>/dev/null || true
    echo -e "\033[1;32mArquivos copiados: ${EAZY_COPY_COPIED:-0} | Pastas criadas: ${EAZY_COPY_DIRS:-0} | Sobrescritos: ${EAZY_COPY_OVERWRITTEN:-0} | Pulados: ${EAZY_COPY_SKIPPED:-0} | Falhas: ${EAZY_COPY_FAILED:-0}\033[0m"
    [ "${EAZY_COPY_CANCEL:-0}" = "1" ] && echo -e "\033[1;33mCópia interrompida; os itens já processados foram mantidos.\033[0m"
    sleep 1.5
}
# Move arquivos selecionados para um destino
mover_arquivos() {
    local selecao="$1"
    eazy_prepare_copy_move_selection "Mover" "$selecao" || return 0
    selecao="$EAZY_PREPARED_SELECTION"
    local dest itens n
    itens=$(echo "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$')
    n=$(echo "$itens" | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9')
    n=${n:-0}
    [ "$n" -eq 0 ] && {
        whiptail --title "Mover" --msgbox "Nenhum arquivo selecionado.\nUse TAB/ESPAÇO para marcar." 8 50
        return
    }

    local ultimo_destino=""
    [ -s "$LAST_MOVE_DEST_FILE" ] && ultimo_destino=$(head -n1 "$LAST_MOVE_DEST_FILE")
    dest=$(escolher_destino "Mover" "$n" "$ultimo_destino") || return
    [ -z "$dest" ] || [ ! -d "$dest" ] && return
    printf '%s\n' "$dest" > "$LAST_MOVE_DEST_FILE"

    # Move entre filesystems diferentes precisa do mesmo espaço que cópia
    local src_dev dst_dev
    src_dev=$(df -P . 2>/dev/null | tail -1 | awk '{print $1}')
    dst_dev=$(df -P "$dest" 2>/dev/null | tail -1 | awk '{print $1}')
    if [ -n "$src_dev" ] && [ -n "$dst_dev" ] && [ "$src_dev" != "$dst_dev" ]; then
        local detalhe necessario
        detalhe=$(printf '%s\n' "$itens" | montar_detalhe_espaco)
        necessario=$(printf '%s\n' "$itens" | somar_selecao_bytes)
        verificar_espaco_disco "$necessario" "$dest" "Mover (outro disco)" "$detalhe" || return
    fi

    echo -e "\n\033[1;33m📦 Movendo $n item(ns) → $dest\033[0m"
    local ok=0 falha=0
    while IFS= read -r item; do
        [ -z "$item" ] && continue
        item_abs=$(caminho_absoluto "$item")
        eazy_status_file "movendo" "$item_abs" "→ $dest" 2>/dev/null || true
        if mv -- "$item_abs" "$dest/" 2>/dev/null; then
            echo -e "  \033[1;32m✓\033[0m $(basename "$item_abs")"
            ok=$((ok + 1))
            if [ "${MODO_DUP:-0}" -eq 1 ] && [ -f "$DUP_FILE" ]; then
                grep -vF "$item_abs" "$DUP_FILE" > "${DUP_FILE}.tmp" 2>/dev/null && mv "${DUP_FILE}.tmp" "$DUP_FILE"
                eazy_dup_salvar_lista
            fi
        else
            echo -e "  \033[1;31m✗\033[0m $(basename "$item_abs")"
            falha=$((falha + 1))
        fi
    done <<< "$itens"
    echo -e "\033[1;32mMovidos: $ok\033[0m | \033[1;31mFalhas: $falha\033[0m"
    sleep 1.5
}

