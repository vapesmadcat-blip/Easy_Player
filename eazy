# --- WSL / caminho Windows para HTML ---
eazy_caminho_para_url_local() {
    # /mnt/c → file:///C:/...
    # /mnt/wsl/PHYSICALDRIVE... e /home → file://wsl.localhost/<distro>/...
    local p="$1" win="" distro abs drive rest
    [ -z "$p" ] && return 1
    if [[ "$p" != /* ]]; then
        p="$(pwd -P)/${p#./}"
    fi
    abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    p="$abs"
    win=""

    if command -v wslpath >/dev/null 2>&1; then
        win=$(wslpath -w -- "$p" 2>/dev/null || true)
        case "$win" in
            /mnt/*|/home/*|/usr/*) win="" ;;
        esac
    fi

    if [ -z "$win" ]; then
        case "$p" in
            /mnt/[a-zA-Z]/*)
                drive=$(printf '%s' "${p:5:1}" | tr '[:lower:]' '[:upper:]')
                rest="${p:7}"
                rest="${rest#/}"
                win=$(printf '%s:\\%s' "$drive" "${rest//\//\\}")
                ;;
            *)
                distro="${WSL_DISTRO_NAME:-}"
                if [ -z "$distro" ] && [ -r /etc/os-release ]; then
                    distro=$(. /etc/os-release 2>/dev/null; printf '%s' "${NAME:-Ubuntu}")
                    distro=$(printf '%s' "$distro" | awk '{print $1}')
                fi
                distro="${distro:-Ubuntu}"
                win=$(printf '\\\\wsl.localhost\\%s%s' "$distro" "${p//\//\\}")
                ;;
        esac
    fi

    win=${win//\\//}
    win=${win// /%20}
    win=${win//#/%23}
    win=${win//\?/%3F}

    case "$win" in
        //*|wsl.localhost/*|wsl\$/*)
            win=${win#/}
            win=${win#/}
            printf 'file://%s\n' "$win"
            ;;
        *)
            printf 'file:///%s\n' "$win"
            ;;
    esac
}

eazy_browser_cmd_exists() {
    # $1 = comando (pode ser path.exe)
    command -v "$1" >/dev/null 2>&1 && return 0
    # Windows: procura no PATH do WSL e pastas comuns
    case "$1" in
        *.exe)
            [ -x "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe" ] && [ "$1" = "chrome.exe" ] && return 0
            [ -x "/mnt/c/Program Files (x86)/Google/Chrome/Application/chrome.exe" ] && [ "$1" = "chrome.exe" ] && return 0
            [ -x "/mnt/c/Program Files/Microsoft/Edge/Application/msedge.exe" ] && [ "$1" = "msedge.exe" ] && return 0
            [ -x "/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe" ] && [ "$1" = "msedge.exe" ] && return 0
            [ -x "/mnt/c/Program Files/Mozilla Firefox/firefox.exe" ] && [ "$1" = "firefox.exe" ] && return 0
            [ -x "/mnt/c/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe" ] && [ "$1" = "brave.exe" ] && return 0
            ;;
