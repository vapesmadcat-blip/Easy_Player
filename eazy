    fi
    # O cache legado contém caminhos relativos (por exemplo, vids/y.mpg).
    # O snapshot precisa continuar abrindo mesmo depois de mudar de pasta.
    normalizar_snapshot_busca "${arquivo%.search}.results.tsv" "$(pwd -P)"
    whiptail --title "Pesquisa salva" --msgbox "Pesquisa salva como:\n$nome\n\nResultado congelado para reabrir sem refazer a busca." 9 65
}

