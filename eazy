    op=$(whiptail --title "TV Aberta · YouTube" --menu \
"Canais / lives públicos:" 18 70 9 \
        "tvbrasil" "TV Brasil" \
        "cultura"  "TV Cultura" \
        "camara"   "TV Câmara" \
        "senado"   "TV Senado" \
        "cnn"      "CNN Brasil" \
        "jp"       "Jovem Pan News" \
        "busca"    "Pesquisar ao vivo..." \
        "voltar"   "Voltar" \
        3>&1 1>&2 2>&3) || return 0
    case "$op" in
