    printf '%s\n' \
'# eazy — eval "$(/caminho/eazy --shell-init)"  ou  eazy --shell-init >> ~/.bashrc' \
"eazy() {" \
"  local _d" \
"  \"$_eazy_bin\" \"\$@\"" \
