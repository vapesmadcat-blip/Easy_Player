# Normaliza o caminho efetivo para proteger também XDG_CONFIG_HOME e caminhos com symlinks.
eazy_caminho_config_real() {
    realpath -m -- "${CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/eazy}" 2>/dev/null || return 1
}

# Retorna sucesso quando o caminho está dentro da configuração (inclusive ela).
eazy_caminho_dentro_config() {
    local alvo config
    alvo=$(realpath -m -- "$1" 2>/dev/null) || return 0
    config=$(eazy_caminho_config_real) || return 0
    [[ "$alvo" == "$config" || "$alvo" == "$config/"* ]]
}

# Retorna sucesso se apagar o alvo removeria qualquer parte da configuração.
eazy_caminho_protegido_config() {
    local alvo config
    alvo=$(realpath -m -- "$1" 2>/dev/null) || return 0
    config=$(eazy_caminho_config_real) || return 0
    [[ "$alvo" == "$config" || "$alvo" == "$config/"* || "$config" == "$alvo/"* ]]
}

eazy_filtrar_config_tsv() {
    local arquivo="$1" config tmp
    [ -f "$arquivo" ] || return 0
    config=$(eazy_caminho_config_real) || return 1
    tmp="${arquivo}.config-filter.$$"
    if ! "${PYTHON_CMD:-python3}" - "$config" "$arquivo" > "$tmp" <<'PYFILTER'
import os, sys
config = os.path.realpath(sys.argv[1])
prefix = config.rstrip(os.sep) + os.sep
with open(sys.argv[2], "r", encoding="utf-8", errors="surrogateescape") as src:
    for line in src:
        body = line.rstrip("\n")
        if not body:
            continue
        path = body.rsplit("\t", 1)[-1]
        real = os.path.realpath(path)
        if real == config or real.startswith(prefix):
            continue
        sys.stdout.write(line)
PYFILTER
    then
        rm -f -- "$tmp"
        return 1
    fi
    mv -f -- "$tmp" "$arquivo"
}

eazy_index_progress_write() {
    local file="$1" phase="$2" processed="$3" total="$4" path="$5"
    local tmp="${file}.$$.tmp"
    path="${path//$'\t'/ }"; path="${path//$'\n'/ }"; path="${path//$'\r'/ }"
    printf '%s\t%s\t%s\t%s\n' "$phase" "$processed" "$total" "$path" > "$tmp" && mv -f -- "$tmp" "$file"
}

eazy_index_progress_screen() {
    local fase="${1:-preparando}" feitos="${2:-0}" total="${3:-0}" atual="${4:-}" raiz="${5:-}"
    local elapsed="${6:-0}" frame="${7:-0}" cols path_max bar_width percent filled bar status stage clock spin md5_status progress_label
    local c_cyan=$'\033[1;36m' c_yellow=$'\033[1;33m' c_green=$'\033[1;32m' c_white=$'\033[1;37m' c_dim=$'\033[0;90m' c_reset=$'\033[0m'
    cols=$( { tput cols 2>/dev/null || echo 80; } | tr -cd '0-9' ); cols=${cols:-80}
    [ "$cols" -lt 64 ] && cols=64
    path_max=$((cols - 30)); [ "$path_max" -lt 28 ] && path_max=28
    bar_width=$((cols - 44)); [ "$bar_width" -gt 36 ] && bar_width=36; [ "$bar_width" -lt 16 ] && bar_width=16
    atual="${atual//$'\n'/ }"; atual="${atual//$'\r'/ }"; atual="${atual//$'\t'/ }"
    raiz="${raiz//$'\n'/ }"; raiz="${raiz//$'\r'/ }"; raiz="${raiz//$'\t'/ }"
    if [ "${#atual}" -gt "$path_max" ]; then atual="…${atual: -$((path_max - 1))}"; fi
    if [ "${#raiz}" -gt "$path_max" ]; then raiz="…${raiz: -$((path_max - 1))}"; fi
    feitos=$(printf '%s' "$feitos" | tr -cd '0-9'); feitos=${feitos:-0}
    total=$(printf '%s' "$total" | tr -cd '0-9'); total=${total:-0}
    elapsed=$(printf '%s' "$elapsed" | tr -cd '0-9'); elapsed=${elapsed:-0}
    printf -v clock '%02d:%02d' "$((elapsed / 60))" "$((elapsed % 60))"
    percent=0
    case "$fase" in
    verificando)
            stage="Conferindo o MD5 de cada diretório"
            md5_status="calculando"
            progress_label="Diretório em análise:"
            status="Pastas conferidas: $feitos · total ainda em contagem"
            spin='|/-\\'; spin="${spin:$((frame % 4)):1}"
            bar=$(printf '%*s' "$bar_width" '' | tr ' ' '-')
            filled=$((frame % bar_width)); bar="${bar:0:filled}#${bar:filled+1}"
            ;;
        assinando)
            stage="Gravando as assinaturas MD5 no SQLite"
            md5_status="gravando"
            progress_label="Diretório atualizado:"
            [ "$total" -gt 0 ] && percent=$((feitos * 100 / total))
            [ "$percent" -gt 99 ] && percent=99
            status="Diretórios registrados: $feitos de $total (${percent}%)"
            filled=$((percent * bar_width / 100))
            bar="$(printf '%*s' "$filled" '' | tr ' ' '#')$(printf '%*s' "$((bar_width - filled))" '' | tr ' ' '-')"
            ;;
        enumerando)
            stage="Localizando itens — uma única varredura recursiva"
            md5_status="preparando"
            progress_label="Diretório em análise:"
            status="Encontrados até agora: $feitos (o total aparece ao terminar esta etapa)"
            spin='|/-\\'; spin="${spin:$((frame % 4)):1}"
            bar=$(printf '%*s' "$bar_width" '' | tr ' ' '-')
            filled=$((frame % bar_width)); bar="${bar:0:filled}#${bar:filled+1}"
            ;;
        indexando)
            stage="Atualizando o índice SQLite"
            md5_status="aguardando gravação"
            progress_label="Item em indexação:"
            [ "$total" -gt 0 ] && percent=$((feitos * 100 / total))
            [ "$percent" -gt 99 ] && percent=99
            status="Processados: $feitos de $total itens (${percent}%)"
            filled=$((percent * bar_width / 100))
            bar="$(printf '%*s' "$filled" '' | tr ' ' '#')$(printf '%*s' "$((bar_width - filled))" '' | tr ' ' '-')"
            ;;
        limpando)
            stage="Conferindo registros antigos no SQLite"
            md5_status="aguardando gravação"
            progress_label="Pasta em conferência:"
            status="Registros examinados: $feitos (total não estimado)"
            spin='|/-\\'; spin="${spin:$((frame % 4)):1}"
            bar=$(printf '%*s' "$bar_width" '' | tr ' ' '-')
            filled=$((frame % bar_width)); bar="${bar:0:filled}#${bar:filled+1}"
            ;;
        concluido)
            stage="Atualização concluída"
            md5_status="salvo"
            progress_label="Ponto concluído:"
            percent=100
            status="Processados: $feitos de $total itens (100%)"
            bar=$(printf '%*s' "$bar_width" '' | tr ' ' '#')
            ;;
        erro)
            stage="A atualização encontrou um erro"
            md5_status="erro"
            progress_label="Diagnóstico:"
            status="Consulte o log da atualização para ver os detalhes."
            bar=$(printf '%*s' "$bar_width" '' | tr ' ' '-')
            ;;
        *)
            stage="Preparando a atualização"
            md5_status="preparando"
            progress_label="Ponto inicial:"
            status="Aguardando o início da varredura"
            spin='|/-\\'; spin="${spin:$((frame % 4)):1}"
            bar=$(printf '%*s' "$bar_width" '' | tr ' ' '-')
            filled=$((frame % bar_width)); bar="${bar:0:filled}#${bar:filled+1}"
            ;;
    esac
    {
        [ "${EAZY_INDEX_PROGRESS_DRAWN:-0}" = 1 ] && printf '\033[7A'
        printf '\r\033[2K%s╭─ EAZY · ATUALIZAÇÃO DO SQLITE ─────────────────────────%s\r\n' "$c_cyan" "$c_reset"
        printf '\r\033[2K  %sEtapa:%s %s\r\n' "$c_yellow" "$c_reset" "$stage"
        printf '\r\033[2K  %sPonto inicial:%s %s\r\n' "$c_dim" "$c_reset" "$raiz"
        printf '\r\033[2K  %sAtividade:%s %s\r\n' "$c_green" "$c_reset" "$status"
        printf '\r\033[2K  %s%s%s %s%s%s\r\n' "$c_dim" "$progress_label" "$c_reset" "$c_white" "$atual" "$c_reset"
        printf '\r\033[2K  %sTempo:%s %s · %sMD5/pasta:%s %s · Config: fora\r\n' "$c_dim" "$c_reset" "$clock" "$c_dim" "$c_reset" "$md5_status"
        printf '\r\033[2K  [%s] %s\r\n' "$bar" "$([[ "$fase" == "enumerando" || "$fase" == "verificando" || "$fase" == "preparando" || "$fase" == "limpando" ]] && printf '%s' "$spin" || printf '%s%%' "$percent")"
    } > /dev/tty 2>/dev/null || true
    EAZY_INDEX_PROGRESS_DRAWN=1
}

eazy_index_progress_clear() {
    local i
    {
        if [ "${EAZY_INDEX_PROGRESS_DRAWN:-0}" = 1 ]; then
            printf '\033[7A'
            for i in 1 2 3 4 5 6 7; do printf '\r\033[2K\r\n'; done
        fi
    } > /dev/tty 2>/dev/null || true
    EAZY_INDEX_PROGRESS_DRAWN=0
}

eazy_live_watch_pause_registered() {
    local resume_file="$1" registry root hidden status result i
    local -a items=()
    eazy_live_watch_migrate_legacy quiet || return 1
    registry=$(eazy_live_watch_registry)
    [ -f "$registry" ] || return 0
    mapfile -d '' -t items < "$registry"
    : > "$resume_file"
    for ((i=0; i+1<${#items[@]}; i+=2)); do
        root="${items[i]}"; hidden="${items[i+1]}"
        status=$(eazy_live_watch_root_status "$root")
        case "$status" in
            ATIVO\|*)
                result=$(eazy_live_watch_stop_root "$root" 2>&1) || {
                    printf 'Não foi possível parar %s: %s\n' "$root" "$result" >&2
                    return 1
                }
                printf '%s\0%s\0' "$root" "$hidden" >> "$resume_file"
                ;;
        esac
    done
}

eazy_live_watch_resume_registered() {
    local resume_file="$1" root hidden result i
    local -a paused=()
    [ -f "$resume_file" ] || return 0
    mapfile -d '' -t paused < "$resume_file"
    for ((i=0; i+1<${#paused[@]}; i+=2)); do
        root="${paused[i]}"; hidden="${paused[i+1]}"
        result=$(eazy_live_watch_start_root "$root" "$hidden" 2>&1) || \
            printf 'Não foi possível reativar %s: %s\n' "$root" "$result" >&2
    done
    rm -f -- "$resume_file"
}

