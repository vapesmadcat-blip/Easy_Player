            return 0
        }
        NF { printf "%s\t%09d\t%09d\t%s\n", $1, grupo($2), NR, $0 }
    ' | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2,2n -k3,3n | cut -f4-
