    f9_acao=$(whiptail --title "F9 — eazy ${EAZY_VERSION} · $agora" \
        --menu "Config · diagnóstico · seleção\nOP sel: $op_lab · IA: $ia_lab" 24 78 14 \
        "config" "Configurar o eazy (inclui downloads/Tor)" \
        "hotkeys" "Hotkeys — config completa de atalhos" \
        "hot_ctrl" "Ver atalhos CTRL" \
        "hot_alt" "Ver atalhos ALT" \
