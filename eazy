eazy_busca_nome_ou_ext_match() {
    local name="${1##*/}" token ext
    local criteria="${2:-}"
    name="${name,,}"
    [[ " $criteria " == *" TODAS "* || " ${criteria,,} " == *" todas "* ]] && return 0
    ext="${name##*.}"
    ext="${ext,,}"
    for token in $criteria; do
        token="${token,,}"
        [ -n "$token" ] || continue
        if [[ "$token" == .* && "$token" != *\** && "$token" != *\?* && "$token" != *\[* ]]; then
            token="${token#.}"
            [ "$ext" = "$token" ] && return 0
        elif [[ "$token" == *\** || "$token" == *\?* || "$token" == *\[* || "$token" == *.* ]]; then
            [[ "$name" == $token ]] && return 0
        else
            [ "$ext" = "$token" ] && return 0
        fi
    done
    return 1
}

# Confere o resumo (quantidade/tamanho) e as assinaturas locais; sincroniza
# somente os filhos imediatos da pasta quando entrar nela, nunca em cada tecla.
eazy_index_sync_directory() {
    local dir="$1" result tag changed removed revived files bytes watch_info watch_root watch_queue
    local -a watch_args=()
    [ -f "${EAZY_INDEXER:-}" ] || return 0
    command -v "${PYTHON_CMD:-python3}" >/dev/null 2>&1 || return 0
    mkdir -p "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    if watch_info=$(eazy_live_watch_covering_root "$dir" 2>/dev/null); then
        IFS=$'\t' read -r watch_root watch_queue <<< "$watch_info"
        [ -n "$watch_root" ] && [ -n "$watch_queue" ] && \
            watch_args=(--watch-covered-root "$watch_root" --watch-queue-dir "$watch_queue")
    fi
    result=$("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
        --sync-dir "$dir" --exclude-path "$(eazy_caminho_config_real)" \
        "${watch_args[@]}" \
        2>>"${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}/index-dir-sync.log") || return 1
    IFS=$'\t' read -r tag changed removed revived files bytes <<< "$result"
    [ "$tag" = "SYNC" ] || return 1
    changed=${changed:-0}; removed=${removed:-0}; revived=${revived:-0}
    if [ "$changed" -gt 0 ] || [ "$removed" -gt 0 ] || [ "$revived" -gt 0 ]; then
        eazy_lista_cache_invalidate
    fi
    return 0
}

# A tabela só é criada durante a migração; antes disso a primeira entrada é bloqueada.
eazy_history_table_exists() {
    [ -f "${EAZY_INDEX_DB:-}" ] || return 1
    "${PYTHON_CMD:-python3}" - "$EAZY_INDEX_DB" <<'PY' >/dev/null 2>&1
import sqlite3,sys
con=sqlite3.connect(sys.argv[1],timeout=2)
ok=con.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_state'").fetchone()
con.close()
raise SystemExit(0 if ok else 1)
PY
}

# Migra uma única vez. O arquivo legado é preservado e não é truncado.
eazy_history_migrate_on_entry() {
    eazy_history_table_exists && return 0
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "Histórico — migração necessária" --msgbox \
            "O histórico ainda não foi migrado para o banco SQLite.\\n\\nO Easy vai recriar history_items lendo cada linha do arquivo original:\\n$HISTORY_FILE\\n\\nO arquivo será mantido intacto; não haverá conversão nem substituição de caracteres.\\n\\nA primeira entrada apenas migra. Quando terminar, entre novamente em Histórico." 14 76 || true
    else
        printf '%s\\n' "Histórico ainda não migrado. Migrando para o SQLite..." >&2
    fi
    [ -f "${HISTORY_FILE:-}" ] || : > "$HISTORY_FILE"
    if ! "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --history-sync-file "$HISTORY_FILE" >/dev/null 2>&1; then
        if command -v whiptail >/dev/null 2>&1; then
            whiptail --title "Falha na migração do histórico" --msgbox "Não foi possível recriar history_items. O arquivo original continua preservado. Verifique Python 3, permissões e eazy-index.py; depois tente Ctrl+G novamente." 11 74 || true
        else
            echo "Falha ao importar o histórico; arquivo original preservado." >&2
        fi
        return 1
    fi
    return 1
}

# Depois da migração, todos os caminhos vêm da tabela, nunca do arquivo legado.
eazy_history_bulk_lookup() {
    local out="$1"
    : > "$out"
    eazy_history_table_exists || return 0
    "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --history-lookup > "$out" 2>/dev/null || :
}

eazy_history_db_count() {
    eazy_history_table_exists || { printf '0'; return 0; }
    "${PYTHON_CMD:-python3}" - "$EAZY_INDEX_DB" <<'PY' 2>/dev/null || printf '0'
import sqlite3,sys
con=sqlite3.connect(sys.argv[1]); print(con.execute('SELECT count(*) FROM history_items').fetchone()[0]); con.close()
PY
}

# A navegação normal usa exclusivamente o índice SQLite. Só o modo anônimo usa find.
eazy_lista_diretorio_fonte() {
    local root extq qtmp errtmp rc error_file
    root=$(pwd -P 2>/dev/null || pwd)
    extq="TODAS"
    case "${FILTRO_ATUAL:-ambos}" in
        videos) extq="mp4 mkv avi mov webm wmv flv m4v mpg mpeg m2ts" ;;
        audios) extq="mp3 m4a wav flac ogg opus aac wma" ;;
        imgs) extq="jpg jpeg png gif webp bmp tif tiff svg" ;;
        compactados) extq="zip tar gz bz2 xz rar 7z" ;;
        ambos) extq="mp4 mkv avi mov webm wmv flv m4v mp3 m4a wav flac ogg opus jpg jpeg png gif webp bmp zip tar gz bz2 xz rar 7z m3u pls m3u8 txt" ;;
    esac
    qtmp="${EAZY_TMP_DIR}/eazy_dir_query_$$"
    error_file="${EAZY_INDEX_QUERY_ERROR_FILE:-${EAZY_TMP_DIR}/index-query-error-$$}"
    if [ "${EAZY_IGNORE:-0}" = "1" ]; then
        find "${find_args[@]}" -printf "%s\t%T@\t%y\t%f\t%p\t\n" 2>/dev/null
        return $?
    fi
    if [ ! -f "${EAZY_INDEXER:-}" ] || ! command -v "${PYTHON_CMD:-python3}" >/dev/null 2>&1 || [ ! -f "${EAZY_INDEX_DB:-}" ]; then
        printf 'SQLite indisponível: indexador, Python ou banco ausente.\nRaiz: %s\nBanco: %s\nIndexador: %s\n' \
            "$root" "${EAZY_INDEX_DB:-}" "${EAZY_INDEXER:-}" > "$error_file"
        return 2
    fi
    local -a qargs=(--db "$EAZY_INDEX_DB" --query --root "$root" --direct --include-dirs --ext "$extq"
        --exclude-path "$(eazy_caminho_config_real)")
    [ "${SHOW_DELETED:-0}" = "1" ] && qargs+=(--show-deleted)
    errtmp="${qtmp}.err"
    if "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" "${qargs[@]}" > "$qtmp" 2>"$errtmp"; then
        cat "$qtmp"
        rm -f "$qtmp" "$errtmp" "$error_file"
        return 0
    else
        rc=$?
    fi
    {
        printf 'Consulta SQLite falhou (código %s).\nRaiz: %s\nBanco: %s\n' "$rc" "$root" "$EAZY_INDEX_DB"
        cat "$errtmp" 2>/dev/null || true
    } > "$error_file"
    rm -f "$qtmp" "$errtmp"
    return "$rc"
}

eazy_index_mark_deleted() {
    local p="$1"
    [ -n "$p" ] && [ -f "${EAZY_INDEX_DB:-}" ] && [ -f "${EAZY_INDEXER:-}" ] || return 0
