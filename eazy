}

# Sincroniza a posição real do fzf, inclusive Page Down/Page Up/Home/End.
# {n} é o índice zero-based do item atualmente focado; {2} é a linha inteira.
eazy_sync_cursor() {
    local idx="${1:-}" linha="${2:-}" item=""
    eazy_ensure_tmp
    [ -n "${TMP_FILE:-}" ] || TMP_FILE="${EAZY_TMP_DIR}/fzf_tmp_$$"
    idx=$(printf '%s' "$idx" | LC_ALL=C tr -cd '0-9')
    [ -n "$idx" ] || return 0
    TMP=$((idx + 1))
    if ! eazy_eh_navegacao "$linha"; then
        item=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    fi
    IFS='|' read -r _old_tmp _old_alvo _old_item _old_dir _old_modo < "$TMP_FILE" 2>/dev/null || true
    printf "%s|%s|%s|%s|%s\n" "$TMP" "${_old_alvo:-$ALVO}" "$item" "${_old_dir:-$ULTIMO_DIR}" "${_old_modo:-${MODO_PLAYLIST:-0}}" > "$TMP_FILE"
}

