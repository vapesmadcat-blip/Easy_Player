        else
            engine_pick=$(whiptail --title "Download — escolher app" --radiolist \
                "Link (não torrent):\n${link_alvo:0:58}\n\nSempre pergunta. Sugestão: ${last_eng}" 17 74 4 \
                "aria" "aria2c (multi-conexão)" "$on_aria" \
                "axel" "Axel" "$on_axel" \
                "wget" "Wget" "$on_wget" \
