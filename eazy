    eazy_ensure_selection
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    grep -Fxq -- "$dir" "$SELECTED_DIRS_FILE" 2>/dev/null || printf '%s\n' "$dir" >> "$SELECTED_DIRS_FILE"
    tmp_new="${SELECTED_FILE}.new_$$"
    : > "$tmp_new"
    while IFS= read -r -d '' p; do
        [ -z "$p" ] && continue
        n=$((n + 1))
        printf '%s\n' "$p" >> "$tmp_new"
        [ $((n % 30)) -eq 0 ] && eazy_sel_progress "$n" "$n" "0" "$p" "expandir"
    done < <(find "$dir" -type f -print0 2>/dev/null)
    if [ -s "$tmp_new" ]; then
        cat "$SELECTED_FILE" "$tmp_new" 2>/dev/null | awk 'NF && !seen[$0]++' > "${SELECTED_FILE}.tmp"
        mv -f -- "${SELECTED_FILE}.tmp" "$SELECTED_FILE"
    fi
    rm -f "$tmp_new"
    eazy_sel_progress "$n" "$n" "0" "$dir" "expandir"
    eazy_sel_progress_end
    adicionar_selecao_local "$dir" 2>/dev/null || true
}

remover_selecao_diretorio() {
    local dir="$1" tmp="${SELECTED_FILE}.tmp" dirs_tmp="${SELECTED_DIRS_FILE}.tmp"
    local n=0 kept=0 total=0 p
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    grep -Fxv -- "$dir" "$SELECTED_DIRS_FILE" 2>/dev/null > "$dirs_tmp" || : > "$dirs_tmp"
    mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"
    total=$(grep -cve '^[[:space:]]*$' "$SELECTED_FILE" 2>/dev/null || echo 0)
    total=$(printf '%s' "$total" | tr -cd '0-9'); total=${total:-0}
    : > "$tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        n=$((n + 1))
        if [[ "$p" == "$dir"/* ]]; then
            : # removido da seleção
        else
            printf '%s\n' "$p" >> "$tmp"
            kept=$((kept + 1))
        fi
        if [ $((n % 50)) -eq 0 ] || [ "$n" -eq "$total" ]; then
            {
                printf '\r\033[K\033[1;33m▶ a remover da global  %s/%s  mantidos:%s\033[0m' "$n" "$total" "$kept"
            } > /dev/tty 2>/dev/null || true
        fi
    done < "$SELECTED_FILE"
    mv -f -- "$tmp" "$SELECTED_FILE"
    printf '\n' > /dev/tty 2>/dev/null || true
}

adicionar_selecao_local() {
    local p="$1" tmp="${SELECTED_LOCAL_FILE}.tmp"
    [ -z "$p" ] && return 0
    p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    grep -Fxq -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null || printf '%s\n' "$p" >> "$SELECTED_LOCAL_FILE"
}

remover_selecao_local() {
    local p="$1" tmp="${SELECTED_LOCAL_FILE}.tmp"
    p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    grep -Fxv -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null > "$tmp" || : > "$tmp"
    mv -f -- "$tmp" "$SELECTED_LOCAL_FILE"
}

reconstruir_selecao_local() {
    # Rápido: localiza só entradas deste dir em selected_paths (cache) — sem du/stat global
    local dir p rest
    eazy_ensure_selection
    dir=$(pwd -P 2>/dev/null || pwd)
    : > "$SELECTED_LOCAL_FILE"
    [ -n "$dir" ] || return 0
    if [ -s "${SELECTED_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            case "$p" in
                "${dir}/"*)
                    rest="${p#"${dir}/"}"
                    case "$rest" in
                        */*) ;;
                        *) printf '%s\n' "$p" ;;
                    esac
                    ;;
            esac
        done < "$SELECTED_FILE" >> "$SELECTED_LOCAL_FILE"
    fi
    if [ -s "${SELECTED_DIRS_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            case "$p" in
                "${dir}/"*)
                    rest="${p#"${dir}/"}"
                    case "$rest" in
                        */*) ;;
                        *) printf '%s\n' "$p" ;;
                    esac
                    ;;
                "$dir")
                    printf '%s\n' "$p"
                    ;;
            esac
        done < "$SELECTED_DIRS_FILE" >> "$SELECTED_LOCAL_FILE"
    fi
    if [ -s "$SELECTED_LOCAL_FILE" ]; then
        sort -u "$SELECTED_LOCAL_FILE" -o "$SELECTED_LOCAL_FILE" 2>/dev/null || true
    fi
}

eazy_toggle_global_item() {
    local linha="$1" p
    eazy_ensure_selection
    p=$(arquivo_selecao_global "$linha") || return 0
    if [ -d "$p" ]; then
        p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        if grep -Fxq -- "$p" "$SELECTED_DIRS_FILE" 2>/dev/null; then
            remover_selecao_diretorio "$p"
            remover_selecao_local "$p"
        else
            expandir_diretorio_selecao "$p"
            adicionar_selecao_local "$p"
        fi
    elif [ -f "$p" ]; then
        if grep -Fxq -- "$p" "$SELECTED_FILE" 2>/dev/null; then
            remover_selecao_global "$p"
            remover_selecao_local "$p"
        else
            adicionar_selecao_global "$p"
            adicionar_selecao_local "$p"
        fi
    fi
}

# Varre cada linha que o fzf devolveu como selecionada.
# Exclusivo da seleção normal: não usa nem toca em DUP_SELECTED_FILE.
eazy_commit_fzf_selected() {
    local linha p
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        if [ -d "$p" ]; then
            expandir_diretorio_selecao "$p"
        elif [ -f "$p" ]; then
            adicionar_selecao_global "$p"
        fi
    done
}

eazy_select_visible_global() {
    local linha p q="${1:-${FZF_QUERY:-}}"
    [ -f "${LISTA_FZF_FILE:-}" ] || return 0
    # LISTA_FZF_FILE contém a lista completa; Ctrl+A deve respeitar o filtro
    # atual, portanto percorre a mesma saída filtrada exibida pelo fzf.
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        if [ -d "$p" ]; then
            expandir_diretorio_selecao "$p"
        elif [ -f "$p" ]; then
            adicionar_selecao_global "$p"
        fi
    done < <(eazy_lista_filtrada "$q")
}

eazy_clear_local_selection() {
    local dir="$(pwd -P)" tmp="${SELECTED_FILE}.tmp" p
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [ "$(dirname -- "$p")" = "$dir" ] || printf '%s\n' "$p"
    done < "$SELECTED_FILE" > "$tmp"
    mv -f -- "$tmp" "$SELECTED_FILE"
    local dirs_tmp="${SELECTED_DIRS_FILE}.tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [[ "$p" == "$dir" || "$p" == "$dir"/* ]] || printf '%s\n' "$p"
    done < "$SELECTED_DIRS_FILE" > "$dirs_tmp"
    mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"
}

# Reconstrói a seleção do diretório atual a partir do conjunto devolvido pelo fzf.
# Preserva seleções de outras pastas e não acessa o estado de duplicados.
eazy_remark_local_selection() {
    local linha p p_abs dir
    dir=$(pwd -P)
    eazy_clear_local_selection
    : > "$SELECTED_LOCAL_FILE"
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        if [ -d "$p_abs" ]; then
            [ "$(dirname -- "$p_abs")" = "$dir" ] || continue
            expandir_diretorio_selecao "$p_abs"
            adicionar_selecao_local "$p_abs"
        elif [ -f "$p_abs" ]; then
            [ "$(dirname -- "$p_abs")" = "$dir" ] || continue
            adicionar_selecao_global "$p_abs"
            adicionar_selecao_local "$p_abs"
        fi
    done
}

# Monta lista de reprodução para Alt+Enter:
# usa a multi-seleção do fzf + a seleção persistente (SELECTED_FILE),
# porque reload (Ctrl-A/X etc.) apaga as marcas do fzf mas mantém a persistência.
eazy_playlist_alt_enter() {
    local dest="$1" linha p p_abs
    : > "$dest"
    [ -n "$dest" ] || return 1
    # 1) itens devolvidos pelo fzf (multi-select da sessão)
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
        [ -z "$p" ] && continue
        eazy_eh_navegacao "$linha" 2>/dev/null && continue
        [[ "$p" =~ \.\.$ ]] && continue
        p_abs=$(caminho_absoluto "$p" 2>/dev/null || printf '%s' "$p")
        p_abs=$(readlink -f -- "$p_abs" 2>/dev/null || printf '%s' "$p_abs")
        [ -f "$p_abs" ] || continue
        grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
    done
    # 2) seleção persistente global (fonte da verdade após reload)
    if [ -f "${SELECTED_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
            [ -f "$p_abs" ] || continue
            grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
        done < "$SELECTED_FILE"
    fi
}

# Expande a seleção com a persistência (mesma regra do Alt+Enter).
# INSERT, Del, Ctrl-K/Y/U/E usam isto — não altera Duplicados.
eazy_expandir_escolha_acoes() {
    local entrada="$1" tmp
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-sel-acoes.XXXXXX") || {
        printf '%s\n' "$entrada"
        return 1
    }
    printf '%s\n' "$entrada" | eazy_playlist_alt_enter "$tmp"
    if [ -s "$tmp" ]; then
        cat "$tmp"
    else
        printf '%s\n' "$entrada"
    fi
    rm -f "$tmp"
}

eazy_prune_selecao_global() {
    local tmp p
    [ -f "${SELECTED_FILE:-}" ] || return 0
    tmp="${SELECTED_FILE}.prune.tmp"
    : > "$tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [ -e "$p" ] || continue
        printf '%s\n' "$p" >> "$tmp"
    done < "$SELECTED_FILE"
    mv -f -- "$tmp" "$SELECTED_FILE"
    if [ -f "${SELECTED_DIRS_FILE:-}" ]; then
        tmp="${SELECTED_DIRS_FILE}.prune.tmp"
        : > "$tmp"
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            [ -d "$p" ] || continue
            printf '%s\n' "$p" >> "$tmp"
        done < "$SELECTED_DIRS_FILE"
        mv -f -- "$tmp" "$SELECTED_DIRS_FILE"
    fi
}

eazy_prune_lista_arquivo() {
    local lista="$1" tmp linha res
    [ -n "$lista" ] && [ -f "$lista" ] || return 0
    tmp="${lista}.prune.tmp"
    : > "$tmp"
    while IFS= read -r linha || [ -n "$linha" ]; do
        linha="${linha%$'\r'}"
        if [ -z "$linha" ] || [[ "$linha" =~ ^# ]]; then
            printf '%s\n' "$linha" >> "$tmp"
            continue
        fi
        res="$linha"
        if [[ "$linha" != /* ]] && [[ ! "$linha" =~ ^https?:// ]]; then
            res="$(dirname -- "$lista")/$linha"
        fi
        if [[ "$linha" =~ ^https?:// ]]; then
            printf '%s\n' "$linha" >> "$tmp"
            continue
        fi
        if [ -e "$linha" ] || [ -e "$res" ]; then
            printf '%s\n' "$linha" >> "$tmp"
        fi
    done < "$lista"
    mv -f -- "$tmp" "$lista"
}


