        registrar_status
        continue
    fi

    if [ -z "$escolha" ]; then
        continue
    fi

    primeiro_caminho=$(printf '%s\n' "$escolha" | head -n 1 | awk -F '\t' '{print $NF}')
    # Enter abre o item sob o cursor; as demais marcas continuam globais.
    if [ -n "${cursor_raw:-}" ] && [ "${tecla:-}" != "alt-enter" ]; then
        cursor_caminho=$(printf '%s\n' "$cursor_raw" | awk -F '\t' '{print $NF}')
        [ -n "$cursor_caminho" ] && primeiro_caminho="$cursor_caminho"
    fi

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_DOWNLOAD=0; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        link_alvo=$(echo "$escolha" | head -n 1 | awk -F '\t' '{print $NF}')
        linha_fila=$(grep "|$link_alvo|" "$DOWNLOAD_QUEUE" | head -n 1)
        engine=$(echo "$linha_fila" | cut -d'|' -f1)
        pass=$(echo "$linha_fila" | cut -d'|' -f3)
        tor_item=$(echo "$linha_fila" | cut -d'|' -f4)
        download_dir_item=$(echo "$linha_fila" | cut -d'|' -f5)
        # O checkbox do item tem prioridade: 0 desligado não herda Tor global.
        # Apenas filas antigas, sem quarto campo, usam o fallback global.
        if [ -z "$tor_item" ]; then
            tor_item="${DOWNLOAD_TOR:-0}"
        fi
        [ "$tor_item" = "1" ] || tor_item="0"

        if [ -z "$pass" ] && [ -f "$DOWNLOAD_PASSWORDS" ]; then
            pass=$(grep -F "$link_alvo|" "$DOWNLOAD_PASSWORDS" | tail -n1 | cut -d'|' -f2-)
        fi

        nome_esperado=$(obter_nome_do_link "$link_alvo")
        dir_antes=$(pwd)
        download_dir="${DOWNLOAD_DIR:-${HOME}/Downloads}"
        [ -n "$download_dir_item" ] && download_dir="$download_dir_item"
        tor_proxy="socks5://127.0.0.1:9050"
        read -r -a ARIA_EXTRA <<< "${DOWNLOAD_ARIA_ARGS:-}"
        read -r -a AXEL_EXTRA <<< "${DOWNLOAD_AXEL_ARGS:---insecure -n 4}"
        read -r -a WGET_EXTRA <<< "${DOWNLOAD_WGET_ARGS:---no-check-certificate}"
        read -r -a YTDLP_EXTRA <<< "${DOWNLOAD_YTDLP_ARGS:-}"
        TOR_PREFIX=()
        mkdir -p -- "$download_dir" || { echo "Não foi possível criar o destino: $download_dir"; read -p "Pressione Enter para continuar..."; continue; }

        # Sempre pergunta o app. Não fixa na fila — só lembra para sugerir depois.
        last_eng=""
        [ -s "${LAST_DOWNLOAD_ENGINE_FILE:-}" ] && last_eng=$(head -n1 "$LAST_DOWNLOAD_ENGINE_FILE" 2>/dev/null | tr -d '\r')
        [ -z "$last_eng" ] && last_eng="${engine:-${DOWNLOAD_ENGINE:-aria}}"
        [ -z "$last_eng" ] && last_eng="aria"
        is_torrent=0
        case "$link_alvo" in
            magnet:*|*.torrent|*.TORRENT) is_torrent=1 ;;
        esac
        on_aria=OFF; on_axel=OFF; on_wget=OFF; on_ytdlp=OFF; on_torrent=OFF
        case "$last_eng" in
            aria) on_aria=ON ;;
            axel) on_axel=ON ;;
            wget) on_wget=ON ;;
            ytdlp) on_ytdlp=ON ;;
            torrent) on_torrent=ON ;;
            *) on_aria=ON ;;
        esac
        if [ "$is_torrent" -eq 1 ]; then
            # torrent: se última não era torrent, sugere torrent
            if [ "$last_eng" != "torrent" ]; then
                on_aria=OFF; on_axel=OFF; on_wget=OFF; on_ytdlp=OFF; on_torrent=ON
