# --- Persistência: posição por diretório ---
# Chave de índice: pasta, playlist, histórico, fila, "dup", etc.
# Funciona para diretórios E para todas as listas (histórico, playlists, temporárias).

# Lê posição real do fzf (focus grava em TMP_FILE; shell vars podem estar velhas)

# Contexto para Alt+V: última lista (pesquisa, histórico, fila 1–3, dup, downloads, pasta)
eazy_capturar_contexto_volta() {
    local item="${1:-${ULTIMO_ARQUIVO:-}}"
    EAZY_VOLTA_KIND=""
    EAZY_VOLTA_PATH=""
    EAZY_VOLTA_ITEM="$item"
    EAZY_VOLTA_CWD="$(pwd -P 2>/dev/null || pwd)"
    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        EAZY_VOLTA_KIND="busca"
        EAZY_VOLTA_PATH="${BUSCA_ORIGEM:-$EAZY_VOLTA_CWD}"
    elif [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        EAZY_VOLTA_KIND="download"
        EAZY_VOLTA_PATH="${DOWNLOAD_QUEUE:-}"
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        EAZY_VOLTA_KIND="dup"
        EAZY_VOLTA_PATH="${DUP_LISTA:-dup}"
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -n "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        EAZY_VOLTA_KIND="playlist"
        EAZY_VOLTA_PATH="$ARQUIVO_PLAYLIST_ABERTO"
    else
        EAZY_VOLTA_KIND="dir"
        EAZY_VOLTA_PATH="$EAZY_VOLTA_CWD"
    fi
    export EAZY_VOLTA_KIND EAZY_VOLTA_PATH EAZY_VOLTA_ITEM EAZY_VOLTA_CWD
}

eazy_aplicar_contexto_volta() {
    # Restaura a última lista / pasta guardada por eazy_capturar_contexto_volta
    local kind="${EAZY_VOLTA_KIND:-}"
    local pth="${EAZY_VOLTA_PATH:-}"
    local item="${EAZY_VOLTA_ITEM:-}"
    [ -z "$kind" ] && return 1
    MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0
    MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
    EAZY_VOLTAR_PARA_BUSCA=0
    case "$kind" in
        busca)
            if [ -n "$pth" ] && [ -d "$pth" ]; then
                cd -- "$pth" 2>/dev/null || true
            fi
            MODO_BUSCA=1
            BUSCA_REMAKE=0
            [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
            ;;
        download)
            MODO_DOWNLOAD=1
            TMP=2
            ;;
        dup)
            MODO_DUP=1
            TMP=2
            eazy_dup_carregar_lista 2>/dev/null || true
            ;;
        playlist)
            if [ -n "$pth" ] && [ -f "$pth" ]; then
                MODO_PLAYLIST=1
                ARQUIVO_PLAYLIST_ABERTO="$pth"
                case "$pth" in
                    *temp_playlist_1) FILA_ATUAL=1 ;;
                    *temp_playlist_2) FILA_ATUAL=2 ;;
                    *temp_playlist_3) FILA_ATUAL=3 ;;
                esac
                atualizar_fila_atual 2>/dev/null || true
                carregar_posicao_dir "$pth"
                [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
            else
                return 1
            fi
            ;;
        dir)
            if [ -n "$pth" ] && [ -d "$pth" ]; then
                cd -- "$pth" 2>/dev/null || return 1
                carregar_filtro_dir "$(pwd -P)" 2>/dev/null || true
                carregar_posicao_dir "$(pwd -P)"
                [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
            else
                return 1
            fi
            ;;
        *) return 1 ;;
    esac
    ALVO="$(pwd -P 2>/dev/null || pwd)"
    ULTIMO_DIR="$ALVO"
    # limpa contexto (uma volta)
    EAZY_VOLTA_KIND=""
    EAZY_VOLTA_PATH=""
    return 0
}

eazy_ler_cursor_fzf() {
    eazy_ensure_tmp
    [ -f "${TMP_FILE:-}" ] || return 0
    local _t _a _u _d _m
    IFS='|' read -r _t _a _u _d _m < "$TMP_FILE" 2>/dev/null || return 0
    _t=$(printf '%s' "${_t:-}" | tr -cd '0-9')
    [ -n "$_t" ] && TMP="$_t"
    [ -n "${_u:-}" ] && ULTIMO_ARQUIVO="$_u"
    [ -n "${_d:-}" ] && ULTIMO_DIR="$_d"
    [ -n "${_a:-}" ] && ALVO="$_a"
}

# Normaliza item guardado na persistência (sempre absoluto se existir)
eazy_pos_item_norm() {
    local it="${1:-}"
    [ -z "$it" ] && { printf '%s\n' ""; return; }
    if [ -e "$it" ]; then
        readlink -f -- "$it" 2>/dev/null || printf '%s\n' "$it"
    else
        # relativo à pasta actual?
        if [ -e "./$it" ]; then
            readlink -f -- "./$it" 2>/dev/null || printf '%s\n' "$it"
        else
            printf '%s\n' "$it"
        fi
    fi
}

eazy_pos_chave() {
    local k="${1:-}"
    [ -z "$k" ] && { printf '%s\n' ""; return; }
    case "$k" in
        dup|download|downloads|busca)
            printf '%s\n' "$k"
            return
            ;;
    esac
    if [ -e "$k" ]; then
        readlink -f -- "$k" 2>/dev/null || printf '%s\n' "$k"
    else
        # caminho ainda não existente (lista vazia) — normaliza se parecer path
        if [[ "$k" == /* ]]; then
            printf '%s\n' "$k"
        else
            printf '%s\n' "$k"
        fi
    fi
}

salvar_posicao_dir() {
    [ "${EAZY_IGNORE:-0}" = "1" ] && return 0
    local dir="$1" pos="$2" item="${3:-}"
    [ -z "$dir" ] && return
    dir=$(eazy_pos_chave "$dir")
    [ -z "$dir" ] && return
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    if [ -n "$item" ]; then
        item=$(eazy_pos_item_norm "$item")
    fi
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    touch "$POSITIONS_FILE"
    # remove entrada antiga desta chave (campo 1)
    awk -F'|' -v d="$dir" '$1 != d' "$POSITIONS_FILE" 2>/dev/null > "${POSITIONS_FILE}.tmp" || true
    # formato: CHAVE|POS|ITEM
    printf '%s|%s|%s\n' "$dir" "$pos" "$item" >> "${POSITIONS_FILE}.tmp"
    grep -v '^$' "${POSITIONS_FILE}.tmp" 2>/dev/null | tail -n 800 > "$POSITIONS_FILE"
    rm -f "${POSITIONS_FILE}.tmp"
}

carregar_posicao_dir() {
    [ "${EAZY_IGNORE:-0}" = "1" ] && { TMP="${TMP:-1}"; return 0; }
    local dir="$1"
    [ -z "$dir" ] || [ ! -f "$POSITIONS_FILE" ] && { TMP="${TMP:-1}"; return; }
    dir=$(eazy_pos_chave "$dir")
    local linha pos item
    linha=$(awk -F'|' -v d="$dir" '$1 == d {line=$0} END {print line}' "$POSITIONS_FILE" 2>/dev/null)
    [ -z "$linha" ] && { TMP="${TMP:-1}"; ULTIMO_ARQUIVO=""; return; }
    pos=$(echo "$linha" | cut -d'|' -f2)
    item=$(echo "$linha" | cut -d'|' -f3-)
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    [ "$pos" -lt 1 ] && pos=1
    TMP="$pos"
    if [ -n "$item" ]; then
        ULTIMO_ARQUIVO=$(eazy_pos_item_norm "$item")
        [ -z "$ULTIMO_ARQUIVO" ] && ULTIMO_ARQUIVO="$item"
    else
        ULTIMO_ARQUIVO=""
    fi
}

# Índice atual da lista ativa (pasta / playlist / histórico / fila / dup)
eazy_chave_lista_atual() {
    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        printf '%s\n' "${DOWNLOAD_QUEUE:-download}"
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        printf '%s\n' "dup"
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -n "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        printf '%s\n' "$ARQUIVO_PLAYLIST_ABERTO"
    elif [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        printf '%s\n' "busca"
