eh_arquivo_html() {
    local f="$1" base ext
    [ -z "$f" ] && return 1
    # URL apontando para html
    if [[ "$f" =~ ^https?:// ]] && [[ "$f" =~ \.(html?|xhtml)([?#]|$) ]]; then
        return 0
    fi
    [ ! -f "$f" ] && return 1
    base="${f##*/}"
    ext="${base##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    case "$ext" in html|htm|xhtml) return 0 ;; esac
    # MIME fallback
    if command -v file >/dev/null 2>&1; then
        case "$(file -b --mime-type -- "$f" 2>/dev/null)" in
            text/html|application/xhtml+xml) return 0 ;;
        esac
    fi
    return 1
}

eazy_spawn_open() {
    local u="$1" c
    [ -z "$u" ] && return 1
    for c in xdg-open gio gnome-open kde-open exo-open sensible-browser \
             firefox firefox-esr chromium-browser chromium google-chrome brave-browser midori; do
        command -v "$c" >/dev/null 2>&1 || continue
        case "$c" in
            gio)      ( gio open "$u" >/dev/null 2>&1 & ) ;;
            xdg-open) ( xdg-open "$u" >/dev/null 2>&1 & ) ;;
            *)        ( "$c" "$u" >/dev/null 2>&1 & ) ;;
        esac
        return 0
    done
    return 1
}

abrir_html_ou_link() {
    local alvo="$1" abs escolha
    [ -z "$alvo" ] && return 1

    if [[ "$alvo" =~ ^https?:// ]]; then
        escolha=$(whiptail --title "Link detectado" --menu "\n$alvo\n\nO que deseja fazer?" 16 72 3 \
            "browser" "Abrir no browser" \
            "download" "Adicionar à fila de downloads (Ctrl+B)" \
            "cancel" "Cancelar" \
            3>&1 1>&2 2>&3) || return 0
        case "$escolha" in
            browser)
                eazy_spawn_open "$alvo" && return 0
                whiptail --title "Abrir link" --msgbox "Não abriu o browser.\n\n$alvo\n\nInstale: sudo apt install xdg-utils" 12 60 2>/dev/null || true
                return 1
                ;;
            download)
                # Reusa fluxo de adicionar download com link pré-preenchido
                if type adicionar_download >/dev/null 2>&1; then
                    EAZY_PREFILL_URL="$alvo" adicionar_download
                else
                    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
                    touch "$DOWNLOAD_QUEUE"
                    echo "ytdlp|$alvo|" >> "$DOWNLOAD_QUEUE"
                    whiptail --title "Downloads" --msgbox "Adicionado à fila (yt-dlp):\n$alvo" 10 70
                fi
                return 0
                ;;
            *) return 0 ;;
        esac
    fi
    if [[ "$alvo" =~ ^file:// ]]; then
        eazy_spawn_open "$alvo" && return 0
        whiptail --title "Abrir link" --msgbox "Não abriu o browser.\n\n$alvo\n\nInstale: sudo apt install xdg-utils" 12 60 2>/dev/null || true
        return 1
    fi

    if [ -f "$alvo" ]; then
        abs=$(readlink -f -- "$alvo" 2>/dev/null || realpath -- "$alvo" 2>/dev/null || printf '%s' "$alvo")
    else
        abs=$(caminho_absoluto "$alvo" 2>/dev/null || printf '%s' "$alvo")
    fi
    [ -f "$abs" ] || return 1

    eazy_spawn_open "$abs" && return 0
    eazy_spawn_open "file://$abs" && return 0
    [ "$abs" != "$alvo" ] && eazy_spawn_open "$alvo" && return 0

    if type mostrar_texto >/dev/null 2>&1; then
        mostrar_texto "$abs"
        return 0
    fi
    whiptail --title "Abrir HTML" --msgbox "Não foi possível abrir:\n$abs\n\nInstale xdg-utils ou um browser." 11 60 2>/dev/null || true
    return 1
}


eazy_clear_global_confirm() {
    local n=0 bytes=0 p sz msg dirs=0 total=0 done=0 lab
    eazy_ensure_selection
    if [ -f "${SELECTED_FILE:-}" ]; then
        total=$(grep -cve '^[[:space:]]*$' "$SELECTED_FILE" 2>/dev/null || echo 0)
        total=$(printf '%s' "$total" | tr -cd '0-9'); total=${total:-0}
        {
            printf '\n\033[1;36m── Contando seleção global ──\033[0m\n'
        } > /dev/tty 2>/dev/null || true
        while IFS= read -r p || [ -n "$p" ]; do
            [ -z "$p" ] && continue
            n=$((n + 1))
            done=$n
            if [ -e "$p" ]; then
                sz=$(stat -c%s -- "$p" 2>/dev/null || du -sb -- "$p" 2>/dev/null | awk '{print $1}')
                sz=$(printf '%s' "${sz:-0}" | tr -cd '0-9'); sz=${sz:-0}
                bytes=$((bytes + sz))
            fi
            if [ $((n % 25)) -eq 0 ] || [ "$n" -eq "$total" ]; then
                lab=$(formatar_bytes_label "$bytes" 2>/dev/null || echo "$bytes B")
                {
                    printf '\r\033[K\033[1;33m▶ %s/%s\033[0m  %s  \033[0;90m%s\033[0m' \
                        "$n" "$total" "$lab" "${p: -60}"
                } > /dev/tty 2>/dev/null || true
            fi
        done < "$SELECTED_FILE"
        printf '\n' > /dev/tty 2>/dev/null || true
    fi
    if [ -f "${SELECTED_DIRS_FILE:-}" ]; then
        dirs=$(grep -cve '^[[:space:]]*$' "$SELECTED_DIRS_FILE" 2>/dev/null || echo 0)
        dirs=$(printf '%s' "$dirs" | tr -cd '0-9')
        dirs=${dirs:-0}
    fi
    if [ "$n" -eq 0 ] && [ "${dirs:-0}" -eq 0 ]; then
        whiptail --title "Seleção global" --msgbox "Seleção global vazia.\nNada a limpar." 8 45 2>/dev/null || true
        return 0
    fi
    msg="Zerar a seleção global?\n\n"
    msg+="Arquivos/itens: $n\n"
    msg+="Tamanho acum.: $(formatar_bytes_label "$bytes")"
    if [ "${dirs:-0}" -gt 0 ]; then
        msg+="\nDirs marcados: $dirs"
    fi
    msg+="\n\nIsso só desmarca — não apaga do disco."
    if whiptail --title "Limpar seleção global" --yesno "$msg" 14 60; then
        {
            printf '\033[1;33m▶ limpando seleção… %s itens · %s\033[0m\n' \
                "$n" "$(formatar_bytes_label "$bytes" 2>/dev/null || echo "$bytes")"
        } > /dev/tty 2>/dev/null || true
        : > "$SELECTED_FILE"
        [ -n "${SELECTED_DIRS_FILE:-}" ] && : > "$SELECTED_DIRS_FILE"
        [ -n "${SELECTED_LOCAL_FILE:-}" ] && : > "$SELECTED_LOCAL_FILE"
        rm -f "${SELECTED_FILE}.bytes" 2>/dev/null || true
        {
            printf '\033[1;32m✓ limpo  0/%s  0 B\033[0m\n' "$n"
        } > /dev/tty 2>/dev/null || true
        whiptail --title "Seleção global" --msgbox "Seleção limpa.\n\nAntes: $n itens\n$(formatar_bytes_label "$bytes")" 10 50 2>/dev/null || true
    fi
}

