    if [ -t 1 ] && command -v whiptail &>/dev/null; then
        whiptail --title "eazy ${EAZY_VERSION} — Ajuda" --msgbox "\
eazy ${EAZY_VERSION} (${EAZY_CODENAME})

Uso: eazy [pasta|arquivo]

