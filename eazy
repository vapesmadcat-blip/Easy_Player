# Compat: exportar pesquisa (usa cache TSV se origem vazia)
exportar_pesquisa_html() {
    local origem_tsv="$1"
    local titulo="${2:-pesquisa}"
    local criterios="${3:-}"

    if [[ -z "$origem_tsv" || ! -f "$origem_tsv" ]]; then
        local chave_cache cache_resultado
        chave_cache=$(chave_cache_busca 2>/dev/null || true)
        cache_resultado="${BUSCA_CACHE_DIR}/${chave_cache}.tsv"
        if [[ -f "$cache_resultado" ]]; then
            origem_tsv="$cache_resultado"
        else
            exportar_tela_html
            return $?
        fi
    fi
    exportar_lista_html "$origem_tsv" "$titulo" "$criterios" "Resultado da pesquisa"
}

# Exporta seleção (se houver) ou o conteúdo da tela. Atalho: Ctrl-H
exportar_tela_html() {
    local tmp titulo crit modo_lbl escopo=""
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-tela-html.XXXXXX") || return 1

    eazy_capturar_export_tsv "$tmp" escopo || {
        rm -f "$tmp"
        whiptail --title "Exportar HTML" --msgbox "Não foi possível capturar os itens." 8 55
        return 1
    }

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        titulo="pesquisa"
        modo_lbl="Pesquisa"
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        titulo="duplicados"
        modo_lbl="Duplicados"
    elif [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        titulo="downloads"
        modo_lbl="Fila de downloads"
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        titulo="lista-$(basename -- "${ARQUIVO_PLAYLIST_ABERTO:-lista}" 2>/dev/null || echo lista)"
        modo_lbl="Lista/Playlist"
    else
        titulo="navegador-$(basename -- "$(pwd -P)" 2>/dev/null || echo pasta)"
        modo_lbl="Navegador"
    fi
    case "$escopo" in
        *[Ss]ele[cç]*) titulo="${titulo}-selecao" ;;
        *) [ -n "${FZF_QUERY:-}" ] && titulo="${titulo}-filtro" ;;
    esac

    crit=$(eazy_criterios_tela_atual "$escopo")
    exportar_lista_html "$tmp" "$modo_lbl — $titulo" "$crit" "$escopo"
    local rc=$?
    rm -f "$tmp"
    return "$rc"
}




normalizar_snapshot_busca() {
    local arquivo="$1" base="${2:-$(pwd -P)}" tmp abs
    [ -f "$arquivo" ] || return 0
    tmp="${arquivo}.tmp.$$"
    : > "$tmp" || return 1
    while IFS=$'\t' read -r bytes mtime tipo nome caminho; do
        [ -z "$caminho" ] && continue
        if [[ "$caminho" == /* ]]; then
            abs="$caminho"
        else
            abs=$(cd -- "$base" 2>/dev/null && caminho_absoluto "$caminho") || abs="$caminho"
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$bytes" "$mtime" "$tipo" "$nome" "$abs" >> "$tmp"
    done < "$arquivo"
    mv -f "$tmp" "$arquivo"
}
caminho_absoluto_busca() {
    local p="$1" base="${BUSCA_ORIGEM:-$(pwd -P)}"
    [ -n "$p" ] || return 1
    if [[ "$p" == /* ]]; then
        printf '%s\n' "$p"
    elif [ -d "$base" ]; then
        (cd -- "$base" && caminho_absoluto "$p")
    else
        caminho_absoluto "$p"
    fi
}
carregar_pesquisa_salva() {
    [ -d "$SAVED_SEARCHES_DIR" ] || return 1
    local opcoes=() arq escolha nome
    while IFS= read -r arq; do
        [ -f "$arq" ] || continue
        nome=$(basename "$arq" .search)
        opcoes+=("$nome" "Pesquisa salva")
    done < <(find "$SAVED_SEARCHES_DIR" -maxdepth 1 -type f -name '*.search' -print 2>/dev/null | sort)
    [ "${#opcoes[@]}" -gt 0 ] || return 1
    escolha=$(whiptail --title "Pesquisas salvas" --menu "Escolha uma pesquisa:" 18 70 8 "${opcoes[@]}" 3>&1 1>&2 2>&3) || return 1
    [ -n "$escolha" ] || return 1
    acao_ps=$(whiptail --title "Pesquisa: $escolha" --menu "O que deseja fazer?" 13 60 3 \
        "A" "Abrir pesquisa" \
        "H" "Exportar esta pesquisa para HTML" \
        "C" "Cancelar" 3>&1 1>&2 2>&3) || return 1
    if [ "$acao_ps" = "H" ]; then
        local snap="$SAVED_SEARCHES_DIR/$escolha.results.tsv"
        local crit=""
        if [ -f "$SAVED_SEARCHES_DIR/$escolha.search" ]; then
            # shellcheck disable=SC1090
            source "$SAVED_SEARCHES_DIR/$escolha.search" 2>/dev/null || true
            crit="Extensão: ${EXT_BUSCA:-qualquer}\nTamanho: ${BUSCA_TAM_LABEL:-qualquer}\nConteúdo: ${BUSCA_CONTEUDO:-—}\nOrigem: ${BUSCA_ORIGEM:-—}"
        fi
        exportar_pesquisa_html "$snap" "$escolha" "$crit"
        return 1
    fi
    [ "$acao_ps" = "A" ] || return 1
    arq="$SAVED_SEARCHES_DIR/$escolha.search"
    # Arquivos são gerados pelo próprio eazy; carregam as variáveis e o snapshot.
    # shellcheck disable=SC1090
    source "$arq" 2>/dev/null || return 1
    # Older .search files stored the snapshot as a relative filename. Resolve
    # that reference against the directory containing the saved search, not
    # against the directory from which eazy was launched.
    local pesquisa_dir snapshot_ref origem_ref
    pesquisa_dir=$(cd -- "$(dirname -- "$arq")" 2>/dev/null && pwd -P) || pesquisa_dir="$SAVED_SEARCHES_DIR"
    origem_ref="${BUSCA_ORIGEM:-$(pwd -P)}"
    if [[ "$origem_ref" != /* ]]; then
        origem_ref="$pesquisa_dir/$origem_ref"
    fi
    if [ -d "$origem_ref" ]; then
        BUSCA_ORIGEM=$(cd -- "$origem_ref" 2>/dev/null && pwd -P) || BUSCA_ORIGEM="$origem_ref"
    else
        BUSCA_ORIGEM="$origem_ref"
    fi
    snapshot_ref="${BUSCA_RESULTADO_FILE:-${arq%.search}.results.tsv}"
    if [[ "$snapshot_ref" == /* ]]; then
        BUSCA_SNAPSHOT_FILE="$snapshot_ref"
    else
        BUSCA_SNAPSHOT_FILE="$pesquisa_dir/$snapshot_ref"
    fi
    # Migra snapshots antigos que ainda guardam o caminho relativo.
    normalizar_snapshot_busca "$BUSCA_SNAPSHOT_FILE" "${BUSCA_ORIGEM:-$(pwd -P)}"
    BUSCA_REMAKE=0
    if whiptail --title "Pesquisa salva" --yesno "Abrir o resultado salvo sem refazer a pesquisa?\n\nSim = usar o resultado congelado\nNão = refazer agora (remake)" 12 70; then
        :
    else
        BUSCA_SNAPSHOT_FILE=""
        BUSCA_REMAKE=1
    fi
    MODO_BUSCA=1
    return 0
}
MODO_DUP=0
MODO_DOWNLOAD=0
