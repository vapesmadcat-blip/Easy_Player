    if [ "${EAZY_IGNORE:-0}" = "1" ]; then
        case "$table" in
            temp_playlist_2) n=$(grep -c '^' "$PLAYLIST_2" 2>/dev/null || echo 0) ;;
            temp_playlist_3) n=$(grep -c '^' "$PLAYLIST_3" 2>/dev/null || echo 0) ;;
            *) n=$(grep -c '^' "$PLAYLIST_1" 2>/dev/null || echo 0) ;;
        esac
    elif [ "${EAZY_SQL_LISTS_READY:-0}" = "1" ]; then
        n=$(eazy_sql_list_indexer "--list-count=$table" 2>/dev/null || echo 0)
    else
        n=0
    fi
    printf '%s\n' "$n" | tr -cd '0-9'
}

