elif [ "$1" = "--config" ]; then
    configurar_defaults
    exit 0
elif [ "$1" = "--ai" ]; then
    eazy_ia_chat
    exit $?
elif [ "$1" = "--torrent-list" ]; then
    list_file="${2:-$CONFIG_DIR/torrents.list}"
    mkdir -p "$(dirname -- "$list_file")"
    : > "$list_file"
    if [ -f "$DOWNLOAD_QUEUE" ]; then
        awk -F'|' '$1 == "torrent" && $2 != "" {print $2}' "$DOWNLOAD_QUEUE" | awk '!seen[$0]++' > "$list_file"
    fi
    [ -s "$list_file" ] || printf '# Um magnet ou arquivo .torrent por linha
' > "$list_file"
