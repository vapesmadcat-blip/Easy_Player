adicionar_download() {
    local link
    if [ -n "${EAZY_PREFILL_URL:-}" ]; then
        link="$EAZY_PREFILL_URL"
        unset EAZY_PREFILL_URL
    else
        link=$(whiptail --title "Gerenciador de Downloads" --inputbox "Digite ou cole o Link para Download:" 10 70 3>&1 1>&2 2>&3)
    fi
    [ -z "$link" ] && return

    local gerenciador extra=""
    local is_video=0
    local is_torrent=0
    if [[ "$link" == magnet:* ]] || [[ "$link" =~ \.torrent$ ]] || [ -f "$link" ] && [[ "$link" == *.torrent ]]; then
        is_torrent=1
    fi
    eh_url_video_online "$link" && is_video=1

    if [ "$is_torrent" -eq 1 ]; then
        gerenciador="torrent"
        extra=""
    elif [ "$is_video" -eq 1 ]; then
        # Pergunta: stream agora ou só enfileirar download
        local _acao_vid
        _acao_vid=$(whiptail --title "Link de vídeo" --menu "\n$link\n" 14 72 3 \
