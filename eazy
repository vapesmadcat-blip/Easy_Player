    if [ -z "$arquivo" ] || [ ! -f "$arquivo" ]; then
        whiptail --title "Exportar lista" --msgbox "Lista vazia ou inexistente:\n${arquivo:-?}" 9 55
        return 1
    fi
    n=$(eazy_count_lines "$arquivo")
    n=${n:-0}
    if [ "$n" -eq 0 ]; then
        whiptail --title "Exportar lista" --msgbox "A lista está vazia:\n$arquivo" 9 55
        return 1
    fi
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-lista-html.XXXXXX") || return 1
    eazy_paths_list_file_to_tsv "$arquivo" "$tmp"
    n=$(eazy_count_lines "$tmp"); n=${n:-0}
    if [ "$n" -eq 0 ]; then
        rm -f "$tmp"
        whiptail --title "Exportar lista" --msgbox "Nenhum caminho válido na lista." 8 50
        return 1
    fi
    crit="Lista: $rotulo
Arquivo: $arquivo
Itens: $n
Pasta eazy: $(pwd -P)"
    exportar_lista_html "$tmp" "$rotulo" "$crit" "Lista: $rotulo ($n item(ns))"
    local rc=$?
    rm -f "$tmp"
    return "$rc"
}

