# --- Leitor e conversor de PDF ---
eh_arquivo_pdf() {
    local f="$1" mime
    [ -f "$f" ] || return 1
    [[ "${f##*.}" =~ ^[Pp][Dd][Ff]$ ]] && return 0
    if command -v file >/dev/null 2>&1; then
        mime=$(file -b --mime-type -- "$f" 2>/dev/null || true)
        [ "$mime" = "application/pdf" ] && return 0
    fi
    return 1
}

pdf_exigir_ferramenta() {
    local cmd="$1" pacote="$2"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        whiptail --title "Ferramenta ausente" --msgbox "$cmd não está instalado.\n\nInstale com:\nsudo apt install $pacote" 10 70
        return 1
    fi
}

# Recolhe PDFs: seleção global do eazy (se houver) ou fzf multi na pasta
pdf_recolher_lista() {
    local -a candidatos=()
    local p abs
    # 1) Seleção global / local do eazy
    eazy_ensure_selection 2>/dev/null || true
    for f in "${SELECTED_FILE:-}" "${SELECTED_LOCAL_FILE:-}"; do
        [ -n "$f" ] && [ -s "$f" ] || continue
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            abs=$(caminho_absoluto "$p" 2>/dev/null || printf '%s' "$p")
            eh_arquivo_pdf "$abs" 2>/dev/null && candidatos+=("$abs")
        done < "$f"
    done
    # 2) Se nada na seleção, fzf multi na pasta atual
    if [ "${#candidatos[@]}" -eq 0 ]; then
        mapfile -t candidatos < <(selecionar_arquivo_conversao 'Selecione PDF(s) — TAB marca vários' pdf 1)
    fi
    # dedupe
    local -A seen=()
    local -a out=()
    for p in "${candidatos[@]}"; do
        [ -f "$p" ] || continue
        [ -n "${seen[$p]:-}" ] && continue
        seen[$p]=1
        out+=("$p")
    done
    if [ "${#out[@]}" -eq 0 ]; then
        whiptail --title "PDF" --msgbox "Nenhum PDF selecionado.\n\nMarque ficheiros com TAB/Espaço no eazy\nou escolha na lista fzf." 11 60
        return 1
    fi
    printf '%s\n' "${out[@]}"
}

pdf_pedir_pasta_saida() {
    local sugestao="${1:-$(pwd)/pdf_convertido}"
    local outdir
    outdir=$(whiptail --title "Pasta de saída" --inputbox \
"Todos os ficheiros convertidos vão para esta pasta:\n(criada se não existir)" 12 72 "$sugestao" 3>&1 1>&2 2>&3) || return 1
    [ -n "$outdir" ] || return 1
    mkdir -p -- "$outdir" || {
        whiptail --title "PDF" --msgbox "Não foi possível criar a pasta:\n$outdir" 9 60
        return 1
    }
    printf '%s\n' "$outdir"
}

pdf_ler_texto() {
    local pdf="$1" out
    pdf_exigir_ferramenta pdftotext poppler-utils || return 1
    out="${pdf%.*}.txt"
    if pdftotext -layout -- "$pdf" "$out" 2>/dev/null; then
        if command -v mostrar_texto >/dev/null 2>&1; then
            mostrar_texto "$out"
        else
            whiptail --title "PDF → TXT" --textbox "$out" 24 80 --scrolltext 2>/dev/null || \
            whiptail --title "PDF → TXT" --msgbox "Texto gravado em:\n$out" 9 70
        fi
    else
        whiptail --title "PDF" --msgbox "Não foi possível extrair texto de:\n$pdf" 9 70
    fi
}

# Converte 1 PDF → TXT (sem abrir viewer); retorna 0/1
pdf_para_txt_silent() {
    local pdf="$1" outdir="$2" base out
    base=$(basename -- "$pdf")
    base="${base%.*}"
    out="$outdir/${base}.txt"
    pdftotext -layout -- "$pdf" "$out" 2>/dev/null
}

pdf_para_html() {
    local pdf="$1" outdir="${2:-}" base dest
    pdf_exigir_ferramenta pdftohtml poppler-utils || return 1
    base="${pdf%.*}"
    if [ -z "$outdir" ]; then
        outdir=$(whiptail --inputbox "Pasta de saída do HTML:" 10 70 "${base}_html" 3>&1 1>&2 2>&3) || return
        [ -n "$outdir" ] || return
    fi
    mkdir -p -- "$outdir"
    dest="$outdir/$(basename "$base").html"
    if pdftohtml -s -noframes -- "$pdf" "$dest" >/dev/null 2>&1; then
        [ -n "${PDF_LOTE_SILENT:-}" ] || whiptail --title "PDF → HTML" --msgbox "HTML criado em:\n$outdir" 9 70
        return 0
    else
        [ -n "${PDF_LOTE_SILENT:-}" ] || whiptail --title "PDF → HTML" --msgbox "Falha ao converter o PDF para HTML." 9 70
        return 1
    fi
}

pdf_para_imagens() {
    local pdf="$1" outdir="${2:-}" base sub
    pdf_exigir_ferramenta pdftoppm poppler-utils || return 1
    base=$(basename -- "${pdf%.*}")
    if [ -z "$outdir" ]; then
        outdir=$(whiptail --inputbox "Pasta de saída das imagens:" 10 70 "${pdf%.*}_img" 3>&1 1>&2 2>&3) || return
        [ -n "$outdir" ] || return
    fi
    # Cada PDF numa subpasta para não misturar páginas
    sub="$outdir/$base"
    mkdir -p -- "$sub"
    if pdftoppm -png -- "$pdf" "$sub/pagina" >/dev/null 2>&1; then
        [ -n "${PDF_LOTE_SILENT:-}" ] || whiptail --title "PDF → Imagens" --msgbox "Imagens PNG criadas em:\n$sub" 9 70
        return 0
    else
        [ -n "${PDF_LOTE_SILENT:-}" ] || whiptail --title "PDF → Imagens" --msgbox "Falha ao converter o PDF para imagens." 9 70
        return 1
    fi
}

# Lote: formato = txt | html | png | all
converter_pdf_lote() {
    local formato="${1:-}"
    local -a pdfs=()
    local outdir ok=0 fail=0 p base log

    case "$formato" in
        txt)  pdf_exigir_ferramenta pdftotext poppler-utils || return 1 ;;
        html) pdf_exigir_ferramenta pdftohtml poppler-utils || return 1 ;;
        png)  pdf_exigir_ferramenta pdftoppm poppler-utils || return 1 ;;
        all)
            pdf_exigir_ferramenta pdftotext poppler-utils || return 1
            pdf_exigir_ferramenta pdftohtml poppler-utils || return 1
            pdf_exigir_ferramenta pdftoppm poppler-utils || return 1
            ;;
        *)
            formato=$(whiptail --title "PDF em lote" --menu \
"Formato de saída para TODOS os PDFs selecionados:" 16 70 6 \
                "txt"  "PDF → TXT (texto)" \
                "html" "PDF → HTML" \
                "png"  "PDF → Imagens PNG" \
                "all"  "TXT + HTML + PNG (tudo)" \
                3>&1 1>&2 2>&3) || return
            converter_pdf_lote "$formato"
            return $?
            ;;
    esac

    mapfile -t pdfs < <(pdf_recolher_lista) || return 1
    [ "${#pdfs[@]}" -gt 0 ] || return 1

    outdir=$(pdf_pedir_pasta_saida "$(pwd)/pdf_${formato}_$(date +%Y%m%d_%H%M%S)") || return 1

    if ! whiptail --title "Confirmar lote" --yesno \
"Converter ${#pdfs[@]} PDF(s) → ${formato}\n\nPasta de saída:\n$outdir\n\nContinuar?" 14 70; then
        return 0
    fi

    log="$outdir/conversao.log"
    {
        echo "=== Conversão PDF lote — $(date) ==="
        echo "Formato: $formato"
        echo "Pasta: $outdir"
        echo "Ficheiros: ${#pdfs[@]}"
        echo
    } > "$log"

    PDF_LOTE_SILENT=1
    clear 2>/dev/null || true
    printf '\n\033[1;36m▶ Convertendo %d PDF(s) → %s\033[0m\n\n' "${#pdfs[@]}" "$formato"

    for p in "${pdfs[@]}"; do
        base=$(basename -- "$p")
        printf '  • %s ... ' "$base"
        case "$formato" in
            txt)
                if pdf_para_txt_silent "$p" "$outdir"; then
                    echo "OK → ${base%.*}.txt"
                    echo "OK txt  $p" >> "$log"
                    ok=$((ok+1))
                else
                    echo "FALHOU"
                    echo "FAIL txt $p" >> "$log"
                    fail=$((fail+1))
                fi
                ;;
            html)
                if pdf_para_html "$p" "$outdir"; then
                    echo "OK → HTML"
                    echo "OK html $p" >> "$log"
                    ok=$((ok+1))
                else
                    echo "FALHOU"
                    echo "FAIL html $p" >> "$log"
                    fail=$((fail+1))
                fi
                ;;
            png)
                if pdf_para_imagens "$p" "$outdir"; then
                    echo "OK → PNG"
                    echo "OK png  $p" >> "$log"
                    ok=$((ok+1))
                else
                    echo "FALHOU"
                    echo "FAIL png $p" >> "$log"
                    fail=$((fail+1))
                fi
                ;;
            all)
                local subok=0
                pdf_para_txt_silent "$p" "$outdir" && subok=$((subok+1))
                pdf_para_html "$p" "$outdir" && subok=$((subok+1))
                pdf_para_imagens "$p" "$outdir" && subok=$((subok+1))
                if [ "$subok" -ge 1 ]; then
                    echo "OK ($subok/3)"
                    echo "OK all($subok) $p" >> "$log"
                    ok=$((ok+1))
                else
                    echo "FALHOU"
                    echo "FAIL all $p" >> "$log"
                    fail=$((fail+1))
                fi
                ;;
        esac
    done
    unset PDF_LOTE_SILENT

    {
        echo
        echo "Resultado: $ok ok · $fail falha(s)"
    } >> "$log"

    whiptail --title "PDF lote concluído" --msgbox \
"Convertidos: $ok\nFalhas: $fail\n\nPasta:\n$outdir\n\nLog:\n$log" 14 72
}

imagens_para_pdf() {
    local dir out
    local -a imagens=()
    pdf_exigir_ferramenta img2pdf img2pdf || return 1
    dir=$(whiptail --inputbox "Pasta com imagens (PNG/JPG):" 10 70 "$(pwd)" 3>&1 1>&2 2>&3) || return
    [ -d "$dir" ] || { whiptail --title "Imagens → PDF" --msgbox "Pasta não encontrada:\n$dir" 9 65; return 1; }
    mapfile -d '' imagens < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) -print0 | sort -z)
    [ "${#imagens[@]}" -gt 0 ] || { whiptail --title "Imagens → PDF" --msgbox "Nenhuma imagem PNG/JPG encontrada em:\n$dir" 9 70; return 1; }
    out=$(whiptail --inputbox "Nome do PDF de saída:" 10 70 "$dir/convertido.pdf" 3>&1 1>&2 2>&3) || return
    [ -n "$out" ] || return
    if img2pdf "${imagens[@]}" -o "$out" >/dev/null 2>&1; then
        whiptail --title "Imagens → PDF" --msgbox "PDF criado com ${#imagens[@]} imagem(ns):\n$out" 10 75
    else
        whiptail --title "Imagens → PDF" --msgbox "Falha ao criar o PDF." 9 60
    fi
}

