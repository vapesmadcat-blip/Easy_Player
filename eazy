       [ "${MODO_BUSCA:-0}" -eq 0 ]; then
        # Ctrl+K usa apenas amarelos locais (selected=1); nunca expande a seleção global.
        local selected_state selected_path
        while IFS= read -r -d '' selected_state && IFS= read -r -d '' selected_path; do
            [ "$selected_state" = 1 ] && local_paths+=("$selected_path")
        done < <("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
            --selection-local-view0 --selection-root "$(pwd -P)" 2>/dev/null)
        selecao=""
        for item in "${local_paths[@]}"; do
            selecao+="${item}"$'\n'
        done
    fi
    if [ -z "$selecao" ] && [ -n "$cursor" ]; then
        cursor_path="${cursor##*$'\t'}"
        if [ -n "$cursor_path" ] && [ "$cursor_path" != ".." ] && \
           [ -f "$(caminho_absoluto "$cursor_path" 2>/dev/null || printf '%s' "$cursor_path")" ]; then
