    dados_brutos=$(obter_lista_rapida)

    linha_voltar=$(echo "$dados_brutos" | awk -F '\t' '$2 ~ /📁 \.\./ || $2 ~ /📁 ◀ Voltar/')
    restante_itens=$(echo "$dados_brutos" | awk -F '\t' '$2 !~ /📁 \.\. / && $2 !~ /📁 ◀ Voltar/')

    if [ "${MODO_PLAYLIST:-0}" -eq 1 ] || [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        lista_preparada="$dados_brutos"
        ORDEM_TEXTO="ESPECIAL"
    else
        if [ "$MODO_ATUAL" = "nome" ]; then
            itens_ordenados=$(echo "$restante_itens" | sort -t$'\t' -k2,2f)
            ORDEM_TEXTO="NOME"
        elif [ "$MODO_ATUAL" = "data" ]; then
            itens_ordenados=$(echo "$restante_itens" | sort -rn)
            ORDEM_TEXTO="DATA"
        else
            itens_ordenados=$(echo "$restante_itens" | sort -rn)
            ORDEM_TEXTO="TAMANHO"
        fi

        if [ -n "$linha_voltar" ]; then
            lista_preparada=$(printf "%s\n%s" "$linha_voltar" "$itens_ordenados")
        else
            lista_preparada="$itens_ordenados"
        fi
    fi

    TOTAL_PLAYLIST=$(grep -c '^' "$PLAYLIST_FILE" 2>/dev/null || echo 0)
    TOTAL_PLAYLIST=$(echo "$TOTAL_PLAYLIST" | LC_ALL=C tr -cd '0-9')
    TOTAL_PLAYLIST=${TOTAL_PLAYLIST:-0}

    # Status permanente: HD livre/total + Sel (atualiza ao marcar)
    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        TOTAL_DL=$(grep -c '^' "$DOWNLOAD_QUEUE" 2>/dev/null || echo 0)
        TOTAL_DL=$(echo "$TOTAL_DL" | LC_ALL=C tr -cd '0-9')
        TOTAL_DL=${TOTAL_DL:-0}
        TEXTO_PROMPT=" 📥 FILA DE DOWNLOADS ($TOTAL_DL itens) ❯ "
        EAZY_HEADER_HINT=" [ENTER]: Baixar | [CTRL-A/X/R]: Marcar | [CTRL-B]: Sair | [DEL]: Remover | [F10]: Ajuda "
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        if [[ "$ARQUIVO_PLAYLIST_ABERTO" == *temp_playlist_* ]]; then
            TOTAL_FILA=$(grep -c '^' "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || echo 0)
            TOTAL_FILA=$(echo "$TOTAL_FILA" | tr -cd '0-9')
            TOTAL_FILA=${TOTAL_FILA:-0}
            # detecta número da fila pelo nome do arquivo
            case "$ARQUIVO_PLAYLIST_ABERTO" in
                *temp_playlist_2) FILA_ATUAL=2 ;;
                *temp_playlist_3) FILA_ATUAL=3 ;;
                *) FILA_ATUAL=1 ;;
            esac
            TEXTO_PROMPT=" 📋 FILA $FILA_ATUAL ($TOTAL_FILA)  [1:$(contar_fila 1)|2:$(contar_fila 2)|3:$(contar_fila 3)] ❯ "
            EAZY_HEADER_HINT=" [ENTER]: Tocar | [DEL]: Só da fila | [ALT+D]: Apaga do DISCO | [CTRL-P]: Próx. fila | [Q]: Sair "
        elif [ "$ARQUIVO_PLAYLIST_ABERTO" = "$HISTORY_FILE" ]; then
            TOTAL_HIST=$(grep -c '^' "$HISTORY_FILE" 2>/dev/null || echo 0)
            TOTAL_HIST=$(echo "$TOTAL_HIST" | tr -cd '0-9')
            TOTAL_HIST=${TOTAL_HIST:-0}
            TEXTO_PROMPT=" 🕐 HISTÓRICO ($TOTAL_HIST) ❯ "
            EAZY_HEADER_HINT=" [ENTER]: Tocar | [TAB]: Marcar | [CTRL-E]: Shuffle | [DEL]: Remover hist | [CTRL-G]: Fechar "
        else
            TEXTO_PROMPT=" 📜 PLAYLIST: $(basename "$ARQUIVO_PLAYLIST_ABERTO") ❯ "
            EAZY_HEADER_HINT=" [TAB/ESPACO]: Marcar | [ENTER]: Tocar | [CTRL-E]: Shuffle | [DEL]: Remover | [INSERT]: Fila | [CTRL-O]: Fechar "
        fi
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        TOTAL_DUP=$(grep -c '^' "$DUP_FILE" 2>/dev/null || echo 0)
        TOTAL_DUP=$(echo "$TOTAL_DUP" | LC_ALL=C tr -cd '0-9')
        TOTAL_DUP=${TOTAL_DUP:-0}
        TEXTO_PROMPT=" 🔁 DUPLICADOS [${EXT_DUP:-todas}] — $TOTAL_DUP arquivo(s) ❯ "
        EAZY_HEADER_HINT=" [TAB/ESPACO]: Marcar | [ENTER]: Tocar | [DEL]: Apagar HD | [CTRL-Y/U]: Copiar/Mover | [CTRL-D]: Sair "
    elif [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        extra_lbl=""
        [ -n "${BUSCA_TAM_LABEL:-}" ] && extra_lbl=" tam:$BUSCA_TAM_LABEL"
        [ -n "${BUSCA_CONTEUDO:-}" ] && extra_lbl="$extra_lbl txt:«${BUSCA_CONTEUDO:0:20}»"
        TEXTO_PROMPT=" 🔎 BUSCA [${EXT_BUSCA:-todas}]$extra_lbl ❯ "
        EAZY_HEADER_HINT=" [TAB]: Marcar | [ENTER]: Tocar | [CTRL-K]: Acoes | [CTRL-L]: Pasta do arquivo | [INSERT]: Fila | [DEL]: HD | [CTRL-F]: Sair "
    else
        TEXTO_PROMPT=" 📂 [$FILTRO_ATUAL] $PASTA_ATUAL ❯ "
        EAZY_HEADER_HINT=" [TAB]: Marcar | [ENTER]: Tocar | [CTRL-K]: Acoes | [CTRL-L]: Pasta | [CTRL-/]: Preview | [INSERT]: Fila | [DEL]: HD | [F10]: Ajuda "
    fi
    export EAZY_HEADER_HINT
    TEXTO_HEADER=$(eazy_status_header)

    TOTAL_LINHAS=$(echo "$lista_preparada" | grep -c '^')
    TOTAL_LINHAS=$(echo "$TOTAL_LINHAS" | LC_ALL=C tr -cd '0-9')
    TOTAL_LINHAS=${TOTAL_LINHAS:-1}

    if [ -f "$TMP_FILE" ]; then
        IFS='|' read -r TMP_READ ALVO_READ ULTIMO_ARQUIVO_READ ULTIMO_DIR_READ MODO_PL_READ < "$TMP_FILE"

        if [ "${MODO_PLAYLIST:-0}" -eq 1 ] || [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
            TMP="${TMP_READ:-2}"
        else
            if [ "$ULTIMO_DIR_READ" != "$PASTA_ATUAL" ] && [ -n "$ULTIMO_DIR_READ" ]; then
                TMP=1
                ALVO="$PASTA_ATUAL"
            else
                TMP="${TMP_READ:-1}"
                ALVO="${ALVO_READ:-$PASTA_ATUAL}"
                ULTIMO_ARQUIVO="${ULTIMO_ARQUIVO_READ:-}"
            fi
        fi

        TMP=$(echo "$TMP" | LC_ALL=C tr -cd '0-9')
        TMP=${TMP:-1}
        [ "$TMP" -lt 1 ] && TMP=1
        [ "$TOTAL_LINHAS" -gt 0 ] && [ "$TMP" -gt "$TOTAL_LINHAS" ] && TMP="$TOTAL_LINHAS"
    fi

    # Se temos um último arquivo tocado, força o ponteiro nele (seleção/posição persiste após sair do player)
    if [ -n "${ULTIMO_ARQUIVO:-}" ] && [ -n "$lista_preparada" ]; then
        pos_ultimo=$(encontrar_posicao "$ULTIMO_ARQUIVO" "$lista_preparada")
        if [ -n "$pos_ultimo" ] && [ "$pos_ultimo" -ge 1 ]; then
            TMP="$pos_ultimo"
        fi
    fi

    [ "$TMP" -lt 1 ] && TMP=1
    [ "$TOTAL_LINHAS" -gt 0 ] && [ "$TMP" -gt "$TOTAL_LINHAS" ] && TMP="$TOTAL_LINHAS"

    registrar_status

    # Preview: estado persistente (desligado por padrão)
    if [ "${PREVIEW_ATIVO:-0}" = "1" ]; then
        PREVIEW_WIN="right:40%:wrap:border-left"
    else
        PREVIEW_WIN="right:40%:wrap:border-left:hidden"
    fi

    # Lista em arquivo p/ reload: .. / Voltar sempre visíveis; filtro só no resto
    printf '%s\n' "$lista_preparada" > "$LISTA_FZF_FILE"

    # Filtro digitado persiste; navegação nunca some e nunca entra nas ações
    # --disabled: o fzf NÃO filtra de novo (senão esconde o ..); quem filtra é eazy_lista_filtrada
    saida_fzf=$(eazy_lista_filtrada "$FZF_QUERY" | fzf --multi --ansi \
        --disabled \
        --print-query \
        --query="$FZF_QUERY" \
        --expect=f1,f2,f3,f4,f5,f6,f7,f8,f9,f10,ctrl-h,del,alt-d,insert,ctrl-s,ctrl-o,ctrl-f,ctrl-p,ctrl-d,ctrl-b,ctrl-t,ctrl-q,ctrl-y,ctrl-u,ctrl-g,ctrl-e,ctrl-k,ctrl-l,ctrl-/,q,X \
        --delimiter='\t' \
        --with-nth=2,3 \
        --layout=reverse \
        --border=rounded \
        --margin=1,2 \
        --padding=1 \
        --info=inline \
        --pointer="▶" \
        --marker="✓" \
        --color="bg+:#2b2b2b,border:#5eacd3,header:#85c1dc,prompt:#98c379,pointer:#ffd700,marker:#ffd700,hl:#000000:reverse,hl+:#000000:reverse,info:#5eacd3,preview-fg:#d4d4d4,preview-bg:#1e1e1e" \
        --header="$TEXTO_HEADER" \
        --prompt="$TEXTO_PROMPT" \
        --no-sort \
        --preview='bash -c "eazy_preview \"\$1\"" -- {}' \
        --preview-window="${PREVIEW_WIN}" \
        --bind="change:reload:eazy_lista_filtrada '{q}'" \
        --bind="tab:toggle+down+transform-header(eazy_status_header {+})" \
        --bind="shift-tab:toggle+up+transform-header(eazy_status_header {+})" \
        --bind="space:toggle+transform-header(eazy_status_header {+})" \
        --bind="ctrl-a:select-all+transform-header(eazy_status_header {+})" \
        --bind="ctrl-x:deselect-all+transform-header(eazy_status_header)" \
        --bind="ctrl-r:toggle-all+transform-header(eazy_status_header {+})" \
        --bind="load:pos($TMP)" \
        --bind="down:down+execute-silent(bash -c '
            IFS=\"|\" read -r TMP ALVO ULTIMO_ARQUIVO ULTIMO_DIR MODO_PL < \"$TMP_FILE\"
            TMP=\$(echo \"\$TMP\" | tr -cd \"0-9\")
            [ -z \"\$TMP\" ] && TMP=0
            TMP=\$((TMP + 1))
            printf \"%s|%s|%s|%s|%s\n\" \"\$TMP\" \"\$ALVO\" \"\$ULTIMO_ARQUIVO\" \"\$ULTIMO_DIR\" \"\$MODO_PL\" > \"$TMP_FILE\"
        ')" \
        --bind="up:up+execute-silent(bash -c '
            IFS=\"|\" read -r TMP ALVO ULTIMO_ARQUIVO ULTIMO_DIR MODO_PL < \"$TMP_FILE\"
            TMP=\$(echo \"\$TMP\" | tr -cd \"0-9\")
            [ -z \"\$TMP\" ] && TMP=1
            [ \$TMP -gt 1 ] && TMP=\$((TMP - 1))
            printf \"%s|%s|%s|%s|%s\n\" \"\$TMP\" \"\$ALVO\" \"\$ULTIMO_ARQUIVO\" \"\$ULTIMO_DIR\" \"\$MODO_PL\" > \"$TMP_FILE\"
        ')")

    # --print-query + --expect: linha1=query, linha2=tecla, resto=seleção
    FZF_QUERY=$(printf '%s\n' "$saida_fzf" | sed -n '1p')
    tecla=$(printf '%s\n' "$saida_fzf" | sed -n '2p')
    escolha_raw=$(printf '%s\n' "$saida_fzf" | tail -n +3)
    # Remove .. / Voltar de seleções múltiplas (Ctrl-A, TAB, espaço…)
    # Mas preserva se for SÓ navegação (Enter em ".." / Voltar deve funcionar)
    escolha=$(printf '%s\n' "$escolha_raw" | eazy_sem_navegacao)
    if [ -z "$escolha" ] && [ -n "$escolha_raw" ]; then
        n_raw=$(printf '%s\n' "$escolha_raw" | grep -c '^' 2>/dev/null || echo 0)
        n_raw=$(echo "$n_raw" | tr -cd '0-9'); n_raw=${n_raw:-0}
        if [ "$n_raw" -ge 1 ]; then
            so_nav=1
            while IFS= read -r _ln; do
                [ -z "$_ln" ] && continue
                eazy_eh_navegacao "$_ln" || { so_nav=0; break; }
            done <<< "$escolha_raw"
            [ "$so_nav" -eq 1 ] && escolha=$(printf '%s\n' "$escolha_raw" | head -n1)
        fi
    fi

    if [ -f "$TMP_FILE" ]; then
        IFS='|' read -r TMP ALVO ULTIMO_ARQUIVO ULTIMO_DIR MODO_PLAYLIST < "$TMP_FILE"
        TMP=$(echo "$TMP" | LC_ALL=C tr -cd '0-9')
        TMP=${TMP:-1}
    fi

    if [ "$tecla" = "X" ] || [ "$tecla" = "ctrl-q" ] || [ "$tecla" = "q" ]; then
        # X / Q / CTRL-Q = sair — salva sessão completa
        salvar_sessao
        rm -f "$TMP_FILE" "$DUP_FILE" "$SELECTED_FILE" 2>/dev/null
        clear
        echo -e "\033[1;32m${EAZY_NAME} ${EAZY_VERSION}\033[0m — sessão salva."
        echo -e "Filas: 1=$(contar_fila 1) · 2=$(contar_fila 2) · 3=$(contar_fila 3)"
        exit 0
    elif [ "$tecla" = "ctrl-/" ] || [ "$tecla" = "ctrl-_" ]; then
        # CTRL-/ (alguns terminais enviam ctrl-_) — liga/desliga preview e persiste
        toggle_preview_persistente
        salvar_sessao
        continue
    elif [ "$tecla" = "ctrl-l" ]; then
        # Vai para a pasta do arquivo sob o cursor / seleção
        alvo_l=$(printf '%s\n' "$escolha" | head -n1 | awk -F '\t' '{print $NF}')
        [ -z "$alvo_l" ] && continue
        alvo_l=$(caminho_absoluto "$alvo_l")
        if [ -d "$alvo_l" ]; then
            dest_dir="$alvo_l"
            dest_item=""
        elif [ -e "$alvo_l" ]; then
            dest_dir=$(dirname -- "$alvo_l")
            dest_item=$(basename -- "$alvo_l")
        else
            whiptail --title "Ir para pasta" --msgbox "Caminho não encontrado:\n$alvo_l" 9 60
            continue
        fi
        # Sai de modos especiais
        MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0
        MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
        BUSCA_TAM_MIN=""; BUSCA_TAM_MAX=""; BUSCA_TAM_LABEL=""; BUSCA_CONTEUDO=""
        salvar_posicao_dir "$(pwd)" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
        cd "$dest_dir" || true
        ULTIMO_ARQUIVO="$dest_item"
        carregar_posicao_dir "$(pwd)"
        [ -n "$dest_item" ] && ULTIMO_ARQUIVO="$dest_item"
        ALVO="$(pwd)"
        ULTIMO_DIR="$(pwd)"
        TMP=1
        registrar_status
        salvar_sessao
        continue
    elif [ "$tecla" = "f1" ]; then
        MODO_ATUAL="tamanho"; continue
    elif [ "$tecla" = "f2" ]; then
        MODO_ATUAL="nome"; continue
    elif [ "$tecla" = "ctrl-t" ]; then
        MODO_ATUAL="data"; continue
    elif [ "$tecla" = "f3" ]; then
        [ "$TELA_ATUAL" = "fs" ] && TELA_ATUAL="janela" || TELA_ATUAL="fs"; continue
    elif [ "$tecla" = "f4" ]; then
        FILTRO_ATUAL="audios"; TMP=1; continue
    elif [ "$tecla" = "f5" ]; then
        FILTRO_ATUAL="videos"; TMP=1; continue
    elif [ "$tecla" = "f6" ]; then
        FILTRO_ATUAL="imgs"; TMP=1; continue
    elif [ "$tecla" = "f7" ]; then
        FILTRO_ATUAL="compactados"; TMP=1; continue
    elif [ "$tecla" = "f8" ]; then
        if [ "$FILTRO_ATUAL" = "todos" ]; then
            FILTRO_ATUAL="${FILTRO_ANTERIOR:-ambos}"
        else
            FILTRO_ANTERIOR="$FILTRO_ATUAL"
            FILTRO_ATUAL="todos"
        fi
        TMP=1; continue
    elif [ "$tecla" = "f9" ]; then
        configurar_defaults; continue
    elif [ "$tecla" = "f10" ] || [ "$tecla" = "ctrl-h" ]; then
        exibir_help; continue
    elif [ "$tecla" = "del" ]; then
        # DEL: na playlist = só da lista; na tela principal = do disco
        confirmar_e_excluir "$escolha"; continue
    elif [ "$tecla" = "alt-d" ]; then
        # ALT+D: apaga do DISCO (e da playlist, se estiver nela)
        # (fzf não suporta ctrl-del de forma confiável)
        confirmar_e_excluir "$escolha" "disco"; continue
    elif [ "$tecla" = "ctrl-k" ]; then
        menu_acoes_selecao "$escolha"; continue
    elif [ "$tecla" = "ctrl-y" ]; then
        copiar_arquivos "$escolha"; continue
    elif [ "$tecla" = "ctrl-u" ]; then
        mover_arquivos "$escolha"; continue
    elif [ "$tecla" = "ctrl-g" ]; then
        # Histórico de arquivos tocados
        if [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ "$ARQUIVO_PLAYLIST_ABERTO" = "$HISTORY_FILE" ]; then
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""; TMP=1
            ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status
        elif [ ! -s "$HISTORY_FILE" ]; then
            whiptail --title "Histórico" --msgbox "Histórico vazio.\nToque arquivos para ir preenchendo." 9 50
        else
            MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0
            MODO_PLAYLIST=1
            ARQUIVO_PLAYLIST_ABERTO="$HISTORY_FILE"
            TMP=2
            registrar_status
        fi
        continue
    elif [ "$tecla" = "ctrl-e" ]; then
        # Shuffle: toca seleção atual (ou fila temp) em ordem aleatória
        shuf_list="/tmp/eazy_shuf_play_$$"
        : > "$shuf_list"
        if [ -n "$escolha" ]; then
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$p" ] || [[ "$p" =~ \.\.$ ]] && continue
                caminho_absoluto "$p" >> "$shuf_list"
            done <<< "$escolha"
        fi
        if [ ! -s "$shuf_list" ] && [ -s "$PLAYLIST_FILE" ]; then
            grep -v '^#' "$PLAYLIST_FILE" | grep -v '^[[:space:]]*$' > "$shuf_list"
        fi
        if [ -s "$shuf_list" ]; then
            tocar_lista "$shuf_list" shuffle
        else
            whiptail --title "Shuffle" --msgbox "Nada para tocar.\nMarque arquivos ou encha a fila (INSERT)." 9 50
        fi
        rm -f "$shuf_list"
        continue
    elif [ "$tecla" = "ctrl-b" ]; then
        if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
            MODO_DOWNLOAD=0; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; TMP=1; registrar_status
        else
            escolha_dl=$(whiptail --title "Gerenciador de Downloads" --menu "Escolha a ação:" 12 50 2 \
                "1" "Ver Fila de Downloads" \
                "2" "Adicionar Link com Senha" \
                3>&1 1>&2 2>&3)
            if [ "$escolha_dl" = "2" ]; then
                adicionar_download
            elif [ "$escolha_dl" = "1" ]; then
                MODO_DOWNLOAD=1; TMP=2; registrar_status
            fi
        fi
        continue
    elif [ "$tecla" = "ctrl-o" ]; then
        if [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; TMP=1; registrar_status
        else
            # Lista playlists da pasta atual + pasta padrão de playlists
            mkdir -p "$PLAYLIST_DIR_PADRAO" 2>/dev/null || true
            playlist_escolhida=$(
                {
                    find . -maxdepth 1 -type f \( -iname "*.m3u" -o -iname "*.pls" \) -printf "%p\n" 2>/dev/null
                    if [ -d "$PLAYLIST_DIR_PADRAO" ]; then
                        find "$PLAYLIST_DIR_PADRAO" -maxdepth 1 -type f \( -iname "*.m3u" -o -iname "*.pls" \) -printf "%p\n" 2>/dev/null
                    fi
                } | sed 's|^\./||' | sort -u | fzf --prompt="Selecionar Playlist ❯ " --preview='head -20 {}' --preview-window=down:40%
            )
            if [ -n "$playlist_escolhida" ]; then
                # Guarda caminho absoluto do arquivo .m3u
                if [[ "$playlist_escolhida" == /* ]]; then
                    ARQUIVO_PLAYLIST_ABERTO="$playlist_escolhida"
                else
                    ARQUIVO_PLAYLIST_ABERTO="$(pwd)/$playlist_escolhida"
                fi
                if [ -f "$ARQUIVO_PLAYLIST_ABERTO" ]; then
                    MODO_PLAYLIST=1; TMP=2; registrar_status
                else
                    whiptail --title "Erro" --msgbox "Playlist não encontrada:\n$ARQUIVO_PLAYLIST_ABERTO" 9 60
                fi
            fi
        fi
        continue
    elif [ "$tecla" = "ctrl-f" ]; then
        if [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DUP:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ]; then
            if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
                MODO_BUSCA=0
                BUSCA_TAM_MIN=""; BUSCA_TAM_MAX=""; BUSCA_TAM_LABEL=""
                BUSCA_CONTEUDO=""
                TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status
            else
                EXT_BUSCA=$(selecionar_extensoes)
                if [ -n "$EXT_BUSCA" ]; then
                    if selecionar_tamanho_busca; then
                        MODO_BUSCA=1; TMP=2; registrar_status
                    fi
                fi
            fi
        fi
        continue
    elif [ "$tecla" = "ctrl-d" ]; then
        if [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_BUSCA:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ]; then
            if [ "${MODO_DUP:-0}" -eq 1 ]; then
                MODO_DUP=0; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status
            else
                EXT_DUP=$(selecionar_extensoes)
                if [ -n "$EXT_DUP" ]; then
                    encontrar_duplicados "$DUP_FILE" "$EXT_DUP"
                    MODO_DUP=1; TMP=2; registrar_status
                fi
            fi
        fi
        continue
    elif [ "$tecla" = "ctrl-s" ]; then
        salvar_playlist
        continue
    elif [ "$tecla" = "insert" ]; then
        itens_para_fila=$(printf '%s\n' "$escolha" | awk -F '\t' 'NF {print $NF}')
        if [ -z "$itens_para_fila" ]; then
            whiptail --title "⚠ NENHUM ARQUIVO SELECIONADO" \
                --msgbox "Nenhum arquivo selecionado.\nUse TAB ou ESPAÇO para marcar." 8 50
            continue
        fi
        # Pergunta em qual das 3 filas colocar
        n1=$(contar_fila 1); n2=$(contar_fila 2); n3=$(contar_fila 3)
        dest_fila=""; dest_file=""
        dest_fila=$(whiptail --title "INSERT → Fila temporária" --radiolist \
            "Para qual fila enviar os itens?\n(Espaço marca, Enter confirma)" 14 55 3 \
            "1" "Fila 1  ($n1 itens)" $( [ "$FILA_ATUAL" = "1" ] && echo ON || echo OFF ) \
            "2" "Fila 2  ($n2 itens)" $( [ "$FILA_ATUAL" = "2" ] && echo ON || echo OFF ) \
            "3" "Fila 3  ($n3 itens)" $( [ "$FILA_ATUAL" = "3" ] && echo ON || echo OFF ) \
            3>&1 1>&2 2>&3)
        [ -z "$dest_fila" ] && continue
        dest_file="$CONFIG_DIR/temp_playlist_${dest_fila}"
        touch "$dest_file"
        quantidade_adicionada=0
        while IFS= read -r item; do
            [ -z "$item" ] && continue
            [[ "$item" =~ \.\.$ ]] && continue
            item_abs=$(caminho_absoluto "$item")
            if ! grep -Fxq -- "$item_abs" "$dest_file" 2>/dev/null; then
                printf '%s\n' "$item_abs" >> "$dest_file"
                quantidade_adicionada=$((quantidade_adicionada + 1))
            fi
        done <<< "$itens_para_fila"
        total_fila=$(contar_fila "$dest_fila")
        FILA_ATUAL="$dest_fila"
        atualizar_fila_atual
        whiptail --title "✓ Fila $dest_fila" \
            --msgbox "Adicionados: $quantidade_adicionada\nTotal na Fila $dest_fila: $total_fila" 10 45
        continue
    elif [ "$tecla" = "ctrl-p" ]; then
        # CTRL-P: diretório → Fila1 → Fila2 → Fila3 → diretório
        MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0
        touch "$PLAYLIST_1" "$PLAYLIST_2" "$PLAYLIST_3" 2>/dev/null || true

        # Detecta em qual fila está agora (pelo arquivo aberto)
        local_onde="dir"
        if [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
            case "$ARQUIVO_PLAYLIST_ABERTO" in
                *temp_playlist_1) local_onde="1" ;;
                *temp_playlist_2) local_onde="2" ;;
                *temp_playlist_3) local_onde="3" ;;
                *) local_onde="outra" ;;  # histórico / .m3u externo
            esac
        fi

        case "$local_onde" in
            dir|outra)
                # Pasta (ou outra lista) → Fila 1
                FILA_ATUAL=1
                atualizar_fila_atual
                MODO_PLAYLIST=1
                ARQUIVO_PLAYLIST_ABERTO="$PLAYLIST_1"
                TMP=1
                ;;
            1)
                FILA_ATUAL=2
                atualizar_fila_atual
                MODO_PLAYLIST=1
                ARQUIVO_PLAYLIST_ABERTO="$PLAYLIST_2"
                TMP=1
                ;;
            2)
                FILA_ATUAL=3
                atualizar_fila_atual
                MODO_PLAYLIST=1
                ARQUIVO_PLAYLIST_ABERTO="$PLAYLIST_3"
                TMP=1
                ;;
            3)
                # Fila 3 → volta ao diretório
                MODO_PLAYLIST=0
                ARQUIVO_PLAYLIST_ABERTO=""
                FILA_ATUAL=1
                atualizar_fila_atual
                TMP=1
                ALVO="$(pwd)"
                ULTIMO_DIR="$(pwd)"
                ;;
        esac
        registrar_status
        continue
    fi

    if [ -z "$escolha" ]; then
        continue
    fi

    primeiro_caminho=$(echo "$escolha" | head -n 1 | awk -F '\t' '{print $NF}')

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_DOWNLOAD=0; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        link_alvo=$(echo "$escolha" | head -n 1 | awk -F '\t' '{print $NF}')
        linha_fila=$(grep "|$link_alvo|" "$DOWNLOAD_QUEUE" | head -n 1)
        engine=$(echo "$linha_fila" | cut -d'|' -f1)
        pass=$(echo "$linha_fila" | cut -d'|' -f3)

        if [ -z "$pass" ] && [ -f "$DOWNLOAD_PASSWORDS" ]; then
            pass=$(grep -F "$link_alvo|" "$DOWNLOAD_PASSWORDS" | tail -n1 | cut -d'|' -f2-)
        fi

        nome_esperado=$(obter_nome_do_link "$link_alvo")
        dir_antes=$(pwd)

        # Downloads: tamanho remoto costuma ser desconhecido — exige folga mínima no disco
        {
            read -r _livre_dl _tot_dl < <(info_disco ".")
            _livre_dl=$(echo "${_livre_dl:-0}" | tr -cd '0-9'); _livre_dl=${_livre_dl:-0}
            # Reserva “virtual” de 1 GB para avisar; bloqueio se < mínimo seguro
            if ! verificar_espaco_disco "$((1024*1024*1024))" "." "Download" \
                "$((1024*1024*1024))|${link_alvo} (estimativa mínima de reserva)"; then
                continue
            fi
        }

        echo -e "\n\033[1;32m⬇ Iniciando download com [$engine]\033[0m"
        echo -e "   URL : $link_alvo"
        if [ "$engine" = "ytdlp" ]; then
            echo -e "   Formato: ${pass:-best}"
        elif [ -n "$pass" ]; then
            echo -e "   Senha: (definida — será usada na extração)"
        fi
        echo ""

        status_dl=1
        case "$engine" in
            ytdlp)
                YTDLP_BIN=$(encontrar_ytdlp 2>/dev/null || true)
                if [ -z "$YTDLP_BIN" ]; then
                    echo -e "\033[1;31myt-dlp não encontrado.\033[0m"
                    echo -e "Atualize SEM pip:  eazy --update-ytdlp"
                    status_dl=1
                else
                    # Limpa tracking (?si=...)
                    link_limpo="${link_alvo%%\?*}"
                    export PATH="$(dirname "$YTDLP_BIN"):$PATH"

                    fmt="${pass:-best}"
                    case "$fmt" in
                        best)  fmt_arg="bv*+ba/b" ;;
                        1080)  fmt_arg="bv*[height<=1080]+ba/b[height<=1080]/b" ;;
                        720)   fmt_arg="bv*[height<=720]+ba/b[height<=720]/b" ;;
                        480)   fmt_arg="bv*[height<=480]+ba/b[height<=480]/b" ;;
                        audio) fmt_arg="ba/b" ;;
                        mp4)   fmt_arg="bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b" ;;
                        *)     fmt_arg="$fmt" ;;
                    esac

                    out_tpl="%(title).200B [%(id)s].%(ext)s"
                    echo -e "   Binário: $YTDLP_BIN"
                    echo -e "   Versão:  $($YTDLP_BIN --version 2>/dev/null || echo '?')"
                    echo -e "   Se 403/400 →  eazy --update-ytdlp"

                    # aria2c como acelerador (não substitui o yt-dlp)
                    ARIA_ARGS=()
                    if command -v aria2c &>/dev/null && [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                        ARIA_ARGS=(--downloader aria2c --downloader-args "aria2c:-x 16 -s 16 -k 1M -j 16")
                        echo -e "   Acelerador: aria2c (multi-conexão)"
                    fi
                    echo ""

                    ytdlp_ok=0
                    if [ "$fmt" = "audio" ]; then
                        if [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                            $YTDLP_BIN -f "$fmt_arg" -x --audio-format mp3 --audio-quality 0 \
                                --extractor-args "youtube:player_client=android,web" \
                                --no-playlist --newline --retries 5 \
                                "${ARIA_ARGS[@]}" \
                                -o "$out_tpl" "$link_limpo" && ytdlp_ok=1
                        else
                            $YTDLP_BIN -f "$fmt_arg" -x --audio-format mp3 \
                                --no-playlist -o "$out_tpl" "$link_limpo" && ytdlp_ok=1
                        fi
                    else
                        if [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                            $YTDLP_BIN -f "$fmt_arg" --merge-output-format mp4 \
                                --extractor-args "youtube:player_client=android,web" \
                                --no-playlist --newline --retries 5 --fragment-retries 5 \
                                "${ARIA_ARGS[@]}" \
                                -o "$out_tpl" "$link_limpo" && ytdlp_ok=1
                        else
                            $YTDLP_BIN -f "$fmt_arg" --merge-output-format mp4 \
                                --no-playlist -o "$out_tpl" "$link_limpo" && ytdlp_ok=1
                        fi
                    fi

                    # Fallback se a 1ª tentativa falhar
                    if [ "$ytdlp_ok" -eq 0 ] && [[ "$(basename "$YTDLP_BIN")" == yt-dlp* ]]; then
                        echo -e "\n\033[1;33mTentando fallback (client web + formato livre)...\033[0m"
                        if $YTDLP_BIN -f "b/bv+ba" --merge-output-format mp4 \
                            --extractor-args "youtube:player_client=web" \
                            --no-playlist --newline --retries 5 \
                            "${ARIA_ARGS[@]}" \
                            -o "$out_tpl" "$link_limpo"; then
                            ytdlp_ok=1
                        fi
                    fi

                    if [ "$ytdlp_ok" -eq 1 ]; then
                        status_dl=0
                    else
                        echo -e "\n\033[1;33mAtualize o yt-dlp SEM pip:\033[0m"
                        echo -e "  eazy --update-ytdlp"
                        echo -e "  # ou wget o binário do GitHub (ver --help)"
                        status_dl=1
                    fi
                fi
                ;;
            aria|axel|wget|*)
                if eh_url_video_online "$link_alvo"; then
                    echo -e "\033[1;31mEste link é de vídeo online (YouTube etc.).\033[0m"
                    echo -e "aria2c sozinho NÃO resolve a URL do YouTube."
                    echo -e "O eazy usa:  yt-dlp + aria2c (acelerador)."
                    echo -e "Remova este item e adicione de novo (força yt-dlp)."
                    echo -e "Atualize:  eazy --update-ytdlp"
                    status_dl=1
                elif [ "$engine" = "aria" ]; then
                    if ! command -v aria2c &>/dev/null; then
                        echo -e "\033[1;31maria2c não instalado.  sudo apt install aria2\033[0m"
                    elif aria2c --console-log-level=notice -x 4 -s 4 --auto-file-renaming=false \
                        --allow-overwrite=true "$link_alvo"; then
                        status_dl=0
                    fi
                elif [ "$engine" = "axel" ]; then
                    if ! command -v axel &>/dev/null; then
                        echo -e "\033[1;31maxel não instalado.  sudo apt install axel\033[0m"
                    elif axel --insecure -n 4 -o "$nome_esperado" "$link_alvo"; then
                        status_dl=0
                    fi
                else
                    if ! command -v wget &>/dev/null; then
                        echo -e "\033[1;31mwget não instalado.  sudo apt install wget\033[0m"
                    elif wget --no-check-certificate -O "$nome_esperado" "$link_alvo"; then
                        status_dl=0
                    fi
                fi
                ;;
        esac

        if [ "$status_dl" -ne 0 ]; then
            echo -e "\n\033[1;31m✗ Download falhou.\033[0m"
            read -p "Pressione Enter para continuar..."
            continue
        fi

        echo -e "\n\033[1;32m✓ Download concluído.\033[0m"

        arquivo_baixado=""
        if [ "$engine" = "ytdlp" ]; then
            # Pega o arquivo mais recente da pasta (yt-dlp define o nome)
            arquivo_baixado=$(find . -maxdepth 1 -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.webm" -o -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.opus" \) -printf '%T@ %p\n' 2>/dev/null \
                | sort -nr | head -n1 | cut -d' ' -f2- | sed 's|^\./||')
        elif [ -f "$nome_esperado" ]; then
            arquivo_baixado="$nome_esperado"
        else
            arquivo_baixado=$(find . -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null \
                | sort -nr | head -n1 | cut -d' ' -f2- | sed 's|^\./||')
        fi

        if [ -n "$arquivo_baixado" ] && [ -f "$arquivo_baixado" ]; then
            echo -e "   Arquivo: $arquivo_baixado"

            # Oferece tocar o vídeo baixado com yt-dlp
            if [ "$engine" = "ytdlp" ]; then
                read -p "Tocar o arquivo agora? (s/N): " quer_tocar
                if [[ "$quer_tocar" =~ ^[Ss]$ ]]; then
                    tocar_arquivo "$arquivo_baixado"
                fi
            fi

            ext_baixado=$(echo "${arquivo_baixado##*.}" | tr '[:upper:]' '[:lower:]')
            if [[ "$ext_baixado" =~ ^(zip|rar|7z|gz|bz2|xz|tar)$ ]] || \
               [[ "$arquivo_baixado" == *.tar.gz ]] || [[ "$arquivo_baixado" == *.tgz ]] || \
               [[ "$arquivo_baixado" == *.tar.bz2 ]] || [[ "$arquivo_baixado" == *.tar.xz ]]; then

                if [ -n "$pass" ] && [ "$engine" != "ytdlp" ]; then
                    echo -e "\033[1;33mArquivo compactado detectado + senha disponível → extraindo...\033[0m"
                    extrair_com_senha "$arquivo_baixado" "$pass"
                else
                    read -p "Arquivo compactado detectado. Deseja extrair agora? (s/N): " quer_extrair
                    if [[ "$quer_extrair" =~ ^[Ss]$ ]]; then
                        extrair_com_senha "$arquivo_baixado" ""
                    fi
                fi
            fi
        else
            echo -e "\033[1;33mNão foi possível identificar o arquivo baixado automaticamente.\033[0m"
        fi

        read -p "Remover este item da fila de downloads? (S/n): " remover_fila
        if [[ ! "$remover_fila" =~ ^[Nn]$ ]]; then
            grep -v "|$link_alvo|" "$DOWNLOAD_QUEUE" > "${DOWNLOAD_QUEUE}.tmp" && mv "${DOWNLOAD_QUEUE}.tmp" "$DOWNLOAD_QUEUE"
            echo -e "\033[1;32mItem removido da fila.\033[0m"
        fi

        read -p "Pressione Enter para continuar..."
        continue
    fi

    if [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi

        # Seleção normal: toca só o que foi marcado / o item sob o cursor
        playlist_sel="/tmp/eazy_sel_play_$$"
        : > "$playlist_sel"
        : > "$SELECTED_FILE"
        while IFS= read -r linha; do
            [ -z "$linha" ] && continue
            p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
            [ -z "$p" ] || [[ "$p" =~ \.\.$ ]] && continue
            # Já vem resolvido (absoluto) da listagem
            printf '%s\n' "$p" >> "$playlist_sel"
            printf '%s\n' "$p" >> "$SELECTED_FILE"
        done <<< "$escolha"
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ]; then
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -eq 1 ]; then
            tocado=$(head -n1 "$playlist_sel")
            ULTIMO_ARQUIVO="$tocado"
            registrar_status
            if [ -f "$tocado" ]; then
                if eh_arquivo_texto "$tocado"; then
                    mostrar_texto "$tocado"
                else
                    ext="${tocado##*.}"
                    ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
                    if [[ "$ext" =~ ^(m3u|pls)$ ]]; then
                        tocar_lista "$tocado"
                    else
                        tocar_arquivo "$tocado"
                    fi
                fi
            else
                whiptail --title "Arquivo ausente" --msgbox "Arquivo não encontrado:\n$tocado" 9 60
            fi
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_DUP=0; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        # Extrai caminhos absolutos da seleção atual
        playlist_sel="/tmp/eazy_sel_play_$$"
        : > "$playlist_sel"
        : > "$SELECTED_FILE"
        while IFS= read -r linha; do
            [ -z "$linha" ] && continue
            p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
            [ -z "$p" ] && continue
            p_abs=$(caminho_absoluto "$p")
            printf '%s\n' "$p_abs" >> "$playlist_sel"
            printf '%s\n' "$p_abs" >> "$SELECTED_FILE"
        done <<< "$escolha"
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ]; then
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -eq 1 ] && [ -f "$(head -n1 "$playlist_sel")" ]; then
            ULTIMO_ARQUIVO=$(head -n1 "$playlist_sel")
            registrar_status
            if eh_arquivo_texto "$ULTIMO_ARQUIVO"; then
                mostrar_texto "$ULTIMO_ARQUIVO"
            else
                tocar_arquivo "$ULTIMO_ARQUIVO"
            fi
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        if [[ "$primeiro_caminho" =~ ^\.\.$ ]]; then
            MODO_BUSCA=0; TMP=1; ALVO="$(pwd)"; ULTIMO_DIR="$(pwd)"; registrar_status; continue
        fi
        playlist_sel="/tmp/eazy_sel_play_$$"
        : > "$playlist_sel"
        : > "$SELECTED_FILE"
        while IFS= read -r linha; do
            [ -z "$linha" ] && continue
            p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
            [ -z "$p" ] && continue
            p_abs=$(caminho_absoluto "$p")
            printf '%s\n' "$p_abs" >> "$playlist_sel"
            printf '%s\n' "$p_abs" >> "$SELECTED_FILE"
        done <<< "$escolha"
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ]; then
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -eq 1 ] && [ -f "$(head -n1 "$playlist_sel")" ]; then
            ULTIMO_ARQUIVO=$(head -n1 "$playlist_sel")
            registrar_status
            if eh_arquivo_texto "$ULTIMO_ARQUIVO"; then
                mostrar_texto "$ULTIMO_ARQUIVO"
            else
                tocar_arquivo "$ULTIMO_ARQUIVO"
            fi
        fi
        rm -f "$playlist_sel"
        continue
    fi

    if [[ "$primeiro_caminho" =~ \.\.$ ]]; then
        # Salva posição desta pasta; sobe; restaura posição do pai (fica no dir de onde saiu)
        local_dir_antes=$(pwd)
        local_nome=$(basename -- "$local_dir_antes")
        salvar_posicao_dir "$local_dir_antes" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
        cd .. || true
        carregar_posicao_dir "$(pwd)"
        # Preferência: cursor no diretório filho de onde viemos
        ULTIMO_ARQUIVO="$local_nome"
        ALVO="$(pwd)"
        ULTIMO_DIR="$(pwd)"
        registrar_status
        salvar_sessao
        continue
    fi

    if [ -d "$primeiro_caminho" ]; then
        # Salva posição atual; entra; restaura posição salva da pasta destino
        salvar_posicao_dir "$(pwd)" "${TMP:-1}" "${ULTIMO_ARQUIVO:-$primeiro_caminho}"
        cd "$primeiro_caminho" || true
        ULTIMO_ARQUIVO=""
        carregar_posicao_dir "$(pwd)"
        ALVO="$(pwd)"
        ULTIMO_DIR="$(pwd)"
        registrar_status
        salvar_sessao
        continue
    fi

    if [ -f "$primeiro_caminho" ]; then
        # Extrai caminhos absolutos da seleção (TAB/ESPAÇO)
        playlist_sel="/tmp/eazy_sel_play_$$"
        : > "$playlist_sel"
        : > "$SELECTED_FILE"
        while IFS= read -r linha; do
            [ -z "$linha" ] && continue
            p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
            [ -z "$p" ] && continue
            p_abs=$(caminho_absoluto "$p")
            printf '%s\n' "$p_abs" >> "$playlist_sel"
            printf '%s\n' "$p_abs" >> "$SELECTED_FILE"
        done <<< "$escolha"
        total_sel=$(grep -c '^' "$playlist_sel" 2>/dev/null || echo 0)
        total_sel=$(echo "$total_sel" | tr -cd '0-9')
        total_sel=${total_sel:-0}

        if [ "$total_sel" -gt 1 ]; then
            # Várias marcas → toca todas em sequência
            ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
            registrar_status
            tocar_lista "$playlist_sel"
        elif [ "$total_sel" -eq 1 ]; then
            tocado=$(head -n1 "$playlist_sel")
            ULTIMO_ARQUIVO="$tocado"
            registrar_status
            if eh_arquivo_texto "$tocado"; then
                mostrar_texto "$tocado"
            else
                ext="${tocado##*.}"
                ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
                if [[ "$ext" =~ ^(m3u|pls)$ ]]; then
                    tocar_lista "$tocado"
                else
                    tocar_arquivo "$tocado"
                fi
            fi
        fi
        rm -f "$playlist_sel"
    fi
done
