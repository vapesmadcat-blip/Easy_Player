    elif command -v apk &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mapk\033[0m"
        sudo apk update 2>/dev/null || true
        sudo apk add "${PKGS_APK[@]}" 2>/dev/null || true
        sudo apk upgrade "${PKGS_APK[@]}" 2>/dev/null || true
        atualizou=1
    else
        echo -e "\033[1;31mNenhum gerenciador conhecido (apt/pacman/dnf/zypper/apk).\033[0m" >&2
        exit 1
    fi

    echo -e "\n\033[1;36m--- yt-dlp (binário oficial GitHub) ---\033[0m"
    DEST_YT="${HOME}/.local/bin"
