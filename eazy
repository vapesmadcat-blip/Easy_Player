# Uma linha TSV por caminho: bytes \t \t label_tamanho \t nome \t caminho
eazy_path_to_tsv_line() {
    local caminho="$1" nome bytes label
    [ -z "$caminho" ] && return 0
    caminho=$(printf '%s' "$caminho" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$caminho" ] && return 0
    case "$caminho" in ..|./..) return 0 ;; esac
    if [[ "$caminho" != /* ]]; then
        caminho=$(caminho_absoluto "$caminho" 2>/dev/null || printf '%s/%s' "$(pwd -P)" "$caminho")
    fi
    nome=$(basename -- "$caminho" 2>/dev/null || printf '%s' "$caminho")
    bytes=0
    if [ -e "$caminho" ]; then
        bytes=$(du -sb -- "$caminho" 2>/dev/null | awk '{print $1}')
        bytes=${bytes:-0}
    fi
    if command -v formatar_bytes_label >/dev/null 2>&1 || type formatar_bytes_label >/dev/null 2>&1; then
        label=$(formatar_bytes_label "$bytes" 2>/dev/null || echo "$bytes")
    elif command -v numfmt >/dev/null 2>&1; then
        label=$(numfmt --to=iec --suffix=B "$bytes" 2>/dev/null || echo "$bytes")
    else
        label="$bytes"
    fi
    printf '%s\t\t%s\t%s\t%s\n' "$bytes" "$label" "$nome" "$caminho"
}

# Converte caminhos (um por linha) em TSV
eazy_paths_file_to_tsv() {
    local src="$1" out="$2" p
    : > "$out" || return 1
    [ -f "$src" ] || return 0
    while IFS= read -r p || [ -n "$p" ]; do
        [ -z "$p" ] && continue
        eazy_path_to_tsv_line "$p" >> "$out"
    done < "$src"
}

# Lista visível do fzf → TSV (respeita filtro digitado)
eazy_capturar_lista_tela_tsv() {
    local out="$1"
    local q="${2:-${FZF_QUERY:-}}"
    local tmp linha plain caminho
    : > "$out" || return 1
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-html-capt.XXXXXX") || return 1

    if [ -f "${LISTA_FZF_FILE:-}" ]; then
        eazy_lista_filtrada "$q" > "$tmp" 2>/dev/null || true
    else
        : > "$tmp"
    fi

    while IFS= read -r linha || [ -n "$linha" ]; do
        [ -z "$linha" ] && continue
        plain=$(printf '%s' "$linha" | sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g')
        caminho=$(printf '%s' "$plain" | awk -F '\t' '{print $NF}')
        caminho=$(printf '%s' "$caminho" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$caminho" ] && continue
        case "$caminho" in ..|./..) continue ;; esac
        # (navegação tratada por eazy_eh_navegacao acima)
        eazy_eh_navegacao "$plain" 2>/dev/null && continue
        eazy_path_to_tsv_line "$caminho" >> "$out"
    done < "$tmp"
    rm -f "$tmp"
    return 0
}

# Conta itens não vazios em arquivo
eazy_count_lines() {
    local f="$1" n
    [ -f "$f" ] || { echo 0; return; }
    n=$(grep -cve '^[[:space:]]*$' "$f" 2>/dev/null || echo 0)
    printf '%s' "$n" | tr -cd '0-9'
    echo
}

# Decide fonte: seleção (se houver) ou tela inteira
eazy_capturar_export_tsv() {
    local out="$1"
    local escopo_var="${2:-_eazy_export_escopo}"
    local n_sel=0 src=""

    : > "$out" || return 1

    if [ "${MODO_DUP:-0}" -eq 1 ] && [ -s "${DUP_SELECTED_FILE:-}" ]; then
        n_sel=$(eazy_count_lines "$DUP_SELECTED_FILE")
        n_sel=${n_sel:-0}
        if [ "$n_sel" -gt 0 ]; then
            eazy_paths_file_to_tsv "$DUP_SELECTED_FILE" "$out"
            eval "$escopo_var=\"Seleção de duplicados ($n_sel item(ns))\""
            return 0
        fi
    fi

    if [ -s "${SELECTED_FILE:-}" ]; then
        n_sel=$(eazy_count_lines "$SELECTED_FILE")
        n_sel=${n_sel:-0}
        if [ "$n_sel" -gt 0 ]; then
            eazy_paths_file_to_tsv "$SELECTED_FILE" "$out"
            # inclui dirs marcados se existirem
            if [ -s "${SELECTED_DIRS_FILE:-}" ]; then
                eazy_paths_file_to_tsv "$SELECTED_DIRS_FILE" "${out}.dirs"
                cat "${out}.dirs" >> "$out" 2>/dev/null || true
                rm -f "${out}.dirs"
            fi
            n_sel=$(eazy_count_lines "$out")
            eval "$escopo_var=\"Seleção marcada ($n_sel item(ns))\""
            return 0
        fi
    fi

    eazy_capturar_lista_tela_tsv "$out" "${FZF_QUERY:-}"
    eval "$escopo_var=\"Conteúdo da tela (filtro/pesquisa inclusos)\""
    return 0
}


# --- árvore HTML (expand all) ---
eazy_html_build_tree() {
    local tsv="$1"
    # Gera <details> aninhados por pasta a partir da coluna de caminho (última ou $5)
    awk -F '\t' '
    function esc(s,  t) {
        t = s
        gsub(/&/, "\\&amp;", t); gsub(/</, "\\&lt;", t); gsub(/>/, "\\&gt;", t); gsub(/"/, "\\&quot;", t)
        return t
    }
    function file_url(p,  u) {
        u = p
        gsub(/%/, "%25", u); gsub(/ /, "%20", u)
        return "file://" u
    }
    {
        bytes = $1 + 0
        # caminho: última coluna não vazia
        path = $NF
        if (path == "" || path == ".." || path ~ /Voltar/) next
        # tamanho legível simples
        if (bytes >= 1073741824) sz = sprintf("%.1f GB", bytes/1073741824)
        else if (bytes >= 1048576) sz = sprintf("%.1f MB", bytes/1048576)
        else if (bytes >= 1024) sz = sprintf("%.0f KB", bytes/1024)
        else sz = bytes " B"
        n = split(path, parts, "/")
        # paths absolutos começam com "" parts[1]
        key = ""
        for (i = 1; i <= n; i++) {
            if (parts[i] == "" && i == 1) continue
            parent = key
            if (key == "") key = "/" parts[i]
            else key = key "/" parts[i]
            if (!(key in seen_dir) && i < n) {
                seen_dir[key] = 1
                parent_of[key] = parent
                name_of[key] = parts[i]
                is_dir[key] = 1
                order[++nd] = key
            }
            if (i == n) {
                files[key] = 1
                f_parent[key] = parent
                f_name[key] = parts[i]
                f_sz[key] = sz
                f_url[key] = file_url(path)
                forder[++nf] = key
            }
        }
    }
    function emit_dir(d,    i, k, children) {
        if (emitted[d]++) return
        print "<details open class=\"tdir\">"
        print "<summary>" esc(name_of[d] == "" ? d : name_of[d]) "</summary>"
        for (i = 1; i <= nd; i++) {
            k = order[i]
            if (parent_of[k] == d) emit_dir(k)
        }
        for (i = 1; i <= nf; i++) {
            k = forder[i]
            if (f_parent[k] == d) {
                print "<div class=\"file\"><a href=\"" f_url[k] "\">" esc(f_name[k]) "</a>" \
                      "<span class=\"sz\">" f_sz[k] "</span></div>"
            }
        }
        print "</details>"
    }
    END {
        # raízes: dirs cujo parent não está em seen_dir (ou parent vazio)
        for (i = 1; i <= nd; i++) {
            k = order[i]
            p = parent_of[k]
            if (p == "" || !(p in seen_dir)) roots[++nr] = k
        }
        if (nr == 0) {
            # só ficheiros na raiz
            for (i = 1; i <= nf; i++) {
                k = forder[i]
                print "<div class=\"file\"><a href=\"" f_url[k] "\">" esc(f_name[k]) "</a>" \
                      "<span class=\"sz\">" f_sz[k] "</span></div>"
            }
        } else {
            for (i = 1; i <= nr; i++) emit_dir(roots[i])
        }
    }
    ' "$tsv" 2>/dev/null
}

