#!/usr/bin/env bash
#
#  eazy — navegador e reprodutor multimídia no terminal
#  https://github.com/ (local)  |  fzf + mpv/mplayer/cvlc/ffplay
#
#  Licença: uso livre. Sem garantias.
#
set -o pipefail

EAZY_VERSION="3.0"
EAZY_CODENAME="professional"
EAZY_NAME="eazy"

# --- DIRETÓRIOS E ARQUIVOS DE CONFIGURAÇÃO ---
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eazy"
CONFIG_FILE="$CONFIG_DIR/config"
DOWNLOAD_QUEUE="$CONFIG_DIR/download_queue"
DOWNLOAD_PASSWORDS="$CONFIG_DIR/download_passwords"
HISTORY_FILE="$CONFIG_DIR/history"
PLAYLIST_PERSISTENTE="$CONFIG_DIR/temp_playlist"   # legado → migrado para _1
PLAYLIST_1="$CONFIG_DIR/temp_playlist_1"
PLAYLIST_2="$CONFIG_DIR/temp_playlist_2"
PLAYLIST_3="$CONFIG_DIR/temp_playlist_3"
FILA_ATUAL=1   # 1, 2 ou 3
SESSION_FILE="$CONFIG_DIR/session"
POSITIONS_FILE="$CONFIG_DIR/dir_positions"
MARK_DELETE_FILE="$CONFIG_DIR/marked_delete"
MPV_SCRIPT_DIR="$CONFIG_DIR/mpv_scripts"

# --- VALORES PADRÃO (FALLBACKS) ---
TELA_PADRAO="fs"
OSD_PADRAO="1"
VOL_PADRAO="100"
DIR_PADRAO="$PWD"
PLAYLIST_DIR_PADRAO="${HOME}/Playlists"
PLAYER_PADRAO="mpv"
SEM_AUDIO="0"       # 1 = vídeo sem áudio (mute)
PREVIEW_ATIVO="0"   # 0=desligado (padrão) | 1=ligado — persiste entre sessões

# Carrega as configurações salvas, se existirem
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi
# Garante default se config antiga não tiver a chave
PREVIEW_ATIVO="${PREVIEW_ATIVO:-0}"
SEM_AUDIO="${SEM_AUDIO:-0}"

# --- FUNÇÃO DE CONFIGURAÇÃO (WIZARD WHIPTAIL) ---
configurar_defaults() {
    mkdir -p "$CONFIG_DIR"

    local nova_tela
    nova_tela=$(whiptail --title "Configuração: Modo de Tela" \
        --radiolist "Modo de vídeo padrão (Espaço marca, Enter avança):" 15 60 2 \
        "fs" "Tela Cheia (Fullscreen)" $( [ "$TELA_PADRAO" = "fs" ] && echo "ON" || echo "OFF" ) \
        "janela" "Modo Janela" $( [ "$TELA_PADRAO" = "janela" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    [ -n "$nova_tela" ] && TELA_PADRAO="$nova_tela"

    local novo_osd
    novo_osd=$(whiptail --title "Configuração: OSD (On-Screen Display)" \
        --radiolist "Detalhes exibidos na tela do player (Espaço marca, Enter avança):" 16 65 4 \
        "0" "Ocultar tudo" $( [ "$OSD_PADRAO" = "0" ] && echo "ON" || echo "OFF" ) \
        "1" "Mostrar volume/tempo (Padrão)" $( [ "$OSD_PADRAO" = "1" ] && echo "ON" || echo "OFF" ) \
        "2" "Mostrar barra de progresso" $( [ "$OSD_PADRAO" = "2" ] && echo "ON" || echo "OFF" ) \
        "3" "Mostrar tempo total" $( [ "$OSD_PADRAO" = "3" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    [ -n "$novo_osd" ] && OSD_PADRAO="$novo_osd"

    local novo_vol
    novo_vol=$(whiptail --title "Configuração: Volume Padrão" \
        --inputbox "Digite o volume inicial (0 a 100):" 10 60 "$VOL_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -n "$novo_vol" ] && VOL_PADRAO="$novo_vol"

    local novo_dir
    novo_dir=$(whiptail --title "Configuração: Diretório Inicial Padrão" \
        --inputbox "Caminho da pasta que o eazy deve abrir ao iniciar:" 10 65 "$DIR_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -n "$novo_dir" ] && DIR_PADRAO="$novo_dir"

    local novo_pl_dir
    novo_pl_dir=$(whiptail --title "Configuração: Pasta Padrão de Playlists" \
        --inputbox "Pasta onde as playlists serão salvas por padrão:\n(ex: $HOME/Playlists)" 11 70 "$PLAYLIST_DIR_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -n "$novo_pl_dir" ] && PLAYLIST_DIR_PADRAO="$novo_pl_dir"

    local novo_player
    novo_player=$(whiptail --title "Configuração: Player de Mídia" \
        --radiolist "Escolha o player padrão (Espaço marca, Enter confirma):\n(cvlc e ffplay precisam estar instalados)" 16 68 4 \
        "mpv" "mpv (recomendado)" $( [ "$PLAYER_PADRAO" = "mpv" ] && echo "ON" || echo "OFF" ) \
        "mplayer" "mplayer (clássico)" $( [ "$PLAYER_PADRAO" = "mplayer" ] && echo "ON" || echo "OFF" ) \
        "cvlc" "VLC CLI (cvlc)" $( [ "$PLAYER_PADRAO" = "cvlc" ] && echo "ON" || echo "OFF" ) \
        "ffplay" "ffplay (FFmpeg)" $( [ "$PLAYER_PADRAO" = "ffplay" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    [ -n "$novo_player" ] && PLAYER_PADRAO="$novo_player"

    # Checkbox: vídeo sem áudio
    local audio_sel
    audio_sel=$(whiptail --title "Áudio do player" --checklist \
        "Espaço marca, Enter confirma:" 10 55 1 \
        "SEM_AUDIO" "Sem áudio (vídeo mudo)" $( [ "${SEM_AUDIO:-0}" = "1" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    if echo "$audio_sel" | grep -q "SEM_AUDIO"; then
        SEM_AUDIO="1"
    else
        SEM_AUDIO="0"
    fi

    # Preserva PREVIEW_ATIVO se já existir no config
    local preview_keep="${PREVIEW_ATIVO:-0}"
    [ -f "$CONFIG_FILE" ] && preview_keep=$(grep '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || echo "$preview_keep")

    cat <<EOF > "$CONFIG_FILE"
TELA_PADRAO="$TELA_PADRAO"
OSD_PADRAO="$OSD_PADRAO"
VOL_PADRAO="$VOL_PADRAO"
DIR_PADRAO="$DIR_PADRAO"
PLAYLIST_DIR_PADRAO="$PLAYLIST_DIR_PADRAO"
PLAYER_PADRAO="$PLAYER_PADRAO"
SEM_AUDIO="$SEM_AUDIO"
PREVIEW_ATIVO="$preview_keep"
EOF
    whiptail --title "Sucesso" --msgbox "Configurações salvas com sucesso em:\n$CONFIG_FILE\n\nPlayer: $PLAYER_PADRAO\nSem áudio: $([ "$SEM_AUDIO" = "1" ] && echo "SIM" || echo "NÃO")" 12 55
}

# --- FUNÇÃO DE AJUDA VISUAL (WHIPTAIL) ---
