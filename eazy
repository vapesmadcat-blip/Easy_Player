# --- TRATAMENTO DE ARGUMENTOS INICIAIS ---
if [ "$1" = "--install" ]; then
    echo -e "\033[1;36m=== ${EAZY_NAME} ${EAZY_VERSION} — instalador ===\033[0m"

    # Mapa pacote → binário (quando diferem)
    bin_do_pkg() {
        case "$1" in
            gawk) echo awk ;;
            findutils) echo find ;;
            aria2) echo aria2c ;;
            p7zip-full|p7zip) echo 7z ;;
            libnewt|newt) echo whiptail ;;
            *) echo "$1" ;;
        esac
    }

    instalar_pkgs() {
        local mgr="$1"; shift
        local -a pkgs=("$@") falt=()
        local p b
        for p in "${pkgs[@]}"; do
            b=$(bin_do_pkg "$p")
            command -v "$b" &>/dev/null || falt+=("$p")
        done
        if [ ${#falt[@]} -eq 0 ]; then
            echo -e "\033[1;32m✓ Dependências principais OK\033[0m"
            return 0
        fi
        echo -e "\033[1;33mAusentes: ${falt[*]}\033[0m"
        case "$mgr" in
            apt)
                echo -e "  \033[0;90msudo apt update && sudo apt install -y ${falt[*]}\033[0m"
                sudo apt update && sudo apt install -y "${falt[@]}"
                ;;
            pacman)
                echo -e "  \033[0;90msudo pacman -S --needed ${falt[*]}\033[0m"
                sudo pacman -S --needed --noconfirm "${falt[@]}"
                ;;
            dnf)
                echo -e "  \033[0;90msudo dnf install -y ${falt[*]}\033[0m"
                sudo dnf install -y "${falt[@]}"
                ;;
            zypper)
                echo -e "  \033[0;90msudo zypper install -y ${falt[*]}\033[0m"
                sudo zypper install -y "${falt[@]}"
                ;;
            apk)
                echo -e "  \033[0;90msudo apk add ${falt[*]}\033[0m"
                sudo apk add "${falt[@]}"
                ;;
        esac
    }

    if command -v apt-get &>/dev/null || command -v apt &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mapt\033[0m"
        instalar_pkgs apt fzf mpv mplayer gawk sed findutils whiptail wget axel aria2 unzip p7zip-full rar yt-dlp
        echo -e "\033[0;90mOpcionais: sudo apt install -y chafa ffmpeg vlc\033[0m"
        echo -e "\033[0;90mNota: pacote 'rar' (non-free) — RAR oficial; não usamos unrar.\033[0m"
    elif command -v pacman &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mpacman\033[0m"
        # Arch: rar costuma estar no AUR; 7z como fallback na extração
        instalar_pkgs pacman fzf mpv mplayer gawk sed findutils libnewt wget axel aria2 unzip p7zip yt-dlp
    elif command -v dnf &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mdnf\033[0m"
        instalar_pkgs dnf fzf mpv mplayer gawk sed findutils newt wget axel aria2 unzip p7zip p7zip-plugins yt-dlp
    elif command -v zypper &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mzypper\033[0m"
        instalar_pkgs zypper fzf mpv mplayer gawk sed findutils newt wget axel aria2 unzip p7zip yt-dlp
    elif command -v apk &>/dev/null; then
        echo -e "Gerenciador: \033[1;37mapk\033[0m (Alpine)"
        instalar_pkgs apk fzf mpv mplayer gawk sed findutils newt wget axel aria2 unzip p7zip yt-dlp
    else
        echo -e "\033[1;31mNenhum gerenciador conhecido (apt/pacman/dnf/zypper/apk).\033[0m" >&2
        echo -e "Instale manualmente: fzf mpv whiptail gawk findutils wget" >&2
        exit 1
    fi

    SCRIPT_ATUAL="$(readlink -f "$0")"
    DESTINO="/usr/local/bin/eazy"
    SCRIPT_DIR="$(dirname -- "$SCRIPT_ATUAL")"
    DESKTOP_SRC="$SCRIPT_DIR/eazy.desktop"
    DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

    echo -e "\033[1;34mInstalando comando global em $DESTINO...\033[0m"
    if sudo cp "$SCRIPT_ATUAL" "$DESTINO" && sudo chmod +x "$DESTINO"; then
        echo -e "\033[1;32m✓\033[0m Comando: \033[1;37meazy\033[0m"
    else
        echo -e "\033[1;31m✗\033[0m Falha ao copiar para $DESTINO" >&2
        exit 1
    fi

    if [ -f "$DESKTOP_SRC" ]; then
        mkdir -p "$DESKTOP_DIR"
        cp "$DESKTOP_SRC" "$DESKTOP_DIR/eazy.desktop"
        echo -e "\033[1;32m✓\033[0m Launcher: $DESKTOP_DIR/eazy.desktop"
        command -v update-desktop-database &>/dev/null && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    fi

    echo -e "\n\033[1;32m${EAZY_NAME} ${EAZY_VERSION} instalado.\033[0m"
    echo -e "  ${EAZY_NAME} --help"
    echo -e "  ${EAZY_NAME} ~/Videos"
    exit 0

elif [ "$1" = "--uninstall" ]; then
    echo -e "\033[1;36m=== ${EAZY_NAME} — desinstalação ===\033[0m"
    REMOVIDO=0
    if [ -f /usr/local/bin/eazy ]; then
        sudo rm -f /usr/local/bin/eazy && echo -e "\033[1;32m✓\033[0m /usr/local/bin/eazy" && REMOVIDO=1
    fi
    if [ -f /usr/bin/eazy ]; then
        sudo rm -f /usr/bin/eazy && echo -e "\033[1;32m✓\033[0m /usr/bin/eazy" && REMOVIDO=1
    fi
    DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    [ -f "$DESKTOP_DIR/eazy.desktop" ] && rm -f "$DESKTOP_DIR/eazy.desktop" && echo -e "\033[1;32m✓\033[0m launcher local"
    [ -f /usr/share/applications/eazy.desktop ] && sudo rm -f /usr/share/applications/eazy.desktop && echo -e "\033[1;32m✓\033[0m launcher sistema"
    # Pacote .deb / rpm instalado
    if command -v dpkg &>/dev/null && dpkg -l eazy &>/dev/null; then
        echo -e "Pacote deb detectado: \033[1;33msudo apt remove eazy\033[0m"
    fi
    if command -v pacman &>/dev/null && pacman -Q eazy &>/dev/null; then
        echo -e "Pacote arch detectado: \033[1;33msudo pacman -R eazy\033[0m"
    fi
    if command -v rpm &>/dev/null && rpm -q eazy &>/dev/null; then
        echo -e "Pacote rpm detectado: \033[1;33msudo dnf remove eazy\033[0m"
    fi
    echo -e "\033[0;90mConfig em ~/.config/eazy/ preservada (remova manualmente se quiser).\033[0m"
    [ "$REMOVIDO" -eq 0 ] && echo -e "Nada encontrado em /usr/local/bin ou /usr/bin."
    exit 0
elif [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    exibir_help_cli
    exit 0
elif [ "$1" = "--version" ] || [ "$1" = "-V" ]; then
    echo "${EAZY_NAME} ${EAZY_VERSION} (${EAZY_CODENAME})"
    exit 0
elif [ "$1" = "--config" ]; then
    configurar_defaults
    exit 0
elif [ "$1" = "--update-ytdlp" ]; then
    # Atualiza yt-dlp SEM pip (baixa binário oficial do GitHub)
    DEST_YT="$HOME/.local/bin"
    mkdir -p "$DEST_YT"
    URL_YT="https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp"
    echo -e "\033[1;36mBaixando yt-dlp mais recente (sem pip)...\033[0m"
    if command -v curl &>/dev/null; then
        curl -L --fail -o "$DEST_YT/yt-dlp" "$URL_YT" || {
            echo -e "\033[1;31mFalha no download.\033[0m"; exit 1
        }
    elif command -v wget &>/dev/null; then
        wget -O "$DEST_YT/yt-dlp" "$URL_YT" || {
            echo -e "\033[1;31mFalha no download.\033[0m"; exit 1
        }
    else
        echo -e "\033[1;31mPrecisa de curl ou wget.\033[0m"
        exit 1
    fi
    chmod a+rx "$DEST_YT/yt-dlp"
    # Garante que ~/.local/bin está no PATH desta sessão
    export PATH="$DEST_YT:$PATH"
    echo -e "\033[1;32mOK → $DEST_YT/yt-dlp\033[0m"
    echo -e "Versão: $($DEST_YT/yt-dlp --version 2>/dev/null || echo '?')"
    echo -e "\nSe 'yt-dlp' não for encontrado em novos terminais, adicione ao ~/.bashrc:"
    echo -e "  export PATH=\"\$HOME/.local/bin:\$PATH\""
    exit 0
fi

# Inicialização com base nas configurações
MODO_ATUAL="tamanho"
TELA_ATUAL="$TELA_PADRAO"
FILTRO_ATUAL="ambos"
FILTRO_ANTERIOR="ambos"
FZF_QUERY=""          # filtro digitado no fzf — persiste até o usuário apagar
TMP=1
TMP_FILE="/tmp/fzf_tmp_$$"
DUP_FILE="/tmp/fzf_dup_$$"
SELECTED_FILE="/tmp/fzf_selected_$$"
mkdir -p "$CONFIG_DIR" 2>/dev/null || true
# Migra fila legada e garante 3 filas
[ -f "$PLAYLIST_PERSISTENTE" ] && [ ! -f "$PLAYLIST_1" ] && mv "$PLAYLIST_PERSISTENTE" "$PLAYLIST_1" 2>/dev/null || true
touch "$PLAYLIST_1" "$PLAYLIST_2" "$PLAYLIST_3"
FILA_ATUAL="${FILA_ATUAL:-1}"
case "$FILA_ATUAL" in 1|2|3) ;; *) FILA_ATUAL=1 ;; esac
PLAYLIST_FILE="$CONFIG_DIR/temp_playlist_${FILA_ATUAL}"

# Atualiza PLAYLIST_FILE conforme FILA_ATUAL
atualizar_fila_atual() {
    case "${FILA_ATUAL:-1}" in
        2) PLAYLIST_FILE="$PLAYLIST_2" ;;
        3) PLAYLIST_FILE="$PLAYLIST_3" ;;
        *) FILA_ATUAL=1; PLAYLIST_FILE="$PLAYLIST_1" ;;
    esac
}

# Conta itens de uma fila (1/2/3)
contar_fila() {
    local n f
    f="$CONFIG_DIR/temp_playlist_${1}"
    n=$(grep -c '^' "$f" 2>/dev/null || echo 0)
    echo "$n" | tr -cd '0-9'
}

MODO_PLAYLIST=0
MODO_BUSCA=0
MODO_DUP=0
MODO_DOWNLOAD=0
ARQUIVO_PLAYLIST_ABERTO=""
ALVO=""
ULTIMO_ARQUIVO=""
ULTIMO_DIR=""

# --- Persistência: posição por diretório ---
salvar_posicao_dir() {
    local dir="$1" pos="$2" item="${3:-}"
    [ -z "$dir" ] && return
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    touch "$POSITIONS_FILE"
    # remove entrada antiga deste dir
    grep -vF "|${dir}|" "$POSITIONS_FILE" 2>/dev/null | grep -v "^${dir}|" > "${POSITIONS_FILE}.tmp" 2>/dev/null || true
    # formato: DIR|POS|ITEM
    printf '%s|%s|%s\n' "$dir" "$pos" "$item" >> "${POSITIONS_FILE}.tmp"
    # limpa linhas vazias e mantém últimas 500 pastas
    grep -v '^$' "${POSITIONS_FILE}.tmp" 2>/dev/null | tail -n 500 > "$POSITIONS_FILE"
    rm -f "${POSITIONS_FILE}.tmp"
}

carregar_posicao_dir() {
    # define TMP e ULTIMO_ARQUIVO a partir do mapa de posições
    local dir="$1"
    [ -z "$dir" ] || [ ! -f "$POSITIONS_FILE" ] && { TMP="${TMP:-1}"; return; }
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    local linha pos item
    linha=$(awk -F'|' -v d="$dir" '$1 == d {line=$0} END {print line}' "$POSITIONS_FILE" 2>/dev/null)
    [ -z "$linha" ] && { TMP="${TMP:-1}"; return; }
    pos=$(echo "$linha" | cut -d'|' -f2)
    item=$(echo "$linha" | cut -d'|' -f3-)
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    TMP="$pos"
    [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
}

# Salva sessão completa (ao sair ou periodicamente)
salvar_sessao() {
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    local cwd
    cwd=$(pwd)
    # posição atual
    salvar_posicao_dir "$cwd" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
    cat > "$SESSION_FILE" <<EOF
EAZY_CWD=$(printf '%q' "$cwd")
MODO_ATUAL=$(printf '%q' "${MODO_ATUAL:-tamanho}")
FILTRO_ATUAL=$(printf '%q' "${FILTRO_ATUAL:-ambos}")
FILTRO_ANTERIOR=$(printf '%q' "${FILTRO_ANTERIOR:-ambos}")
TELA_ATUAL=$(printf '%q' "${TELA_ATUAL:-fs}")
PREVIEW_ATIVO=$(printf '%q' "${PREVIEW_ATIVO:-0}")
ULTIMO_ARQUIVO=$(printf '%q' "${ULTIMO_ARQUIVO:-}")
TMP=$(printf '%q' "${TMP:-1}")
EOF
    # preview também no config permanente
    if [ -f "$CONFIG_FILE" ]; then
        if grep -q '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s|^PREVIEW_ATIVO=.*|PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"|" "$CONFIG_FILE"
        else
            echo "PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"" >> "$CONFIG_FILE"
        fi
    else
        echo "PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"" > "$CONFIG_FILE"
    fi
}

carregar_sessao() {
    [ ! -f "$SESSION_FILE" ] && return 1
    # shellcheck disable=SC1090
    source "$SESSION_FILE" 2>/dev/null || return 1
    if [ -n "${EAZY_CWD:-}" ] && [ -d "$EAZY_CWD" ]; then
        cd "$EAZY_CWD" || true
    fi
