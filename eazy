elif [ "$1" = "--torrent" ]; then
    shift
    torrent_cmd="${EAZY_INSTALL_DIR}/eazy-tor"
    [ -x "$torrent_cmd" ] || torrent_cmd="$(command -v eazy-tor 2>/dev/null || true)"
