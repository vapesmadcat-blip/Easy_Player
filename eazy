eazy_menu_listas_ctrlp() {
    local n1 n2 n3 nh nd ns escolha custom_nome custom_count sql_table sql_view
    local menu_args=()
    eazy_sql_lists_require || return 1
    if [ "${EAZY_IGNORE:-0}" = "1" ]; then
        touch "$PLAYLIST_1" "$PLAYLIST_2" "$PLAYLIST_3" 2>/dev/null || true
    fi
    eazy_dup_results_init || true
    n1=$(contar_fila 1 2>/dev/null || echo 0); n1=$(printf '%s' "$n1" | tr -cd '0-9'); n1=${n1:-0}
    n2=$(contar_fila 2 2>/dev/null || echo 0); n2=$(printf '%s' "$n2" | tr -cd '0-9'); n2=${n2:-0}
    n3=$(contar_fila 3 2>/dev/null || echo 0); n3=$(printf '%s' "$n3" | tr -cd '0-9'); n3=${n3:-0}
    nh=$(eazy_history_db_count 2>/dev/null || echo 0)
    nh=$(printf '%s' "$nh" | tr -cd '0-9'); nh=${nh:-0}
    nd=$(contar_dup_lista 2>/dev/null || echo 0); nd=$(printf '%s' "$nd" | tr -cd '0-9'); nd=${nd:-0}
    if [ "${EAZY_SQL_SELECTION:-0}" = 1 ]; then
        ns=$("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --selection-count --selection-state 2 2>/dev/null || echo 0)
    else
        ns=$(grep -cve '^[[:space:]]*$' "${SELECTED_FILE:-/dev/null}" 2>/dev/null || echo 0)
    fi
    ns=$(printf '%s' "$ns" | tr -cd '0-9'); ns=${ns:-0}
    menu_args+=(
        "dir"  "Diretorio atual  ($(pwd -P))"
        "1"    "Fila 1  ($n1 itens)"
        "2"    "Fila 2  ($n2 itens)"
        "3"    "Fila 3  ($n3 itens)"
        "global" "Seleção global  ($ns itens)"
        "hist" "Historico  ($nh itens)"
        "dup"  "Duplicados  ($nd itens)"
    )
    if [ "${EAZY_IGNORE:-0}" != "1" ]; then
        while IFS= read -r -d '' custom_nome && IFS= read -r -d '' custom_count; do
            case "$custom_nome" in temp_playlist_1|temp_playlist_2|temp_playlist_3) continue ;; esac
            if [ "$custom_nome" = "eazy_internal_last_search" ]; then
                menu_args+=("c:$custom_nome" "Última pesquisa  ($custom_count itens)")
            else
                menu_args+=("c:$custom_nome" "$custom_nome  ($custom_count itens)")
            fi
        done < <(eazy_sql_list_indexer --list-menu0 2>/dev/null)
    fi
    escolha=$(whiptail --title "Ctrl-P — Listas e filas" --menu \
        "Escolha a lista a abrir:" 22 78 12 "${menu_args[@]}" 3>&1 1>&2 2>&3) || return 1
    local posicao_origem; posicao_origem="$(pwd -P)"
    if [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -f "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        posicao_origem="$ARQUIVO_PLAYLIST_ABERTO"
    fi
    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        eazy_dup_salvar_lista 2>/dev/null || true
        posicao_origem="dup"
    fi
    salvar_posicao_dir "$posicao_origem" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
    MODO_BUSCA=0; MODO_DOWNLOAD=0
    case "$escolha" in
        dir)
            [ "${MODO_DUP:-0}" -eq 1 ] && eazy_dup_salvar_lista 2>/dev/null || true
            MODO_DUP=0; MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
            FILA_ATUAL=1; atualizar_fila_atual 2>/dev/null || true
            TMP=1; carregar_posicao_dir "$(pwd -P)"
            ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
            ;;
        1|2|3)
            MODO_DUP=0; FILA_ATUAL="$escolha"; atualizar_fila_atual 2>/dev/null || true
            MODO_PLAYLIST=1
            if [ "${EAZY_IGNORE:-0}" = "1" ]; then
                ARQUIVO_PLAYLIST_ABERTO="$PLAYLIST_FILE"
                touch "$ARQUIVO_PLAYLIST_ABERTO"
            else
                sql_table="temp_playlist_${escolha}"
                sql_view=$(eazy_sql_list_view_path "$sql_table") || return 1
                EAZY_SQL_LIST_VIEW_TABLE["$sql_view"]="$sql_table"
                eazy_sql_list_refresh_view "$sql_table" || return 1
                ARQUIVO_PLAYLIST_ABERTO="$sql_view"
            fi
            carregar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO"
            ;;
        global)
            MODO_DUP=0; MODO_PLAYLIST=1
            [ "${EAZY_SQL_SELECTION:-0}" = 1 ] && eazy_sql_selection_refresh "$(pwd -P)"
            ARQUIVO_PLAYLIST_ABERTO="$SELECTED_FILE"
            carregar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO"
            ;;
        hist)
            eazy_history_migrate_on_entry || return 1
            if [ "$(eazy_history_db_count 2>/dev/null || echo 0)" -eq 0 ] 2>/dev/null; then
                whiptail --title "Historico" --msgbox "Historico vazio." 8 40; return 1
            fi
            MODO_DUP=0; MODO_PLAYLIST=1; ARQUIVO_PLAYLIST_ABERTO="$HISTORY_FILE"
            carregar_posicao_dir "$HISTORY_FILE"
            ;;
        dup)
            MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
            eazy_dup_carregar_lista 2>/dev/null || : > "$DUP_FILE"
            eazy_dup_db --dup-marks-clear all >/dev/null 2>&1 || true
            : > "$DUP_SELECTED_FILE"; rm -f "$DUP_MANUAL_FILE" 2>/dev/null || true
            MODO_DUP=1; export MODO_DUP; carregar_posicao_dir "dup"
            ;;
        c:*)
            custom_nome="${escolha#c:}"
            MODO_DUP=0; MODO_PLAYLIST=1
            [ "${EAZY_IGNORE:-0}" != "1" ] || return 1
            sql_table="$custom_nome"
            sql_view=$(eazy_sql_list_view_path "$sql_table") || return 1
            EAZY_SQL_LIST_VIEW_TABLE["$sql_view"]="$sql_table"
            eazy_sql_list_refresh_view "$sql_table" || { whiptail --title "Lista SQLite" --msgbox "Não foi possível ler a tabela $sql_table." 9 55; return 1; }
            ARQUIVO_PLAYLIST_ABERTO="$sql_view"
            carregar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO"
            ;;
        *) return 1 ;;
    esac
    FZF_QUERY=""
    eazy_lista_cache_invalidate 2>/dev/null || true
    eazy_playlist_cache_invalidate 2>/dev/null || true
    registrar_status 2>/dev/null || true
    return 0
}

