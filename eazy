eazy_converter_playlist_m3u() {
    local lista="$1" resultado rc=0 destino direcao fs
    if [ ! -f "$EAZY_M3U_CONVERTER" ]; then
        whiptail --title "Conversor M3U" --msgbox "O conversor não foi encontrado:\n$EAZY_M3U_CONVERTER\n\nMantenha eazy-convert-m3u.py ao lado do Eazy ou instale o pacote completo." 11 76
        return 1
    fi
    if ! command -v "${PYTHON_CMD:-python3}" >/dev/null 2>&1; then
        whiptail --title "Conversor M3U" --msgbox "Python 3 não foi encontrado. Instale Python 3 e tente novamente." 9 64
        return 1
    fi
    direcao=$("${PYTHON_CMD:-python3}" "$EAZY_M3U_CONVERTER" auto "$lista" --detect-only 2>&1) || {
        whiptail --title 'Não foi possível detectar os caminhos' --msgbox "$direcao" 12 76
        return 1
    }
    case "$direcao" in
        linux-to-windows) destino="${M3U_WINDOWS_OUT_DIR:-}" ;;
        windows-to-linux) destino="${M3U_LINUX_OUT_DIR:-}" ;;
        *) whiptail --title 'Conversor M3U' --msgbox "Direção não reconhecida: $direcao" 9 70; return 1 ;;
    esac
    if [ -z "$destino" ]; then
        whiptail --title 'Integração não configurada' --msgbox "Configure a pasta de saída correspondente em F9 → Integração antes de converter." 10 72
        return 1
    fi
    if [ ! -d "$destino" ]; then
        whiptail --title 'Criar pasta de integração' --yesno "A pasta de destino não existe:\n$destino\n\nCriar agora?" 11 76 || return 0
        mkdir -p -- "$destino" || { whiptail --title 'Erro' --msgbox "Não foi possível criar:\n$destino" 9 70; return 1; }
    fi
    fs=$(eazy_m3u_filesystem_for_path "$destino")
    resultado=$("${PYTHON_CMD:-python3}" "$EAZY_M3U_CONVERTER" auto "$lista" \
        --windows-output-dir "$M3U_WINDOWS_OUT_DIR" \
        --linux-output-dir "$M3U_LINUX_OUT_DIR" \
        --distro "${WSL_DISTRO_NAME:-Ubuntu}" 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then
        whiptail --title "Conversor M3U" --msgbox "$resultado\n\nSistema de arquivos de destino: $fs\nO arquivo original foi preservado." 13 76
    else
        whiptail --title "Falha na conversão M3U" --msgbox "$resultado" 12 76
    fi
    return "$rc"
}

eazy_menu_playlist_m3u() {
