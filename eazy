import sqlite3, sys, time
db, path = sys.argv[1], sys.argv[2]
con = sqlite3.connect(db, timeout=10)
con.execute("UPDATE files SET deleted=1, deleted_at=? WHERE path=?", (int(time.time()), path))
con.commit()
con.close()
PY
}

# Sincroniza a posição real do fzf, inclusive Page Down/Page Up/Home/End.
# {n} é o índice zero-based do item atualmente focado; {2} é a linha inteira.
eazy_sync_cursor() {
    # Leve: só grava índice/item no TMP_FILE (chamado no focus do fzf)
    local idx="${1:-}" linha="${2:-}" item=""
    [ -n "${TMP_FILE:-}" ] || TMP_FILE="${EAZY_TMP_DIR:-/tmp}/fzf_tmp_$$"
    idx="${idx//[^0-9]/}"
    [ -n "$idx" ] || return 0
    TMP=$((idx + 1))
    # campo path é o último tab; evita awk se possível
    if [ -n "$linha" ]; then
        item="${linha##*$'\t'}"
        case "$item" in
            ..|*"◀ Voltar"*) item="" ;;
        esac
        # O handler de Del/ações precisa do item focado mesmo sem Enter.
        if [ -n "$item" ] && [ -n "${EAZY_CURSOR_ITEM_FILE:-}" ]; then
            printf '%s\n' "$linha" > "$EAZY_CURSOR_ITEM_FILE" 2>/dev/null || true
        fi
    fi
    # lê só o que precisa manter; uma escrita
    local _old_alvo _old_dir _old_modo
    IFS='|' read -r _ _old_alvo _ _old_dir _old_modo < "$TMP_FILE" 2>/dev/null || true
    printf "%s|%s|%s|%s|%s\n" "$TMP" "${_old_alvo:-${ALVO:-}}" "$item" "${_old_dir:-${ULTIMO_DIR:-}}" "${_old_modo:-${MODO_PLAYLIST:-0}}" > "$TMP_FILE"
}

obter_lista_rapida() {
    local C_DIR='\033[1;34m'
    local C_VID='\033[1;36m'
    local C_AUD='\033[1;33m'
    local C_IMG='\033[1;35m'
    local C_ZIP='\033[1;31m'
    local C_SIZE='\033[0;32m'
    local C_RESET='\033[0m'

    eazy_status_file "carregando" "$(pwd -P 2>/dev/null || pwd)" 2>/dev/null || true

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        printf "000000000000000\t%b[D] %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar aos Arquivos" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        if [ -s "$DOWNLOAD_QUEUE" ]; then
            while IFS='|' read -r engine link pass; do
                [ -z "$link" ] && continue
                local exib_link="$link"
                [ ${#exib_link} -gt 35 ] && exib_link="${exib_link:0:35}.."
                local exib_pass="Nenhuma"
                if [ -n "$pass" ]; then
                    exib_pass="••••••"
                fi
                printf "000000000000001\t%b📥 [%s] %-30s%b\t%b[Senha: %s]%b\t%s\n" \
                    "$C_VID" "$engine" "$exib_link" "$C_RESET" "$C_AUD" "$exib_pass" "$C_RESET" "$link"
            done < "$DOWNLOAD_QUEUE"
        fi
        eazy_status_file_clear 2>/dev/null || true
        return
    fi

    if [ "$MODO_PLAYLIST" -eq 1 ] && [ -f "$ARQUIVO_PLAYLIST_ABERTO" ]; then
        # Cache da apresentação; em listas SQL o conteúdo é reconsultado da tabela quando o cache é invalidado.
        local pl_mtime pl_key pl_cache pl_meta pl_dir pl_sql_table lookup_paths lookup_meta lookup_item lookup_res
        pl_sql_table=$(eazy_sql_list_table_for_view "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || true)
        pl_mtime=$(stat -c '%Y' -- "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || echo 0)
        pl_key="${ARQUIVO_PLAYLIST_ABERTO}|${pl_mtime}|${MODO_ATUAL:-tamanho}|${FILTRO_ATUAL:-ambos}|sz4|history-db-513|playlist-type-filter-v1"
        [ "$ARQUIVO_PLAYLIST_ABERTO" = "$HISTORY_FILE" ] && pl_key="${pl_key}|$(eazy_history_db_count 2>/dev/null || echo 0)"
        pl_cache="${EAZY_TMP_DIR}/pl_view_$(printf '%s' "$ARQUIVO_PLAYLIST_ABERTO" | md5sum 2>/dev/null | awk '{print $1}').cache"
        pl_meta="${pl_cache}.meta"
        if [ -s "$pl_cache" ] && [ -f "$pl_meta" ] && [ "$(cat "$pl_meta" 2>/dev/null)" = "$pl_key" ]; then
            cat "$pl_cache"
            return
        fi
        if [ -n "$pl_sql_table" ]; then
            # As listas SQL substituem arquivos legados que ficavam em CONFIG_DIR;
            # caminhos relativos migrados continuam relativos a essa pasta, não ao snapshot tmp.
            pl_dir="$CONFIG_DIR"
        else
            pl_dir=$(dirname "$ARQUIVO_PLAYLIST_ABERTO")
        fi
        {
            printf "000000000000000\t%b[D] %-40s%b\t%b[%-6s]%b\t..\n" \
                "$C_DIR" "◀ Voltar aos Arquivos" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"
            local hist_meta="" hist_source="$ARQUIVO_PLAYLIST_ABERTO"
            declare -gA EAZY_HIST_SIZE EAZY_HIST_MT EAZY_HIST_KIND EAZY_HIST_DUR
            EAZY_HIST_SIZE=(); EAZY_HIST_MT=(); EAZY_HIST_KIND=(); EAZY_HIST_DUR=()
            if [ "$ARQUIVO_PLAYLIST_ABERTO" = "$HISTORY_FILE" ]; then
                hist_source="${EAZY_TMP_DIR}/history_paths_$$"
                "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --history-list > "$hist_source" 2>/dev/null || :
                hist_meta="${EAZY_TMP_DIR}/history_meta_$$"
                eazy_history_bulk_lookup "$hist_meta"
                while IFS=$'\t' read -r _hs _hm _hk _hn _hp _hd _he _hx; do
                    [ -n "$_hp" ] || continue
                    EAZY_HIST_SIZE["$_hp"]="$_hs"
                    EAZY_HIST_MT["$_hp"]="$_hm"
                    EAZY_HIST_KIND["$_hp"]="$_hk"
                    EAZY_HIST_DUR["$_hp"]="$_hd"
                done < "$hist_meta"
                rm -f "$hist_meta"
            elif [ -n "$pl_sql_table" ]; then
                hist_source="${EAZY_TMP_DIR}/sql_playlist_paths_$$"
                if ! eazy_sql_list_indexer "--list-export=$pl_sql_table" > "$hist_source" 2>/dev/null; then
                    : > "$hist_source"
                    eazy_term_log "Falha ao ler diretamente a tabela SQLite da lista $pl_sql_table" 2>/dev/null || true
                fi
            fi
            if [ "$ARQUIVO_PLAYLIST_ABERTO" != "$HISTORY_FILE" ]; then
                # Uma única chamada SQLite para todos os itens, em vez de iniciar
                # Python/abrir o banco novamente para cada título da playlist.
                declare -gA EAZY_PLAYLIST_SIZE EAZY_PLAYLIST_MT EAZY_PLAYLIST_KIND EAZY_PLAYLIST_DELETED
                EAZY_PLAYLIST_SIZE=(); EAZY_PLAYLIST_MT=(); EAZY_PLAYLIST_KIND=(); EAZY_PLAYLIST_DELETED=()
                lookup_paths="${EAZY_TMP_DIR}/playlist_lookup_paths_$$.nul"
                lookup_meta="${EAZY_TMP_DIR}/playlist_lookup_meta_$$.tsv"
                : > "$lookup_paths"
                while IFS= read -r lookup_item || [ -n "$lookup_item" ]; do
                    lookup_item="${lookup_item%$'\r'}"
                    [ -n "$lookup_item" ] || continue
                    [[ "$lookup_item" =~ ^[[:space:]]*# ]] && continue
                    [[ "$lookup_item" =~ ^https?:// ]] && continue
                    lookup_res="$lookup_item"
                    [[ "$lookup_res" == /* ]] || lookup_res="$pl_dir/$lookup_res"
                    lookup_res="${lookup_res//\/\.\//\/}"
                    printf '%s\0' "$lookup_res" >> "$lookup_paths"
                done < "$hist_source"
                if [ -s "$lookup_paths" ] && [ -f "${EAZY_INDEX_DB:-}" ] && [ -f "${EAZY_INDEXER:-}" ]; then
                    "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --lookup0 \
                        < "$lookup_paths" > "$lookup_meta" 2>/dev/null || :
                    while IFS=$'\t' read -r _lsz _lmt _lkind _lname _lpath _ldur _lext; do
                        [ -n "$_lpath" ] || continue
                        EAZY_PLAYLIST_SIZE["$_lpath"]="$_lsz"
                        EAZY_PLAYLIST_MT["$_lpath"]="$_lmt"
                        case "$_lkind" in
                            d) EAZY_PLAYLIST_KIND["$_lpath"]="directory"; EAZY_PLAYLIST_DELETED["$_lpath"]=0 ;;
                            X) EAZY_PLAYLIST_KIND["$_lpath"]="directory"; EAZY_PLAYLIST_DELETED["$_lpath"]=1 ;;
                            x) EAZY_PLAYLIST_KIND["$_lpath"]="file"; EAZY_PLAYLIST_DELETED["$_lpath"]=1 ;;
                            *) EAZY_PLAYLIST_KIND["$_lpath"]="file"; EAZY_PLAYLIST_DELETED["$_lpath"]=0 ;;
                        esac
                    done < "$lookup_meta"
                fi
                rm -f "$lookup_paths" "$lookup_meta"
            fi
            while IFS= read -r item || [ -n "$item" ]; do
                [ -z "$item" ] && continue
                [[ "$item" =~ ^# ]] && continue
                item="${item%$'\r'}"
                local item_res="$item"
                [[ "$item" != /* ]] && item_res="$pl_dir/$item"
                item_res="${item_res//\/\.\//\/}"
                local nome_exib tipo_icone="[F]" tipo_cor="$C_SIZE" chave_ord=0 ext
                nome_exib="${item_res%/}"
                nome_exib="${nome_exib##*/}"
                [ -n "$nome_exib" ] || nome_exib="/"
                [ ${#nome_exib} -gt 38 ] && nome_exib="${nome_exib:0:38}.."
                ext="${item_res##*.}"
                ext="${ext,,}"
                case "$ext" in
                    mp4|wmv|flv|mkv|avi|mov|webm|m4v|mpg|mpeg|m2ts) tipo_icone="[V]"; tipo_cor="$C_VID" ;;
                    mp3|m4a|wav|flac|ogg|opus|aac|wma) tipo_icone="[A]"; tipo_cor="$C_AUD" ;;
                    webp|jpg|jpeg|png|gif|bmp|tif|tiff|svg) tipo_icone="[I]"; tipo_cor="$C_IMG" ;;
                    zip|tar|gz|bz2|xz|rar|7z|tgz) tipo_icone="[Z]"; tipo_cor="$C_ZIP" ;;
                esac
                case "${FILTRO_ATUAL:-ambos}" in
                    videos|audios|imgs|compactados)
                        [ -d "$item_res" ] && continue
                        eazy_lista_tipo_match_extension "$ext" "$FILTRO_ATUAL" || continue
                        ;;
                esac
                local _sz=0 _mb="?" _mt=0 _info="" _db_found=0 _db_deleted=0 _db_kind="" _stat_row="" _tenths=0
                if [ "$ARQUIVO_PLAYLIST_ABERTO" = "$HISTORY_FILE" ] && [ -n "${EAZY_HIST_SIZE[$item_res]+yes}" ]; then
                    _sz="${EAZY_HIST_SIZE[$item_res]}"
                    _mt="${EAZY_HIST_MT[$item_res]}"
                elif [ -n "${EAZY_PLAYLIST_SIZE[$item_res]+yes}" ]; then
                    _sz="${EAZY_PLAYLIST_SIZE[$item_res]}"
                    _mt="${EAZY_PLAYLIST_MT[$item_res]}"
                    _db_kind="${EAZY_PLAYLIST_KIND[$item_res]}"
                    _db_deleted="${EAZY_PLAYLIST_DELETED[$item_res]}"
                    _db_found=1
                fi
                if [ "$_db_found" -eq 0 ] && [ "$_db_deleted" != "1" ]; then
                    if [ -f "$item_res" ]; then
                        if [ "$ARQUIVO_PLAYLIST_ABERTO" != "$HISTORY_FILE" ] || \
                           [ -z "${EAZY_HIST_SIZE[$item_res]+yes}" ] || [ "${_sz:-0}" -eq 0 ]; then
                            _stat_row=$(stat -c $'%s\t%Y' -- "$item_res" 2>/dev/null || printf '0\t0')
                            IFS=$'\t' read -r _sz _mt <<< "$_stat_row"
                        fi
                        _db_found=1; _db_kind="file"
                    elif [ -d "$item_res" ]; then
                        _db_found=1; _db_kind="directory"
                    fi
                fi
                if [ "$_db_deleted" = "1" ]; then
                    _mb="miss"
                    nome_exib="⚠ $nome_exib"
                elif [ "$_db_found" -eq 1 ] && [ "$_db_kind" = "directory" ]; then
                    _mb="dir"
                    tipo_icone="[D]"; tipo_cor="$C_DIR"
                elif [ "$_db_found" -eq 1 ]; then
                    [[ "$_sz" =~ ^[0-9]+$ ]] || _sz=0
                    [[ "$_mt" =~ ^[0-9]+$ ]] || _mt=0
                    if [ "$_sz" -ge 1073741824 ]; then
                        _tenths=$(( (_sz * 10 + 536870912) / 1073741824 ))
                        _mb="$((_tenths / 10)).$((_tenths % 10))GB"
                    elif [ "$_sz" -ge 1048576 ]; then
                        _tenths=$(( (_sz * 10 + 524288) / 1048576 ))
                        _mb="$((_tenths / 10)).$((_tenths % 10))MB"
                    elif [ "$_sz" -ge 1024 ]; then
                        _mb="$(( (_sz + 512) / 1024 ))KB"
                    else
                        _mb="${_sz}B"
                    fi
                else
                    _mb="miss"
                    nome_exib="⚠ $nome_exib"
                fi
                # Chave de ordenação conforme F1/F2/Ctrl-T
                case "${MODO_ATUAL:-tamanho}" in
                    data)
                        chave_ord="$_mt"
                        if [ "$_mt" -gt 0 ]; then
                            _info=$(date -d "@$_mt" '+%d/%m/%y %H:%M' 2>/dev/null                                 || date -r "$_mt" '+%d/%m/%y %H:%M' 2>/dev/null                                 || printf '%s' "$_mb")
                        else
                            _info="$_mb"
                        fi
                        ;;
                    nome)
                        # nome: chave irrelevante (sort -k2); mantém tamanho só para desempate
                        chave_ord="$_sz"
                        _info="$_mb"
                        ;;
                    *)
                        chave_ord="$_sz"
                        _info="$_mb"
                        ;;
                esac
                if [[ "$item_res" != /* ]]; then
                    item_res=$(readlink -f -- "$item_res" 2>/dev/null || printf '%s' "$item_res")
                fi
                printf "%015d\t%b%s %-40s%b\t%b[%s]%b\t%s\n" \
                    "$chave_ord" "$tipo_cor" "$tipo_icone" "$nome_exib" "$C_RESET" \
                    "$C_SIZE" "$_info" "$C_RESET" "$item_res"
            done < "$hist_source"
            [ "$hist_source" = "$ARQUIVO_PLAYLIST_ABERTO" ] || rm -f "$hist_source"
        } > "$pl_cache"
        printf '%s\n' "$pl_key" > "$pl_meta"
        cat "$pl_cache"
        return
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        eazy_status_file "carregando duplicados" "${DUP_FILE:-}" 2>/dev/null || true
        printf "000000000000000\t%b[D] %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar (Sair de Duplicados)" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        if [ -s "$DUP_FILE" ]; then
            # VERMELHO = amostra F12 fixa | AMARELO = seleção interativa (Tab/Ctrl-A/X/R)
            # Comparação sempre por caminho absoluto (evita ✓ no lugar errado após invert)
            awk -F'\t' \
                -v c_red=$'\033[1;31m' \
                -v c_yel=$'\033[1;33m' \
                -v c_dim=$'\033[0;90m' \
                -v c_size="$C_SIZE" \
                -v c_reset="$C_RESET" \
                -v selected_file="$DUP_SELECTED_FILE" \
                -v fixed_file="$DUP_FIXED_FILE" '
            BEGIN {
                grupo = 0; anterior = ""
                if (selected_file != "") {
                    while ((getline escolhido < selected_file) > 0) {
                        if (escolhido != "") amarelo[escolhido] = 1
                    }
                    close(selected_file)
                }
                if (fixed_file != "") {
                    while ((getline escolhido < fixed_file) > 0) {
                        if (escolhido != "") vermelho[escolhido] = 1
                    }
                    close(fixed_file)
                }
            }
            function abs_path(p,   cmd, out) {
                if (p == "") return p
                if (substr(p, 1, 1) == "/") return p
                cmd = "readlink -f -- \"" p "\" 2>/dev/null"
                cmd | getline out
                close(cmd)
                return (out != "" ? out : p)
            }
            {
                hash = $1; tam = $2; caminho = $3
                if (hash != anterior) { grupo++; anterior = hash }
                caminho_abs = abs_path(caminho)

                # Marcas: R=fixo (F12)  Y=seleção normal  ambas possíveis
                m_r = (caminho_abs in vermelho) || (caminho in vermelho)
                m_y = (caminho_abs in amarelo)  || (caminho in amarelo)
                if (m_r && m_y) {
                    marca = c_red "●" c_yel "✓ " c_reset
                } else if (m_r) {
                    marca = c_red "●  " c_reset
                } else if (m_y) {
                    marca = c_yel "✓  " c_reset
                } else {
                    marca = "   "
                }

                nome_exib = caminho
                if (length(nome_exib) > 38) {
                    nome_exib = "..." substr(nome_exib, length(nome_exib) - 35)
                }
                mb = sprintf("%.1f", tam / 1048576)

                printf "%015d\t%s#G%02d %-34s%s\t%s[%s MB]%s\t%s\n",
                    tam, marca, grupo, nome_exib, c_reset, c_size, mb, c_reset, caminho
            }' "$DUP_FILE"
        fi
        return
    fi

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        # Cada execução começa sem sinal residual de cancelamento.
        rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true
        printf "000000000000000\t%b[D] %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar (Sair da Busca)" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        local -a ext_arr_busca
        construir_iname_array ext_arr_busca "$EXT_BUSCA"

        local tmp_busca cache_key cache_file
        cache_key=$(chave_cache_busca)
        cache_file="${BUSCA_CACHE_DIR}/${cache_key}.tsv"
        tmp_busca="$EAZY_TMP_DIR/eazy_busca_raw_$$"

        # Remake: apaga cache de sessão e snapshot para forçar scan novo
        if [ "${BUSCA_REMAKE:-0}" = "1" ]; then
            rm -f "$cache_file" "${cache_file}.meta" 2>/dev/null || true
            BUSCA_SNAPSHOT_FILE=""
            rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" 2>/dev/null || true
            EAZY_BUSCA_NOME_ATUAL=""
            eazy_lista_cache_invalidate 2>/dev/null || true
        fi

        # Pesquisa salva: usa o resultado congelado até o usuário pedir remake.
        if [ -n "${BUSCA_SNAPSHOT_FILE:-}" ] && [ "${BUSCA_REMAKE:-0}" -ne 1 ] && [ -f "$BUSCA_SNAPSHOT_FILE" ]; then
            local n_snapshot
            n_snapshot=$(wc -l < "$BUSCA_SNAPSHOT_FILE" 2>/dev/null | tr -cd '0-9')
            n_snapshot=${n_snapshot:-0}
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;33m'"📌 Resultado salvo — $n_snapshot arquivo(s) (sem remake)"$'\033[0m'
            eazy_busca_msg ""
            cp -f "$BUSCA_SNAPSHOT_FILE" "$tmp_busca" 2>/dev/null || cat "$BUSCA_SNAPSHOT_FILE" > "$tmp_busca"
            eazy_filtrar_config_tsv "$tmp_busca" || : > "$tmp_busca"
        # Buffer de busca: reutiliza resultado enquanto o eazy estiver aberto
        # (só refaz quando BUSCA_REMAKE=1 — Alt+R ou Nova pesquisa)
        elif [ -s "$cache_file" ] && [ "${BUSCA_REMAKE:-0}" -ne 1 ]; then
            # Só relê cache — NÃO refaz scan (F9, marcar, ordenar, etc.)
            BUSCA_REMAKE=0
            cp -f "$cache_file" "$tmp_busca" 2>/dev/null || cat "$cache_file" > "$tmp_busca"
            eazy_filtrar_config_tsv "$tmp_busca" || : > "$tmp_busca"
            # silencioso: sem mensagem, sem espera, sem monitor de Esc
        else
            : > "$tmp_busca"
            BUSCA_REMAKE=0

            local size_args=()
            [ -n "${BUSCA_TAM_MIN:-}" ] && size_args+=("-size" "+${BUSCA_TAM_MIN}c")
            [ -n "${BUSCA_TAM_MAX:-}" ] && size_args+=("-size" "-${BUSCA_TAM_MAX}c")

            # Com pastas globais marcadas, pesquisa somente a união dessas árvores.
            # Sem pastas marcadas, preserva a raiz atual da busca.
            local busca_raiz busca_config_real busca_scope_file
            local -a busca_roots=()
            busca_raiz="${BUSCA_ORIGEM:-}"
            if [ -z "$busca_raiz" ] || [ ! -d "$busca_raiz" ]; then
                busca_raiz=$(pwd -P 2>/dev/null || pwd)
            fi
            BUSCA_ORIGEM="$busca_raiz"
            busca_scope_file="$EAZY_TMP_DIR/eazy_search_roots_$$.nul"
            eazy_selection_scope_roots0 > "$busca_scope_file"
            if [ -s "$busca_scope_file" ]; then
                mapfile -d '' -t busca_roots < "$busca_scope_file"
            else
                busca_roots=("$busca_raiz")
                printf '%s\0' "$busca_raiz" > "$busca_scope_file"
            fi
            if [ "${#busca_roots[@]}" -eq 1 ]; then
                busca_raiz="${busca_roots[0]}"
            fi
            if [ "${#busca_roots[@]}" -eq 0 ] || { [ "${#busca_roots[@]}" -eq 1 ] && eazy_caminho_dentro_config "${busca_roots[0]}"; }; then
                eazy_busca_msg "Busca bloqueada: a pasta de configuração do eazy não é uma origem de pesquisa."
                : > "$tmp_busca"
                rm -f "$busca_scope_file" 2>/dev/null || true
                return 0
            fi
            busca_config_real=$(eazy_caminho_config_real) || busca_config_real="$CONFIG_DIR"

            # Caminho rápido: consultas simples usam o índice SQLite já gerado.
            # Busca por conteúdo continua no fluxo tradicional, pois precisa ler os arquivos.
            local indice_usado=0
            if [ -z "${BUSCA_CONTEUDO:-}" ] && [ -f "${EAZY_INDEXER:-}" ] && [ -f "${EAZY_INDEX_DB:-}" ] && command -v "${PYTHON_CMD:-python3}" >/dev/null 2>&1; then
                local idx_query="$EAZY_TMP_DIR/eazy_busca_index_$$"
                if "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --query --root "$busca_raiz" --roots-file "$busca_scope_file" --exclude-path "$busca_config_real" --ext "${EXT_BUSCA:-TODAS}" --min-size "${BUSCA_TAM_MIN:-0}" --max-size "${BUSCA_TAM_MAX:-0}" > "$idx_query" 2>/dev/null; then
                    cp -f "$idx_query" "$tmp_busca" 2>/dev/null || cat "$idx_query" > "$tmp_busca"
                    rm -f "$idx_query"
                    total_achados=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9'); total_achados=${total_achados:-0}
                    indice_usado=1
                    eazy_busca_msg "✓ Pesquisa respondida pelo banco SQLite — $total_achados arquivo(s)"
                else
                    rm -f "$idx_query"
                fi
            fi
            rm -f "$busca_scope_file" 2>/dev/null || true

            # Alerta se a raiz for demasiado ampla (/, /mnt/c, etc.)
            case " ${busca_roots[*]} " in
                *" / "*|*" /mnt "*|*" /mnt/c "*|*" /mnt/d "*|*" /mnt/e "*)
                    local _msg_amp
                    _msg_amp="A busca vai começar em:\n\n  $busca_raiz\n\nIsto pode demorar vários minutos (ou muito mais),\ndependendo da quantidade de dados neste ponto.\n\nDeseja realmente continuar?"
                    if command -v whiptail >/dev/null 2>&1; then
                        if ! whiptail --title "⚠ Busca ampla" --yesno "$_msg_amp" 16 62; then
                            eazy_busca_msg $'\033[0;90m'"Busca cancelada — raiz ampla."$'[0m'
                            return 0
                        fi
                    else
                        printf '%s\n' "⚠ Busca ampla: $busca_raiz"
                        printf '%s\n' "Pode demorar vários minutos conforme a quantidade de dados."
                        printf '%s' "Deseja realmente continuar? [s/N] "
                        local _r=""
                        IFS= read -r _r || true
                        case "$_r" in
                            s|S|y|Y|sim|Sim) ;;
                            *) eazy_busca_msg $'\033[0;90m'"Busca cancelada."$'[0m'; return 0 ;;
                        esac
                    fi
                    ;;
            esac

            if [ "$indice_usado" -eq 0 ]; then
            # Sempre segmentado (0-9/A-Z/outros): progresso + Esc.
            local busca_parcial=0 total_achados=0 _ult=""

            # Segmentos: 0-9, A-Z, outros — UI ao vivo + Esc confirma resultados parciais
            local letras=({0..9} {A..Z})
            local total_seg=$((${#letras[@]} + 1))
            local idx=0 total_achados=0
            local let seg_tmp n_seg pct _ult busca_parcial=0

            local titulo="🔍 Busca segmentada [${EXT_BUSCA:-todas}]"
            [ -n "${BUSCA_TAM_LABEL:-}" ] && titulo="$titulo  tam:$BUSCA_TAM_LABEL"
            [ -n "${BUSCA_CONTEUDO:-}" ] && titulo="$titulo  txt:«${BUSCA_CONTEUDO:0:16}»"
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;36m'"$titulo"$'\033[0m'
            eazy_busca_msg $'\033[0;90m'"   em: $busca_raiz"$'[0m'
            eazy_busca_msg $'\033[0;90m'"   segmentos: 0-9 → A-Z → outros  ·  Esc = parar e usar achados"$'\033[0m'
            eazy_busca_msg ""

            eazy_busca_cancelar_iniciar 2>/dev/null || true

            for let in "${letras[@]}"; do
                if eazy_busca_cancelada; then
                    busca_parcial=1
                    break
                fi
                pct=$((idx * 100 / total_seg))
                eazy_status_file "busca" "$busca_raiz/$let*" "[seg $let]" 2>/dev/null || true
                eazy_busca_progresso "$pct" "$let" "..." "$total_achados" "scan..." "${EAZY_BUSCA_NOME_ATUAL:-}" "$tmp_busca"
                seg_tmp="$EAZY_TMP_DIR/eazy_busca_seg_$$"
                atual_tmp="$EAZY_TMP_DIR/eazy_busca_atual_$$"
                : > "$seg_tmp"
                : > "$atual_tmp"
                # Stream ficheiro a ficheiro: "atual:" = nome real, não o padrão da letra.
                if [ "${#ext_arr_busca[@]}" -lt 1 ]; then
                    _find_pid=""
                else
                    (
                        find "${busca_roots[@]}" -path "$busca_config_real" -prune -o -type f -iname "${let}*" -print 2>/dev/null | while IFS= read -r _fp || [ -n "${_fp:-}" ]; do
                            [ -z "${_fp:-}" ] && continue
                            _bn="${_fp##*/}"
                            printf '%s\n' "$_bn" > "$atual_tmp"
                            eazy_busca_nome_ou_ext_match "$_bn" "${EXT_BUSCA:-}" || continue
                            _sz=$(stat -c%s -- "$_fp" 2>/dev/null || echo 0)
                            _mt=$(stat -c%Y -- "$_fp" 2>/dev/null || echo 0)
                            if [ -n "${BUSCA_TAM_MIN:-}" ] && [ "$_sz" -le "${BUSCA_TAM_MIN}" ] 2>/dev/null; then
                                continue
                            fi
                            if [ -n "${BUSCA_TAM_MAX:-}" ] && [ "$_sz" -ge "${BUSCA_TAM_MAX}" ] 2>/dev/null; then
                                continue
                            fi
                            printf '%s\t%s\t%s\t%s\t%s\n' "$_sz" "$_mt" "f" "$_bn" "$_fp" >> "$seg_tmp"
                        done
                    ) &
                    _find_pid=$!
                fi
                if [ -n "$_find_pid" ] && ! eazy_busca_esperar_pid "$_find_pid" "$let" "$pct" "$tmp_busca" "$seg_tmp" "$atual_tmp"; then
                    # cancelado a meio
                    [ -s "$seg_tmp" ] && cat "$seg_tmp" >> "$tmp_busca"
                    n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9'); n_seg=${n_seg:-0}
                    total_achados=$((total_achados + n_seg))
                    rm -f "$seg_tmp"
                    busca_parcial=1
                    break
                fi
                n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9')
                n_seg=${n_seg:-0}
                cat "$seg_tmp" >> "$tmp_busca"
                _ult=$(tail -n1 "$seg_tmp" 2>/dev/null | awk -F '\t' '{print $4}')
                if [ "${BUSCA_LIVE_STATUS:-1}" = "1" ]; then
                    mkdir -p "$BUSCA_CACHE_DIR" 2>/dev/null || true
                    cp -f "$tmp_busca" "$cache_file" 2>/dev/null || true
                fi
                rm -f "$seg_tmp"
                total_achados=$((total_achados + n_seg))
                idx=$((idx + 1))
                pct=$((idx * 100 / total_seg))
                eazy_busca_progresso "$pct" "$let" "$n_seg" "$total_achados" "ok" "${_ult:-}" "$tmp_busca"
            done

            if [ "$busca_parcial" -ne 1 ]; then
                if eazy_busca_cancelada; then
                    busca_parcial=1
                else
                    pct=$((idx * 100 / total_seg))
                    eazy_busca_progresso "$pct" "outros" "..." "$total_achados" "scan..." "${EAZY_BUSCA_NOME_ATUAL:-}" "$tmp_busca"
                    seg_tmp="$EAZY_TMP_DIR/eazy_busca_seg_$$"
                    atual_tmp="$EAZY_TMP_DIR/eazy_busca_atual_$$"
                    : > "$seg_tmp"
                    : > "$atual_tmp"
                    (
                        find "${busca_roots[@]}" -path "$busca_config_real" -prune -o -type f ! -iname "[0-9]*" ! -iname "[A-Za-z]*" -print 2>/dev/null | while IFS= read -r _fp || [ -n "${_fp:-}" ]; do
                            [ -z "${_fp:-}" ] && continue
                            _bn="${_fp##*/}"
                            printf '%s\n' "$_bn" > "$atual_tmp"
                            eazy_busca_nome_ou_ext_match "$_bn" "${EXT_BUSCA:-}" || continue
                            _sz=$(stat -c%s -- "$_fp" 2>/dev/null || echo 0)
                            _mt=$(stat -c%Y -- "$_fp" 2>/dev/null || echo 0)
                            if [ -n "${BUSCA_TAM_MIN:-}" ] && [ "$_sz" -le "${BUSCA_TAM_MIN}" ] 2>/dev/null; then continue; fi
                            if [ -n "${BUSCA_TAM_MAX:-}" ] && [ "$_sz" -ge "${BUSCA_TAM_MAX}" ] 2>/dev/null; then continue; fi
                            printf '%s\t%s\t%s\t%s\t%s\n' "$_sz" "$_mt" "f" "$_bn" "$_fp" >> "$seg_tmp"
                        done
                    ) &
                    _find_pid=$!
                    if ! eazy_busca_esperar_pid "$_find_pid" "outros" "$pct" "$tmp_busca" "$seg_tmp" "$atual_tmp"; then
                        [ -s "$seg_tmp" ] && cat "$seg_tmp" >> "$tmp_busca"
                        n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9'); n_seg=${n_seg:-0}
                        total_achados=$((total_achados + n_seg))
                        rm -f "$seg_tmp"
                        busca_parcial=1
                    else
                        n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9')
                        n_seg=${n_seg:-0}
                        cat "$seg_tmp" >> "$tmp_busca"
                        _ult=$(tail -n1 "$seg_tmp" 2>/dev/null | awk -F '\t' '{print $4}')
                        rm -f "$seg_tmp"
                        total_achados=$((total_achados + n_seg))
                        eazy_busca_progresso 100 "outros" "$n_seg" "$total_achados" "ok" "${_ult:-}" "$tmp_busca"
                    fi
                fi
            fi

            eazy_busca_cancelar_parar 2>/dev/null || true

            if [ "$busca_parcial" -eq 1 ]; then
                eazy_busca_msg ""
                eazy_busca_msg $'\033[1;33m'"⏸ Esc — busca interrompida. Já encontrados: $total_achados"$'\033[0m'
                if [ "$total_achados" -gt 0 ]; then
                    if command -v whiptail >/dev/null 2>&1; then
                        whiptail --title "Busca interrompida" --yesno \
"Encontrados até agora: $total_achados arquivo(s).

SIM = mostrar na lista
NÃO = descartar

(Esc no diálogo também MANTÉM os resultados)" 13 60
                        _brc=$?
                        rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" 2>/dev/null || true
                        # 0=Sim, 255=Esc → manter; só 1=Não descarta
                        if [ "$_brc" -eq 1 ]; then
                            eazy_busca_msg $'\033[1;33m'"Busca cancelada — sem resultados."$'\033[0m'
                            rm -f "$tmp_busca"
                            return 130
                        fi
                        eazy_busca_msg $'\033[1;32m'"✓ A mostrar resultados parciais."$'\033[0m'
                    else
                        eazy_busca_msg "Usar os $total_achados achados? [S/n]"
                        read -r -n1 _r < /dev/tty 2>/dev/null || read -r -n1 _r
                        eazy_busca_msg ""
                        case "${_r:-S}" in
                            n|N) rm -f "$tmp_busca"; return 130 ;;
                            *) rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" 2>/dev/null || true
                               eazy_busca_msg $'\033[1;32m'"✓ Resultados parciais."$'\033[0m' ;;
                        esac
                    fi
                else
                    eazy_busca_msg $'\033[1;33m'"Nenhum arquivo encontrado antes do Esc."$'\033[0m'
                    rm -f "$tmp_busca"
                    return 130
                fi
            else
                eazy_busca_msg ""
                eazy_busca_msg $'\033[1;32m'"✓ Busca concluída — $total_achados arquivo(s)"$'\033[0m'
                eazy_busca_msg ""
                eazy_busca_aguardar_enter
            fi

            # Também limpa snapshots/cache antigos que possam conter caminhos da configuração.
            if ! eazy_filtrar_config_tsv "$tmp_busca"; then
                eazy_busca_msg "Falha ao validar caminhos da pesquisa; resultados foram bloqueados por segurança."
                : > "$tmp_busca"
            fi

            # Remove linhas vazias/incompletas (típico de Esc a meio do find)
            if [ -s "$tmp_busca" ]; then
                awk -F '\t' 'NF >= 5 && $5 != "" && $5 != "." && $5 != ".." {
                    gsub(/\r/, "", $5)
                    if (length($5) > 0) print $0
                }' "$tmp_busca" > "${tmp_busca}.ok" 2>/dev/null                     && mv -f "${tmp_busca}.ok" "$tmp_busca"                     || true
                total_achados=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9')
                total_achados=${total_achados:-0}
            fi


            # Valida também resultados do índice: extensões literais ou curingas de nome.
            if [ -s "$tmp_busca" ] && [ -n "${EXT_BUSCA:-}" ] && [[ " ${EXT_BUSCA^^} " != *" TODAS "* ]]; then
                : > "${tmp_busca}.f"
                while IFS= read -r _search_row; do
                    IFS=$'\t' read -r _search_size _search_mtime _search_kind _search_name _search_path _search_rest <<< "$_search_row"
                    eazy_busca_nome_ou_ext_match "${_search_name:-${_search_path##*/}}" "$EXT_BUSCA" && printf '%s\n' "$_search_row" >> "${tmp_busca}.f"
                done < "$tmp_busca"
                mv -f "${tmp_busca}.f" "$tmp_busca"
                total_achados=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9')
                total_achados=${total_achados:-0}
            fi

            # Filtro por conteúdo (grep) com barra própria
            if [ -n "${BUSCA_CONTEUDO:-}" ]; then
                local tmp_filtro="$EAZY_TMP_DIR/eazy_busca_grep_$$"
                : > "$tmp_filtro"
                local n_grep=0 n_total gi=0
                n_total=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9')
                n_total=${n_total:-1}
                [ "$n_total" -lt 1 ] && n_total=1
                eazy_busca_progresso 0 "grep" 0 "$n_total" "iniciando..."
                while IFS=$'\t' read -r bytes mtime tipo nome caminho; do
                    gi=$((gi + 1))
                    [ -z "$caminho" ] && continue
                    if eazy_busca_cancelada; then
                        rm -f "$tmp_filtro"
                        eazy_busca_cancelar_parar
                        return 130
                    fi
                    local conteudo_ok=0
                    if eazy_conteudo_match "$BUSCA_CONTEUDO" "$caminho"; then
                        conteudo_ok=1
                    fi
                    if [ "$conteudo_ok" -eq 1 ]; then
                        printf "%s\t%s\t%s\t%s\t%s\n" "$bytes" "$mtime" "$tipo" "$nome" "$caminho" >> "$tmp_filtro"
                        n_grep=$((n_grep + 1))
                    elif eazy_busca_cancelada; then
                        rm -f "$tmp_filtro"
                        eazy_busca_cancelar_parar
                        return 130
                    fi
                    if [ $((gi % 15)) -eq 0 ] || [ "$gi" -eq "$n_total" ]; then
                        eazy_busca_progresso "$((gi * 100 / n_total))" "grep" "$n_grep" "$gi" "/$n_total"
                    fi
                done < "$tmp_busca"
                mv "$tmp_filtro" "$tmp_busca"
                eazy_busca_msg ""
                eazy_busca_msg $'\033[1;32m'"✓ Conteúdo — $n_grep hit(s)"$'\033[0m'
                eazy_busca_msg ""
            fi

            if eazy_busca_cancelada; then
                # Se ainda há flag mas já temos ficheiros, usa-os (não lista vazia)
                n_keep=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9')
                n_keep=${n_keep:-0}
                rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" 2>/dev/null || true
                if [ "$n_keep" -lt 1 ]; then
                    eazy_busca_msg ""
                    eazy_busca_msg $'\033[1;33mBusca cancelada por Esc.\033[0m'
                    return 130
                fi
                eazy_busca_msg $'\033[1;33m'"Esc — a usar $n_keep resultado(s) já encontrados."$'\033[0m'
            fi

            # Grava no buffer da sessão
            mkdir -p "$BUSCA_CACHE_DIR" 2>/dev/null || true
            cp -f "$tmp_busca" "$cache_file" 2>/dev/null || cat "$tmp_busca" > "$cache_file"
            # Importante: limpa Esc residual para não esvaziar a lista no passo seguinte
            rm -f "${EAZY_BUSCA_CANCEL_FILE:-$EAZY_TMP_DIR/eazy_search_cancel_$$}" 2>/dev/null || true
            BUSCA_REMAKE=0
            fi
            if ! eazy_filtrar_config_tsv "$tmp_busca"; then
                eazy_busca_msg "Falha ao validar caminhos da pesquisa; resultados foram bloqueados por segurança."
                : > "$tmp_busca"
            fi
            _last_search_error="$EAZY_TMP_DIR/eazy_last_search_error_$$"
            if ! eazy_sql_list_save_last_search "$tmp_busca" 2>"$_last_search_error"; then
                _last_search_detail=$(cat "$_last_search_error" 2>/dev/null || true)
                eazy_term_log "Não foi possível atualizar a tabela SQLite da Última pesquisa. ${_last_search_detail}" 2>/dev/null || true
            fi
            rm -f "$_last_search_error" 2>/dev/null || true
        fi

        awk -F'\t' \
            -v c_vid="$C_VID" -v c_aud="$C_AUD" -v c_img="$C_IMG" -v c_zip="$C_ZIP" \
            -v c_size="$C_SIZE" -v c_reset="$C_RESET" -v modo="$MODO_ATUAL" \
            -v tmin="${BUSCA_TAM_MIN:-0}" -v tmax="${BUSCA_TAM_MAX:-0}" \
            -v c_dir=$'\033[1;34m' '
        {
            bytes = $1 + 0
            if (tmin > 0 && bytes <= tmin) next
            if (tmax > 0 && bytes >= tmax) next

            mtime = $2
            tipo = $3
            nome = $4
            caminho = $5
            sub(/^\.\//, "", caminho)

            # Busca só deve listar ficheiros (-type f). Se vier dir, ignora.
            if (tipo == "d") next

            nome_exib = caminho
            if (length(nome_exib) > 45) {
                nome_exib = "..." substr(nome_exib, length(nome_exib) - 41)
            }
            mb = sprintf("%.1f", bytes / 1048576)
            dt = strftime("%d/%m/%y %H:%M", int(mtime))
            if (modo == "data") {
                chave = int(mtime + 0)
                if (chave < 0) chave = 0
            } else {
                chave = bytes + 0
            }
            n = split(nome, ext_arr, ".")
            # sem ponto no nome → sem extensão (NÃO é vídeo por omissão)
            ext = (n > 1 && length(ext_arr[n]) > 0 && length(ext_arr[n]) <= 8) ? tolower(ext_arr[n]) : ""
            info = (ext == "") ? sprintf("%s · %sMB · (sem ext)", dt, mb) : sprintf("%s · %sMB · .%s", dt, mb, ext)

            if (ext ~ /^(m3u|pls|m3u8)$/) {
                printf "%015d\t%s📜 %-42s%s\t%s[%s]%s\t%s\n",
                    chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(mp3|m4a|wav|flac|ogg|opus)$/) {
                printf "%015d\t%s🎵 %-42s%s\t%s[%s]%s\t%s\n",
                    chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(webp|jpg|jpeg|png|gif|bmp)$/) {
                printf "%015d\t%s🖼️ %-42s%s\t%s[%s]%s\t%s\n",
                    chave, c_img, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(zip|tar|gz|bz2|xz|rar|7z)$/) {
                printf "%015d\t%s📦 %-42s%s\t%s[%s]%s\t%s\n",
                    chave, c_zip, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(mp4|mkv|avi|mov|webm|wmv|flv|m4v|mpg|mpeg)$/) {
                printf "%015d\t%s🎬 %-42s%s\t%s[%s]%s\t%s\n",
                    chave, c_vid, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else {
                # ficheiro genérico (vazio, sem extensão, .bin, etc.) — NUNCA trata como dir/vídeo
                printf "%015d\t%s📄 %-42s%s\t%s[%s]%s\t%s\n",
                    chave, c_size, nome_exib, c_reset, c_size, info, c_reset, caminho
            }
        }' "$tmp_busca"
        rm -f "$tmp_busca"
        return
    fi

    if [ "$(pwd)" != "/" ]; then
        printf "000000000000000\t%b[D] %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" ".." "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"
    fi

    local -a find_args=("." "-maxdepth" "1" "-mindepth" "1" "(" "-type" "d")

    case "$FILTRO_ATUAL" in
        videos)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp4" "-o" "-iname" "*.mp3" "-o" "-iname" "*.wmv" "-o" "-iname" "*.flv" "-o" "-iname" "*.mkv" "-o" \
                "-iname" "*.avi" "-o" "-iname" "*.mov" "-o" "-iname" "*.webm" "-o" "-iname" "*.m4v" ")")
            ;;
        audios)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp3" "-o" "-iname" "*.m4a" "-o" "-iname" "*.wav" "-o" \
                "-iname" "*.flac" ")")
            ;;
        imgs)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.webp" "-o" "-iname" "*.jpg" "-o" "-iname" "*.jpeg" "-o" \
                "-iname" "*.png" "-o" "-iname" "*.gif" ")")
            ;;
        compactados)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.zip" "-o" "-iname" "*.tar" "-o" "-iname" "*.gz" "-o" \
                "-iname" "*.bz2" "-o" "-iname" "*.xz" "-o" "-iname" "*.rar" "-o" \
                "-iname" "*.7z" ")")
            ;;
        todos)
            find_args+=("-o" "-type" "f")
            ;;
        ambos|*)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp4" "-o" "-iname" "*.mp3" "-o" "-iname" "*.wmv" "-o" "-iname" "*.flv" "-o" \
                "-iname" "*.mkv" "-o" "-iname" "*.mov" "-o" \
                "-iname" "*.m4v" "-o" "-iname" "*.m4a" "-o" "-iname" "*.avi" "-o" "-iname" "*.wav" "-o" \
                "-iname" "*.flac" "-o" "-iname" "*.webm" "-o" "-iname" "*.webp" "-o" \
                "-iname" "*.jpg" "-o" "-iname" "*.jpeg" "-o" "-iname" "*.png" "-o" \
                "-iname" "*.gif" "-o" "-iname" "*.zip" "-o" "-iname" "*.tar" "-o" \
                "-iname" "*.gz" "-o" "-iname" "*.bz2" "-o" "-iname" "*.xz" "-o" \
                "-iname" "*.rar" "-o" "-iname" "*.7z" "-o" "-iname" "*.m3u" "-o" "-iname" "*.m3u8" "-o" \
                "-iname" "*.pls" "-o" "-iname" "*.txt" ")")
            ;;
    esac
    find_args+=(")")

        eazy_status_file "listando pasta" "$(pwd -P)" 2>/dev/null || true
    local _lista_raw="${EAZY_TMP_DIR:-${CONFIG_DIR}/tmp}/eazy_lista_raw_$$"
    local _n_itens=0
    : > "$_lista_raw"
    while IFS=$'\t' read -r _bytes _mtime _tipo _nome _caminho _duracao || [ -n "${_caminho:-}" ]; do
        [ -z "${_caminho:-}" ] && [ -z "${_nome:-}" ] && continue
        _n_itens=$((_n_itens + 1))
        # status a cada 25 itens — em /mnt/c update por ficheiro é lento
        if [ $((_n_itens % 25)) -eq 1 ] || [ "$_n_itens" -le 3 ]; then
            eazy_status_file "lendo" "${_caminho:-$_nome}" "[$_n_itens]" 2>/dev/null || true
        fi
        case "${_caminho:-}" in
            /*) ;;
            ./*) _caminho="$(pwd -P)/${_caminho#./}" ;;
            "") ;;
            *) _caminho="$(pwd -P)/${_caminho}" ;;
        esac
        # Confia no %y do find (f/d). NÃO fazer [ -d ]/[ -f ] por item:
        # em /mnt/c (WSL/drvfs) cada teste trava a listagem.
        # A busca já filtra -type f; Enter em modo busca nunca faz cd.
        printf '%s\t%s\t%s\t%s\t%s\n' "$_bytes" "$_mtime" "$_tipo" "$_nome" "$_caminho" >> "$_lista_raw"
    done < <(eazy_lista_diretorio_fonte)
    eazy_status_file "formatando lista" "$(pwd -P)" "[$_n_itens itens]" 2>/dev/null || true
    if [ -s "$_lista_raw" ]; then
        awk -F$'\t' \
        -v c_dir="$C_DIR" -v c_vid="$C_VID" -v c_aud="$C_AUD" -v c_img="$C_IMG" -v c_zip="$C_ZIP" \
        -v c_size="$C_SIZE" -v c_reset="$C_RESET" -v modo="$MODO_ATUAL" \
        -v c_ord1=$'\033[1;36m' -v c_ord2=$'\033[1;35m' -v c_ord3=$'\033[0;33m' '
    {
        bytes = $1
        mtime = $2
        tipo = $3
        nome = $4
        caminho = $5
        duracao = $6

        if (tipo == "x" || tipo == "X") {
            nome = "[DELETADO] " nome
            tipo = (tipo == "X") ? "d" : "f"
        }

        sub(/^\.\//, "", caminho)
        nome_exib = (length(nome) > 34) ? substr(nome, 1, 34) ".." : nome
        mb = sprintf("%.1f", bytes / 1048576)
        dt = strftime("%d/%m/%y %H:%M", int(mtime))
        dur_txt = ""
        if (duracao != "" && duracao > 0) {
            ds = int((duracao + 0) / 1000)
            dh = int(ds / 3600)
            dm = int((ds % 3600) / 60)
            dsec = ds % 60
            if (dh > 0) dur_txt = sprintf("%d:%02d:%02d", dh, dm, dsec)
            else dur_txt = sprintf("%d:%02d", dm, dsec)
        }

        # data → mtime (epoch s); tamanho → bytes; nome → bytes (desempate, sort real é -k2)
        if (modo == "data") {
            chave = int(mtime + 0)
            if (chave < 0) chave = 0
        } else {
            chave = bytes + 0
        }
        # Ciclo visual idx3: mantém as três cores de ordenação por posição.
        idx++
        c_ord = (idx % 3 == 1) ? c_ord1 : (idx % 3 == 2) ? c_ord2 : c_ord3

        n = split(nome, ext_arr, ".")
        ext = (n > 1) ? tolower(ext_arr[n]) : "—"
        # tipo legível; se indetectável mostra extensão
        if (tipo == "d") {
            tipo_lab = "dir"
            icon = "[D]"; cor = c_dir
            nome_exib = nome_exib "/"
        } else if (ext ~ /^(m3u|pls|m3u8)$/) {
            tipo_lab = "pls"; icon = "[P]"; cor = c_aud
        } else if (ext ~ /^(mp3|m4a|wav|flac|ogg|opus)$/) {
            tipo_lab = "aud"; icon = "[A]"; cor = c_aud
        } else if (ext ~ /^(webp|jpg|jpeg|png|gif|bmp)$/) {
            tipo_lab = "img"; icon = "[I]"; cor = c_img
        } else if (ext ~ /^(zip|tar|gz|bz2|xz|rar|7z)$/) {
            tipo_lab = "zip"; icon = "[Z]"; cor = c_zip
        } else if (ext ~ /^(mp4|mkv|avi|mov|webm|wmv|flv|m4v|mpg|mpeg)$/) {
            tipo_lab = "vid"; icon = "[V]"; cor = c_vid
        } else if (ext ~ /^(pdf|txt|md|html|htm|sh|py)$/) {
            tipo_lab = ext; icon = "[F]"; cor = c_size
        } else {
            tipo_lab = (ext == "—" ? "?" : ext); icon = "[*]"; cor = c_size
        }

        # info: TAM · data · tipo/ext (tamanho primeiro para leitura rápida)
        if (tipo == "d") {
            info = sprintf("-- MB · %s · %s", dt, tipo_lab)
        } else if (dur_txt != "") {
            info = sprintf("%sMB · %s · %s · %s", mb, dt, dur_txt, tipo_lab)
        } else {
            info = sprintf("%sMB · %s · .%s", mb, dt, tipo_lab)
        }

        printf "%015d\t%s%s %-36s%s\t%s[%s]%s\t%s\n",
            chave, cor, icon, nome_exib, c_reset, c_ord, info, c_reset, caminho
    }' "$_lista_raw"
    fi
    rm -f "$_lista_raw"
}


# Converte caminho relativo para absoluto (robusto)
caminho_absoluto() {
    local p="$1"
    [ -z "$p" ] && return
    # Resultados de uma pesquisa salva podem ser relativos ao diretório
    # original da pesquisa, não ao diretório atual do navegador.
    if [[ "$p" != /* ]] && [ "${MODO_BUSCA:-0}" -eq 1 ] && [ -n "${BUSCA_ORIGEM:-}" ] && [ -d "$BUSCA_ORIGEM" ]; then
        (cd -- "$BUSCA_ORIGEM" && MODO_BUSCA=0 caminho_absoluto "$p")
        return
    fi
    # Já é absoluto?
    if [[ "$p" == /* ]]; then
        printf '%s\n' "$p"
        return
    fi
    # realpath se existir, senão fallback
    if command -v realpath &>/dev/null; then
        realpath -m -- "$p" 2>/dev/null || printf '%s/%s\n' "$(pwd)" "${p#./}"
    else
        local base
        base=$(pwd)
        p="${p#./}"
        printf '%s/%s\n' "$base" "$p"
    fi
}

# --- Editor de notas rápidas ---
# Usa o mini editor visual fornecido no projeto; não depende de Vim, vi ou nano.
# Ctrl-N cria nota; Ctrl-S salva e abre outra; Esc salva e sai.

# --- Memo de voz (Alt-M) ---
eazy_gravar_memo_voz() {
    local dest segs nome out rc=1
    mkdir -p "${NOTES_DIR:-$CONFIG_DIR/notas}" 2>/dev/null || true
    dest="${NOTES_DIR:-$CONFIG_DIR/notas}"
    segs=$(whiptail --title "Memo de voz · Alt-M" --inputbox \
        "Duração em segundos (Enter=30, Esc cancela)\nDestino: $dest" \
        11 70 "30" 3>&1 1>&2 2>&3) || return 0
    segs=$(printf '%s' "$segs" | tr -cd '0-9'); segs=${segs:-30}
    [ "$segs" -lt 1 ] && segs=1
    [ "$segs" -gt 600 ] && segs=600
    nome="memo_$(date '+%Y%m%d_%H%M%S')"
    clear 2>/dev/null || true
    echo -e "\n\033[1;36m🎙️  Memo de voz — ${segs}s\033[0m"
    echo -e "Pasta: $dest\nA gravar… fale agora.\n"
    if command -v ffmpeg >/dev/null 2>&1; then
        out="$dest/${nome}.ogg"
        if ffmpeg -hide_banner -loglevel error -f pulse -i default -t "$segs" -c:a libopus -b:a 64k "$out" 2>/dev/null \
           || ffmpeg -hide_banner -loglevel error -f alsa -i default -t "$segs" -c:a libopus -b:a 64k "$out" 2>/dev/null; then
            rc=0
        fi
    elif command -v arecord >/dev/null 2>&1; then
        out="$dest/${nome}.wav"
        arecord -q -d "$segs" -f cd -t wav "$out" 2>/dev/null && rc=0
    else
        whiptail --title "Memo de voz" --msgbox "Instale ffmpeg ou alsa-utils (arecord)." 10 55
        return 1
    fi
    if [ "$rc" -eq 0 ] && [ -s "${out:-}" ]; then
        # NÃO aponta LAST_NOTE_FILE para áudio — Ctrl-N só abre texto (nota.txt)
        whiptail --title "Memo gravado" --msgbox "Arquivo:\n$out\n\nDuração: ${segs}s\n\n(Ctrl-N continua a abrir nota.txt)" 14 70
        if whiptail --title "Memo de voz" --yesno "Ir à pasta de notas agora?" 8 50; then
            cd -- "$dest" 2>/dev/null || true
            ULTIMO_ARQUIVO="$(basename -- "$out")"
            MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0; MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
            ALVO="$(pwd -P)"; ULTIMO_DIR="$(pwd -P)"
            registrar_status 2>/dev/null || true
            eazy_lista_cache_invalidate 2>/dev/null || true
        fi
    else
        rm -f "${out:-}" 2>/dev/null || true
        whiptail --title "Memo de voz" --msgbox "Falha na gravação. Verifique o microfone." 10 55
    fi
}

