extrair_com_senha() {
    local arquivo="$1"
    local senha="$2"
    local sucesso=0

    [ ! -f "$arquivo" ] && return 1

    local ext
    ext=$(echo "${arquivo##*.}" | tr '[:upper:]' '[:lower:]')
    local nome_base
    nome_base=$(basename "$arquivo")

    echo -e "\n\033[1;36m📦 Tentando extrair: $nome_base\033[0m"

    case "$ext" in
        zip)
            if command -v unzip &>/dev/null; then
                if [ -n "$senha" ]; then
                    unzip -o -P "$senha" "$arquivo" && sucesso=1
                else
                    unzip -o "$arquivo" && sucesso=1
                fi
            else
                echo -e "\033[1;31mFerramenta 'unzip' não encontrada.\033[0m"
            fi
            ;;
        rar)
            # Preferir o RAR oficial (WinRAR/rarlab). unrar de terceiros não é confiável.
            if command -v rar &>/dev/null; then
                if [ -n "$senha" ]; then
                    rar x -o+ -p"$senha" -- "$arquivo" && sucesso=1
                else
                    rar x -o+ -- "$arquivo" && sucesso=1
                fi
            elif command -v 7z &>/dev/null; then
                echo -e "\033[0;90m'rar' não encontrado — tentando 7z…\033[0m"
                if [ -n "$senha" ]; then
                    7z x -y -p"$senha" -- "$arquivo" && sucesso=1
                else
                    7z x -y -- "$arquivo" && sucesso=1
                fi
            else
                echo -e "\033[1;31mNenhuma ferramenta RAR encontrada.\033[0m"
                echo -e "Instale o RAR oficial:  \033[1;37msudo apt install rar\033[0m"
                echo -e "(pacote non-free; evite 'unrar' de fontes duvidosas)"
            fi
            ;;
        7z)
            if command -v 7z &>/dev/null; then
                if [ -n "$senha" ]; then
                    7z x -y -p"$senha" "$arquivo" && sucesso=1
                else
                    7z x -y "$arquivo" && sucesso=1
                fi
            else
                echo -e "\033[1;31mFerramenta '7z' não encontrada.\033[0m"
            fi
            ;;
        gz|bz2|xz|tar)
            if [[ "$arquivo" == *.tar.gz ]] || [[ "$arquivo" == *.tgz ]]; then
                tar -xzf "$arquivo" && sucesso=1
            elif [[ "$arquivo" == *.tar.bz2 ]] || [[ "$arquivo" == *.tbz2 ]]; then
                tar -xjf "$arquivo" && sucesso=1
            elif [[ "$arquivo" == *.tar.xz ]]; then
                tar -xJf "$arquivo" && sucesso=1
            elif [ "$ext" = "gz" ]; then
                gunzip -k "$arquivo" 2>/dev/null && sucesso=1
            elif [ "$ext" = "bz2" ]; then
                bunzip2 -k "$arquivo" 2>/dev/null && sucesso=1
            elif [ "$ext" = "xz" ]; then
                unxz -k "$arquivo" 2>/dev/null && sucesso=1
            else
                tar -xf "$arquivo" && sucesso=1
            fi
            ;;
        *)
            echo -e "\033[1;33mExtensão .$ext não suportada para extração automática.\033[0m"
            return 1
            ;;
    esac

    if [ "$sucesso" -eq 1 ]; then
        echo -e "\033[1;32m✓ Extração concluída com sucesso!\033[0m"
        read -p "Deseja apagar o arquivo compactado original? (s/N): " apagar
        if [[ "$apagar" =~ ^[Ss]$ ]]; then
            rm -f -- "$arquivo"
            echo -e "\033[1;32mArquivo compactado removido.\033[0m"
        fi
        return 0
    else
        echo -e "\033[1;31m✗ Falha na extração (senha incorreta ou arquivo corrompido?).\033[0m"
        return 1
    fi
}

obter_nome_do_link() {
    local url="$1"
    local nome

    nome="${url%%\?*}"
    nome="${nome%%\#*}"
    nome=$(basename "$nome")

    if [ -z "$nome" ] || [ "$nome" = "/" ] || [ "$nome" = "." ]; then
        nome="download_$$"
    fi

    nome=$(printf '%b' "${nome//%/\\x}" 2>/dev/null || echo "$nome")
    echo "$nome"
}

eazy_dup_progresso() {
    local fase="${1:-Analisando duplicados}" local_atual="${2:-$(pwd -P 2>/dev/null || pwd)}"
    local varridos="${3:-0}" candidatos_tamanho="${4:-0}" candidatos_tipo="${5:-0}"
    local hashes="${6:-0}" total_hashes="${7:-0}" confirmados="${8:-aguardando análise}"
    local scope="${EAZY_DUP_SCOPE:-não informado}" cols max_path c_cyan c_yellow c_green c_white c_dim c_reset
    cols=$( { tput cols 2>/dev/null || echo 80; } | tr -cd '0-9' ); cols=${cols:-80}
    [ "$cols" -lt 50 ] && cols=50
    max_path=$((cols - 12))
    local_atual="${local_atual//$'\n'/ }"; local_atual="${local_atual//$'\r'/ }"; local_atual="${local_atual//$'\t'/ }"
    if [ "${#local_atual}" -gt "$max_path" ]; then
        local_atual="…${local_atual: -$((max_path - 1))}"
    fi
    scope="${scope//$'\n'/ }"; scope="${scope//$'\r'/ }"; scope="${scope//$'\t'/ }"
    if [ "${#scope}" -gt "$max_path" ]; then
        scope="…${scope: -$((max_path - 1))}"
    fi
    c_cyan=$'\033[1;36m'; c_yellow=$'\033[1;33m'; c_green=$'\033[1;32m'
    c_white=$'\033[1;37m'; c_dim=$'\033[0;90m'; c_reset=$'\033[0m'
    {
        printf '\033[s'
        printf '\r\033[2K%s╭─ EAZY · DUPLICADOS ─────────────────────────%s\r\n' "$c_cyan" "$c_reset"
        printf '\r\033[2K  %sEtapa:%s %s\r\n' "$c_yellow" "$c_reset" "$fase"
        printf '\r\033[2K  %sTipos escolhidos:%s %s\r\n' "$c_dim" "$c_reset" "$scope"
        printf '\r\033[2K  %sLocal:%s %s%s%s\r\n' "$c_dim" "$c_reset" "$c_white" "$local_atual" "$c_reset"
        printf '\r\033[2K  %sArquivos encontrados:%s %s\r\n' "$c_green" "$c_reset" "$varridos"
        printf '\r\033[2K  %sTam. repetido:%s %s  %sTam.+tipo:%s %s  %sMD5:%s %s/%s\r\n' \
            "$c_dim" "$c_reset" "$candidatos_tamanho" "$c_dim" "$c_reset" "$candidatos_tipo" \
            "$c_dim" "$c_reset" "$hashes" "$total_hashes"
        printf '\r\033[2K  %sConfirmados:%s %s\r\n' "$c_yellow" "$c_reset" "$confirmados"
        printf '\033[u'
    } > /dev/tty 2>/dev/null || true
}

eazy_dup_progresso_limpar() {
    local i
    {
        printf '\033[s'
        for i in 1 2 3 4 5 6 7; do printf '\r\033[2K\r\n'; done
        printf '\033[u'
    } > /dev/tty 2>/dev/null || true
}

encontrar_duplicados() {
    local saida="$1" extensoes="$2"
    local config_real
    mkdir -p "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    local tmp_all="${EAZY_TMP_DIR}/dup_all_$$" tmp_sizes="${EAZY_TMP_DIR}/dup_sizes_$$"
    local tmp_hashes="${EAZY_TMP_DIR}/dup_hashes_$$" tmp_hashdup="${EAZY_TMP_DIR}/dup_hashdup_$$"
    local tmp_typed="${EAZY_TMP_DIR}/dup_typed_$$" tmp_hash_candidates="${EAZY_TMP_DIR}/dup_hash_candidates_$$"
    local -a ext_arr find_dup dup_roots
    local dup_root_label
    EAZY_DUP_SCOPE="$extensoes"
    construir_iname_array ext_arr "$extensoes"
    mapfile -d '' -t dup_roots < <(eazy_selection_scope_roots0)
    if [ "${#dup_roots[@]}" -eq 0 ]; then
        dup_roots=("$(pwd -P 2>/dev/null || pwd)")
        if eazy_caminho_dentro_config "${dup_roots[0]}"; then
            : > "$saida"
            whiptail --title "Duplicados" --msgbox "A pesquisa não pode começar dentro da configuração protegida do eazy.\n\n$(eazy_caminho_config_real)" 10 68 2>/dev/null || true
            return 1
        fi
    fi
    config_real=$(eazy_caminho_config_real) || config_real="$CONFIG_DIR"
    find_dup=("${dup_roots[@]}" "-path" "$config_real" "-prune" "-o" "-type" "f" "(" "${ext_arr[@]}" ")")
    dup_root_label="${dup_roots[0]}"
    [ "${#dup_roots[@]}" -gt 1 ] && dup_root_label="${#dup_roots[@]} pastas selecionadas"
    : > "$saida" "$tmp_all"
    eazy_dup_progresso "Varrendo arquivos" "$dup_root_label" 0 0 0 0 0 "aguardando análise"
    find "${find_dup[@]}" -printf "%s\t%p\n" 2>/dev/null | tee "$tmp_all" | {
        _varridos=0
        while IFS=$'\t' read -r _size _caminho; do
            _varridos=$((_varridos + 1))
            if [ "$_varridos" -eq 1 ] || [ $((_varridos % 25)) -eq 0 ]; then
                eazy_dup_progresso "Varrendo arquivos" "$_caminho" "$_varridos" 0 0 0 0 "aguardando análise"
            fi
        done
    }
    local total processados=0 candidatos_tamanho=0 candidatos_tipo=0 grupos_dup=0 arquivos_dup=0
    local tipos_processados=0 tipo h
    total=$(wc -l < "$tmp_all" 2>/dev/null || echo 0)
    total=$(printf '%s' "$total" | tr -cd '0-9'); total=${total:-0}
    eazy_dup_progresso "Separando arquivos por tamanho" "$dup_root_label" "$total" 0 0 0 0 "aguardando classificação por tipo"
    awk -F'\t' '{print $1}' "$tmp_all" | sort -n | uniq -d > "$tmp_sizes"
    candidatos_tamanho=$(awk -F'\t' 'FILENAME == ARGV[1] {repete[$1]=1; next} $1 in repete {n++} END {print n+0}' "$tmp_sizes" "$tmp_all")
    : > "$tmp_typed"
    if [ -s "$tmp_sizes" ]; then
        while IFS=$'\t' read -r tam caminho; do
            [ -f "$caminho" ] || continue
            if command -v file >/dev/null 2>&1; then
                tipo=$(file -b --mime-type -- "$caminho" 2>/dev/null || true)
                tipo=${tipo:-application/octet-stream}
            else
                tipo="ext:${caminho##*.}"
                tipo=${tipo,,}
            fi
            printf '%s\t%s\t%s\n' "$tam" "$tipo" "$caminho" >> "$tmp_typed"
            tipos_processados=$((tipos_processados + 1))
            if [ "$tipos_processados" -eq 1 ] || [ $((tipos_processados % 25)) -eq 0 ]; then
                eazy_dup_progresso "Classificando tipo dos candidatos" "$caminho" "$total" "$candidatos_tamanho" 0 0 0 "checksum ainda não calculado"
            fi
        done < <(awk -F'\t' 'FILENAME == ARGV[1] {repete[$1]=1; next} $1 in repete {print $1 "\t" $2}' "$tmp_sizes" "$tmp_all")
    fi
    LC_ALL=C sort -t "$(printf '\t')" -k1,1n -k2,2 -o "$tmp_typed" "$tmp_typed"
    awk -F'\t' '
        function flush( i) {
            if (n > 1) for (i = 1; i <= n; i++) print linhas[i]
            n = 0
        }
        {
            chave = $1 SUBSEP $2
            if (NR > 1 && chave != anterior) flush()
            anterior = chave
            linhas[++n] = $0
        }
        END { flush() }
    ' "$tmp_typed" > "$tmp_hash_candidates"
    candidatos_tipo=$(wc -l < "$tmp_hash_candidates" 2>/dev/null || echo 0)
    candidatos_tipo=$(printf '%s' "$candidatos_tipo" | tr -cd '0-9'); candidatos_tipo=${candidatos_tipo:-0}
    eazy_dup_progresso "Separando por tipo e tamanho" "$dup_root_label" "$total" "$candidatos_tamanho" "$candidatos_tipo" 0 "$candidatos_tipo" "aguardando comparação de conteúdo"
    : > "$tmp_hashes"

    if [ -s "$tmp_hash_candidates" ]; then
        while IFS=$'\t' read -r tam tipo caminho; do
            [ -f "$caminho" ] || continue
            h=$(md5sum -- "$caminho" 2>/dev/null | awk '{print $1}')
            [ -n "$h" ] || continue
            printf '%s\t%s\t%s\t%s\n' "$h" "$tam" "$tipo" "$caminho" >> "$tmp_hashes"
            processados=$((processados + 1))
            if [ "$processados" -eq 1 ] || [ $((processados % 10)) -eq 0 ] || [ "$processados" -eq "$candidatos_tipo" ]; then
                eazy_dup_progresso "Calculando checksum MD5" "$caminho" "$total" "$candidatos_tamanho" "$candidatos_tipo" "$processados" "$candidatos_tipo" "comparação em andamento"
            fi
        done < "$tmp_hash_candidates"
    fi

    eazy_dup_progresso "Comparando checksums" "$dup_root_label" "$total" "$candidatos_tamanho" "$candidatos_tipo" "$processados" "$candidatos_tipo" "apurando grupos repetidos"
    awk -F'\t' '{print $1 "\t" $2 "\t" $3}' "$tmp_hashes" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2n -k3,3 | uniq -d > "$tmp_hashdup"
    if [ -s "$tmp_hashdup" ]; then
        while IFS=$'\t' read -r hsh tam tipo; do
            [ -z "$hsh" ] && continue
            awk -F'\t' -v h="$hsh" -v t="$tam" -v m="$tipo" \
                '$1 == h && $2 == t && $3 == m {print $1 "\t" $2 "\t" $4}' "$tmp_hashes" >> "$saida"
        done < "$tmp_hashdup"
    fi
    sort -t $'\t' -k1,1 -o "$saida" "$saida" 2>/dev/null
    arquivos_dup=$(wc -l < "$saida" 2>/dev/null || echo 0)
    grupos_dup=$(wc -l < "$tmp_hashdup" 2>/dev/null || echo 0)
    eazy_dup_progresso "Busca concluída" "$dup_root_label" "$total" "$candidatos_tamanho" "$candidatos_tipo" "$processados" "$candidatos_tipo" "$arquivos_dup arquivo(s) em $grupos_dup grupo(s)"
    eazy_dup_progresso_limpar
    rm -f "$tmp_all" "$tmp_sizes" "$tmp_typed" "$tmp_hash_candidates" "$tmp_hashes" "$tmp_hashdup"
}


