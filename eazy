# 1. VALIDAÇÃO E LIMPEZA DE ARQUIVOS .M3U (Ctrl+K)
# ============================================================================

validar_e_limpar_m3u() {
    local arquivo_m3u="$1"
    local arquivo_temp="${arquivo_m3u}.tmp"
    local linhas_originais=0
    local linhas_removidas=0
    local linhas_validas=0

    if [ ! -f "$arquivo_m3u" ]; then
        whiptail --title "Erro" --msgbox "Arquivo M3U não encontrado: $arquivo_m3u" 8 60
        return 1
    fi

    linhas_originais=$(grep -c '^/' "$arquivo_m3u" 2>/dev/null || echo 0)

    # Contar com barra de progresso
    {
        echo "0"
        grep '^[^#]' "$arquivo_m3u" 2>/dev/null | while IFS= read -r linha; do
            if [ -f "$linha" ] 2>/dev/null; then
                echo "$linha" >> "$arquivo_temp"
                ((linhas_validas++))
            fi
            echo $((++i * 100 / linhas_originais))
        done
        echo "100"
    } | whiptail --gauge "Validando arquivos em M3U..." 8 60 0

    linhas_removidas=$((linhas_originais - linhas_validas))

    if [ -f "$arquivo_temp" ]; then
        mv "$arquivo_temp" "$arquivo_m3u"
        whiptail --title "✓ Limpeza Concluída" --msgbox \
            "Arquivos validados em: $(basename "$arquivo_m3u")\n\n\
Linhas originais: $linhas_originais\n\
Removidas (não encontradas): $linhas_removidas\n\
Mantidas: $linhas_validas" 10 60
        return 0
    else
        whiptail --title "Erro" --msgbox "Nenhum arquivo válido encontrado." 8 60
        return 1
    fi
}

