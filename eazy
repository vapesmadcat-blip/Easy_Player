# Compat: exportar pesquisa (usa cache TSV se origem vazia)
exportar_pesquisa_html() {
    local origem_tsv="$1"
    local titulo="${2:-pesquisa}"
    local criterios="${3:-}"

    if [[ -z "$origem_tsv" || ! -f "$origem_tsv" ]]; then
        local chave_cache cache_resultado
        chave_cache=$(chave_cache_busca 2>/dev/null || true)
        cache_resultado="${BUSCA_CACHE_DIR}/${chave_cache}.tsv"
        if [[ -f "$cache_resultado" ]]; then
            origem_tsv="$cache_resultado"
        else
            exportar_tela_html
            return $?
        fi
    fi
    exportar_lista_html "$origem_tsv" "$titulo" "$criterios" "Resultado da pesquisa"
}

# Exporta seleção (se houver) ou o conteúdo da tela. Atalho: Ctrl-H
exportar_tela_html() {
    local tmp titulo crit modo_lbl escopo=""
    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-tela-html.XXXXXX") || return 1

    eazy_capturar_export_tsv "$tmp" escopo || {
        rm -f "$tmp"
        whiptail --title "Exportar HTML" --msgbox "Não foi possível capturar os itens." 8 55
        return 1
    }

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        titulo="pesquisa"
        modo_lbl="Pesquisa"
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        titulo="duplicados"
        modo_lbl="Duplicados"
    elif [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        titulo="downloads"
        modo_lbl="Fila de downloads"
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ]; then
        titulo="lista-$(basename -- "${ARQUIVO_PLAYLIST_ABERTO:-lista}" 2>/dev/null || echo lista)"
        modo_lbl="Lista/Playlist"
    else
        titulo="navegador-$(basename -- "$(pwd -P)" 2>/dev/null || echo pasta)"
        modo_lbl="Navegador"
    fi
    case "$escopo" in
        *[Ss]ele[cç]*) titulo="${titulo}-selecao" ;;
        *) [ -n "${FZF_QUERY:-}" ] && titulo="${titulo}-filtro" ;;
    esac

    crit=$(eazy_criterios_tela_atual "$escopo")
    exportar_lista_html "$tmp" "$modo_lbl — $titulo" "$crit" "$escopo"
    local rc=$?
    rm -f "$tmp"
    return "$rc"
}




normalizar_snapshot_busca() {
    local arquivo="$1" base="${2:-$(pwd -P)}" tmp abs
    [ -f "$arquivo" ] || return 0
    tmp="${arquivo}.tmp.$$"
    : > "$tmp" || return 1
    while IFS=$'\t' read -r bytes mtime tipo nome caminho; do
        [ -z "$caminho" ] && continue
        if [[ "$caminho" == /* ]]; then
            abs="$caminho"
        else
            abs=$(cd -- "$base" 2>/dev/null && caminho_absoluto "$caminho") || abs="$caminho"
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$bytes" "$mtime" "$tipo" "$nome" "$abs" >> "$tmp"
    done < "$arquivo"
    mv -f "$tmp" "$arquivo"
}
caminho_absoluto_busca() {
    local p="$1" base="${BUSCA_ORIGEM:-$(pwd -P)}"
    [ -n "$p" ] || return 1
    if [[ "$p" == /* ]]; then
        printf '%s\n' "$p"
    elif [ -d "$base" ]; then
        (cd -- "$base" && caminho_absoluto "$p")
    else
        caminho_absoluto "$p"
    fi
}
carregar_pesquisa_salva() {
    [ -d "$SAVED_SEARCHES_DIR" ] || return 1
    local opcoes=() arq escolha nome
    while IFS= read -r arq; do
        [ -f "$arq" ] || continue
        nome=$(basename "$arq" .search)
        opcoes+=("$nome" "Pesquisa salva")
    done < <(find "$SAVED_SEARCHES_DIR" -maxdepth 1 -type f -name '*.search' -print 2>/dev/null | sort)
    [ "${#opcoes[@]}" -gt 0 ] || return 1
    escolha=$(whiptail --title "Pesquisas salvas" --menu "Escolha uma pesquisa:" 18 70 8 "${opcoes[@]}" 3>&1 1>&2 2>&3) || return 1
    [ -n "$escolha" ] || return 1
    acao_ps=$(whiptail --title "Pesquisa: $escolha" --menu "O que deseja fazer?" 13 60 3 \
        "A" "Abrir pesquisa" \
        "H" "Exportar esta pesquisa para HTML" \
        "C" "Cancelar" 3>&1 1>&2 2>&3) || return 1
    if [ "$acao_ps" = "H" ]; then
        local snap="$SAVED_SEARCHES_DIR/$escolha.results.tsv"
        local crit=""
        if [ -f "$SAVED_SEARCHES_DIR/$escolha.search" ]; then
            # shellcheck disable=SC1090
            source "$SAVED_SEARCHES_DIR/$escolha.search" 2>/dev/null || true
            crit="Extensão: ${EXT_BUSCA:-qualquer}\nTamanho: ${BUSCA_TAM_LABEL:-qualquer}\nConteúdo: ${BUSCA_CONTEUDO:-—}\nOrigem: ${BUSCA_ORIGEM:-—}"
        fi
        exportar_pesquisa_html "$snap" "$escolha" "$crit"
        return 1
    fi
    [ "$acao_ps" = "A" ] || return 1
    arq="$SAVED_SEARCHES_DIR/$escolha.search"
    # Arquivos são gerados pelo próprio eazy; carregam as variáveis e o snapshot.
    # shellcheck disable=SC1090
    source "$arq" 2>/dev/null || return 1
    # Older .search files stored the snapshot as a relative filename. Resolve
    # that reference against the directory containing the saved search, not
    # against the directory from which eazy was launched.
    local pesquisa_dir snapshot_ref origem_ref
    pesquisa_dir=$(cd -- "$(dirname -- "$arq")" 2>/dev/null && pwd -P) || pesquisa_dir="$SAVED_SEARCHES_DIR"
    origem_ref="${BUSCA_ORIGEM:-$(pwd -P)}"
    if [[ "$origem_ref" != /* ]]; then
        origem_ref="$pesquisa_dir/$origem_ref"
    fi
    if [ -d "$origem_ref" ]; then
        BUSCA_ORIGEM=$(cd -- "$origem_ref" 2>/dev/null && pwd -P) || BUSCA_ORIGEM="$origem_ref"
    else
        BUSCA_ORIGEM="$origem_ref"
    fi
    snapshot_ref="${BUSCA_RESULTADO_FILE:-${arq%.search}.results.tsv}"
    if [[ "$snapshot_ref" == /* ]]; then
        BUSCA_SNAPSHOT_FILE="$snapshot_ref"
    else
        BUSCA_SNAPSHOT_FILE="$pesquisa_dir/$snapshot_ref"
    fi
    # Migra snapshots antigos que ainda guardam o caminho relativo.
    normalizar_snapshot_busca "$BUSCA_SNAPSHOT_FILE" "${BUSCA_ORIGEM:-$(pwd -P)}"
    BUSCA_REMAKE=0
    if whiptail --title "Pesquisa salva" --yesno "Abrir o resultado salvo sem refazer a pesquisa?\n\nSim = usar o resultado congelado\nNão = refazer agora (remake)" 12 70; then
        :
    else
        BUSCA_SNAPSHOT_FILE=""
        BUSCA_REMAKE=1
    fi
    MODO_BUSCA=1
    return 0
}
MODO_DUP=0
MODO_DOWNLOAD=0
ARQUIVO_PLAYLIST_ABERTO=""
ALVO=""
ULTIMO_ARQUIVO=""
ULTIMO_DIR=""
DIRETORIO_ANTERIOR=""
DIR_LISTA_ORIGEM=""
ARQUIVO_LISTA_ORIGEM=""
# --- Persistência: posição por diretório ---
# Chave de índice: pasta, playlist, histórico, fila, "dup", etc.
# Funciona para diretórios E para todas as listas (histórico, playlists, temporárias).

# Lê posição real do fzf (focus grava em TMP_FILE; shell vars podem estar velhas)

# Contexto para Alt+V: última lista (pesquisa, histórico, fila 1–3, dup, downloads, pasta)
eazy_capturar_contexto_volta() {
    local item="${1:-${ULTIMO_ARQUIVO:-}}"
    EAZY_VOLTA_KIND=""
    EAZY_VOLTA_PATH=""
    EAZY_VOLTA_ITEM="$item"
    EAZY_VOLTA_CWD="$(pwd -P 2>/dev/null || pwd)"
    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        EAZY_VOLTA_KIND="busca"
        EAZY_VOLTA_PATH="${BUSCA_ORIGEM:-$EAZY_VOLTA_CWD}"
    elif [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        EAZY_VOLTA_KIND="download"
        EAZY_VOLTA_PATH="${DOWNLOAD_QUEUE:-}"
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        EAZY_VOLTA_KIND="dup"
        EAZY_VOLTA_PATH="dup"
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -n "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        EAZY_VOLTA_KIND="playlist"
        EAZY_VOLTA_PATH="$ARQUIVO_PLAYLIST_ABERTO"
    else
        EAZY_VOLTA_KIND="dir"
        EAZY_VOLTA_PATH="$EAZY_VOLTA_CWD"
    fi
    export EAZY_VOLTA_KIND EAZY_VOLTA_PATH EAZY_VOLTA_ITEM EAZY_VOLTA_CWD
}

eazy_aplicar_contexto_volta() {
    # Restaura a última lista / pasta guardada por eazy_capturar_contexto_volta
    local kind="${EAZY_VOLTA_KIND:-}"
    local pth="${EAZY_VOLTA_PATH:-}"
    local item="${EAZY_VOLTA_ITEM:-}"
    local sql_table=""
    [ -z "$kind" ] && return 1
    MODO_BUSCA=0; MODO_DUP=0; MODO_DOWNLOAD=0
    MODO_PLAYLIST=0; ARQUIVO_PLAYLIST_ABERTO=""
    EAZY_VOLTAR_PARA_BUSCA=0
    case "$kind" in
        busca)
            if [ -n "$pth" ] && [ -d "$pth" ]; then
                cd -- "$pth" 2>/dev/null || true
            fi
            MODO_BUSCA=1
            BUSCA_REMAKE=0
            [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
            ;;
        download)
            MODO_DOWNLOAD=1
            TMP=2
            ;;
        dup)
            MODO_DUP=1
            TMP=2
            eazy_dup_carregar_lista 2>/dev/null || true
            ;;
        playlist)
            if [ -n "$pth" ] && [ -f "$pth" ]; then
                MODO_PLAYLIST=1
                ARQUIVO_PLAYLIST_ABERTO="$pth"
                sql_table=$(eazy_sql_list_table_for_view "$pth" 2>/dev/null || true)
                case "$sql_table" in
                    temp_playlist_1) FILA_ATUAL=1 ;;
                    temp_playlist_2) FILA_ATUAL=2 ;;
                    temp_playlist_3) FILA_ATUAL=3 ;;
                esac
                atualizar_fila_atual 2>/dev/null || true
                carregar_posicao_dir "$pth"
                [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
            else
                return 1
            fi
            ;;
        dir)
            if [ -n "$pth" ] && [ -d "$pth" ]; then
                cd -- "$pth" 2>/dev/null || return 1
                carregar_filtro_dir "$(pwd -P)" 2>/dev/null || true
                carregar_posicao_dir "$(pwd -P)"
                [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
            else
                return 1
            fi
            ;;
        *) return 1 ;;
    esac
    ALVO="$(pwd -P 2>/dev/null || pwd)"
    ULTIMO_DIR="$ALVO"
    # limpa contexto (uma volta)
    EAZY_VOLTA_KIND=""
    EAZY_VOLTA_PATH=""
    return 0
}

eazy_ler_cursor_fzf() {
    eazy_ensure_tmp
    [ -f "${TMP_FILE:-}" ] || return 0
    local _t _a _u _d _m
    IFS='|' read -r _t _a _u _d _m < "$TMP_FILE" 2>/dev/null || return 0
    _t=$(printf '%s' "${_t:-}" | tr -cd '0-9')
    [ -n "$_t" ] && TMP="$_t"
    [ -n "${_u:-}" ] && ULTIMO_ARQUIVO="$_u"
    [ -n "${_d:-}" ] && ULTIMO_DIR="$_d"
    [ -n "${_a:-}" ] && ALVO="$_a"
}

# Normaliza item guardado na persistência (sempre absoluto se existir)
eazy_pos_item_norm() {
    local it="${1:-}"
    [ -z "$it" ] && { printf '%s\n' ""; return; }
    if [ -e "$it" ]; then
        readlink -f -- "$it" 2>/dev/null || printf '%s\n' "$it"
    else
        # relativo à pasta actual?
        if [ -e "./$it" ]; then
            readlink -f -- "./$it" 2>/dev/null || printf '%s\n' "$it"
        else
            printf '%s\n' "$it"
        fi
    fi
}

eazy_pos_chave() {
    local k="${1:-}"
    [ -z "$k" ] && { printf '%s\n' ""; return; }
    case "$k" in
        dup|download|downloads|busca)
            printf '%s\n' "$k"
            return
            ;;
    esac
    if [ -e "$k" ]; then
        readlink -f -- "$k" 2>/dev/null || printf '%s\n' "$k"
    else
        # caminho ainda não existente (lista vazia) — normaliza se parecer path
        if [[ "$k" == /* ]]; then
            printf '%s\n' "$k"
        else
            printf '%s\n' "$k"
        fi
    fi
}

eazy_sql_list_position_key() {
    local table hash
    table=$(eazy_sql_list_table_for_view "${1:-}") || return 1
    hash=$(printf '%s' "$table" | sha256sum | awk '{print $1}') || return 1
    printf 'sql-list:%s\n' "$hash"
}

salvar_posicao_dir() {
    [ "${EAZY_IGNORE:-0}" = "1" ] && return 0
    local dir="$1" pos="$2" item="${3:-}"
    [ -z "$dir" ] && return
    dir=$(eazy_sql_list_position_key "$dir" 2>/dev/null || printf '%s' "$dir")
    dir=$(eazy_pos_chave "$dir")
    [ -z "$dir" ] && return
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    if [ -n "$item" ]; then
        item=$(eazy_pos_item_norm "$item")
    fi
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    touch "$POSITIONS_FILE"
    # remove entrada antiga desta chave (campo 1)
    awk -F'|' -v d="$dir" '$1 != d' "$POSITIONS_FILE" 2>/dev/null > "${POSITIONS_FILE}.tmp" || true
    # formato: CHAVE|POS|ITEM
    printf '%s|%s|%s\n' "$dir" "$pos" "$item" >> "${POSITIONS_FILE}.tmp"
    grep -v '^$' "${POSITIONS_FILE}.tmp" 2>/dev/null | tail -n 800 > "$POSITIONS_FILE"
    rm -f "${POSITIONS_FILE}.tmp"
}

carregar_posicao_dir() {
    [ "${EAZY_IGNORE:-0}" = "1" ] && { TMP="${TMP:-1}"; return 0; }
    local dir="$1"
    [ -z "$dir" ] || [ ! -f "$POSITIONS_FILE" ] && { TMP="${TMP:-1}"; return; }
    dir=$(eazy_sql_list_position_key "$dir" 2>/dev/null || printf '%s' "$dir")
    dir=$(eazy_pos_chave "$dir")
    local linha pos item
    linha=$(awk -F'|' -v d="$dir" '$1 == d {line=$0} END {print line}' "$POSITIONS_FILE" 2>/dev/null)
    [ -z "$linha" ] && { TMP="${TMP:-1}"; ULTIMO_ARQUIVO=""; return; }
    pos=$(echo "$linha" | cut -d'|' -f2)
    item=$(echo "$linha" | cut -d'|' -f3-)
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    [ "$pos" -lt 1 ] && pos=1
    TMP="$pos"
    if [ -n "$item" ]; then
        ULTIMO_ARQUIVO=$(eazy_pos_item_norm "$item")
        [ -z "$ULTIMO_ARQUIVO" ] && ULTIMO_ARQUIVO="$item"
    else
        ULTIMO_ARQUIVO=""
    fi
}

# Índice atual da lista ativa (pasta / playlist / histórico / fila / dup)
eazy_chave_lista_atual() {
    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        printf '%s\n' "${DOWNLOAD_QUEUE:-download}"
    elif [ "${MODO_DUP:-0}" -eq 1 ]; then
        printf '%s\n' "dup"
    elif [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -n "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        eazy_sql_list_position_key "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || printf '%s\n' "$ARQUIVO_PLAYLIST_ABERTO"
    elif [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        printf '%s\n' "busca"
    else
        pwd -P 2>/dev/null || pwd
    fi
}

salvar_filtro_dir() {
    local dir="$1" filtro="${2:-}"
    [ -n "$dir" ] || return
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    touch "$FILTER_POSITIONS_FILE"
    awk -F '\t' -v d="$dir" '$1 != d' "$FILTER_POSITIONS_FILE" 2>/dev/null > "${FILTER_POSITIONS_FILE}.tmp" || true
    printf '%s\t%s\n' "$dir" "$filtro" >> "${FILTER_POSITIONS_FILE}.tmp"
    tail -n 500 "${FILTER_POSITIONS_FILE}.tmp" > "$FILTER_POSITIONS_FILE"
    rm -f "${FILTER_POSITIONS_FILE}.tmp"
}

carregar_filtro_dir() {
    local dir="$1" linha
    [ -n "$dir" ] || return
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    linha=$(awk -F '\t' -v d="$dir" '$1 == d {line=$0} END {print line}' "$FILTER_POSITIONS_FILE" 2>/dev/null)
    if [ -n "$linha" ]; then
        FZF_QUERY="${linha#*$'\t'}"
        FZF_QUERY=$(printf '%s' "$FZF_QUERY" | sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g; s/\r//g')
    else
        FZF_QUERY=""
    fi
}

# Salva sessão completa (ao sair ou periodicamente)
salvar_sessao() {
    [ "${EAZY_IGNORE:-0}" = "1" ] && return 0
    mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    local cwd
    cwd=$(pwd)
    # Posição atual: cada playlist tem seu próprio cursor persistente.
    local posicao_chave="$cwd"
    if [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -f "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        posicao_chave="$(readlink -f -- "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || echo "$ARQUIVO_PLAYLIST_ABERTO")"
    fi
    salvar_posicao_dir "$posicao_chave" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
    cat > "$SESSION_FILE" <<EOF
EAZY_CWD=$(printf '%q' "$cwd")
MODO_ATUAL=$(printf '%q' "${MODO_ATUAL:-tamanho}")
FILTRO_ATUAL=$(printf '%q' "${FILTRO_ATUAL:-ambos}")
FILTRO_ANTERIOR=$(printf '%q' "${FILTRO_ANTERIOR:-ambos}")
TELA_ATUAL=$(printf '%q' "${TELA_ATUAL:-fs}")
PREVIEW_ATIVO=$(printf '%q' "${PREVIEW_ATIVO:-0}")
ULTIMO_ARQUIVO=$(printf '%q' "${ULTIMO_ARQUIVO:-}")
DIRETORIO_ANTERIOR=$(printf '%q' "${DIRETORIO_ANTERIOR:-}")
TMP=$(printf '%q' "${TMP:-1}")
EOF
    # preview também no config permanente
    if [ -f "$CONFIG_FILE" ]; then
        if grep -q '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s|^PREVIEW_ATIVO=.*|PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"|" "$CONFIG_FILE"
        else
            echo "PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"" >> "$CONFIG_FILE"
        fi
    else
        echo "PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"" > "$CONFIG_FILE"
    fi
}

carregar_sessao() {
    [ "${EAZY_IGNORE:-0}" = "1" ] && return 1
    [ ! -f "$SESSION_FILE" ] && return 1
    # shellcheck disable=SC1090
    source "$SESSION_FILE" 2>/dev/null || return 1
    if [ -n "${EAZY_CWD:-}" ] && [ -d "$EAZY_CWD" ]; then
        cd "$EAZY_CWD" || true
    fi
    MODO_ATUAL="${MODO_ATUAL:-tamanho}"
    FILTRO_ATUAL="${FILTRO_ATUAL:-ambos}"
    FILTRO_ANTERIOR="${FILTRO_ANTERIOR:-ambos}"
    TELA_ATUAL="${TELA_ATUAL:-$TELA_PADRAO}"
    PREVIEW_ATIVO="${PREVIEW_ATIVO:-0}"
    TMP="${TMP:-1}"
    DIRETORIO_ANTERIOR="${DIRETORIO_ANTERIOR:-}"
    [ -n "$DIRETORIO_ANTERIOR" ] && [ ! -d "$DIRETORIO_ANTERIOR" ] && DIRETORIO_ANTERIOR=""
    # posição salva da pasta
    carregar_posicao_dir "$(pwd)"
    return 0
}

toggle_preview_persistente() {
    if [ "${PREVIEW_ATIVO:-0}" = "1" ]; then
        PREVIEW_ATIVO="0"
    else
        PREVIEW_ATIVO="1"
    fi
    # grava imediatamente
    if [ -f "$CONFIG_FILE" ]; then
        if grep -q '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s|^PREVIEW_ATIVO=.*|PREVIEW_ATIVO=\"$PREVIEW_ATIVO\"|" "$CONFIG_FILE"
        else
            echo "PREVIEW_ATIVO=\"$PREVIEW_ATIVO\"" >> "$CONFIG_FILE"
        fi
    else
        mkdir -p "$CONFIG_DIR" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
        echo "PREVIEW_ATIVO=\"$PREVIEW_ATIVO\"" > "$CONFIG_FILE"
    fi
}

