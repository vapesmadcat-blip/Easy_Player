# Localiza yt-dlp (prioriza binário em ~/.local/bin — atualizado sem pip)
encontrar_ytdlp() {
    local c
    for c in \
        "${HOME}/.local/bin/yt-dlp" \
        "/usr/local/bin/yt-dlp" \
        "/usr/bin/yt-dlp" \
        "$(command -v yt-dlp 2>/dev/null)" \
        "$(command -v youtube-dl 2>/dev/null)"
    do
        [ -n "$c" ] && [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

