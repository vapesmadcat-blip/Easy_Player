#!/usr/bin/env bash
# eazy 3.2 (release)
# Para a versão PRONTA com conversões+F9, use o arquivo eazy-3.2-PRONTO do release/local
set -euo pipefail
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
curl -fsSL "https://raw.githubusercontent.com/vapesmadcat-blip/Easy_Player/c91e1859617135dc827bbe9110662ca79246a5b7/eazy" -o "$TMP"
chmod +x "$TMP"
if ! head -1 "$TMP" | grep -q '^#!'; then
  { printf '%s\n' '#!/usr/bin/env bash'; cat "$TMP"; } > "$TMP.x" && mv "$TMP.x" "$TMP" && chmod +x "$TMP"
fi
exec bash "$TMP" "$@"
