eh_arquivo_texto() {
    local f="$1"
    [ ! -f "$f" ] && return 1
    local ext
    ext=$(echo "${f##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        txt|md|log|conf|cfg|ini|json|xml|csv|c|h|cpp|hpp|js|ts|css|yaml|yml|toml|nfo|srt|ass|ssa|cue|m3u|pls|lst|org|rst|tex|sql|r|rb|go|rs|java|kt|swift|php|pl|lua|vim|diff|patch|gitignore|dockerfile|makefile|readme|license|changelog)
            return 0
            ;;
    esac
    # Fallback: MIME text/*
    if command -v file &>/dev/null; then
        local mime
        mime=$(file -b --mime-type -- "$f" 2>/dev/null)
        [[ "$mime" == text/* ]] && return 0
        [[ "$mime" == application/json ]] && return 0
        [[ "$mime" == application/xml ]] && return 0
        [[ "$mime" == application/javascript ]] && return 0
    fi
    return 1
}

mostrar_texto() {
    local f="$1" rc
    [ ! -f "$f" ] && return 1
    clear
