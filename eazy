        "ia" "IA ativa: $ia_lab" \
        "ia_chat" "Abrir chat com IA" \
        "cancel" "Voltar" \
        3>&1 1>&2 2>&3)
    case "$f9_acao" in
        overview) mostrar_overview_sistema_completo; return ;;
        sound) testar_som; return ;;
        shell) abrir_shell_sistema; return ;;
        exitdir) configurar_dir_saida; return ;;
        download) configurar_downloads; return ;;
        dirs) configurar_diretorios_eazy; return ;;
        lixeira) abrir_lixeira; return ;;
        export_notas) exportar_notas_eazy; return ;;
        hotkeys) configurar_hotkeys; return ;;
        hot_ctrl) eazy_mostrar_hotkeys_modificador ctrl; return ;;
        hot_alt) eazy_mostrar_hotkeys_modificador alt; return ;;
        hot_fn) eazy_mostrar_hotkeys_modificador fn; return ;;
        sel_list) mostrar_selecao_global; return ;;
        sel_op) eazy_toggle_sel_global_op; return ;;
        ia)
            if [ "${IA_ATIVA:-0}" = "1" ]; then IA_ATIVA=0; else IA_ATIVA=1; fi
            if [ -f "$CONFIG_FILE" ]; then
                if grep -q "^IA_ATIVA=" "$CONFIG_FILE" 2>/dev/null; then
                    sed -i "s|^IA_ATIVA=.*|IA_ATIVA=\"$IA_ATIVA\"|" "$CONFIG_FILE"
                else
                    echo "IA_ATIVA=\"$IA_ATIVA\"" >> "$CONFIG_FILE"
                fi
            fi
