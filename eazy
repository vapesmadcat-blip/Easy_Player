        S|H|A|V|W|Z|M|P) ;;
        *) [ "$n" -gt 0 ] || {
        whiptail --title "Ações" --msgbox "Nada selecionado.\nUse TAB/ESPAÇO para marcar arquivos.\n\n(Criar arquivo: opção N)" 10 55
        return
        } ;;
    esac

    case "$acao" in
        S)
            # Sistema
            menu_manutencao_sistema
            ;;
        H)
            # HD/Disco
            menu_manutencao_sistema  # Usa o mesmo menu (opção 3 é análise)
            ;;
        A)
            # Som/Áudio
            menu_gerenciar_som
            ;;
        V)
            # Vídeo
            menu_otimizar_video
            ;;
        W)
            # SWAP
            menu_gerenciar_swap
            ;;
        Z)
            # Diretórios Vazios
            limpar_vazios "$(pwd)"
            ;;
        M)
            menu_manutencao
            ;;
        C)
            menu_conversoes
            ;;
        P)
            # Proteção com senha
            op=$(whiptail --title "🔒 Proteção" --menu "" 10 50 3 \
                "1" "Proteger pasta" \
                "2" "Ver protegidas" \
                "0" "Cancelar" \
                3>&1 1>&2 2>&3)
            case "$op" in
                1)
                    senha=$(whiptail --passwordbox "Senha:" 9 50 3>&1 1>&2 2>&3)
                    if [ -n "$senha" ]; then
                        hash=$(echo -n "$senha" | sha256sum | cut -d' ' -f1)
                        echo "$(pwd -P):$hash" >> "$PASTA_PROTEGIDA_CONFIG"
                        whiptail --title "✓" --msgbox "Protegida!" 8 50
                    fi
                    ;;
                2)
                    [ -f "$PASTA_PROTEGIDA_CONFIG" ] && whiptail --textbox "$PASTA_PROTEGIDA_CONFIG" 12 70
                    ;;
            esac
            ;;
        1)
            # Tocar: reutiliza lógica de multi-seleção
            local playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
            : > "$playlist_sel"
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$p" ] || [[ "$p" =~ \.\.$ ]] && continue
                p_abs=$(caminho_absoluto "$p")
                [ -f "$p_abs" ] && printf '%s\n' "$p_abs" >> "$playlist_sel"
            done <<< "$selecao"
            if [ -s "$playlist_sel" ]; then
                total=$(grep -c '^' "$playlist_sel")
                if [ "$total" -gt 1 ]; then
                    ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
                    registrar_status
                    tocar_lista "$playlist_sel"
                else
                    tocado=$(head -n1 "$playlist_sel")
                    ULTIMO_ARQUIVO="$tocado"
                    registrar_status
                    eazy_abrir_arquivo_enter "$tocado"
                fi
            fi
            rm -f "$playlist_sel"
            ;;
        2) compactar_selecao "$selecao" ;;
        3) descompactar_selecao "$selecao" ;;
        4) editar_selecao "$selecao" ;;
        5) executar_selecao "$selecao" ;;
        Y)
            _py=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.\$' | head -n1)
            _py=$(caminho_absoluto "$_py" 2>/dev/null || echo "$_py")
            if eh_arquivo_python "$_py"; then
                executar_python_arquivo "$_py"
            else
                # tenta primeiro .py da seleção
                _found=""
                while IFS= read -r _l; do
                    [ -z "$_l" ] && continue
                    _p=$(printf '%s\n' "$_l" | awk -F '\t' '{print $NF}')
                    _p=$(caminho_absoluto "$_p" 2>/dev/null || echo "$_p")
                    if eh_arquivo_python "$_p"; then _found="$_p"; break; fi
                done <<< "$selecao"
                if [ -n "$_found" ]; then
                    executar_python_arquivo "$_found"
                else
                    whiptail --title "Python" --msgbox "Nenhum arquivo .py na seleção.\nInterpretador atual: ${PYTHON_CMD:-python3}" 9 55
                fi
            fi
            unset _py _found _l _p
            ;;
        6) renomear_selecao "$selecao" ;;
        7) copiar_arquivos "$selecao" ;;
        8) mover_arquivos "$selecao" ;;
        9)
            # INSERT
            local quantidade_adicionada=0 table_queue
            local -a paths_to_add=()
            if [ "${EAZY_IGNORE:-0}" != "1" ]; then
                eazy_sql_lists_require || return 1
            fi
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                item=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$item" ] || [[ "$item" =~ \.\.$ ]] && continue
                item_abs=$(caminho_absoluto "$item")
                paths_to_add+=("$item_abs")
            done <<< "$selecao"
            if [ "${EAZY_IGNORE:-0}" = "1" ]; then
                for item_abs in "${paths_to_add[@]}"; do
                    if ! grep -Fxq -- "$item_abs" "$PLAYLIST_FILE" 2>/dev/null; then
                        printf '%s\n' "$item_abs" >> "$PLAYLIST_FILE"
                        quantidade_adicionada=$((quantidade_adicionada + 1))
                    fi
                done
                total_fila=$(grep -c '^' "$PLAYLIST_FILE" 2>/dev/null || echo 0)
            else
                table_queue="temp_playlist_${FILA_ATUAL:-1}"
                quantidade_adicionada=$(eazy_sql_list_append_args "$table_queue" "${paths_to_add[@]}") || quantidade_adicionada=0
                eazy_sql_list_refresh_view "$table_queue" || true
                total_fila=$(contar_fila "${FILA_ATUAL:-1}")
            fi
            whiptail --title "Fila" --msgbox "Adicionados: $quantidade_adicionada\nTotal na fila: $total_fila" 9 45
            ;;
    esac
    printf '\n'
    read -r -p "Pressione Enter para voltar ao menu de ações..." _ || true
}

# Copia arquivos selecionados para um destino
# Navegador de destino: lista pastas + "aqui" + "criar pasta" + digitar caminho
# $1 = título da ação (Copiar / Mover)  $2 = qtd itens
# Imprime o caminho escolhido em stdout; vazio = cancelou
escolher_destino() {
    local titulo="${1:-Destino}"
    local nitens="${2:-0}"
    local preferido="${3:-}"
    local cursor dir escolha nome nova dig
    cursor="$(pwd)"
    [ -d "$preferido" ] && cursor="$(cd -- "$preferido" && pwd -P)"

    while true; do
        dir="$cursor"
        # Monta lista: ações especiais + subpastas
        escolha=$(
            {
                printf '%s\n' "✅  ${titulo} AQUI  →  $dir"
                printf '%s\n' "📁  Criar nova pasta aqui…"
                printf '%s\n' "⌨️   Digitar caminho…"
                if [ "$dir" != "/" ]; then
                    printf '%s\n' "⬆   ..  (subir)"
                fi
                # Subdiretórios (não ocultos primeiro, depois todos legíveis)
                find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null | LC_ALL=C sort
                find "$dir" -mindepth 1 -maxdepth 1 -type d -name '.*' -printf '%f\n' 2>/dev/null | LC_ALL=C sort
            } | fzf --prompt="$titulo ($nitens)  $dir ❯ " \
                    --header="Enter: abrir pasta | ações no topo | Esc: cancelar" \
                    --layout=reverse --border=rounded --height=80% \
                    --info=inline --no-multi
        ) || return 1

        [ -z "$escolha" ] && return 1

        case "$escolha" in
            "✅"*)
                printf '%s\n' "$dir"
                return 0
                ;;
            "📁"*)
                nova=$(whiptail --title "Nova pasta" \
                    --inputbox "Nome da pasta em:\n$dir" 10 60 \
                    3>&1 1>&2 2>&3) || continue
                [ -z "$nova" ] && continue
                # Remove barras do nome
                nova=$(printf '%s' "$nova" | tr -d '/')
                if mkdir -p -- "$dir/$nova" 2>/dev/null; then
                    cursor="$dir/$nova"
                else
                    whiptail --title "Erro" --msgbox "Não foi possível criar:\n$dir/$nova" 9 55
                fi
                ;;
            "⌨️"*)
                dig=$(whiptail --title "Caminho de destino" \
                    --inputbox "Digite o caminho completo:" 10 70 "$dir" \
                    3>&1 1>&2 2>&3) || continue
                [ -z "$dig" ] && continue
                dig="${dig/#\~/$HOME}"
                if [ -d "$dig" ]; then
                    cursor=$(cd -- "$dig" && pwd -P)
                else
                    if whiptail --title "Pasta não existe" --yesno "Criar e usar?\n$dig" 9 60; then
                        mkdir -p -- "$dig" 2>/dev/null || {
                            whiptail --title "Erro" --msgbox "Falha ao criar pasta." 8 40
                            continue
                        }
                        cursor=$(cd -- "$dig" && pwd -P)
                    fi
                fi
                ;;
            "⬆"*|..)
                cursor=$(cd -- "$dir/.." && pwd -P)
                ;;
            *)
                # Nome de subpasta
                nome="$escolha"
                if [ -d "$dir/$nome" ]; then
                    cursor=$(cd -- "$dir/$nome" && pwd -P)
                fi
                ;;
        esac
    done
}

# BEGIN EAZY COPY TREE HELPERS
# Os diretórios selecionados são posicionados relativamente ao ancestral comum
# dos itens, preservando nomes de pais sem copiar o caminho absoluto inteiro.
eazy_copy_path_within() {
    local path="$1" root="$2"
    [ "$path" = "$root" ] && return 0
    [ "$root" = "/" ] && [[ "$path" == /* ]] && return 0
    [[ "$path" == "$root/"* ]]
}

eazy_copy_common_root() {
    local root parent path
    [ "$#" -gt 0 ] || return 1
    root=$(dirname -- "$1") || return 1
    shift
    for path in "$@"; do
        parent=$(dirname -- "$path") || return 1
        while ! eazy_copy_path_within "$parent" "$root"; do
            [ "$root" = "/" ] && break
            root=$(dirname -- "$root") || return 1
        done
    done
    printf '%s\n' "$root"
}

eazy_copy_relative_path() {
    local path="$1" root="$2"
    if [ "$root" = "/" ]; then
        printf '%s\n' "${path#/}"
    elif [ "$path" = "$root" ]; then
        printf '%s\n' "$(basename -- "$path")"
    elif eazy_copy_path_within "$path" "$root"; then
        printf '%s\n' "${path#"$root"/}"
    else
        return 1
    fi
}

eazy_copy_unique_path() {
    local original="$1" parent base stem ext candidate i
    parent=$(dirname -- "$original")
    base=$(basename -- "$original")
    if [[ "$base" == *.* && "$base" != .* ]]; then
        ext=".${base##*.}"
        stem="${base%.*}"
    else
        ext=""
        stem="$base"
    fi
    candidate="$parent/${stem} (cópia)${ext}"
    i=2
    while [[ -e "$candidate" || -L "$candidate" ]]; do
        candidate="$parent/${stem} (cópia $i)${ext}"
        i=$((i + 1))
    done
    printf '%s\n' "$candidate"
}

eazy_copy_conflict_menu() {
    local source="$1" target="$2" title message
    if [ "${EAZY_COPY_PREFLIGHT_RUNNING:-0}" = 1 ]; then
        title="Simulação — conflito previsto"
        message="A cópia ainda não começou. Um item com este caminho já existe.\n\nOrigem:\n$source\n\nDestino previsto:\n$target\n\nRegistre agora como tratar este conflito:"
    else
        title="Destino já existe"
        message="Um item com este caminho já existe.\n\nOrigem:\n$source\n\nDestino:\n$target\n\nEscolha como continuar:"
    fi
    whiptail --title "$title" --menu "$message" \
        20 84 5 \
        "rename" "Renomear automaticamente e copiar" \
        "overwrite" "Sobrescrever o item existente" \
        "skip" "Pular este item e continuar com os próximos" \
        "skip_all" "Pular todos os conflitos restantes" \
        "cancel" "Cancelar o restante da cópia" \
        3>&1 1>&2 2>&3
}

eazy_copy_resolve_conflict() {
    local source="$1" target="$2" key action choice
    EAZY_COPY_TARGET="$target"
    EAZY_COPY_DECISION="cancel"
    # Nunca permita que a opção de sobrescrita apague o próprio arquivo-fonte.
    if [ "$source" = "$target" ]; then
        EAZY_COPY_DECISION="skip"
        return 0
    fi
    if [ "${EAZY_NORMAL_COPY_MOVE:-0}" = 1 ]; then
        key="${source}"$'\034'"${target}"
        if [ -z "${EAZY_COPY_PREFLIGHT_ACTIONS[$key]+x}" ]; then
            # O destino mudou depois da simulação. Não pergunte no meio da cópia:
            # pare por segurança e informe a divergência no resumo final.
            EAZY_COPY_CANCEL=1
            EAZY_COPY_DECISION="cancel"
            return 0
        fi
        action="${EAZY_COPY_PREFLIGHT_ACTIONS[$key]}"
        EAZY_COPY_TARGET="${EAZY_COPY_PREFLIGHT_TARGETS[$key]:-$target}"
        case "$action" in
            copy) EAZY_COPY_DECISION="copy" ;;
            overwrite) EAZY_COPY_DECISION="overwrite" ;;
            skip) EAZY_COPY_DECISION="skip" ;;
            *) EAZY_COPY_CANCEL=1; EAZY_COPY_DECISION="cancel" ;;
        esac
        return 0
    fi
    if [ "${EAZY_COPY_SKIP_ALL:-0}" = 1 ]; then EAZY_COPY_DECISION=skip; return 0; fi
    choice=$(eazy_copy_conflict_menu "$source" "$target") || choice=cancel
    case "$choice" in
        rename) EAZY_COPY_TARGET=$(eazy_copy_unique_path "$target"); EAZY_COPY_DECISION=copy ;;
        overwrite) EAZY_COPY_DECISION=overwrite ;;
        skip) EAZY_COPY_DECISION=skip ;;
        skip_all) EAZY_COPY_SKIP_ALL=1; EAZY_COPY_DECISION=skip ;;
        *) EAZY_COPY_CANCEL=1; EAZY_COPY_DECISION=cancel ;;
    esac
}

# Copia uma árvore tratando arquivos individualmente. Diretórios homônimos são
# mesclados; arquivos ou tipos incompatíveis sempre passam pelo menu de conflito.
eazy_copy_tree_preserve() {
    local source="$1" target_root="$2" entry mapped parent_src parent_target
    local conflict_target action i
    local -A dir_targets=()
    local -a new_dir_sources=() new_dir_targets=()
    local source_real target_real

    if [ -d "$source" ] && [ ! -L "$source" ]; then
        source_real=$(cd -- "$source" 2>/dev/null && pwd -P) || {
            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); return 1;
        }
        target_real=$(realpath -m -- "$target_root" 2>/dev/null) || {
            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); return 1;
        }
        if eazy_copy_path_within "$target_real" "$source_real"; then
            whiptail --title "Destino inválido" --msgbox \
                "O caminho final da cópia coincide com a origem ou fica dentro dela.\n\nOrigem:\n$source_real\n\nDestino calculado:\n$target_real\n\nEscolha outro destino para evitar uma cópia recursiva." 14 72 || true
            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1))
            return 1
        fi
        while IFS= read -r -d '' entry; do
            [ "${EAZY_COPY_CANCEL:-0}" = "1" ] && break
            if [ "$entry" = "$source" ]; then
                mapped="$target_root"
            else
                parent_src="${entry%/*}"
                parent_target="${dir_targets[$parent_src]-}"
                if [ -z "$parent_target" ]; then
                    EAZY_COPY_SKIPPED=$((EAZY_COPY_SKIPPED + 1))
                    continue
                fi
                mapped="$parent_target/$(basename -- "$entry")"
            fi

            eazy_status_file "copiando" "$entry" "→ $mapped" 2>/dev/null || true
            if [ -d "$entry" ] && [ ! -L "$entry" ]; then
                if [[ -e "$mapped" || -L "$mapped" ]] && { [ ! -d "$mapped" ] || [ -L "$mapped" ]; }; then
                    eazy_copy_resolve_conflict "$entry" "$mapped"
                    action="$EAZY_COPY_DECISION"
                    mapped="$EAZY_COPY_TARGET"
                    case "$action" in
                        overwrite)
                            rm -rf -- "$mapped" 2>/dev/null || {
                                EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); dir_targets["$entry"]=""; continue;
                            }
                            EAZY_COPY_OVERWRITTEN=$((EAZY_COPY_OVERWRITTEN + 1))
                            ;;
                        skip)
                            EAZY_COPY_SKIPPED=$((EAZY_COPY_SKIPPED + 1)); dir_targets["$entry"]=""; continue
                            ;;
                        cancel)
                            dir_targets["$entry"]=""; break
                            ;;
                    esac
                fi
                if [ ! -d "$mapped" ] || [ -L "$mapped" ]; then
                    if ! mkdir -p -- "$mapped" 2>/dev/null; then
                        EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); dir_targets["$entry"]=""; continue
                    fi
                    new_dir_sources+=("$entry")
                    new_dir_targets+=("$mapped")
                    EAZY_COPY_DIRS=$((EAZY_COPY_DIRS + 1))
                fi
                dir_targets["$entry"]="$mapped"
                continue
            fi

            parent_target=$(dirname -- "$mapped")
            if ! mkdir -p -- "$parent_target" 2>/dev/null; then
                EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); continue
            fi
            conflict_target="$mapped"
            if [[ -e "$conflict_target" || -L "$conflict_target" ]]; then
                eazy_copy_resolve_conflict "$entry" "$conflict_target"
                action="$EAZY_COPY_DECISION"
                conflict_target="$EAZY_COPY_TARGET"
                case "$action" in
                    overwrite)
                        rm -rf -- "$conflict_target" 2>/dev/null || {
                            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); continue;
                        }
                        EAZY_COPY_OVERWRITTEN=$((EAZY_COPY_OVERWRITTEN + 1))
                        ;;
                    skip)
                        EAZY_COPY_SKIPPED=$((EAZY_COPY_SKIPPED + 1)); continue
                        ;;
                    cancel) break ;;
                esac
            fi
            if cp -a --no-clobber -- "$entry" "$conflict_target" 2>/dev/null; then
                EAZY_COPY_COPIED=$((EAZY_COPY_COPIED + 1))
            else
                EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1))
            fi
        done < <(find "$source" -print0 2>/dev/null)

        # As pastas recém-criadas recebem modo e horário originais sem alterar
        # metadados de diretórios preexistentes que foram mesclados.
        for ((i=${#new_dir_sources[@]} - 1; i>=0; i--)); do
            if [ -d "${new_dir_targets[i]}" ] && [ ! -L "${new_dir_targets[i]}" ]; then
                chmod --reference="${new_dir_sources[i]}" -- "${new_dir_targets[i]}" 2>/dev/null || true
                touch -r "${new_dir_sources[i]}" -- "${new_dir_targets[i]}" 2>/dev/null || true
            fi
        done
    else
        if ! mkdir -p -- "$(dirname -- "$target_root")" 2>/dev/null; then
            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); return 1
        fi
        conflict_target="$target_root"
        if [[ -e "$conflict_target" || -L "$conflict_target" ]]; then
            eazy_copy_resolve_conflict "$source" "$conflict_target"
            action="$EAZY_COPY_DECISION"
            conflict_target="$EAZY_COPY_TARGET"
            case "$action" in
                overwrite)
                    rm -rf -- "$conflict_target" 2>/dev/null || {
                        EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); return 1;
                    }
                    EAZY_COPY_OVERWRITTEN=$((EAZY_COPY_OVERWRITTEN + 1))
                    ;;
                skip)
                    EAZY_COPY_SKIPPED=$((EAZY_COPY_SKIPPED + 1)); return 0
                    ;;
                cancel) return 0 ;;
            esac
        fi
        if cp -a --no-clobber -- "$source" "$conflict_target" 2>/dev/null; then
            EAZY_COPY_COPIED=$((EAZY_COPY_COPIED + 1))
        else
            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); return 1
        fi
    fi
    return 0
}

eazy_copy_selected_paths() {
    local destination="$1" root source rel target
    shift
    EAZY_COPY_COPIED=0
    EAZY_COPY_DIRS=0
    EAZY_COPY_OVERWRITTEN=0
    EAZY_COPY_SKIPPED=0
    EAZY_COPY_FAILED=0
    EAZY_COPY_CANCEL=0
    EAZY_COPY_SKIP_ALL=0
    [ "$#" -gt 0 ] || return 1
    root=$(eazy_copy_common_root "$@") || return 1
    for source in "$@"; do
        [ "${EAZY_COPY_CANCEL:-0}" = "1" ] && break
        rel=$(eazy_copy_relative_path "$source" "$root") || {
            EAZY_COPY_FAILED=$((EAZY_COPY_FAILED + 1)); continue;
        }
        target="$destination/$rel"
        eazy_copy_tree_preserve "$source" "$target" || true
    done
}
# END EAZY COPY TREE HELPERS

# BEGIN EAZY COPY SELECTION AND PREFLIGHT
eazy_prepare_copy_move_selection() {
    local operation="$1" incoming="${2:-}" root local_count global_count selected choice path ancestor duplicate list_tmp
    local -a local_paths=() global_paths=() merged=() filtered=()
    local -A global_seen=()
    EAZY_PREPARED_SELECTION="$incoming"
    EAZY_NORMAL_COPY_MOVE=0
    # Somente o navegador normal usa o novo fluxo SQL e o plano sem prompts;
    # listas, busca, downloads e Duplicados mantêm o comportamento anterior.
    if [ "${MODO_PLAYLIST:-0}" -eq 0 ] && [ "${MODO_DOWNLOAD:-0}" -eq 0 ] && \
       [ "${MODO_DUP:-0}" -eq 0 ] && [ "${MODO_BUSCA:-0}" -eq 0 ]; then
        EAZY_NORMAL_COPY_MOVE=1
    else
        return 0
    fi
    if [ "${EAZY_SQL_SELECTION:-0}" != 1 ] || [ "${EAZY_IGNORE:-0}" = 1 ]; then return 0; fi
    root=$(pwd -P 2>/dev/null || pwd)
    local_count=$("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
        --selection-count --selection-state 1 --selection-root "$root" 2>/dev/null) || {
            whiptail --title "$operation — seleção SQLite" --msgbox "Não foi possível consultar a seleção local no banco SQLite. A operação foi cancelada por segurança." 10 68 2>/dev/null || true
            return 1
        }
    global_count=$("${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
        --selection-count --selection-state 2 2>/dev/null) || {
            whiptail --title "$operation — seleção SQLite" --msgbox "Não foi possível contar a seleção global no banco SQLite. A operação foi cancelada por segurança." 10 68 2>/dev/null || true
            return 1
        }
    [[ "$local_count" =~ ^[0-9]+$ ]] || local_count=0
    [[ "$global_count" =~ ^[0-9]+$ ]] || global_count=0

    if [ "$global_count" -gt 0 ]; then
        list_tmp=$(mktemp "${TMPDIR:-/tmp}/eazy-copy-move-global.XXXXXX") || return 1
        if ! "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
            --selection-list0 --selection-state 2 > "$list_tmp" 2>/dev/null; then
            rm -f -- "$list_tmp"
            whiptail --title "$operation — seleção SQLite" --msgbox "Não foi possível listar a seleção global. A operação foi cancelada por segurança." 10 68 2>/dev/null || true
            return 1
        fi
        while IFS= read -r -d '' path; do
            [ -n "$path" ] || continue
            global_paths+=("$path")
            global_seen["$path"]=1
        done < "$list_tmp"
        rm -f -- "$list_tmp"
    fi

    list_tmp=$(mktemp "${TMPDIR:-/tmp}/eazy-copy-move-local.XXXXXX") || return 1
    if ! "${PYTHON_CMD:-python3}" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" \
        --selection-list0 --selection-state 1 --selection-root "$root" > "$list_tmp" 2>/dev/null; then
        rm -f -- "$list_tmp"
        whiptail --title "$operation — seleção SQLite" --msgbox "Não foi possível listar a seleção amarela. A operação foi cancelada por segurança." 10 68 2>/dev/null || true
        return 1
    fi
    while IFS= read -r -d '' path; do [ -n "$path" ] && local_paths+=("$path"); done < "$list_tmp"
    rm -f -- "$list_tmp"
    # Sem marcas amarelas, preserva seleção FZF/cursor da tela atual.
    if [ "${#local_paths[@]}" -eq 0 ] && [ -n "$incoming" ]; then
        while IFS= read -r selected; do
            [ -n "$selected" ] || continue
            path=$(printf '%s\n' "$selected" | awk -F '\t' '{print $NF}')
            [ -n "$path" ] && [ "$path" != ".." ] || continue
            path=$(caminho_absoluto "$path" 2>/dev/null || printf '%s' "$path")
            [ -n "${global_seen[$path]+x}" ] || local_paths+=("$path")
        done <<< "$incoming"
    fi

    if [ "$global_count" -gt 0 ]; then
        choice=$(whiptail --title "$operation — seleção global" --menu \
            "Há $global_count item(ns) na seleção global e $local_count item(ns) amarelo(s) na seleção atual.\n\nO que usar nesta operação?" \
            15 76 2 \
            "local" "Somente os amarelos da seleção atual ($local_count)" \
            "unir" "Incluir também a seleção global ($global_count)" \
            3>&1 1>&2 2>&3) || return 1
        [ -n "$choice" ] || return 1
    else
        choice=local
    fi

    # União opcional sem duplicar caminhos; cópia e movimento recebem caminhos absolutos.
    declare -A seen=()
    for path in "${local_paths[@]}"; do
        [ -n "$path" ] || continue
        path=$(caminho_absoluto "$path" 2>/dev/null || printf '%s' "$path")
        [ -n "${seen[$path]+x}" ] && continue
        seen[$path]=1; merged+=("$path")
    done
    if [ "$choice" = "unir" ]; then
        for path in "${global_paths[@]}"; do
            [ -n "$path" ] || continue
            path=$(caminho_absoluto "$path" 2>/dev/null || printf '%s' "$path")
            [ -n "${seen[$path]+x}" ] && continue
            seen[$path]=1; merged+=("$path")
        done
    fi
    # Um diretório marcado já contém seus descendentes. Removê-los da lista
    # evita mover/copiar a mesma árvore duas vezes quando local e global se cruzam.
    for path in "${merged[@]}"; do
        duplicate=0
        for ancestor in "${merged[@]}"; do
            [ "$path" = "$ancestor" ] && continue
            if [ -d "$ancestor" ] && [ ! -L "$ancestor" ] && eazy_copy_path_within "$path" "$ancestor"; then
                duplicate=1
                break
            fi
        done
        [ "$duplicate" -eq 0 ] && filtered+=("$path")
    done
    merged=("${filtered[@]}")
    EAZY_PREPARED_SELECTION=""
    for path in "${merged[@]}"; do EAZY_PREPARED_SELECTION+="${path}"$'\n'; done
    return 0
}

eazy_copy_preflight_conflicts() {
    local destination="$1" common source rel entry mapped parent_src parent_target key
    local conflicts=0 sample="" shown=0 choice action skip_all=0
    shift
    common=$(eazy_copy_common_root "$@") || return 1
    declare -gA EAZY_COPY_PREFLIGHT_ACTIONS=()
    declare -gA EAZY_COPY_PREFLIGHT_TARGETS=()
    EAZY_COPY_PREFLIGHT_RUNNING=1
    EAZY_COPY_PREFLIGHT_CANCEL=0

    for source in "$@"; do
        rel=$(eazy_copy_relative_path "$source" "$common") || continue
        if [ -d "$source" ] && [ ! -L "$source" ]; then
            local -A dir_targets=()
            while IFS= read -r -d '' entry; do
                if [ "$entry" = "$source" ]; then
                    mapped="$destination/$rel"
                else
                    parent_src="${entry%/*}"
                    parent_target="${dir_targets[$parent_src]-}"
                    if [ -z "$parent_target" ]; then dir_targets["$entry"]=""; continue; fi
                    mapped="$parent_target/$(basename -- "$entry")"
                fi

                if [ -d "$entry" ] && [ ! -L "$entry" ]; then
                    if [[ -e "$mapped" || -L "$mapped" ]] && { [ ! -d "$mapped" ] || [ -L "$mapped" ]; } && [ "$entry" != "$mapped" ]; then
                        conflicts=$((conflicts + 1))
                        [ "$shown" -ge 5 ] || { sample+="\n• $mapped"; shown=$((shown + 1)); }
                        key="${entry}"$'\034'"${mapped}"
                        if [ "$skip_all" -eq 1 ]; then
                            action=skip
                        else
                            choice=$(eazy_copy_conflict_menu "$entry" "$mapped") || choice=cancel
                            case "$choice" in
                                rename) action=copy; mapped=$(eazy_copy_unique_path "$mapped") ;;
                                overwrite) action=overwrite ;;
                                skip) action=skip ;;
                                skip_all) action=skip; skip_all=1 ;;
                                *) EAZY_COPY_PREFLIGHT_CANCEL=1; EAZY_COPY_PREFLIGHT_RUNNING=0; return 1 ;;
                            esac
                        fi
                        EAZY_COPY_PREFLIGHT_ACTIONS["$key"]="$action"
                        EAZY_COPY_PREFLIGHT_TARGETS["$key"]="$mapped"
                        if [ "$action" = skip ]; then dir_targets["$entry"]=""; continue; fi
                    fi
                    dir_targets["$entry"]="$mapped"
                elif [[ -e "$mapped" || -L "$mapped" ]] && [ "$entry" != "$mapped" ]; then
                    conflicts=$((conflicts + 1))
                    [ "$shown" -ge 5 ] || { sample+="\n• $mapped"; shown=$((shown + 1)); }
                    key="${entry}"$'\034'"${mapped}"
                    if [ "$skip_all" -eq 1 ]; then
                        action=skip
                    else
                        choice=$(eazy_copy_conflict_menu "$entry" "$mapped") || choice=cancel
                        case "$choice" in
                            rename) action=copy; mapped=$(eazy_copy_unique_path "$mapped") ;;
                            overwrite) action=overwrite ;;
                            skip) action=skip ;;
                            skip_all) action=skip; skip_all=1 ;;
                            *) EAZY_COPY_PREFLIGHT_CANCEL=1; EAZY_COPY_PREFLIGHT_RUNNING=0; return 1 ;;
                        esac
                    fi
                    EAZY_COPY_PREFLIGHT_ACTIONS["$key"]="$action"
                    EAZY_COPY_PREFLIGHT_TARGETS["$key"]="$mapped"
                fi
            done < <(find "$source" -print0 2>/dev/null)
        else
            mapped="$destination/$rel"
            if [[ -e "$mapped" || -L "$mapped" ]] && [ "$source" != "$mapped" ]; then
                conflicts=$((conflicts + 1))
                [ "$shown" -ge 5 ] || { sample+="\n• $mapped"; shown=$((shown + 1)); }
                key="${source}"$'\034'"${mapped}"
                if [ "$skip_all" -eq 1 ]; then
                    action=skip
                else
                    choice=$(eazy_copy_conflict_menu "$source" "$mapped") || choice=cancel
                    case "$choice" in
                        rename) action=copy; mapped=$(eazy_copy_unique_path "$mapped") ;;
                        overwrite) action=overwrite ;;
                        skip) action=skip ;;
                        skip_all) action=skip; skip_all=1 ;;
                        *) EAZY_COPY_PREFLIGHT_CANCEL=1; EAZY_COPY_PREFLIGHT_RUNNING=0; return 1 ;;
                    esac
                fi
                EAZY_COPY_PREFLIGHT_ACTIONS["$key"]="$action"
                EAZY_COPY_PREFLIGHT_TARGETS["$key"]="$mapped"
            fi
        fi
    done
    EAZY_COPY_PREFLIGHT_RUNNING=0
    EAZY_COPY_PREFLIGHT_CONFLICTS="$conflicts"
    EAZY_COPY_PREFLIGHT_SAMPLE="$sample"
}

eazy_copy_preflight_confirm() {
    local destination="$1" required="$2" conflicts="$3" sample="$4" free_kb free_bytes summary
    free_kb=$(df -Pk -- "$destination" 2>/dev/null | awk 'END {print $4}')
    [[ "$free_kb" =~ ^[0-9]+$ ]] || free_kb=0
    free_bytes=$((free_kb * 1024))
    summary="Simulação da cópia\n\nItens de origem: $5\nTamanho estimado: $(formatar_bytes_label "$required")\nEspaço livre no destino: $(formatar_bytes_label "$free_bytes")\nConflitos previstos: $conflicts${sample}"
    whiptail --title "Prévia da cópia — plano pronto" \
        --yesno "$summary\n\nTodas as decisões de conflito já foram registradas. Iniciar a cópia sem novas perguntas?" 20 82 || return 1
}
