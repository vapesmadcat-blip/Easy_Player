        [ -z "$last_tor" ] && last_tor="${tor_item:-${DOWNLOAD_TOR:-0}}"
        [ "$last_tor" = "1" ] || last_tor="0"
        on_tor_n=ON; on_tor_y=OFF
        [ "$last_tor" = "1" ] && on_tor_n=OFF && on_tor_y=ON
        tor_pick=$(whiptail --title "Download — usar rede Tor?" --radiolist \
            "Usar Tor neste download?\nsocks5://127.0.0.1:9050 (torsocks)\n\nSugestão: $([ "$last_tor" = 1 ] && echo SIM || echo NÃO) — pode mudar" 14 72 2 \
            "0" "Não — rede normal" "$on_tor_n" \
            "1" "Sim — via Tor" "$on_tor_y" \
            3>&1 1>&2 2>&3) || continue
        tor_item="${tor_pick:-0}"
        [ "$tor_item" = "1" ] || tor_item="0"
        printf '%s\n' "$tor_item" > "${LAST_DOWNLOAD_TOR_FILE:-$CONFIG_DIR/last_download_tor}"

        TOR_PREFIX=()
        if [ "$tor_item" = 1 ]; then
            if command -v torsocks >/dev/null 2>&1; then
                TOR_PREFIX=(torsocks)
                echo "   Rede: Tor via torsocks (aria2c/Axel/wget · 127.0.0.1:9050)"
            else
                echo "   Tor marcado, mas torsocks não está instalado — instale: sudo apt install torsocks"
            fi
        else
            echo "   Rede: normal (sem Tor)"
        fi

        # Downloads: tamanho remoto costuma ser desconhecido — exige folga mínima no disco
        {
            read -r _livre_dl _tot_dl < <(info_disco ".")
            _livre_dl=$(echo "${_livre_dl:-0}" | tr -cd '0-9'); _livre_dl=${_livre_dl:-0}
            # Reserva “virtual” de 1 GB para avisar; bloqueio se < mínimo seguro
            if ! verificar_espaco_disco "$((1024*1024*1024))" "$download_dir" "Download" \
                "$((1024*1024*1024))|${link_alvo} (estimativa mínima de reserva)"; then
                continue
            fi
        }

        echo -e "\n\033[1;32m⬇ Iniciando download com [$engine]\033[0m"
        echo -e "   URL : $link_alvo"
        if [ "$engine" = "ytdlp" ]; then
            echo -e "   Formato: ${pass:-best}"
