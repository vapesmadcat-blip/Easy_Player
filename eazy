            local playlist_sel="$EAZY_TMP_DIR/eazy_sel_play_$$"
            : > "$playlist_sel"
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$p" ] || [[ "$p" =~ \.\.$ ]] && continue
                p_abs=$(caminho_absoluto "$p")
