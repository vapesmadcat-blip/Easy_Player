# 2. MANUTENÇÃO DE HD - Limpeza de Temporários
# ============================================================================

limpar_temporarios() {
    local tempo_dias="${1:-30}"
    local tamanho_antes=0
    local tamanho_depois=0
    local contador=0

    whiptail --title "Limpeza de Temporários" --yesno \
        "Remover arquivos temporários com mais de $tempo_dias dias?\n\n\
Diretórios a limpar:\n\
  /tmp\n\
  ~/.cache\n\
  ~/.local/share/Trash\n\
  Arquivos .tmp locais" 12 60 || return 1

    {
        echo "10"

        # /tmp
        tamanho_antes=$(du -sh /tmp 2>/dev/null | cut -f1)
        find /tmp -type f -atime +$tempo_dias -delete 2>/dev/null || true
        echo "30"

        # ~/.cache
        tamanho_antes=$(du -sh ~/.cache 2>/dev/null | cut -f1)
        find ~/.cache -type f -atime +$tempo_dias -delete 2>/dev/null || true
        echo "60"

        # Lixeira
        rm -rf ~/.local/share/Trash/* 2>/dev/null || true
        echo "80"

        # .tmp locais
        find . -name "*.tmp" -type f -atime +$tempo_dias -delete 2>/dev/null || true
        echo "100"
    } | whiptail --gauge "Limpando arquivos temporários..." 8 60 0

    whiptail --title "✓ Limpeza Concluída" --msgbox \
        "Arquivos temporários removidos com sucesso." 8 60
}

# ============================================================================
# 3. MANUTENÇÃO DE HD - Remover Diretórios Vazios
# ============================================================================


# Diretório é considerado vazio quando não contém nenhum arquivo descendente,
# incluindo arquivos ocultos. Subdiretórios vazios não tornam a árvore não vazia.
listar_dirs_sem_arquivos() {
    local pasta="${1:-.}"
    find "$pasta" -mindepth 1 -depth -type d -print 2>/dev/null | while IFS= read -r dir; do
        if ! find "$dir" -mindepth 1 ! -type d -print -quit 2>/dev/null | grep -q .; then
            printf '%s\n' "$dir"
        fi
    done | awk -F/ '{ print NF "\t" $0 }' | LC_ALL=C sort -rn -k1,1 -k2,2 | cut -f2-
}
# Diretórios vazios: sempre listar no fzf → confirmar → rmdir (ou DRY RUN)
# Compat: remover_dirs_vazios / remover_dirs_vazios_fzf → limpar_vazios
remover_dirs_vazios() { limpar_vazios "$@"; }
remover_dirs_vazios_fzf() { limpar_vazios "$@"; }

limpar_vazios() {
    local pasta="${1:-.}"
    local tmp selected n dir item_type ok=0 falha=0 dry_status
    local tmp_dirs tmp_files n_dirs n_files

    [ -d "$pasta" ] || {
        whiptail --title "Erro" --msgbox "Pasta inválida:\n$pasta" 8 50 2>/dev/null || echo "Pasta inválida: $pasta"
        return 1
    }
    if ! command -v fzf >/dev/null 2>&1; then
        whiptail --title "Erro" --msgbox "fzf obrigatório para listar itens antes de apagar." 8 55
        return 1
    fi

    dry_status="DESLIGADO"
    [ "${DRY_RUN:-0}" = "1" ] && dry_status="LIGADO (só simula)"

    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-empty.XXXXXX") || return 1
    tmp_dirs=$(mktemp "${EAZY_TMP_DIR}/eazy-empty-dirs.XXXXXX") || return 1
    tmp_files=$(mktemp "${EAZY_TMP_DIR}/eazy-empty-files.XXXXXX") || return 1

    listar_dirs_sem_arquivos "$pasta" > "$tmp_dirs"
    # Todos os arquivos regulares de 0 bytes, com ou sem extensão, recursivamente.
    find "$pasta" -mindepth 1 -type f -size 0 -print 2>/dev/null | LC_ALL=C sort > "$tmp_files"

    n_dirs=$(wc -l < "$tmp_dirs" 2>/dev/null | tr -cd '0-9'); n_dirs=${n_dirs:-0}
    n_files=$(wc -l < "$tmp_files" 2>/dev/null | tr -cd '0-9'); n_files=${n_files:-0}

    {
        [ "$n_dirs" -gt 0 ] && sed 's|^|[DIR] |' "$tmp_dirs"
        [ "$n_files" -gt 0 ] && sed 's|^|[FILE 0B] |' "$tmp_files"
    } > "$tmp"

    n=$(wc -l < "$tmp" 2>/dev/null | tr -cd '0-9'); n=${n:-0}
    rm -f "$tmp_dirs" "$tmp_files"

    if [ "$n" -eq 0 ]; then
        whiptail --title "Vazios" --msgbox "Nada encontrado em:\n$pasta\n\n· diretórios sem arquivos descendentes\n· arquivos regulares de 0 bytes" 12 55
        rm -f "$tmp"
        return 0
    fi

    echo -e "\n${CYAN}Vazios: $n_dirs pasta(s) + $n_files arquivo(s) 0B | DRY: $dry_status${NC}"
    selected=$(cat "$tmp" | fzf -m --reverse --border \
        --prompt="Selecionar vazios ❯ " \
        --header="[TAB] marcar | [ENTER] confirmar | [ESC] cancelar | DIR=pastas | FILE 0B=arquivos vazios | DRY:$dry_status" \
        --preview='p={}; p="${p#\[DIR\] }"; p="${p#\[FILE 0B\] }"; echo "$p"; echo; ls -la "$p" 2>/dev/null | head -15' \
        --preview-window=down:35%:wrap \
        --height=80%) || true
    rm -f "$tmp"

    if [ -z "$selected" ]; then
        echo -e "${YELLOW}Nada selecionado. Nenhum diretório foi apagado.${NC}"
        sleep 1
        return 0
    fi

    n=$(printf '%s\n' "$selected" | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9'); n=${n:-0}

    tmp=$(mktemp "${EAZY_TMP_DIR}/eazy-empty.XXXXXX") || return 1
    {
        echo "DRY RUN: $dry_status"
        echo "Selecionados ($n):"
        echo "----------------------------------------"
        printf '%s\n' "$selected"
        echo "----------------------------------------"
        echo "Somente rmdir (não usa rm -rf)."
        [ "${DRY_RUN:-0}" = "1" ] && echo "Modo simulação: NADA será removido de verdade."
    } > "$tmp"

    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "Revisão — $n item(ns)" --textbox "$tmp" 22 78 --scrolltext
        if ! whiptail --title "Confirmar" --yesno \
            "Remover $n item(ns) vazio(s)?\n\nDiretórios vazios → rmdir\nArquivos regulares de 0 bytes → rm\n\nDRY RUN: $dry_status" 13 58; then
            rm -f "$tmp"
            echo -e "${YELLOW}Cancelado.${NC}"
            return 0
        fi
    else
        cat "$tmp"
        read -r -p "Confirma? (s/N): " conf
        [[ "$conf" =~ ^[Ss]$ ]] || { rm -f "$tmp"; echo "Cancelado."; return 0; }
    fi

    {
        echo "Processando..."
        echo ""
        while IFS= read -r dir; do
            [ -z "$dir" ] && continue
            # Remove os rótulos como texto literal, não como padrões glob.
            case "$dir" in
                '[DIR] '*) dir="${dir:6}"; item_type=dir ;;
                '[FILE 0B] '*) dir="${dir:10}"; item_type=file ;;
                *) echo "✗ (rótulo inválido) $dir"; falha=$((falha + 1)); continue ;;
            esac
            if [ "${DRY_RUN:-0}" = "1" ]; then
                if [ "$item_type" = file ]; then
                    echo "[DRY RUN] rm -- $dir"
                else
                    echo "[DRY RUN] rmdir -- $dir"
                fi
                ok=$((ok + 1))
                continue
            fi
            if [ "$item_type" = file ]; then
                if [ ! -f "$dir" ] || [ -L "$dir" ] || [ -s "$dir" ]; then
                    echo "✗ (não é arquivo regular vazio) $dir"
                    falha=$((falha + 1))
                    continue
                fi
                if rm -f -- "$dir" 2>/dev/null; then
                    echo "✓ ficheiro $dir"
                    ok=$((ok + 1))
                else
                    echo "✗ (permissão) $dir"
                    falha=$((falha + 1))
                fi
                continue
            fi
            if [ ! -d "$dir" ] || [ -L "$dir" ]; then
                echo "✗ (não existe) $dir"
                falha=$((falha + 1))
                continue
            fi
            if rmdir -- "$dir" 2>/dev/null; then
                echo "✓ pasta $dir"
                ok=$((ok + 1))
            else
                echo "✗ (não vazia/permissão) $dir"
                falha=$((falha + 1))
            fi
        done <<< "$selected"
        echo ""
        echo "Resultado: $ok ok, $falha falha(s). DRY RUN=$dry_status"
    } > "$tmp"

    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "Resultado" --textbox "$tmp" 20 78 --scrolltext
    else
        cat "$tmp"
        read -r -p "Enter..."
    fi
    rm -f "$tmp"
}

