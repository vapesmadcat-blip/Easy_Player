    if eazy_caminho_dentro_config "$raiz"; then
        whiptail --title "Banco de dados" --msgbox \
            "A pasta de configuração do eazy não pode ser usada como ponto de partida.\n\nConfiguração protegida:\n$(eazy_caminho_config_real)\n\nEscolha a pasta atual ou uma pasta fora dela." 12 72
        return 1
    fi
    config_real=$(eazy_caminho_config_real) || return 1
    if ! whiptail --title "Confirmar atualização do banco" --yesno \
        "A atualização começa exatamente nesta pasta:\n\n$raiz\n\nO Easy mostrará a etapa, a quantidade encontrada/processada e o caminho atual desde o início. A configuração do eazy será ignorada.\n\nO índice incremental e as assinaturas MD5 de cada diretório serão atualizados. Monitores ativos da lista F9 serão pausados antes da varredura e retomados ao terminar.\n\nDeseja continuar?" 17 76; then
        return 0
    fi
    mkdir -p "$EAZY_TMP_DIR" 2>/dev/null || true
    resume_file=$(mktemp "$EAZY_TMP_DIR/live-watch-resume.XXXXXX") || {
        whiptail --title "Banco de dados" --msgbox "Não foi possível preparar a retomada dos monitores. A atualização não foi iniciada." 9 68
        return 1
    }
    if ! eazy_live_watch_pause_registered "$resume_file"; then
        eazy_live_watch_resume_registered "$resume_file"
        whiptail --title "Banco de dados" --msgbox "Não foi possível parar com segurança todos os monitores cadastrados. A atualização não foi iniciada.\n\nVerifique os processos e tente novamente." 11 72
        return 1
    fi
    EAZY_INDEX_ROOT="$raiz"
    eazy_config_set EAZY_INDEX_ROOT "$raiz"
    mkdir -p "$EAZY_TMP_DIR" "$(dirname -- "$EAZY_INDEX_DB")" 2>/dev/null || true
    log="$EAZY_TMP_DIR/index-update.log"
    progresso="$EAZY_TMP_DIR/index-progress-$$.tsv"
    : > "$log"
    eazy_index_progress_write "$progresso" "preparando" 0 0 "$raiz"
    (
        "$PYTHON_CMD" "$EAZY_INDEXER" --db "$EAZY_INDEX_DB" --scan-tree "$raiz" \
            --exclude-path "$config_real" --progress-file "$progresso" >/dev/null 2>>"$log"
        rc=$?
        [ "$rc" -eq 0 ] || eazy_index_progress_write "$progresso" "erro" 0 0 "Indexador incremental falhou (código $rc)"
        exit "$rc"
    ) &
    pid=$!
    inicio_update=$SECONDS
    frame=0
    eazy_index_progress_screen "preparando" 0 0 "$raiz" "$raiz" 0 "$frame"
    while kill -0 "$pid" 2>/dev/null; do
        estado=$(cat "$progresso" 2>/dev/null || true)
        if [ -n "$estado" ]; then
            IFS=$'\t' read -r fase feitos total atual <<< "$estado"
        else
            fase="preparando"; feitos=0; total=0; atual="$raiz"
        fi
        feitos=$(printf '%s' "$feitos" | tr -cd '0-9'); feitos=${feitos:-0}
        total=$(printf '%s' "$total" | tr -cd '0-9'); total=${total:-0}
        [ -n "$atual" ] || atual="$raiz"
        elapsed=$((SECONDS - inicio_update)); frame=$((frame + 1))
        eazy_index_progress_screen "$fase" "$feitos" "$total" "$atual" "$raiz" "$elapsed" "$frame"
        [[ "$fase" == "concluido" || "$fase" == "erro" ]] && break
        sleep 1
    done
    if wait "$pid"; then rc=0; else rc=$?; fi
    estado=$(cat "$progresso" 2>/dev/null || true)
    IFS=$'\t' read -r fase feitos total atual <<< "$estado"
    feitos=$(printf '%s' "${feitos:-0}" | tr -cd '0-9'); feitos=${feitos:-0}
    total=$(printf '%s' "${total:-0}" | tr -cd '0-9'); total=${total:-0}
    elapsed=$((SECONDS - inicio_update))
    if [ "$rc" -eq 0 ]; then
        eazy_index_progress_screen "concluido" "$feitos" "$total" "$raiz" "$raiz" "$elapsed" "$frame"
        sleep 1
    else
        eazy_index_progress_screen "erro" "$feitos" "$total" "Consulte o log: $log" "$raiz" "$elapsed" "$frame"
        sleep 1
    fi
    eazy_index_progress_clear
    rm -f "$progresso" "$progresso".*.tmp
    if [ "$rc" -ne 0 ]; then
        eazy_live_watch_resume_registered "$resume_file"
        whiptail --title "Banco de dados" --msgbox "A atualização encontrou um erro.\n\nEtapa: ${fase:-desconhecida}\nPonto inicial: $raiz\n\n$(tail -n 8 "$log" 2>/dev/null)" 14 72
        return "$rc"
    fi
    eazy_live_watch_resume_registered "$resume_file"
    eazy_lista_cache_invalidate all
    EAZY_LAST_DIR_SYNC_CONTEXT=""
    total=$("$PYTHON_CMD" - "$EAZY_INDEX_DB" "$raiz" "$config_real" <<'PYDB'
import sqlite3, sys
try:
    db = sqlite3.connect(sys.argv[1])
    root = sys.argv[2].rstrip('/')
    excluded = sys.argv[3]
    prefix = excluded.rstrip('/') + '/'
    n = db.execute("SELECT count(*) FROM files WHERE (path=? OR path LIKE ?) AND path<>? AND substr(path,1,?)<>?",
                   (root, root + '/%', excluded, len(prefix), prefix)).fetchone()[0]
    print(n)
except Exception:
    print('?')
PYDB
)
    whiptail --title "Banco de dados atualizado" --msgbox \
        "Ponto indexado:\n$raiz\n\nRegistros disponíveis nesse ponto: $total\n\nBanco:\n$EAZY_INDEX_DB\n\nConfiguração do eazy ignorada. As playlists .m3u, .m3u8 e .pls continuam fora desse índice." 15 76
    return 0
}

eazy_live_watch_sessions_dir() {
    local runtime="/dev/shm/eazy-livewatch-${UID:-$(id -u)}" owner fallback
    owner=$(id -u)
    if mkdir -p "$runtime" 2>/dev/null && [ "$(stat -c '%u' "$runtime" 2>/dev/null)" = "$owner" ]; then
        chmod 700 "$runtime" 2>/dev/null || true
        if mkdir -p "$runtime/sessions" 2>/dev/null && chmod 700 "$runtime/sessions" 2>/dev/null; then
            printf '%s\n' "$runtime/sessions"
            return 0
        fi
    fi
    fallback="${EAZY_TMP_DIR:-${CONFIG_DIR:-$HOME/.config/eazy}/tmp}/live-watch-sessions"
    mkdir -p "$fallback" 2>/dev/null || return 1
    chmod 700 "$fallback" 2>/dev/null || true
    printf '%s\n' "$fallback"
}

eazy_live_watch_helper() {
    local candidate
    for candidate in "${EAZY_INSTALL_DIR:-}/eazy-live-watch.py" "/usr/lib/eazy/eazy-live-watch.py"; do
        [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

eazy_live_watch_registry() { printf '%s/live-watch-roots.nul\n' "${CONFIG_DIR}"; }

eazy_live_watch_instance_id() {
    printf '%s\0%s\0' "$1" "${EAZY_INDEX_DB:-}" | sha256sum | cut -c1-24
}

eazy_live_watch_instance_state() {
    printf '%s/live-watch/instances/%s\n' "${CONFIG_DIR}" "$(eazy_live_watch_instance_id "$1")"
}

eazy_live_watch_instance_queue() {
    local sessions runtime id
    sessions=$(eazy_live_watch_sessions_dir) || return 1
    runtime="${sessions%/sessions}"
    id=$(eazy_live_watch_instance_id "$1")
    printf '%s/queues/%s\n' "$runtime" "$id"
}

eazy_live_watch_root_status() {
    local helper state
    helper=$(eazy_live_watch_helper) || return 1
    state=$(eazy_live_watch_instance_state "$1")
    "${PYTHON_CMD:-python3}" "$helper" status --state-dir "$state" 2>/dev/null || true
}
eazy_live_watch_covering_root() {
    local target="$1" registry root status state queue i
    local -a registered=()
    registry=$(eazy_live_watch_registry)
    [ -f "$registry" ] || return 1
    mapfile -d '' -t registered < "$registry" 2>/dev/null || return 1
    for ((i=0; i+1<${#registered[@]}; i+=2)); do
        root="${registered[i]}"
        if [ "$root" != "/" ] && [[ "$target" != "$root" && "$target" != "$root/"* ]]; then
            continue
        fi
        # Só confiar no atalho depois que o backend complementar confirmou prontidão.
        state=$(eazy_live_watch_instance_state "$root")
        [ -f "$state/backend-ready" ] || continue
        status=$(eazy_live_watch_root_status "$root")
        [ "$status" = "ATIVO|$root" ] || continue
        queue=$(eazy_live_watch_instance_queue "$root") || continue
        [ -d "$queue" ] || continue
        printf '%s\t%s\n' "$root" "$queue"
        return 0
    done
    return 1
}
eazy_live_watch_start_root() {
    local helper sessions state queue result hidden_args=()
    helper=$(eazy_live_watch_helper) || return 1
    sessions=$(eazy_live_watch_sessions_dir) || return 1
    state=$(eazy_live_watch_instance_state "$1")
    queue=$(eazy_live_watch_instance_queue "$1") || return 1
    [ "${2:-0}" = 1 ] && hidden_args=(--hidden)
    result=$("${PYTHON_CMD:-python3}" "$helper" start \
        --state-dir "$state" --root "$1" --indexer "$EAZY_INDEXER" \
        --db "$EAZY_INDEX_DB" --exclude "$(eazy_caminho_config_real)" \
        --sessions-dir "$sessions" --queue-dir "$queue" "${hidden_args[@]}" 2>&1) || {
        printf '%s\n' "$result"
        return 1
    }
    printf '%s\n' "$result"
}

eazy_live_watch_stop_root() {
    local helper state
    helper=$(eazy_live_watch_helper) || return 1
    state=$(eazy_live_watch_instance_state "$1")
    "${PYTHON_CMD:-python3}" "$helper" stop --state-dir "$state" 2>&1
}

eazy_live_watch_registry_add() {
    local registry tmp
    registry=$(eazy_live_watch_registry)
    mkdir -p "$(dirname -- "$registry")" || return 1
    tmp=$(mktemp "${registry}.XXXXXX") || return 1
    [ ! -f "$registry" ] || cat -- "$registry" > "$tmp"
    printf '%s\0%s\0' "$1" "${2:-0}" >> "$tmp"
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f -- "$tmp" "$registry"
}

eazy_live_watch_registry_remove() {
    local remove_index="$1" registry tmp i
    local -a items=()
    registry=$(eazy_live_watch_registry)
    [ -f "$registry" ] && mapfile -d '' -t items < "$registry"
    tmp=$(mktemp "${registry}.XXXXXX") || return 1
    for ((i=0; i+1<${#items[@]}; i+=2)); do
        [ "$((i/2+1))" = "$remove_index" ] && continue
        printf '%s\0%s\0' "${items[i]}" "${items[i+1]}" >> "$tmp"
    done
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f -- "$tmp" "$registry"
}

eazy_live_watch_status_label() {
    local registry root status active=0 total=0 i
    local -a items=()
    registry=$(eazy_live_watch_registry)
    [ -f "$registry" ] && mapfile -d '' -t items < "$registry"
    for ((i=0; i+1<${#items[@]}; i+=2)); do
        total=$((total + 1))
        status=$(eazy_live_watch_root_status "${items[i]}")
        case "$status" in ATIVO\|*) active=$((active + 1));; esac
    done
    if [ "$total" -eq 0 ]; then printf 'desligado'; else printf '%s/%s ativos' "$active" "$total"; fi
}

eazy_live_watch_migrate_legacy() {
    local quiet="${1:-0}" helper legacy_state legacy_status root pid hidden=0 registry status result i found=0
    local -a items=()
    helper=$(eazy_live_watch_helper) || return 0
    legacy_state="${CONFIG_DIR}/live-watch"
    legacy_status=$("${PYTHON_CMD:-python3}" "$helper" status --state-dir "$legacy_state" 2>/dev/null || true)
    case "$legacy_status" in
        ATIVO\|*) root="${legacy_status#ATIVO|}";;
        *)
            # Recolhe órfãos das versões antigas somente se o argv[0] for o
            # executável full guardado neste diretório legado específico.
            "${PYTHON_CMD:-python3}" "$helper" stop --state-dir "$legacy_state" >/dev/null 2>&1 || true
            return 0
            ;;
    esac
    pid=$(cat "$legacy_state/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] && tr '\0' '\n' < "/proc/$pid/cmdline" | grep -Fxq -- '--hidden'; then hidden=1; fi
    registry=$(eazy_live_watch_registry)
    [ -f "$registry" ] && mapfile -d '' -t items < "$registry" || items=()
    for ((i=0; i+1<${#items[@]}; i+=2)); do
        if [ "${items[i]}" = "$root" ]; then hidden="${items[i+1]}"; found=1; break; fi
    done
    if [ "$found" -eq 0 ]; then eazy_live_watch_registry_add "$root" "$hidden" || return 1; fi
    if ! result=$("${PYTHON_CMD:-python3}" "$helper" stop --state-dir "$legacy_state" 2>&1); then
        [ "$quiet" = quiet ] || whiptail --title "Monitor legado" --msgbox "Não foi possível transferir com segurança o monitor antigo desta raiz:\n$root\n\n$result" 12 76
        return 1
    fi
    status=$(eazy_live_watch_root_status "$root")
    case "$status" in ATIVO\|*) result="A raiz já está ativa na lista.";;
        *) result=$(eazy_live_watch_start_root "$root" "$hidden" 2>&1) || {
            [ "$quiet" = quiet ] || whiptail --title "Monitor legado migrado" --msgbox "A raiz foi incluída na lista e o processo antigo foi parado, mas não consegui reativá-la.\n\n$root\n\n$result" 13 76
            return 1
        } ;;
    esac
    [ "$quiet" = quiet ] || whiptail --title "Monitor transferido para a lista F9" --msgbox "$root\n\nO monitor legado foi parado e a raiz agora usa estado e fila exclusivos. O comportamento de acompanhamento foi mantido." 11 76
}

eazy_live_watch_menu() {
    local helper sessions registry root status result hidden current desc choice idx i selected hidden_flag duplicate
    local -a items=() menu_items=() remove_items=()
    helper=$(eazy_live_watch_helper) || {
        whiptail --title "Monitor em tempo real" --msgbox "Os arquivos eazy-live-watch.py e full.c não foram encontrados. Reextraia o pacote atualizado ou instale os auxiliares do Easy." 10 72
        return 1
    }
    sessions=$(eazy_live_watch_sessions_dir) || {
        whiptail --title "Monitor em tempo real" --msgbox "Não foi possível preparar as filas temporárias do monitor." 9 68
        return 1
    }
    registry=$(eazy_live_watch_registry)
    eazy_live_watch_migrate_legacy || true
    while :; do
        items=(); menu_items=("add" "Adicionar diretório à lista" "start_all" "Iniciar todos os diretórios" "stop_all" "Parar todos os monitores" "remove" "Remover diretório da lista")
        [ ! -f "$registry" ] || mapfile -d '' -t items < "$registry"
        for ((i=0; i+1<${#items[@]}; i+=2)); do
            root="${items[i]}"; hidden_flag="${items[i+1]}"
            status=$(eazy_live_watch_root_status "$root")
            desc="[PARADO] ${root//$'\n'/ }"
            case "$status" in ATIVO\|*) desc="[ATIVO] ${root//$'\n'/ }";; esac
            menu_items+=("root_$((i/2+1))" "$desc")
        done
        choice=$(whiptail --title "F9 — Monitores recursivos" \
            --menu "Lista persistente de diretórios. Cada raiz tem fila e monitor isolados; selecione uma raiz para ligar/desligar." \
            24 92 14 "${menu_items[@]}" 3>&1 1>&2 2>&3) || return 0
        case "$choice" in
            add)
                root=$(whiptail --title "Adicionar diretório monitorado" --inputbox \
                    "Informe a raiz que será acompanhada recursivamente:" 10 78 "$(pwd -P 2>/dev/null || pwd)" 3>&1 1>&2 2>&3) || continue
                [ -d "$root" ] || { whiptail --title "Raiz inválida" --msgbox "A pasta não existe ou não pode ser acessada:\n$root" 9 68; continue; }
                root=$(realpath -e -- "$root" 2>/dev/null) || continue
                [ -f "$registry" ] && mapfile -d '' -t items < "$registry" || items=()
                duplicate=0
                for ((i=0; i+1<${#items[@]}; i+=2)); do
                    current="${items[i]}"
                    if [ "$root" = "$current" ] || [[ "$root/" == "$current/"* ]] || [[ "$current/" == "$root/"* ]]; then duplicate=1; break; fi
                done
                if [ "$duplicate" -eq 1 ]; then
                    whiptail --title "Raiz já coberta" --msgbox "Essa raiz já está cadastrada, ou está dentro de outra raiz da lista. Evitei criar monitores sobrepostos." 10 70
                    continue
                fi
                hidden_flag=0
                if whiptail --title "Arquivos ocultos" --yesno "Incluir itens ocultos dentro desta raiz?" 9 66; then hidden_flag=1; fi
                if eazy_live_watch_registry_add "$root" "$hidden_flag"; then
                    result=$(eazy_live_watch_start_root "$root" "$hidden_flag" 2>&1) && \
                        whiptail --title "Monitor adicionado e iniciado" --msgbox "$result" 9 70 || \
                        whiptail --title "Raiz cadastrada, mas não iniciada" --msgbox "$result\n\nConsulte o log em:\n$(eazy_live_watch_instance_state "$root")/watch.log" 12 76
                fi
                ;;
            start_all|stop_all)
                [ -f "$registry" ] && mapfile -d '' -t items < "$registry" || items=()
                result=""
                for ((i=0; i+1<${#items[@]}; i+=2)); do
                    root="${items[i]}"; hidden_flag="${items[i+1]}"
                    if [ "$choice" = start_all ]; then
                        status=$(eazy_live_watch_root_status "$root")
                        case "$status" in ATIVO\|*) continue;; esac
                        if current=$(eazy_live_watch_start_root "$root" "$hidden_flag" 2>&1); then :; else current="ERRO: $current"; fi
                    else
                        status=$(eazy_live_watch_root_status "$root")
                        case "$status" in ATIVO\|*)
                            if current=$(eazy_live_watch_stop_root "$root" 2>&1); then :; else current="ERRO: $current"; fi
                            ;;
                            *) continue;;
                        esac
                    fi
                    result+="${root}: ${current}\n"
                done
                [ -n "$result" ] || result="Nenhuma alteração: todos já estavam no estado solicitado."
                whiptail --title "Monitores recursivos" --msgbox "$result" 16 78
                ;;
            remove)
                [ -f "$registry" ] && mapfile -d '' -t items < "$registry" || items=()
                remove_items=()
                for ((i=0; i+1<${#items[@]}; i+=2)); do remove_items+=("root_$((i/2+1))" "${items[i]}"); done
                [ "${#remove_items[@]}" -gt 0 ] || { whiptail --title "Lista vazia" --msgbox "Não há diretórios cadastrados." 8 52; continue; }
                selected=$(whiptail --title "Remover diretório monitorado" --menu "Selecione a raiz a remover; se estiver ativa, será parada primeiro." 20 88 12 "${remove_items[@]}" 3>&1 1>&2 2>&3) || continue
                idx="${selected#root_}"; root="${items[$(((idx-1)*2))]}"; status=$(eazy_live_watch_root_status "$root")
                case "$status" in ATIVO\|*)
                    if ! whiptail --title "Parar e remover" --yesno "Parar o monitor e remover esta raiz da lista?\n\n$root" 11 76; then continue; fi
                    eazy_live_watch_stop_root "$root" >/dev/null 2>&1 || true
                    ;;
                esac
                eazy_live_watch_registry_remove "$idx"
                whiptail --title "Diretório removido" --msgbox "$root" 8 72
                ;;
            root_*)
                idx="${choice#root_}"; root="${items[$(((idx-1)*2))]}"; hidden_flag="${items[$(((idx-1)*2+1))]}"
                status=$(eazy_live_watch_root_status "$root")
                case "$status" in
                    ATIVO\|*)
                        if whiptail --title "Monitor ativo" --yesno "Parar o monitor desta raiz?\n\n$root" 11 76; then
                            result=$(eazy_live_watch_stop_root "$root" 2>&1) && whiptail --title "Monitor parado" --msgbox "$result" 9 64
                        fi
                        ;;
                    *)
                        result=$(eazy_live_watch_start_root "$root" "$hidden_flag" 2>&1) && \
                            whiptail --title "Monitor recursivo ativo" --msgbox "$result\n\nEsta raiz foi sincronizada com o SQLite e será atualizada por eventos. FZF com --listen atualiza a pasta aberta imediatamente." 12 76 || \
                            whiptail --title "Falha ao iniciar monitor" --msgbox "$result\n\nConsulte:\n$(eazy_live_watch_instance_state "$root")/watch.log" 12 76
                        ;;
                esac
                ;;
        esac
    done
}

eazy_config_set_value() {
    local key="$1" value="$2" tmp
    [[ "$key" =~ ^[A-Z_]+$ ]] || return 1
    mkdir -p "$CONFIG_DIR" || return 1
    tmp="${CONFIG_FILE}.tmp.$$"
    if [ -f "$CONFIG_FILE" ]; then
        grep -v "^${key}=" "$CONFIG_FILE" > "$tmp" || true
    else
        : > "$tmp"
    fi
    printf '%s=%q\n' "$key" "$value" >> "$tmp"
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f -- "$tmp" "$CONFIG_FILE"
}

eazy_config_unset_value() {
    local key="$1" tmp
    [[ "$key" =~ ^[A-Z_]+$ ]] || return 1
    mkdir -p "$CONFIG_DIR" || return 1
    tmp="${CONFIG_FILE}.tmp.$$"
    if [ -f "$CONFIG_FILE" ]; then
        grep -v "^${key}=" "$CONFIG_FILE" > "$tmp" || true
    else
        : > "$tmp"
    fi
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f -- "$tmp" "$CONFIG_FILE"
}

eazy_m3u_filesystem_for_path() {
    local path="$1" fs=""
    if command -v findmnt >/dev/null 2>&1; then
        fs=$(findmnt --noheadings --raw --output FSTYPE --target "$path" 2>/dev/null | head -n 1)
    fi
    if [ -z "$fs" ] && [ -e "$path" ]; then
        fs=$(stat -f -c '%T' -- "$path" 2>/dev/null || true)
    fi
    printf '%s' "${fs:-desconhecido}"
}

eazy_m3u_show_mounts() {
    local report="$EAZY_TMP_DIR/m3u_mounts_$$.txt"
    mkdir -p "$EAZY_TMP_DIR"
    {
        printf 'Montagem                                                   Sistema de arquivos\n'
        printf '%s\n' '--------------------------------------------------------------------------------'
        if command -v findmnt >/dev/null 2>&1; then
            findmnt --noheadings --raw --types ext4,ntfs,ntfs3,drvfs,9p,fuseblk,xfs,btrfs,nfs,nfs4,cifs,vfat,exfat \
                --output TARGET,FSTYPE 2>/dev/null \
                | awk '{ printf "%-58s %s\n", $1, $2 }'
        else
            printf 'findmnt não está instalado; instale util-linux para listar montagens.\n'
        fi
        printf '\nDestinos de playlists configurados:\n'
        printf '  Windows: %s  [%s]\n' "${M3U_WINDOWS_OUT_DIR:-não definido}" "$(eazy_m3u_filesystem_for_path "${M3U_WINDOWS_OUT_DIR:-/}")"
        printf '  Linux:   %s  [%s]\n' "${M3U_LINUX_OUT_DIR:-não definido}" "$(eazy_m3u_filesystem_for_path "${M3U_LINUX_OUT_DIR:-$HOME}")"
    } > "$report"
    whiptail --title 'Montagens e sistemas de arquivos' --textbox "$report" 24 88
    rm -f -- "$report"
}

eazy_m3u_set_destination() {
    local kind="$1" current prompt dest fs key
    if [ "$kind" = windows ]; then
        current="${M3U_WINDOWS_OUT_DIR:-}"
        prompt="Pasta Windows acessível pelo Linux/WSL onde serão salvas conversões Linux → Windows.\nExemplo: /mnt/c/Users/USUARIO/EazyData"
        key=M3U_WINDOWS_OUT_DIR
    else
        current="${M3U_LINUX_OUT_DIR:-$HOME/EazyData}"
        prompt="Pasta Linux onde serão salvas conversões Windows → Linux.\nExemplo: $HOME/EazyData ou um caminho Linux montado."
        key=M3U_LINUX_OUT_DIR
    fi
    dest=$(whiptail --title 'Destino da integração' --inputbox "$prompt" 13 78 "$current" 3>&1 1>&2 2>&3) || return 0
    [ -n "$dest" ] || return 0
    case "$dest" in
        '~') dest="$HOME" ;;
        '~/'*) dest="$HOME/${dest#\~/}" ;;
    esac
    case "$dest" in
        /*) ;;
        *) whiptail --title 'Caminho inválido' --msgbox 'Informe um caminho Linux absoluto, por exemplo /mnt/c/Users/USUARIO/EazyData.' 9 76; return 1 ;;
    esac
    if [ ! -d "$dest" ]; then
        whiptail --title 'Criar pasta de destino' --yesno "A pasta ainda não existe:\n$dest\n\nCriar agora?" 11 76 || return 0
        mkdir -p -- "$dest" || { whiptail --title 'Erro' --msgbox "Não foi possível criar:\n$dest" 9 70; return 1; }
    fi
    fs=$(eazy_m3u_filesystem_for_path "$dest")
    if whiptail --title 'Confirmar destino' --yesno "Pasta:\n$dest\n\nSistema de arquivos detectado: $fs\n\nSalvar como destino $([ "$kind" = windows ] && echo Windows || echo Linux)?" 13 78; then
        if [ "$key" = M3U_WINDOWS_OUT_DIR ]; then M3U_WINDOWS_OUT_DIR="$dest"; else M3U_LINUX_OUT_DIR="$dest"; fi
        eazy_config_set_value "$key" "$dest"
        whiptail --title 'Integração' --msgbox "Destino salvo.\n\n$dest\nSistema de arquivos: $fs" 10 72
    fi
}

eazy_configurar_integracao() {
    local opcao
    while true; do
        opcao=$(whiptail --title 'F9 — Integração Linux/Windows (WSL)' --menu \
            "Destinos das playlists convertidas:\nLinux → Windows: ${M3U_WINDOWS_OUT_DIR:-não configurado}\nWindows → Linux: ${M3U_LINUX_OUT_DIR:-não configurado}" 18 82 4 \
            '1' 'Configurar pasta Windows (saída Linux → Windows)' \
            '2' 'Configurar pasta Linux (saída Windows → Linux)' \
            '3' 'Ver pastas montadas e sistemas de arquivos' \
            '0' 'Voltar' 3>&1 1>&2 2>&3) || return 0
        case "$opcao" in
            1) eazy_m3u_set_destination windows ;;
            2) eazy_m3u_set_destination linux ;;
