# --- HELP EXPANDIDO (F10) — HTML + terminal + seções ---
exibir_help_expandido() {
    local html dest escolha
    dest="$(eazy_dir_html_export 2>/dev/null || true)"
    [ -n "$dest" ] || dest="${HOME}/Documentos/Easy-Pesquisas"
    [ -d "$dest" ] || dest="${HOME}/Documents/Easy-Pesquisas"
    [ -d "$dest" ] || dest="${CONFIG_DIR:-$HOME/.config/eazy}"
    mkdir -p "$dest" "${EAZY_TMP_DIR:-$CONFIG_DIR/tmp}" 2>/dev/null || true
    html="${dest}/eazy-help-${EAZY_VERSION}.html"

    eazy_gerar_help_html "$html"

    escolha=$(whiptail --title "eazy ${EAZY_VERSION} — ${EAZY_AUTHOR}" --menu \
        "eazy ${EAZY_VERSION}  ·  ${EAZY_AUTHOR}\nHelp completo gerado.\n\nEscolha como visualizar:" 18 72 5 \
        "1" "Abrir HTML no navegador (recomendado)" \
        "2" "Ver no terminal (less / rolagem)" \
        "3" "Seções no terminal (menu)" \
        "4" "Só caminho do HTML" \
        "5" "Cancelar" \
        3>&1 1>&2 2>&3) || return 0

    case "$escolha" in
        1)
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$html" 2>/dev/null &
            elif command -v sensible-browser >/dev/null 2>&1; then
                sensible-browser "$html" 2>/dev/null &
            else
                whiptail --title "HTML" --msgbox "Arquivo:\n$html\n\nAbra no navegador." 12 70
            fi
            ;;
        2)
            eazy_help_texto | less -R
            ;;
        3)
            eazy_help_menu_secoes
            ;;
        4)
            whiptail --title "HTML gerado" --msgbox "Help HTML:\n\n$html" 12 72
            ;;
        *) return 0 ;;
    esac
}

eazy_help_menu_secoes() {
    local s
    while true; do
        s=$(whiptail --title "Help por seção — eazy ${EAZY_VERSION}" --menu \
            "Selecione a seção:" 22 78 12 \
            "nav"    "Navegação, filtros e busca" \
            "dup"    "Duplicados e progresso" \
            "fila"   "Filas, playlists e ações" \
            "dl"     "Downloads, Tor e torrents" \
            "ai"     "IA (eazy-ai) e notas" \
            "player" "Player, conversões e PDF" \
            "maint"  "Manutenção (Ctrl-K)" \
            "sys"    "Sistema, config e saída" \
            "cli"    "Linha de comando" \
            "html"   "Abrir HTML completo" \
            "sair"   "Voltar" \
            3>&1 1>&2 2>&3) || return 0
        case "$s" in
            sair) return 0 ;;
            html)
                local h
                h="$(eazy_dir_html_export 2>/dev/null || echo "${CONFIG_DIR}/eazy-help-${EAZY_VERSION}.html")"
                [ -f "$h" ] || h="${CONFIG_DIR}/eazy-help-${EAZY_VERSION}.html"
                eazy_gerar_help_html "$h"
                xdg-open "$h" 2>/dev/null || true
                ;;
            *)
                local tf
                tf=$(mktemp "${EAZY_TMP_DIR:-/tmp}/eazy-help-sec.XXXXXX")
                eazy_help_secao "$s" > "$tf"
                whiptail --title "eazy — $s" --scrolltext --textbox "$tf" 28 88
                rm -f "$tf"
                ;;
        esac
    done
}

