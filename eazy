#!/usr/bin/env bash
# eazy — bootstrap temporário de recuperação
# O arquivo completo foi restaurado incorretamente; baixe a versão boa:
#   curl -L -o eazy https://raw.githubusercontent.com/vapesmadcat-blip/Easy_Player/eazy-v3.0-9/eazy
#   chmod +x eazy
# Ou: git checkout eazy-v3.0-9 -- eazy
set -euo pipefail
TAG_URL="https://raw.githubusercontent.com/vapesmadcat-blip/Easy_Player/eazy-v3.0-9/eazy"
SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
DIR="$(cd "$(dirname "$SELF")" && pwd)"
TARGET="$DIR/eazy"
echo "eazy: recuperando versão eazy-v3.0-9…" >&2
if command -v curl >/dev/null 2>&1; then
  curl -fsSL -o "$TARGET.tmp" "$TAG_URL"
elif command -v wget >/dev/null 2>&1; then
  wget -q -O "$TARGET.tmp" "$TAG_URL"
else
  echo "Instale curl ou wget, ou: git checkout eazy-v3.0-9 -- eazy" >&2
  exit 1
fi
mv -f "$TARGET.tmp" "$TARGET"
chmod +x "$TARGET"
echo "OK. Reexecutando…" >&2
exec "$TARGET" "$@"
