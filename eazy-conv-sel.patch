+# Extrai caminhos absolutos da seleção do eazy (linhas fzf / tab)
+eazy_paths_from_selecao() {
+    local selecao="${1:-}"
+    local linha p
+    [ -n "$selecao" ] || return 0
+    while IFS= read -r linha; do
+        [ -z "$linha" ] && continue
+        p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
+        [ -z "$p" ] && continue
+        [[ "$p" =~ \.\.\$ ]] && continue
+        eazy_eh_navegacao "$p" 2>/dev/null && continue
+        p=$(caminho_absoluto "$p" 2>/dev/null || printf '%s\n' "$p")
+        [ -f "$p" ] && printf '%s\n' "$p"
+    done <<< "$selecao"
+}
+
+# Filtra lista de paths por tipo: video | imagem | pdf
+eazy_filtrar_tipo() {
+    local tipo="$1"
+    local f ext
+    while IFS= read -r f; do
+        [ -f "$f" ] || continue
+        ext=$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')
+        case "$tipo" in
+            video)  [[ "$ext" =~ ^(mp4|avi|mkv|mov|webm|mpg|mpeg|m4v|wmv|flv)$ ]] && printf '%s\n' "$f" ;;
+            imagem) [[ "$ext" =~ ^(jpg|jpeg|png|bmp|gif|webp|tif|tiff)$ ]] && printf '%s\n' "$f" ;;
+            pdf)    [[ "$ext" == "pdf" ]] && printf '%s\n' "$f" ;;
+            *)      printf '%s\n' "$f" ;;
+        esac
+    done
+}
