fi

# ─── Cursor helpers ───────────────────────────────────────────
pos_para_linha_col() {
    local pos=$1 linha=1 col=1 i=0 len=${#BUFFER}
    (( pos > len )) && pos=$len
    while (( i < pos )); do
        local c="${BUFFER:i:1}"
        if [[ "$c" == "$LF" ]]; then ((linha++)); col=1
        elif [[ "$c" != "$CR" ]]; then ((col++)); fi
        ((i++))
    done
    echo "$linha $col"
}

mover_vertical() {
    local dir=$1
    read -r cur_linha cur_col <<< "$(pos_para_linha_col $CURSOR_POS)"
    local target=$((cur_linha + dir))
    (( target < 1 )) && return
    local linha=1 i=0 len=${#BUFFER} col=1
    while (( i <= len )); do
        if (( linha == target )); then
            if (( col == cur_col )); then CURSOR_POS=$i; return; fi
            if (( i == len )) || [[ "${BUFFER:i:1}" == "$LF" ]]; then CURSOR_POS=$i; return; fi
        fi
        (( i == len )) && break
        local c="${BUFFER:i:1}"
        if [[ "$c" == "$LF" ]]; then
            ((linha++)); col=1
            (( linha > target )) && return
        elif [[ "$c" != "$CR" ]]; then ((col++)); fi
        ((i++))
    done
}

inserir() {
    local s="$1"
    BUFFER="${BUFFER:0:CURSOR_POS}${s}${BUFFER:CURSOR_POS}"
    CURSOR_POS=$(( CURSOR_POS + ${#s} ))
}

apagar_esquerda() {
    (( CURSOR_POS <= 0 )) && return
    if (( CURSOR_POS >= 2 )) && [[ "${BUFFER:CURSOR_POS-2:2}" == "$CRLF" ]]; then
        BUFFER="${BUFFER:0:CURSOR_POS-2}${BUFFER:CURSOR_POS}"
        CURSOR_POS=$(( CURSOR_POS - 2 ))
    else
        BUFFER="${BUFFER:0:CURSOR_POS-1}${BUFFER:CURSOR_POS}"
        CURSOR_POS=$(( CURSOR_POS - 1 ))
    fi
}

# Quebra automática visual: parte uma string em pedaços de no máx. maxw chars
wrap_linha() {
    local s="$1" maxw="$2"
    local -n _out=$3
    _out=()
    if [[ -z "$s" ]]; then _out=(""); return; fi
    while (( ${#s} > maxw )); do
        _out+=("${s:0:maxw}")
        s="${s:maxw}"
    done
    _out+=("$s")
}

carregar_lista_import() {
    IMPORT_LIST=()
    local f name
    local -a dirs=() files=()
    local filt="${IMPORT_FILTER,,}"   # minúsculas para filtro case-insensitive

    if [[ "$IMPORT_DIR" != "/" ]]; then
        # ".." só some se o filtro não estiver vazio e não casar
        if [[ -z "$filt" || ".." == *"$filt"* ]]; then
            IMPORT_LIST+=("..")
        fi
    fi

    shopt -s nullglob
    for f in "$IMPORT_DIR"/* "$IMPORT_DIR"/.[!.]*; do
        name="${f##*/}"
        [[ "$name" == "." || "$name" == ".." ]] && continue
        # filtro
        if [[ -n "$filt" ]]; then
            local low="${name,,}"
            [[ "$low" != *"$filt"* ]] && continue
        fi
        if [[ -d "$f" ]]; then
            dirs+=("$name/")
        elif [[ -f "$f" ]]; then
            files+=("$name")
        fi
    done
    shopt -u nullglob

    if ((${#dirs[@]} > 0)); then
        IFS=$'\n' dirs=($(printf '%s\n' "${dirs[@]}" | sort -f)); unset IFS
        IMPORT_LIST+=("${dirs[@]}")
    fi
    if ((${#files[@]} > 0)); then
        IFS=$'\n' files=($(printf '%s\n' "${files[@]}" | sort -f)); unset IFS
        IMPORT_LIST+=("${files[@]}")
    fi
    # ajusta índice
    if (( ${#IMPORT_LIST[@]} == 0 )); then
        IMPORT_LIST+=("(vazio)")
        IMPORT_IDX=0
    else
        (( IMPORT_IDX >= ${#IMPORT_LIST[@]} )) && IMPORT_IDX=$(( ${#IMPORT_LIST[@]} - 1 ))
        (( IMPORT_IDX < 0 )) && IMPORT_IDX=0
    fi
}

# Importa arquivo para o buffer; rejeita > 4KB; salva path em NOTES_DIR
importar_arquivo() {
    local path="$1"
    local base size
    if [[ ! -f "$path" ]]; then
        MSG_STATUS="arquivo inexistente"
        return 1
    fi
    size=$(wc -c < "$path" | tr -d ' ')
    if (( size > MAX_IMPORT_BYTES )); then
        MSG_STATUS="recusado: >4KB (${size} bytes)"
        return 1
    fi
    BUFFER=$(<"$path")
    CURSOR_POS=${#BUFFER}
    base="${path##*/}"
    # vai para o dir de notas
    mkdir -p "$NOTES_DIR" 2>/dev/null || true
    ARQUIVO_ATUAL="$NOTES_DIR/$base"
    # se já existir nota com mesmo nome, gera notaN
    if [[ -e "$ARQUIVO_ATUAL" && "$path" != "$ARQUIVO_ATUAL" ]]; then
        local i=1
        local stem="${base%.*}"
        local ext="${base##*.}"
        if [[ "$stem" == "$base" ]]; then ext=""; else ext=".$ext"; fi
        while [[ -e "$NOTES_DIR/${stem}_${i}${ext}" ]]; do ((i++)); done
        ARQUIVO_ATUAL="$NOTES_DIR/${stem}_${i}${ext}"
    fi
    printf '%s' "$BUFFER" > "$ARQUIVO_ATUAL"
    MSG_STATUS="importado → ${ARQUIVO_ATUAL##*/}"
    return 0
}

