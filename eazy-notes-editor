            ACCENT="${TEMA_AURORA[accent]}"; BG="${TEMA_AURORA[bg]}"
            PANEL="${TEMA_AURORA[panel]}"; NOME_TEMA="${TEMA_AURORA[nome]}" ;;
    esac
}
aplicar_tema "DARK"
RESET='\033[0m'
BOLD='\033[1m'

cleanup() {
    stty sane 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    tput sgr0 2>/dev/null || true
    printf '\033[0m\033[?25h\n'
}
trap cleanup EXIT INT TERM

gerar_nome() {
    local i=1
    mkdir -p "$NOTES_DIR" 2>/dev/null || true
    while [[ -f "$NOTES_DIR/nota${i}.txt" ]]; do ((i++)); done
    echo "$NOTES_DIR/nota${i}.txt"
}

ARQUIVO_ATUAL=""
BUFFER=""
CURSOR_POS=0
MODO="edit"          # edit | import
IMPORT_LIST=()
IMPORT_IDX=0
IMPORT_DIR="$(pwd)"
IMPORT_FILTER=""
NOTES_DIR="$(pwd)"   # notas ficam aqui (onde o editor foi iniciado)
MAX_IMPORT_BYTES=4096
MSG_STATUS=""

if [[ $# -ge 1 && -n "${1:-}" ]]; then
    ARQUIVO_ATUAL="$1"
else
    ARQUIVO_ATUAL=$(gerar_nome)
fi
if [[ -f "$ARQUIVO_ATUAL" ]]; then
    BUFFER=$(<"$ARQUIVO_ATUAL")
