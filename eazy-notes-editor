tput civis 2>/dev/null || true

ler_byte() {
    local b
    b=$(dd bs=1 count=1 2>/dev/null | od -An -tu1 2>/dev/null)
    b=${b// /}
    b=${b//$'\n'/}
    echo -n "$b"
}

# ─── Desenho ──────────────────────────────────────────────────
desenhar() {
    local COLS=$(tput cols 2>/dev/null || echo 80)
    local LINES=$(tput lines 2>/dev/null || echo 24)

    # Layout: editor ~60% à esquerda, help ~35% à direita
    local HELP_W=$(( COLS * 32 / 100 ))
    (( HELP_W < 22 )) && HELP_W=22
    (( HELP_W > 36 )) && HELP_W=36
    local GAP=2
    local BOX_W=$(( COLS - HELP_W - GAP - 4 ))
    (( BOX_W < 36 )) && BOX_W=36
    local BOX_H=$(( LINES * 78 / 100 ))
    (( BOX_H < 12 )) && BOX_H=12
    (( BOX_H > LINES - 3 )) && BOX_H=$((LINES - 3))

    local START_X=2
    local START_Y=$(( (LINES - BOX_H) / 2 ))
    (( START_Y < 1 )) && START_Y=1
    local INNER_W=$(( BOX_W - 2 ))
    local INNER_H=$(( BOX_H - 5 ))

    local HELP_X=$(( START_X + BOX_W + GAP ))
    local HELP_H=$BOX_H

    clear
    if [[ -n "${BG:-}" ]]; then
        printf "${BG}"
        local yy
        for ((yy=1; yy<=LINES; yy++)); do
            printf '\033[%d;1H%*s' $yy $COLS ""
        done
    fi

    gotoxy() { printf '\033[%d;%dH' "$1" "$2"; }

    # ── Caixa do editor ──
    gotoxy $START_Y $START_X
    printf "${BORDER}╔"; printf '═%.0s' $(seq 1 $INNER_W); printf "╗${RESET}"

    gotoxy $((START_Y+1)) $START_X
    printf "${BORDER}║${RESET}${TITLE_BG}${TITLE}"
    local titulo=" ✦ ${ARQUIVO_ATUAL} "
    (( ${#titulo} > INNER_W )) && titulo="${titulo:0:INNER_W}"
    local pad=$(( (INNER_W - ${#titulo}) / 2 )); (( pad < 0 )) && pad=0
    printf "%*s%s%*s" $pad "" "$titulo" $((INNER_W - ${#titulo} - pad)) ""
    printf "${RESET}${BORDER}║${RESET}"

    gotoxy $((START_Y+2)) $START_X
    printf "${BORDER}╠"; printf '═%.0s' $(seq 1 $INNER_W); printf "╣${RESET}"

    local content_start=$((START_Y+3))
    local i
    for ((i=0; i<INNER_H; i++)); do
        gotoxy $((content_start+i)) $START_X
        printf "${BORDER}║${RESET}"
        if [[ -n "${BG:-}" ]]; then printf "${BG}%*s${RESET}" $INNER_W ""
        else printf "%*s" $INNER_W ""; fi
        printf "${BORDER}║${RESET}"
    done

    gotoxy $((content_start+INNER_H)) $START_X
    printf "${BORDER}╠"; printf '═%.0s' $(seq 1 $INNER_W); printf "╣${RESET}"

    gotoxy $((content_start+INNER_H+1)) $START_X
    printf "${BORDER}║${RESET}${HELP}"
    local rodape=" ${NOME_TEMA} "
    (( ${#rodape} > INNER_W )) && rodape="${rodape:0:INNER_W}"
    pad=$(( (INNER_W - ${#rodape}) / 2 )); (( pad < 0 )) && pad=0
    printf "%*s%s%*s" $pad "" "$rodape" $((INNER_W - ${#rodape} - pad)) ""
    printf "${RESET}${BORDER}║${RESET}"

    gotoxy $((content_start+INNER_H+2)) $START_X
    printf "${BORDER}╚"; printf '═%.0s' $(seq 1 $INNER_W); printf "╝${RESET}"

    # ── Painel HELP à direita ──
    local hw=$(( HELP_W - 2 ))
    (( hw < 18 )) && hw=18
    gotoxy $START_Y $HELP_X
    printf "${ACCENT}╔"; printf '═%.0s' $(seq 1 $hw); printf "╗${RESET}"
    gotoxy $((START_Y+1)) $HELP_X
    printf "${ACCENT}║${RESET}${BOLD}${ACCENT}"
    local ht=" ATALHOS "
    pad=$(( (hw - ${#ht}) / 2 )); (( pad < 0 )) && pad=0
    printf "%*s%s%*s" $pad "" "$ht" $((hw - ${#ht} - pad)) ""
    printf "${RESET}${ACCENT}║${RESET}"
    gotoxy $((START_Y+2)) $HELP_X
    printf "${ACCENT}╠"; printf '═%.0s' $(seq 1 $hw); printf "╣${RESET}"

    local -a helps=(
        " ← → ↑ ↓  mover"
        " Enter     nova linha"
        " Backspace apagar"
        " Ctrl+N    nova nota"
        " Ctrl+S    salvar+nova"
        " Ctrl+I    importar/dirs"
        " Ctrl+T    tema"
        " ESC       salvar e sair"
        ""
        " PgUp/PgDn página"
        " Quebra de linha"
        " automática na"
        " largura da caixa"
    )
    local hy=$((START_Y+3))
    local hi
    for ((hi=0; hi<${#helps[@]} && hi<INNER_H; hi++)); do
        gotoxy $((hy+hi)) $HELP_X
        printf "${ACCENT}║${RESET}${PANEL}"
        local line="${helps[$hi]}"
        (( ${#line} > hw )) && line="${line:0:hw}"
        printf "%-*s" $hw "$line"
        printf "${RESET}${ACCENT}║${RESET}"
    done
    # preenche resto do painel
    for ((; hi<INNER_H; hi++)); do
        gotoxy $((hy+hi)) $HELP_X
        printf "${ACCENT}║${RESET}%*s${ACCENT}║${RESET}" $hw ""
    done
    gotoxy $((content_start+INNER_H)) $HELP_X
    printf "${ACCENT}╠"; printf '═%.0s' $(seq 1 $hw); printf "╣${RESET}"
    gotoxy $((content_start+INNER_H+1)) $HELP_X
    printf "${ACCENT}║${RESET}${HELP}"
    local tip=" Ctrl+I = pastas+arq "
    (( ${#tip} > hw )) && tip="${tip:0:hw}"
    printf "%-*s" $hw "$tip"
    printf "${RESET}${ACCENT}║${RESET}"
    gotoxy $((content_start+INNER_H+2)) $HELP_X
    printf "${ACCENT}╚"; printf '═%.0s' $(seq 1 $hw); printf "╝${RESET}"

    # ── Conteúdo com soft-wrap ──
    # linhas lógicas (separadas por LF)
    local -a logicas=()
    local atual="" i=0 len=${#BUFFER}
    while (( i < len )); do
        local c="${BUFFER:i:1}"
        if [[ "$c" == "$LF" ]]; then
            logicas+=("$atual"); atual=""
        elif [[ "$c" != "$CR" ]]; then
            atual+="$c"
        fi
        ((i++))
    done
    logicas+=("$atual")

    # linhas visuais (soft wrap) + mapa: visual → (linha_logica, col_inicio)
    local -a visuais=()
    local -a v_logica=()   # índice da linha lógica
    local -a v_off=()      # offset de caractere dentro da lógica
    local li
    for ((li=0; li<${#logicas[@]}; li++)); do
        local -a parts=()
        wrap_linha "${logicas[$li]}" $((INNER_W - 1)) parts
        local pi=0 off=0
        for ((pi=0; pi<${#parts[@]}; pi++)); do
            visuais+=("${parts[$pi]}")
            v_logica+=("$li")
            v_off+=("$off")
            off=$(( off + ${#parts[$pi]} ))
        done
    done
    local num_vis=${#visuais[@]}
    (( num_vis < 1 )) && { visuais=(""); v_logica=(0); v_off=(0); num_vis=1; }

    read -r CUR_LINHA CUR_COL <<< "$(pos_para_linha_col $CURSOR_POS)"
    # linha lógica 1-based → índice 0-based
    local log_idx=$(( CUR_LINHA - 1 ))
    (( log_idx < 0 )) && log_idx=0
    # achar linha visual do cursor
    local vis_cursor=0
    for ((i=0; i<num_vis; i++)); do
        if (( ${v_logica[$i]} == log_idx )); then
            local start_off=${v_off[$i]}
            local plen=${#visuais[$i]}
            if (( CUR_COL - 1 >= start_off && CUR_COL - 1 <= start_off + plen )); then
                vis_cursor=$i
                break
            fi
            vis_cursor=$i
        fi
    done

    local start_line=0
    if (( vis_cursor >= INNER_H )); then
        start_line=$(( vis_cursor - INNER_H + 1 ))
    fi
    (( start_line < 0 )) && start_line=0

    local y=$content_start
    local cursor_sy=-1 cursor_sx=-1
    for ((i=start_line; i<num_vis && y < content_start+INNER_H; i++)); do
        gotoxy $y $((START_X+1))
        local texto="${visuais[$i]}"
        (( ${#texto} > INNER_W-1 )) && texto="${texto:0:$((INNER_W-1))}"
        printf "${TEXT}%s${RESET}" "$texto"
        if (( i == vis_cursor )); then
            cursor_sy=$y
            local col_in_vis=$(( CUR_COL - 1 - ${v_off[$i]} ))
            (( col_in_vis < 0 )) && col_in_vis=0
            (( col_in_vis > ${#visuais[$i]} )) && col_in_vis=${#visuais[$i]}
            cursor_sx=$(( START_X + 1 + col_in_vis ))
        fi
        ((y++))
    done

    if (( cursor_sy >= 0 )); then
        gotoxy $cursor_sy $cursor_sx
        printf "${CURSOR}${BOLD}▌${RESET}"
    fi

    # Status inferior
    gotoxy $LINES 1
    printf "${ACCENT}${BOLD} %d/%d ${RESET}${HELP}│ %s" "$CUR_LINHA" "$CUR_COL" "$NOME_TEMA"
    if [[ -n "$MSG_STATUS" ]]; then
        printf " │ ${ACCENT}%s${RESET}" "$MSG_STATUS"
        MSG_STATUS=""
    fi
    if [[ "$MODO" == "import" ]]; then
        printf " │ ${BOLD}${ACCENT}IMPORTAR${RESET}"
    fi
    printf "   "

    # ── Overlay de importação ──
    if [[ "$MODO" == "import" ]]; then
        local iw=48 ih=16
        (( iw > COLS-4 )) && iw=$((COLS-4))
        local ix=$(( (COLS - iw) / 2 ))
        local iy=$(( (LINES - ih) / 2 ))
        local iiw=$(( iw - 2 ))
        gotoxy $iy $ix
        printf "${ACCENT}╔"; printf '═%.0s' $(seq 1 $iiw); printf "╗${RESET}"
        gotoxy $((iy+1)) $ix
        printf "${ACCENT}║${RESET}${BOLD}"
        local hdr=" ↑↓ navegar  Enter abrir  ESC sair "
        (( ${#hdr} > iiw )) && hdr="${hdr:0:iiw}"
        printf "%-*s" $iiw "$hdr"
        printf "${RESET}${ACCENT}║${RESET}"
        gotoxy $((iy+2)) $ix
        printf "${ACCENT}║${RESET}${HELP}"
        local pathshow="$IMPORT_DIR"
        if [[ -n "$IMPORT_FILTER" ]]; then
            pathshow="filtro: $IMPORT_FILTER"
        fi
        (( ${#pathshow} > iiw-1 )) && pathshow="…${pathshow:$(( ${#pathshow} - iiw + 2 ))}"
        printf " %-*s" $((iiw-1)) "$pathshow"
        printf "${RESET}${ACCENT}║${RESET}"
        gotoxy $((iy+3)) $ix
        printf "${ACCENT}╠"; printf '═%.0s' $(seq 1 $iiw); printf "╣${RESET}"
        local max_show=$(( ih - 5 ))
        (( max_show < 3 )) && max_show=3
        local nfiles=${#IMPORT_LIST[@]}
        local start=0
        if (( IMPORT_IDX >= max_show )); then start=$(( IMPORT_IDX - max_show + 1 )); fi
        local row=0
        for ((row=0; row<max_show; row++)); do
            local fi=$(( start + row ))
            gotoxy $((iy+4+row)) $ix
            printf "${ACCENT}║${RESET}"
            if (( fi < nfiles )); then
                local nome="${IMPORT_LIST[$fi]}"
                (( ${#nome} > iiw-2 )) && nome="${nome:0:$((iiw-2))}"
                if (( fi == IMPORT_IDX )); then
                    printf "${TITLE_BG}${BOLD}${TITLE}▶ %-*s${RESET}" $((iiw-2)) "$nome"
                else
                    # pastas em accent
                    if [[ "$nome" == */ || "$nome" == ".." ]]; then
                        printf "${ACCENT}  %-*s${RESET}" $((iiw-2)) "$nome"
                    else
                        printf "  %-*s" $((iiw-2)) "$nome"
                    fi
                fi
            else
                printf "%*s" $iiw ""
            fi
            printf "${ACCENT}║${RESET}"
        done
        gotoxy $((iy+ih-1)) $ix
        printf "${ACCENT}╚"; printf '═%.0s' $(seq 1 $iiw); printf "╝${RESET}"
        if (( nfiles == 0 )); then
            gotoxy $((iy+5)) $((ix+2))
            printf "${HELP}(nenhum arquivo no diretório)${RESET}"
        fi
    fi
}

# ─── Loop ─────────────────────────────────────────────────────
while true; do
    desenhar
    codigo=$(ler_byte)
    [[ -z "$codigo" ]] && continue

    # ── Modo IMPORT ──
    if [[ "$MODO" == "import" ]]; then
        case "$codigo" in
            27)
                old_stty=$(stty -g 2>/dev/null || true)
                stty -echo -icanon time 2 min 0 2>/dev/null || true
                b2=$(dd bs=1 count=1 2>/dev/null | od -An -tu1 2>/dev/null | tr -d " \n")
