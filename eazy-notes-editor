# Mini Editor de Texto em Bash
# Uso: bash editor [arquivo]
#
# Ctrl+N Nova | Ctrl+S Salvar+nova | Ctrl+T Tema | Ctrl+I Importar
# ESC salva e sai | Setas movem | Enter CRLF | Backspace apaga

set -u

CR=$'\x0d'
LF=$'\x0a'
CRLF="${CR}${LF}"

# ─── Temas ────────────────────────────────────────────────────
declare -A TEMA_DARK=(
    [nome]="Dark" [border]='\033[38;5;39m' [title]='\033[1;97m'
    [title_bg]='\033[48;5;236m' [text]='\033[38;5;252m' [cursor]='\033[1;92m'
    [help]='\033[2;37m' [accent]='\033[38;5;45m' [bg]='' [panel]='\033[38;5;245m'
)
declare -A TEMA_LIGHT=(
    [nome]="Light" [border]='\033[38;5;25m' [title]='\033[1;30m'
    [title_bg]='\033[48;5;255m' [text]='\033[38;5;235m' [cursor]='\033[1;31m'
    [help]='\033[2;30m' [accent]='\033[38;5;27m' [bg]='\033[48;5;255m' [panel]='\033[38;5;240m'
)
declare -A TEMA_CREPUSCULO=(
    [nome]="Crepúsculo" [border]='\033[38;5;209m' [title]='\033[1;38;5;223m'
    [title_bg]='\033[48;5;53m' [text]='\033[38;5;223m' [cursor]='\033[1;38;5;214m'
    [help]='\033[2;38;5;180m' [accent]='\033[38;5;175m' [bg]='' [panel]='\033[38;5;180m'
)
declare -A TEMA_AURORA=(
    [nome]="Aurora" [border]='\033[38;5;49m' [title]='\033[1;38;5;159m'
