            ACCENT="${TEMA_CREPUSCULO[accent]}"; BG="${TEMA_CREPUSCULO[bg]}"
            PANEL="${TEMA_CREPUSCULO[panel]}"; NOME_TEMA="${TEMA_CREPUSCULO[nome]}" ;;
        AURORA) BORDER="${TEMA_AURORA[border]}"; TITLE="${TEMA_AURORA[title]}"
            TITLE_BG="${TEMA_AURORA[title_bg]}"; TEXT="${TEMA_AURORA[text]}"
