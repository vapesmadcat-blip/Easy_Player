            PANEL="${TEMA_DARK[panel]}"; NOME_TEMA="${TEMA_DARK[nome]}" ;;
        LIGHT) BORDER="${TEMA_LIGHT[border]}"; TITLE="${TEMA_LIGHT[title]}"
            TITLE_BG="${TEMA_LIGHT[title_bg]}"; TEXT="${TEMA_LIGHT[text]}"
            CURSOR="${TEMA_LIGHT[cursor]}"; HELP="${TEMA_LIGHT[help]}"
            ACCENT="${TEMA_LIGHT[accent]}"; BG="${TEMA_LIGHT[bg]}"
            PANEL="${TEMA_LIGHT[panel]}"; NOME_TEMA="${TEMA_LIGHT[nome]}" ;;
        CREPUSCULO) BORDER="${TEMA_CREPUSCULO[border]}"; TITLE="${TEMA_CREPUSCULO[title]}"
            TITLE_BG="${TEMA_CREPUSCULO[title_bg]}"; TEXT="${TEMA_CREPUSCULO[text]}"
