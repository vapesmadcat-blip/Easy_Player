#!/usr/bin/env bash
# eazy-tor - baixador CLI de torrents com aria2c
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; NC='\033[0m'
DOWNLOAD_DIR="${HOME}/Downloads/Torrents"
SEED_RATIO="1.0"; SEED_TIME="0"; MAX_PEERS="100"; SHOW_FILES=false; USE_TOR=false; LIST_FILE=""; LOG_FILE=""; STOP_ON_ERROR=false
TARGETS=()

print_help() { cat <<EOF
${CYAN}eazy-tor${NC} — baixador CLI com aria2c

Uso: eazy-tor [opções] <magnet|arquivo.torrent>

  -d, --dir DIR       Diretório de destino (padrão: ~/Downloads/Torrents)
  -r, --ratio RATIO   Ratio de seed (padrão: 1.0)
  -p, --peers N       Máximo de peers (padrão: 100)
  --no-seed           Não faz seed após concluir
  --tor               Usa torsocks neste download
  -L, --list FILE     Baixa uma lista (1 magnet/.torrent por linha)
  --log FILE          Salva log completo do lote
  --stop-on-error     Para no primeiro erro (padrão: continua)
  -s, --show          Mostra os arquivos do torrent
  -h, --help          Ajuda

Exemplos:
  eazy-tor arquivo.torrent
  eazy-tor --tor 'magnet:?xt=urn:btih:...'
  eazy-tor -d /mnt/torrents --no-seed arquivo.torrent
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir) [[ $# -ge 2 ]] || { echo -e "${RED}Falta DIR.${NC}" >&2; exit 2; }; DOWNLOAD_DIR="$2"; shift 2;;
    -r|--ratio) [[ $# -ge 2 ]] || { echo -e "${RED}Falta RATIO.${NC}" >&2; exit 2; }; SEED_RATIO="$2"; shift 2;;
    -p|--peers) [[ $# -ge 2 ]] || { echo -e "${RED}Falta N.${NC}" >&2; exit 2; }; MAX_PEERS="$2"; shift 2;;
    --no-seed) SEED_RATIO="0.0"; SEED_TIME="0"; shift;;
    --tor) USE_TOR=true; shift;;
    -L|--list) [[ $# -ge 2 ]] || { echo -e "${RED}Falta FILE.${NC}" >&2; exit 2; }; LIST_FILE="$2"; shift 2;;
    --log) [[ $# -ge 2 ]] || { echo -e "${RED}Falta FILE.${NC}" >&2; exit 2; }; LOG_FILE="$2"; shift 2;;
    --stop-on-error) STOP_ON_ERROR=true; shift;;
    -s|--show) SHOW_FILES=true; shift;;
    -h|--help) print_help; exit 0;;
    -*) echo -e "${RED}Opção inválida: $1${NC}" >&2; exit 2;;
    *) TARGETS+=("$1"); shift;;
  esac
done
if [ -n "$LIST_FILE" ]; then
  [ -f "$LIST_FILE" ] || { echo -e "${RED}Lista não encontrada: $LIST_FILE${NC}" >&2; exit 1; }
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    TARGETS+=("$line")
  done < "$LIST_FILE"
fi
[[ ${#TARGETS[@]} -gt 0 ]] || { print_help >&2; exit 2; }
if [ -n "$LOG_FILE" ]; then
  mkdir -p -- "$(dirname -- "$LOG_FILE")"
  exec > >(tee -a "$LOG_FILE") 2>&1
fi
command -v aria2c >/dev/null 2>&1 || { echo -e "${RED}aria2c não instalado. Use: sudo apt install aria2${NC}" >&2; exit 1; }
if $USE_TOR; then
  command -v torsocks >/dev/null 2>&1 || { echo -e "${RED}Tor solicitado, mas torsocks não está instalado.${NC}\nInstale: sudo apt install tor torsocks" >&2; exit 1; }
  TOR_PREFIX=(torsocks); echo -e "${CYAN}Rede: Tor via torsocks (127.0.0.1:9050)${NC}"
else
  TOR_PREFIX=()
fi
mkdir -p -- "$DOWNLOAD_DIR"
if $SHOW_FILES; then
  for target in "${TARGETS[@]}"; do "${TOR_PREFIX[@]}" aria2c --show-files=true "$target"; done
  exit 0
fi
ARIA2_OPTS=(--dir="$DOWNLOAD_DIR" --continue=true --max-connection-per-server=16 --split=16 --min-split-size=1M --bt-max-peers="$MAX_PEERS" --seed-ratio="$SEED_RATIO" --seed-time="$SEED_TIME" --enable-dht=true --bt-enable-lpd=true --bt-save-metadata=true --summary-interval=3 --console-log-level=notice --allow-overwrite=true --auto-file-renaming=true --file-allocation=falloc)
total=${#TARGETS[@]}; ok=0; failed=0; index=0
for target in "${TARGETS[@]}"; do
  index=$((index+1)); echo -e "${YELLOW}[$index/$total] Baixando:${NC} $target"
  if "${TOR_PREFIX[@]}" aria2c "${ARIA2_OPTS[@]}" "$target"; then
    ok=$((ok+1)); echo -e "${GREEN}✓ Item $index concluído${NC}"
  else
    failed=$((failed+1)); echo -e "${RED}✗ Item $index falhou${NC}"
    $STOP_ON_ERROR && break
  fi
done
echo -e "${GREEN}Resumo: $ok concluído(s), $failed falho(s), $total total${NC}"
[ "$failed" -eq 0 ]
