# Converte tamanho humano (10M, 1G, 500K, 1024) → bytes
parse_tamanho_humano() {
    local entrada="$1"
    entrada=$(echo "$entrada" | tr -d ' ' | tr '[:lower:]' '[:upper:]')
    [ -z "$entrada" ] && { echo ""; return; }

    local num unidade
    if [[ "$entrada" =~ ^([0-9]+([.][0-9]+)?)([KMGTP]?)$ ]]; then
        num="${BASH_REMATCH[1]}"
        unidade="${BASH_REMATCH[3]}"
    else
        echo ""
        return
    fi

    case "$unidade" in
        K) awk -v n="$num" 'BEGIN {printf "%.0f", n * 1024}' ;;
        M) awk -v n="$num" 'BEGIN {printf "%.0f", n * 1048576}' ;;
        G) awk -v n="$num" 'BEGIN {printf "%.0f", n * 1073741824}' ;;
        T) awk -v n="$num" 'BEGIN {printf "%.0f", n * 1099511627776}' ;;
        P) awk -v n="$num" 'BEGIN {printf "%.0f", n * 1125899906842624}' ;;
        *) awk -v n="$num" 'BEGIN {printf "%.0f", n}' ;;  # bytes
    esac
}

# Formata bytes para label legível
formatar_bytes_label() {
    local b="$1"
    [ -z "$b" ] && { echo "0B"; return; }
    awk -v b="$b" 'BEGIN {
        if (b >= 1073741824) printf "%.2fG", b/1073741824
        else if (b >= 1048576) printf "%.2fM", b/1048576
        else if (b >= 1024) printf "%.1fK", b/1024
        else printf "%dB", b
    }'
}

# Tamanho de arquivo ou pasta (recursivo, em bytes)
tamanho_caminho() {
    local p="$1"
    [ -z "$p" ] && { echo 0; return; }
    if [ -d "$p" ]; then
        du -sb -- "$p" 2>/dev/null | awk '{print $1+0}'
    elif [ -f "$p" ]; then
        stat -c%s -- "$p" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

# Soma tamanhos de uma lista de caminhos (um por linha); pastas via du
somar_selecao_bytes() {
    local total=0
    local p t
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [[ "$p" =~ \.\.$ ]] && continue
        t=$(tamanho_caminho "$p")
        t=$(echo "$t" | tr -cd '0-9')
        t=${t:-0}
        total=$((total + t))
    done
    echo "$total"
}

# Disco: livre e total (bytes) do filesystem de um caminho (padrão: .)
info_disco() {
    local alvo="${1:-.}"
    df -B1 --output=avail,size "$alvo" 2>/dev/null | tail -n1 | awk '{print $1+0, $2+0}'
}

# Margem mínima de segurança (abaixo disso o sistema fica instável)
EAZY_MIN_LIVRE_SISTEMA_MB=500
EAZY_MIN_LIVRE_SISTEMA=$((EAZY_MIN_LIVRE_SISTEMA_MB * 1024 * 1024))

# Verifica espaço antes de operações que gravam no disco.
# $1 = bytes necessários (estimativa)
# $2 = caminho no filesystem de destino (pasta)
# $3 = nome da operação (Copiar, Compactar…)
# $4 = lista detalhe opcional: linhas "bytes|caminho" (um item por linha)
# Retorna 0 = pode seguir | 1 = abortar
verificar_espaco_disco() {
    local necessario="${1:-0}"
    local alvo="${2:-.}"
    local op_nome="${3:-operação}"
    local detalhe="${4:-}"

    necessario=$(echo "$necessario" | tr -cd '0-9')
    necessario=${necessario:-0}

    local livre total
    read -r livre total < <(info_disco "$alvo")
    livre=$(echo "${livre:-0}" | tr -cd '0-9'); livre=${livre:-0}
    total=$(echo "${total:-0}" | tr -cd '0-9'); total=${total:-0}

    # Folga: +10% ou no mínimo 50 MB
    local folga=$((necessario / 10))
    local min_folga=$((50 * 1024 * 1024))
    [ "$folga" -lt "$min_folga" ] && folga=$min_folga
    local preciso=$((necessario + folga))
    local sobra_apos=$((livre - necessario))
    [ "$sobra_apos" -lt 0 ] && sobra_apos=0

    local nec_h livre_h prec_h sobra_h min_h
    nec_h=$(formatar_bytes_label "$necessario")
    livre_h=$(formatar_bytes_label "$livre")
    prec_h=$(formatar_bytes_label "$preciso")
    sobra_h=$(formatar_bytes_label "$sobra_apos")
    min_h="${EAZY_MIN_LIVRE_SISTEMA_MB} MB"

    echo -e "\n\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;37m  VERIFICAÇÃO DE ESPAÇO — $op_nome\033[0m"
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "  Destino     : \033[1;37m$alvo\033[0m"
    echo -e "  Livre agora : \033[1;37m$livre_h\033[0m"
    echo -e "  Necessário  : \033[1;33m$nec_h\033[0m  (+ folga → \033[1;33m$prec_h\033[0m)"
    echo -e "  Sobra após  : \033[1;37m$sobra_h\033[0m"
    echo -e "  Mínimo seguro do sistema: \033[1;31m$min_h\033[0m"
    echo -e "\033[0;90m  Abaixo de $min_h a estabilidade do sistema fica COMPROMETIDA.\033[0m"

    if [ -n "$detalhe" ]; then
        echo -e "\n\033[1;37m  Por item:\033[0m"
        local linha b p bh resto=0
        while IFS= read -r linha; do
            [ -z "$linha" ] && continue
            b="${linha%%|*}"
            p="${linha#*|}"
            b=$(echo "$b" | tr -cd '0-9'); b=${b:-0}
            bh=$(formatar_bytes_label "$b")
            resto=$((livre - b))
            [ "$resto" -lt 0 ] && resto=0
            echo -e "    · \033[1;33m$bh\033[0m  $(basename -- "$p" 2>/dev/null || echo "$p")"
            echo -e "      caminho: $p"
            echo -e "      livre se só este: $(formatar_bytes_label "$resto")"
        done <<< "$detalhe"
    fi
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

    # Bloqueio absoluto: após a operação ficaria abaixo do mínimo seguro
    # ou nem há espaço para o necessário
    if [ "$livre" -lt "$necessario" ] || [ "$sobra_apos" -lt "$EAZY_MIN_LIVRE_SISTEMA" ]; then
        echo -e "\033[1;31m✗ IMPOSSÍVEL CONTINUAR\033[0m"
        echo -e "\033[1;31m  Espaço insuficiente para \"$op_nome\" com segurança.\033[0m"
        if [ "$livre" -lt "$necessario" ]; then
            echo -e "\033[1;31m  Falta: $(formatar_bytes_label "$((necessario - livre))")\033[0m"
        fi
        echo -e "\033[1;31m  A sobra ficaria abaixo de $min_h (estabilidade do sistema).\033[0m"
        echo -e "\033[0;90m  Libere espaço ou escolha outro destino e tente de novo.\033[0m\n"
        read -r -p "Enter para voltar..."
        return 1
    fi

    # Espaço existe, mas sem a folga desejada — pergunta
    if [ "$livre" -lt "$preciso" ]; then
        echo -e "\033[1;33m⚠ Espaço justo (sem folga de segurança de 10% / 50MB).\033[0m"
        echo -e "\033[1;33m  Livre: $livre_h  |  Ideal: $prec_h  |  Sobra prevista: $sobra_h\033[0m"
        if ! whiptail --title "Espaço justo — $op_nome" --yesno \
"Espaço livre está APERTADO.

Necessário : $nec_h
Ideal (+folga): $prec_h
Livre agora: $livre_h
Sobra após : $sobra_h

Mínimo seguro do sistema: $min_h
Abaixo disso a estabilidade fica COMPROMETIDA.

Continuar mesmo assim?" 16 60; then
            echo -e "\033[1;33mCancelado pelo usuário.\033[0m"
            sleep 0.8
            return 1
        fi
    else
        echo -e "\033[1;32m✓ Espaço OK para $op_nome\033[0m\n"
        sleep 0.4
    fi
    return 0
}

# Monta detalhe "bytes|caminho" e total a partir de lista de paths
montar_detalhe_espaco() {
    local p t
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [[ "$p" =~ \.\.$ ]] && continue
        t=$(tamanho_caminho "$p")
        t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
        printf '%s|%s\n' "$t" "$p"
    done
}

# Barra de progresso (0-100) — blocos coloridos
barra_progresso() {
    local pct="$1"
    local largura="${2:-32}"
    pct=$(echo "$pct" | tr -cd '0-9')
    pct=${pct:-0}
    [ "$pct" -gt 100 ] && pct=100
    local preenchido=$((pct * largura / 100))
    local i
    local c_on=$'\033[1;32m'
    local c_off=$'\033[0;90m'
    local c_pct=$'\033[1;36m'
    local c_rst=$'\033[0m'
    local bar=""
    for ((i=0; i<preenchido; i++)); do bar+="█"; done
    for ((i=preenchido; i<largura; i++)); do bar+="░"; done
    # [barra]  42%
    printf "%s[%s%s%s]%s %s%3d%%%s" \
        "$c_off" "$c_on" "$bar" "$c_off" "$c_rst" "$c_pct" "$pct" "$c_rst"
}

# Escreve progresso da busca no terminal (nunca no stdout do fzf)
# args: pct letra hits_seg total_hits [status]
eazy_busca_progresso() {
    local pct="$1" letra="$2" hits="$3" total="$4" status="${5:-}"
    local c_t=$'\033[1;33m'
    local c_w=$'\033[1;37m'
    local c_g=$'\033[1;32m'
    local c_d=$'\033[0;90m'
    local c_r=$'\033[0m'
    local out
    out=$(printf "\r\033[K%s  %sletra %s%-6s%s  %s+%s%s  %stotal: %s%s  %s%s%s" \
        "$(barra_progresso "$pct")" \
        "$c_t" "$c_w" "$letra" "$c_r" \
        "$c_g" "$hits" "$c_r" \
        "$c_d" "$total" "$c_r" \
        "$c_d" "$status" "$c_r")
    # Preferir /dev/tty; se falhar, stderr (nunca stdout — polui a lista)
    { printf "%s" "$out" > /dev/tty; } 2>/dev/null || printf "%s" "$out" >&2
}

# Helper: mensagem de busca só no tty/stderr
eazy_busca_msg() {
    local msg="$1"
    { printf "%s\n" "$msg" > /dev/tty; } 2>/dev/null || printf "%s\n" "$msg" >&2
}

# Monitor de cancelamento: durante a varredura, Esc cria um sinal no /tmp.
eazy_busca_cancelar_iniciar() {
    EAZY_BUSCA_CANCEL_FILE="${EAZY_BUSCA_CANCEL_FILE:-/tmp/eazy_search_cancel_$$}"
    EAZY_BUSCA_CANCEL_PID_FILE="${EAZY_BUSCA_CANCEL_PID_FILE:-/tmp/eazy_search_cancel_pid_$$}"
    rm -f "$EAZY_BUSCA_CANCEL_FILE" "$EAZY_BUSCA_CANCEL_PID_FILE"
    (
        [ -r /dev/tty ] || exit 0
        old_stty=$(stty -g < /dev/tty 2>/dev/null || true)
        stty -icanon -echo min 0 time 1 < /dev/tty 2>/dev/null || exit 0
        trap '[ -n "$old_stty" ] && stty "$old_stty" < /dev/tty 2>/dev/null || true' EXIT HUP INT TERM
        while :; do
            tecla=""
            IFS= read -r -n1 -s -t 0.10 tecla < /dev/tty || true
            if [ "$tecla" = $'\e' ]; then
                : > "$EAZY_BUSCA_CANCEL_FILE"
                break
            fi
        done
    ) &
    printf '%s\n' "$!" > "$EAZY_BUSCA_CANCEL_PID_FILE"
}

eazy_busca_cancelar_parar() {
    local pid
    pid=$(cat "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true)
    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>/dev/null || true
        # Não usar wait aqui: o monitor pode estar bloqueado na leitura do tty
        # e prender a entrega dos resultados até o usuário pressionar Esc.
        sleep 0.12
    fi
    rm -f "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true
    # O trap do monitor restaura o terminal; esta chamada apenas garante o modo normal.
    stty sane < /dev/tty 2>/dev/null || true
}

eazy_busca_cancelada() {
    [ -e "${EAZY_BUSCA_CANCEL_FILE:-/tmp/eazy_search_cancel_$$}" ]
}

eazy_busca_esperar_pid() {
    local pid="$1"
    while kill -0 "$pid" 2>/dev/null; do
        if eazy_busca_cancelada; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 130
        fi
        sleep 0.08
    done
    wait "$pid" 2>/dev/null
}

# Linha de status: HD livre/total + seleção (para header do fzf)
# Uso: eazy_status_header [caminho1 caminho2 ...]
# Preserva atalhos em EAZY_HEADER_HINT (exportado antes do fzf)
eazy_status_header() {
    local livre total livre_h total_h sel_bytes sel_h sel_count=0
    read -r livre total < <(info_disco)
    livre=${livre:-0}; total=${total:-0}
    livre_h=$(formatar_bytes_label "$livre")
    total_h=$(formatar_bytes_label "$total")

    sel_bytes=0
    if [ "${MODO_DUP:-0}" -eq 1 ] && [ -f "${DUP_SELECTED_FILE:-}" ]; then
        local p t
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            t=$(tamanho_caminho "$p")
            t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
            sel_bytes=$((sel_bytes + t))
            sel_count=$((sel_count + 1))
        done < "$DUP_SELECTED_FILE"
    elif [ "$#" -gt 0 ]; then
        local p t
        for p in "$@"; do
            [ -z "$p" ] && continue
            # fzf pode passar linha completa com tabs
            p=$(printf '%s\n' "$p" | awk -F '\t' '{print $NF}')
            [[ "$p" =~ \.\.$ ]] && continue
            t=$(tamanho_caminho "$p")
            t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
            sel_bytes=$((sel_bytes + t))
            sel_count=$((sel_count + 1))
        done
    fi
    if [ "$#" -eq 0 ] && [ "${MODO_DUP:-0}" -ne 1 ] && [ -f "${SELECTED_FILE:-}" ]; then
        local gp gt
        while IFS= read -r gp; do
            [ -f "$gp" ] || continue
            gt=$(tamanho_caminho "$gp")
            gt=$(echo "$gt" | tr -cd '0-9'); gt=${gt:-0}
            sel_bytes=$((sel_bytes + gt))
            sel_count=$((sel_count + 1))
        done < "$SELECTED_FILE"
    fi
    local atual_dir atual_count=0 atual_bytes=0 ap at
    atual_dir=$(pwd -P)
    if [ "$#" -eq 0 ] && [ "${MODO_DUP:-0}" -ne 1 ]; then
        reconstruir_selecao_local
    fi
    if [ "$#" -eq 0 ] && [ "${MODO_DUP:-0}" -ne 1 ]; then
        while IFS= read -r ap; do
            [ -f "$ap" ] || continue
            ap=$(readlink -f -- "$ap" 2>/dev/null || printf '%s' "$ap")
            if [ "$(dirname -- "$ap")" = "$atual_dir" ]; then
                at=$(tamanho_caminho "$ap"); at=$(echo "$at" | tr -cd '0-9'); at=${at:-0}
                atual_bytes=$((atual_bytes + at)); atual_count=$((atual_count + 1))
            fi
        done < "${SELECTED_LOCAL_FILE:-/dev/null}"
        while IFS= read -r ap; do
            [ -d "$ap" ] || continue
            ap=$(readlink -f -- "$ap" 2>/dev/null || printf '%s' "$ap")
            if [ "$(dirname -- "$ap")" = "$atual_dir" ]; then
                at=$(tamanho_caminho "$ap"); at=$(echo "$at" | tr -cd '0-9'); at=${at:-0}
                atual_bytes=$((atual_bytes + at)); atual_count=$((atual_count + 1))
            fi
        done < "/dev/null"
    fi
    sel_h=$(formatar_bytes_label "$sel_bytes")
    atual_h=$(formatar_bytes_label "$atual_bytes")
    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        printf "DRY-RUN: %s  |  HD livre: %s / %s  |  Sel: %s (%s item(ns))" "$([ "${DRY_RUN:-0}" = "1" ] && echo LIGADO || echo DESLIGADO)" "$livre_h" "$total_h" "$sel_h" "$sel_count"
    else
        printf "DRY-RUN: %s  |  HD livre: %s / %s  |  Sel global: %s (%s)  |  Dir atual: %s (%s)" "$([ "${DRY_RUN:-0}" = "1" ] && echo LIGADO || echo DESLIGADO)" "$livre_h" "$total_h" "$sel_h" "$sel_count" "$atual_h" "$atual_count"
    fi
    if [ -n "${EAZY_HEADER_HINT:-}" ]; then
        printf "\n%s" "$EAZY_HEADER_HINT"
    fi
}

# Pergunta filtro de tamanho para a busca recursiva
selecionar_tamanho_busca() {
    BUSCA_TAM_MIN=""
    BUSCA_TAM_MAX=""
    BUSCA_TAM_LABEL=""

    local modo
    modo=$(whiptail --title "Filtro de Tamanho" --radiolist \
        "Filtrar arquivos por tamanho?\n(Exemplos: 10M, 1G, 500K, 1024)" 16 60 5 \
        "nenhum" "Sem filtro de tamanho" "ON" \
        "maior" "Maior que X  ( > X )" "OFF" \
        "menor" "Menor que Y  ( < Y )" "OFF" \
        "entre" "Entre X e Y  ( > X e < Y )" "OFF" \
        "exato" "Aproximadamente X (±10%)" "OFF" \
        3>&1 1>&2 2>&3)
    [ -z "$modo" ] && modo="nenhum"

    local min_in max_in
    case "$modo" in
        maior)
            min_in=$(whiptail --title "Tamanho mínimo" \
                --inputbox "Arquivos MAIORES que:\n(ex: 100M, 1G, 500K)" 11 55 "100M" \
                3>&1 1>&2 2>&3)
            [ -z "$min_in" ] && return 1
            BUSCA_TAM_MIN=$(parse_tamanho_humano "$min_in")
            if [ -z "$BUSCA_TAM_MIN" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido: $min_in" 8 40
                return 1
            fi
            BUSCA_TAM_LABEL=">$(formatar_bytes_label "$BUSCA_TAM_MIN")"
            ;;
        menor)
            max_in=$(whiptail --title "Tamanho máximo" \
                --inputbox "Arquivos MENORES que:\n(ex: 50M, 1G)" 11 55 "50M" \
                3>&1 1>&2 2>&3)
            [ -z "$max_in" ] && return 1
            BUSCA_TAM_MAX=$(parse_tamanho_humano "$max_in")
            if [ -z "$BUSCA_TAM_MAX" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido: $max_in" 8 40
                return 1
            fi
            BUSCA_TAM_LABEL="<$(formatar_bytes_label "$BUSCA_TAM_MAX")"
            ;;
        entre)
            min_in=$(whiptail --title "Tamanho mínimo" \
                --inputbox "Maior que (mínimo):\n(ex: 10M)" 11 55 "10M" \
                3>&1 1>&2 2>&3)
            [ -z "$min_in" ] && return 1
            max_in=$(whiptail --title "Tamanho máximo" \
                --inputbox "Menor que (máximo):\n(ex: 500M)" 11 55 "500M" \
                3>&1 1>&2 2>&3)
            [ -z "$max_in" ] && return 1
            BUSCA_TAM_MIN=$(parse_tamanho_humano "$min_in")
            BUSCA_TAM_MAX=$(parse_tamanho_humano "$max_in")
            if [ -z "$BUSCA_TAM_MIN" ] || [ -z "$BUSCA_TAM_MAX" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido." 8 40
                return 1
            fi
            if [ "$BUSCA_TAM_MIN" -ge "$BUSCA_TAM_MAX" ] 2>/dev/null; then
                whiptail --title "Erro" --msgbox "O mínimo deve ser menor que o máximo." 8 45
                return 1
            fi
            BUSCA_TAM_LABEL=">$(formatar_bytes_label "$BUSCA_TAM_MIN") <$(formatar_bytes_label "$BUSCA_TAM_MAX")"
            ;;
        exato)
            min_in=$(whiptail --title "Tamanho aproximado" \
                --inputbox "Tamanho aproximado (±10%):\n(ex: 700M)" 11 55 "700M" \
                3>&1 1>&2 2>&3)
            [ -z "$min_in" ] && return 1
            local centro
            centro=$(parse_tamanho_humano "$min_in")
            if [ -z "$centro" ]; then
                whiptail --title "Erro" --msgbox "Tamanho inválido: $min_in" 8 40
                return 1
            fi
            BUSCA_TAM_MIN=$(awk -v c="$centro" 'BEGIN {printf "%.0f", c * 0.9}')
            BUSCA_TAM_MAX=$(awk -v c="$centro" 'BEGIN {printf "%.0f", c * 1.1}')
            BUSCA_TAM_LABEL="~$(formatar_bytes_label "$centro")"
            ;;
        *)
            BUSCA_TAM_MIN=""
            BUSCA_TAM_MAX=""
            BUSCA_TAM_LABEL=""
            ;;
    esac
    return 0
}

