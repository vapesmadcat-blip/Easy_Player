# ============================================================
# SUDO + DRY RUN
# ============================================================
restaurar_terminal() {
    stty sane 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    printf '\033[0m'
}

solicitar_senha_sudo() {
    local senha ret
    if sudo -n true 2>/dev/null; then
        return 0
    fi
    if ! command -v whiptail >/dev/null 2>&1; then
        echo -e "${YELLOW}sudo requer senha, mas o whiptail não está disponível.${NC}" >&2
        restaurar_terminal
        return 1
    fi
    senha=$(whiptail --title "Autenticação sudo" --passwordbox \
        "Digite sua senha para autorizar a próxima operação privilegiada:\n\nA senha não será exibida nem gravada." 10 70 3>&1 1>&2 2>&3)
    ret=$?
    restaurar_terminal
    [ "$ret" -eq 0 ] || return 1
    [ -n "$senha" ] || return 1
    if printf '%s\n' "$senha" | sudo -S -p '' -v >/dev/null 2>&1; then
        unset senha
        return 0
    fi
    unset senha
    whiptail --title "Senha sudo" --msgbox "Senha incorreta ou sudo não autorizado." 8 60 2>/dev/null || true
    restaurar_terminal
    return 1
}

executar_com_sudo() {
    local cmd="$1" desc="${2:-Executando comando}" dry_msg="${3:-}" ret
    if [ "${DRY_RUN:-0}" = "1" ]; then
        echo -e "${YELLOW}[DRY RUN] $desc${NC}"
        [ -n "$dry_msg" ] && echo -e "${YELLOW}[DRY RUN] $dry_msg${NC}"
        echo -e "${YELLOW}[DRY RUN] Comando: $cmd${NC}"
        return 0
    fi
    if [[ "$cmd" =~ ^(sudo |apt|apt-get|dnf|pacman|zypper|apk|swapoff|swapon|fallocate|dd |mount|umount|systemctl|journalctl|smartctl|sysctl|mkswap|tee ) ]]; then
        solicitar_senha_sudo || return 1
        # -n garante que o comando não tente abrir prompt no terminal depois.
        sudo -n bash -c "$cmd" 2>&1
        ret=$?
        restaurar_terminal
        return "$ret"
    fi
    eval "$cmd" 2>&1
    return $?
}

tem_sudo_sem_senha() {
    sudo -n true 2>/dev/null
}

eazy_pausa_terminal() {
    local mensagem="${1:-Pressione Enter para continuar...}"
    if [ -t 0 ]; then
        printf '\n\033[1;36m%s\033[0m\n' "$mensagem"
        IFS= read -r _eazy_pause || true
    fi
}

# Confirmação exclusiva do Alt+Enter antes de executar a seleção múltipla.
confirmar_alt_enter() {
    local quantidade="${1:-0}"
    printf '\n\033[1;33m[ALT+ENTER] %s item(ns) selecionado(s).\033[0m\n' "$quantidade"
    printf '\033[1;36mPressione Enter para executar ou Ctrl-C para cancelar: \033[0m'
    IFS= read -r _alt_enter_confirm
}

operacao_com_sudo() {
    local cmd="$1"
    local desc="${2:-Operação}"
    local dry_msg="${3:-}"
    clear 2>/dev/null || printf '\033c'
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}🔧 $desc${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    if [ "${DRY_RUN:-0}" = "1" ]; then
        echo -e "${YELLOW}[DRY RUN] Simulando: $desc${NC}"
        [ -n "$dry_msg" ] && echo -e "${YELLOW}[DRY RUN] $dry_msg${NC}"
        echo -e "${YELLOW}[DRY RUN] Comando: $cmd${NC}"
        echo -e "${GREEN}✅ [DRY RUN] Concluído (sem alterações)${NC}"
        eazy_pausa_terminal "DRY-RUN concluído. Pressione Enter para voltar."
        return 0
    fi

    local output ret
    output=$(executar_com_sudo "$cmd" "$desc" "$dry_msg")
    ret=$?
    if [ "$ret" -eq 0 ]; then
        echo -e "${GREEN}✅ $desc concluída com sucesso!${NC}"
        [ -n "$output" ] && echo "$output"
    else
        echo -e "${RED}❌ Falha na operação (código $ret)${NC}"
        [ -n "$output" ] && echo "$output"
        fi
    eazy_pausa_terminal "$desc concluída. Pressione Enter para voltar."
    return "$ret"
}
toggle_dry_run() {
    if [ "${DRY_RUN:-0}" = "1" ]; then
        DRY_RUN="0"
        export DRY_RUN
        whiptail --title "DRY RUN" --msgbox "Modo DRY RUN DESLIGADO\n\nAs operações agora farão alterações reais." 10 55
    else
        DRY_RUN="1"
        export DRY_RUN
        whiptail --title "DRY RUN" --msgbox "Modo DRY RUN LIGADO 🔄\n\nOperações serão só simuladas (nada é apagado/alterado).\n\nÚtil para testar o que seria feito." 12 60
    fi
}

# --- DIAGNÓSTICO DO SISTEMA (DISPONÍVEL DENTRO DO F9) ---
mostrar_overview_sistema() {
    local tmp os_name kernel desktop PRETTY_NAME NAME VERSION_ID
    tmp=$(mktemp "${TMPDIR:-/tmp}/eazy-overview.XXXXXX") || return 1

    if [ -r /etc/os-release ]; then
        os_name=$(awk -F= '$1 == "PRETTY_NAME" {gsub(/^"|"$/, "", $2); print $2; exit}' /etc/os-release 2>/dev/null)
        os_name="${os_name:-Linux}"
    else
        os_name="Linux"
    fi
    kernel=$(uname -srmo 2>/dev/null || echo "indisponível")
    desktop="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-indisponível}}"

    {
        printf '%s\n' 'eazy — OVERVIEW DO SISTEMA'
        printf '%s\n' '========================================'
        printf 'Sistema operacional : %s\n' "$os_name"
        printf 'Kernel              : %s\n' "$kernel"
        printf 'Hostname            : %s\n' "$(hostname 2>/dev/null || echo indisponível)"
        printf 'Ambiente gráfico    : %s\n' "$desktop"
        printf 'Shell               : %s\n' "${SHELL:-indisponível}"
        printf '\n%s\n' 'MEMÓRIA RAM'
        if command -v free >/dev/null 2>&1; then
            free -h
        elif [ -r /proc/meminfo ]; then
            grep -E '^(MemTotal|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo
        else
            printf '%s\n' 'Informação indisponível.'
        fi

        printf '\n%s\n' 'HD / ARMAZENAMENTO'
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -e7 -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS,MODEL 2>/dev/null || true
        else
            printf '%s\n' 'lsblk não está instalado.'
        fi
        printf '\n%s\n' 'USO DOS SISTEMAS DE ARQUIVOS'
        if command -v df >/dev/null 2>&1; then
            df -hT -x tmpfs -x devtmpfs -x squashfs 2>/dev/null | sed -n '1,20p'
        fi
        printf '\n%s\n' 'DRIVES REMOVÍVEIS / INTERFACE'
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -e7 -o NAME,TRAN,RM,SIZE,TYPE,MOUNTPOINTS 2>/dev/null | awk 'NR == 1 || $3 == "1" || $2 != ""'
        else
            printf '%s\n' 'Informação indisponível.'
        fi

        printf '\n%s\n' 'ÁUDIO — SERVIDOR, SAÍDAS E ENTRADAS'
        if command -v wpctl >/dev/null 2>&1; then
            wpctl status 2>/dev/null || true
        elif command -v pactl >/dev/null 2>&1; then
            pactl info 2>/dev/null || true
            pactl list short sinks 2>/dev/null || true
            pactl list short sources 2>/dev/null || true
        elif command -v aplay >/dev/null 2>&1 || command -v arecord >/dev/null 2>&1; then
            command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null || true
            command -v arecord >/dev/null 2>&1 && arecord -l 2>/dev/null || true
        else
            printf '%s\n' 'Nenhuma ferramenta de áudio encontrada.'
        fi

        printf '\n%s\n' 'VÍDEO — GPU, DRIVER E MONITORES'
        if command -v lspci >/dev/null 2>&1; then
            lspci -nnk 2>/dev/null | awk '
                /Audio device|Multimedia audio controller|VGA compatible controller|3D controller|Display controller/ {show=1; n=0}
                show {print; n++}
                show && n >= 4 {show=0}
            '
        else
            printf '%s\n' 'lspci não está instalado.'
        fi
        if [ -d /sys/class/drm ]; then
            printf '\nMonitores detectados:\n'
            for connector in /sys/class/drm/*/status; do
                [ -f "$connector" ] || continue
                printf '  %s: %s\n' "$(basename "$(dirname "$connector")")" "$(cat "$connector" 2>/dev/null)"
            done
        fi
        if command -v lsmod >/dev/null 2>&1; then
            printf '\nMódulos gráficos/áudio carregados:\n'
            lsmod | grep -E '^(snd|sof|i915|amdgpu|radeon|nouveau|nvidia|vc4|xe)' | head -30 || true
        fi
    } > "$tmp"

    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "eazy — Overview do sistema" --textbox "$tmp" 32 112 --scrolltext
    else
        cat "$tmp"
    fi
    rm -f "$tmp"
}

# Overview ampliado: usa ferramentas nativas e aproveita utilitários opcionais quando disponíveis.
mostrar_overview_sistema_completo() {
    local tmp os_name kernel desktop data_boot model cpu_count phys_mem swap_total
    local dev tipo smart_result battery connector
    tmp=$(mktemp "${TMPDIR:-/tmp}/eazy-overview-full.XXXXXX") || return 1

    if [ -r /etc/os-release ]; then
        os_name=$(awk -F= '$1 == "PRETTY_NAME" {gsub(/^"|"$/, "", $2); print $2; exit}' /etc/os-release 2>/dev/null)
        os_name="${os_name:-Linux}"
    else
        os_name="Linux"
    fi
    kernel=$(uname -srmo 2>/dev/null || echo "indisponível")
    desktop="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-indisponível}}"
    local display_server="${XDG_SESSION_TYPE:-}"
    [ -n "$display_server" ] || display_server="${WAYLAND_DISPLAY:+Wayland}${DISPLAY:+X11}"
    [ -n "$display_server" ] || display_server="indisponível"
    data_boot=$(uptime -s 2>/dev/null || echo "indisponível")
    model=$(awk -F': ' '/^model name[[:space:]]*:/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)
    model="${model:-indisponível}"
    cpu_count=$(nproc --all 2>/dev/null || grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo "indisponível")
    phys_mem=$(awk '/^MemTotal:/ {print $2 " kB"}' /proc/meminfo 2>/dev/null)
    swap_total=$(awk '/^SwapTotal:/ {print $2 " kB"}' /proc/meminfo 2>/dev/null)

    {
        printf '%s\n' 'eazy — OVERVIEW COMPLETO DO SISTEMA'
        printf '%s\n' '========================================'
        printf 'Gerado em          : %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || echo indisponível)"
        printf 'Hostname            : %s\n' "$(hostname 2>/dev/null || echo indisponível)"
        printf 'Usuário             : %s\n' "${USER:-$(id -un 2>/dev/null || echo indisponível)}"
        printf 'Sistema operacional : %s\n' "$os_name"
        printf 'Kernel              : %s\n' "$kernel"
        printf 'Arquitetura         : %s\n' "$(uname -m 2>/dev/null || echo indisponível)"
        printf 'Boot                : %s\n' "$data_boot"
        printf 'Ambiente gráfico    : %s\n' "$desktop"
        printf 'Display server      : %s\n' "$display_server"
        printf 'Shell               : %s\n' "${SHELL:-indisponível}"
        printf 'Locale              : %s\n' "${LANG:-indisponível}"
        printf 'Uptime              : %s\n' "$(uptime -p 2>/dev/null || uptime 2>/dev/null || echo indisponível)"

        if command -v inxi >/dev/null 2>&1; then
            printf '\n%s\n' 'RESUMO INXI'
            inxi -Fazy 2>/dev/null || true
        fi

        printf '\n%s\n' 'CPU / PROCESSADOR'
        printf 'Modelo              : %s\n' "$model"
        printf 'CPUs lógicas        : %s\n' "$cpu_count"
        if command -v lscpu >/dev/null 2>&1; then
            lscpu 2>/dev/null | grep -E '^(Architecture|Vendor ID|Model name|CPU family|Model|Thread|Core|Socket|NUMA|CPU max MHz|CPU min MHz|Virtualization)' || true
        fi
        if [ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
            printf 'Governador           : %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
        fi
        printf 'Load average        : %s\n' "$(awk '{print $1 " " $2 " " $3}' /proc/loadavg 2>/dev/null || echo indisponível)"

        printf '\n%s\n' 'MEMÓRIA RAM / SWAP'
        if command -v free >/dev/null 2>&1; then
            free -h
        else
            printf 'RAM total           : %s\n' "${phys_mem:-indisponível}"
            printf 'Swap total          : %s\n' "${swap_total:-indisponível}"
        fi
        if command -v swapon >/dev/null 2>&1; then
            swapon --show 2>/dev/null || true
        fi

        printf '\n%s\n' 'PLACA-MÃE / BIOS / FIRMWARE'
        if command -v dmidecode >/dev/null 2>&1; then
            for campo in system-manufacturer system-product-name system-version bios-vendor bios-version bios-release-date baseboard-manufacturer baseboard-product-name; do
                smart_result=$(dmidecode -s "$campo" 2>/dev/null || true)
                [ -n "$smart_result" ] && printf '%-22s: %s\n' "$campo" "$smart_result"
            done
        else
            printf '%s\n' 'dmidecode não instalado ou sem permissão de leitura.'
        fi

        printf '\n%s\n' 'HD / SSD / PARTIÇÕES / MONTAGENS'
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -e7 -o NAME,PATH,SIZE,TYPE,FSTYPE,FSAVAIL,FSUSE%,MOUNTPOINTS,MODEL,SERIAL,TRAN,RM 2>/dev/null || true
        else
            printf '%s\n' 'lsblk não está instalado.'
        fi
        if command -v findmnt >/dev/null 2>&1; then
            printf '\nMontagens:\n'
            findmnt -D 2>/dev/null | sed -n '1,35p' || true
        fi
        printf '\nUso dos sistemas de arquivos:\n'
        df -hT -x tmpfs -x devtmpfs -x squashfs 2>/dev/null | sed -n '1,35p' || true
        if command -v smartctl >/dev/null 2>&1 && command -v lsblk >/dev/null 2>&1; then
            printf '\nSaúde SMART resumida:\n'
            while read -r dev tipo; do
                [ "$tipo" = 'disk' ] || continue
                [ -b "$dev" ] || continue
                smart_result=$(timeout 4s smartctl -H "$dev" 2>/dev/null | grep -Ei 'overall-health|health status|result' | head -n 1 || true)
                printf '%s: %s\n' "$dev" "${smart_result:-sem leitura SMART/permissão}"
            done < <(lsblk -dn -o PATH,TYPE 2>/dev/null)
        else
            printf '\nSMART: instale smartmontools para verificar a saúde dos discos.\n'
        fi

        printf '\n%s\n' 'DRIVES REMOVÍVEIS / USB / PCI'
        if command -v lsusb >/dev/null 2>&1; then
            printf '%s\n' 'USB:'
            lsusb 2>/dev/null || true
        else
            printf '%s\n' 'lsusb não está instalado.'
        fi
        if command -v lspci >/dev/null 2>&1; then
            printf '\nPCI relevante e drivers:\n'
            lspci -nnk 2>/dev/null | awk '/VGA compatible controller|3D controller|Display controller|Audio device|Multimedia audio controller|Network controller|Ethernet controller|USB controller|SATA controller|NVMe controller|Host bridge/ {show=1; n=0} show {print; n++} show && n >= 5 {show=0}' || true
        else
            printf '%s\n' 'lspci não está instalado.'
        fi
        if command -v lshw >/dev/null 2>&1; then
            printf '\nHardware resumido via lshw:\n'
            lshw -sanitize -short 2>/dev/null | sed -n '1,80p' || true
        fi

        printf '\n%s\n' 'ÁUDIO — SERVIDOR, SAÍDAS, ENTRADAS E MIXER'
        if command -v wpctl >/dev/null 2>&1; then
            printf 'Volume padrão: '\''%s'\''\n' "$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo indisponível)"
            wpctl status 2>/dev/null || true
        fi
        if command -v pactl >/dev/null 2>&1; then
            pactl info 2>/dev/null || true
            printf '\nSinks:\n'; pactl list short sinks 2>/dev/null || true
            printf '\nSources:\n'; pactl list short sources 2>/dev/null || true
        fi
        if command -v aplay >/dev/null 2>&1; then
            printf '\nALSA playback:\n'; aplay -l 2>/dev/null || true
        fi
        if command -v arecord >/dev/null 2>&1; then
            printf '\nALSA capture:\n'; arecord -l 2>/dev/null || true
        fi
        if command -v amixer >/dev/null 2>&1; then
            printf '\nControles ALSA:\n'; amixer scontrols 2>/dev/null || true
        fi
        if ! command -v wpctl >/dev/null 2>&1 && ! command -v pactl >/dev/null 2>&1 && ! command -v aplay >/dev/null 2>&1; then
            printf '%s\n' 'Nenhuma ferramenta de áudio encontrada.'
        fi

        printf '\n%s\n' 'VÍDEO — GPU, DRIVER, OPENGL, VULKAN E MONITORES'
        if command -v lspci >/dev/null 2>&1; then
            lspci -nnk 2>/dev/null | awk '/VGA compatible controller|3D controller|Display controller/ {show=1; n=0} show {print; n++} show && n >= 5 {show=0}' || true
        fi
        if command -v xrandr >/dev/null 2>&1; then
            printf '\nMonitores via xrandr:\n'; xrandr --query 2>/dev/null | sed -n '1,30p' || true
        fi
        if command -v glxinfo >/dev/null 2>&1; then
            printf '\nOpenGL:\n'; glxinfo -B 2>/dev/null || true
        fi
        if command -v vulkaninfo >/dev/null 2>&1; then
            printf '\nVulkan:\n'; vulkaninfo --summary 2>/dev/null | sed -n '1,45p' || true
        fi
        if [ -d /sys/class/drm ]; then
            printf '\nMonitores via DRM:\n'
            for connector in /sys/class/drm/*/status; do
                [ -f "$connector" ] || continue
                printf '  %s: %s\n' "$(basename "$(dirname "$connector")")" "$(cat "$connector" 2>/dev/null)"
            done
        fi
        if command -v lsmod >/dev/null 2>&1; then
            printf '\nMódulos gráficos/áudio:\n'; lsmod | grep -E '^(snd|sof|i915|amdgpu|radeon|nouveau|nvidia|vc4|xe)' | head -40 || true
        fi

        printf '\n%s\n' 'REDE / INTERNET / INTERFACES'
        if command -v ip >/dev/null 2>&1; then
            printf 'Interfaces:\n'; ip -br link 2>/dev/null || true
            printf '\nEndereços:\n'; ip -br addr 2>/dev/null || true
            printf '\nRotas:\n'; ip route 2>/dev/null | sed -n '1,20p' || true
        fi
        if command -v iw >/dev/null 2>&1; then
            printf '\nWi-Fi:\n'; iw dev 2>/dev/null || true
        fi
        if command -v nmcli >/dev/null 2>&1; then
            printf '\nNetworkManager:\n'; nmcli -t -f GENERAL.STATE,GENERAL.CONNECTION device show 2>/dev/null || true
        fi
        if command -v resolvectl >/dev/null 2>&1; then
            printf '\nDNS:\n'; resolvectl status 2>/dev/null | sed -n '1,25p' || true
        fi

        printf '\n%s\n' 'BATERIA / ENERGIA / TEMPERATURA'
        if command -v upower >/dev/null 2>&1; then
            upower -e 2>/dev/null | while read -r battery; do
                [ -n "$battery" ] || continue
                upower -i "$battery" 2>/dev/null | grep -E 'Device:|native-path:|model:|state:|percentage:|capacity:|time to' || true
            done
        fi
        if [ -d /sys/class/power_supply ]; then
            for battery in /sys/class/power_supply/*; do
                [ -d "$battery" ] || continue
                printf '%s: ' "$(basename "$battery")"
                [ -r "$battery/status" ] && printf 'status=%s ' "$(cat "$battery/status")"
                [ -r "$battery/capacity" ] && printf 'capacity=%s%% ' "$(cat "$battery/capacity")"
                printf '\n'
            done
        fi
        if command -v sensors >/dev/null 2>&1; then
            printf '\nSensores lm-sensors:\n'; sensors 2>/dev/null || true
        fi
        if [ -d /sys/class/thermal ]; then
            printf '\nZonas térmicas:\n'
            for zone in /sys/class/thermal/thermal_zone*; do
                [ -d "$zone" ] || continue
                printf '  %s: ' "$(basename "$zone")"
                [ -r "$zone/type" ] && printf '%s ' "$(cat "$zone/type")"
                [ -r "$zone/temp" ] && awk '{printf "%.1f°C", $1 / 1000}' "$zone/temp"
                printf '\n'
            done
        fi

        printf '\n%s\n' 'PROCESSOS / RECURSOS'
        ps -eo pid,comm,%cpu,%mem,rss,stat --sort=-%cpu 2>/dev/null | head -n 16 || true

        printf '\n%s\n' 'FERRAMENTAS DO EAZY'
        for campo in fzf mpv mplayer cvlc ffplay whiptail yt-dlp ffmpeg speaker-test wpctl pactl aplay lspci lsblk; do
            if command -v "$campo" >/dev/null 2>&1; then
                printf '%-16s: %s (%s)\n' "$campo" "$(command -v "$campo")" "$("$campo" --version 2>/dev/null | head -n 1 || true)"
            else
                printf '%-16s: não instalado\n' "$campo"
            fi
        done
    } > "$tmp"

    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "eazy — Overview completo do sistema" --textbox "$tmp" 38 120 --scrolltext
    else
        cat "$tmp"
    fi
    rm -f "$tmp"
}

testar_som() {
    local log metodo rc=0 trecho sample encontrou=0
    if ! whiptail --title "Teste de som" --yesno \
        "Será emitido um tom de teste de 440 Hz pelos dispositivos de saída.\n\nDeseja continuar?" 10 68; then
        return 0
    fi

    log=$(mktemp "${TMPDIR:-/tmp}/eazy-sound-test.XXXXXX") || return 1
    if command -v speaker-test >/dev/null 2>&1; then
        metodo="ALSA speaker-test"
        timeout 5s speaker-test -t sine -f 440 -l 1 -s 1 >"$log" 2>&1 || rc=$?
    elif command -v ffplay >/dev/null 2>&1; then
        metodo="FFmpeg ffplay"
        ffplay -f lavfi -i 'sine=frequency=440:duration=2' -nodisp -autoexit -loglevel error >"$log" 2>&1 || rc=$?
    elif command -v paplay >/dev/null 2>&1; then
        metodo="PulseAudio/PipeWire paplay"
        for sample in /usr/share/sounds/freedesktop/stereo/bell.oga /usr/share/sounds/freedesktop/stereo/message.oga /usr/share/sounds/gnome/default/alerts/glass.ogg; do
            if [ -f "$sample" ]; then
                encontrou=1
                paplay "$sample" >"$log" 2>&1 || rc=$?
                break
            fi
        done
        [ "$encontrou" -eq 1 ] || { rc=127; printf '%s\n' 'Nenhum arquivo de som do sistema foi encontrado.' >"$log"; }
    elif command -v canberra-gtk-play >/dev/null 2>&1; then
        metodo="libcanberra"
        canberra-gtk-play -i bell >"$log" 2>&1 || rc=$?
    else
        metodo="indisponível"
        rc=127
        printf '%s\n' 'Nenhum método de teste encontrado (speaker-test, ffplay, paplay ou canberra-gtk-play).' >"$log"
    fi

    trecho=$(tail -n 8 "$log" 2>/dev/null)
    if [ "$rc" -eq 0 ]; then
        whiptail --title "Teste de som — concluído" --msgbox "Método: $metodo\n\nO teste foi enviado ao dispositivo de saída.\n\n$trecho" 16 82
    elif [ "$rc" -eq 124 ]; then
        whiptail --title "Teste de som — verificação" --msgbox "Método: $metodo\n\nO teste foi interrompido após 5 segundos. Verifique se o tom foi ouvido.\n\n$trecho" 16 82
    else
        whiptail --title "Teste de som — erro" --msgbox "Método: $metodo\n\nNão foi possível concluir o teste (código $rc).\nVerifique a saída de som e as ferramentas instaladas.\n\n$trecho" 18 82
    fi
    rm -f "$log"
}

# --- FUNÇÃO DE CONFIGURAÇÃO (WIZARD WHIPTAIL) ---
configurar_defaults() {
    mkdir -p "$CONFIG_DIR"

    local f9_acao
    f9_acao=$(whiptail --title "F9 — Configuração e diagnóstico" \
        --menu "Escolha uma opção:" 16 78 4 \
        "config" "Configurar o eazy" \
        "overview" "Overview do sistema" \
        "sound" "Teste de som" \
        "cancel" "Voltar" \
        3>&1 1>&2 2>&3)
    case "$f9_acao" in
        overview) mostrar_overview_sistema_completo; return ;;
        sound) testar_som; return ;;
        config) : ;;
        *) return 0 ;;
    esac

    local nova_tela
    nova_tela=$(whiptail --title "Configuração: Modo de Tela" \
        --radiolist "Modo de vídeo padrão (Espaço marca, Enter avança):" 15 60 2 \
        "fs" "Tela Cheia (Fullscreen)" $( [ "$TELA_PADRAO" = "fs" ] && echo "ON" || echo "OFF" ) \
        "janela" "Modo Janela" $( [ "$TELA_PADRAO" = "janela" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    [ -n "$nova_tela" ] && TELA_PADRAO="$nova_tela"

    local novo_osd
    novo_osd=$(whiptail --title "Configuração: OSD (On-Screen Display)" \
        --radiolist "Detalhes exibidos na tela do player (Espaço marca, Enter avança):" 16 65 4 \
        "0" "Ocultar tudo" $( [ "$OSD_PADRAO" = "0" ] && echo "ON" || echo "OFF" ) \
        "1" "Mostrar volume/tempo (Padrão)" $( [ "$OSD_PADRAO" = "1" ] && echo "ON" || echo "OFF" ) \
        "2" "Mostrar barra de progresso" $( [ "$OSD_PADRAO" = "2" ] && echo "ON" || echo "OFF" ) \
        "3" "Mostrar tempo total" $( [ "$OSD_PADRAO" = "3" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    [ -n "$novo_osd" ] && OSD_PADRAO="$novo_osd"

    local novo_vol
    novo_vol=$(whiptail --title "Configuração: Volume Padrão" \
        --inputbox "Digite o volume inicial (0 a 100):" 10 60 "$VOL_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -n "$novo_vol" ] && VOL_PADRAO="$novo_vol"

    local novo_dir
    novo_dir=$(whiptail --title "Configuração: Diretório Inicial Padrão" \
        --inputbox "Caminho da pasta que o eazy deve abrir ao iniciar:" 10 65 "$DIR_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -n "$novo_dir" ] && DIR_PADRAO="$novo_dir"

    local novo_pl_dir
    novo_pl_dir=$(whiptail --title "Configuração: Pasta Padrão de Playlists" \
        --inputbox "Pasta onde as playlists serão salvas por padrão:\n(ex: $HOME/Playlists)" 11 70 "$PLAYLIST_DIR_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -n "$novo_pl_dir" ] && PLAYLIST_DIR_PADRAO="$novo_pl_dir"

    local novo_player
    novo_player=$(whiptail --title "Configuração: Player de Mídia" \
        --radiolist "Escolha o player padrão (Espaço marca, Enter confirma):\n(cvlc e ffplay precisam estar instalados)" 16 68 4 \
        "mpv" "mpv (recomendado)" $( [ "$PLAYER_PADRAO" = "mpv" ] && echo "ON" || echo "OFF" ) \
        "mplayer" "mplayer (clássico)" $( [ "$PLAYER_PADRAO" = "mplayer" ] && echo "ON" || echo "OFF" ) \
        "cvlc" "VLC CLI (cvlc)" $( [ "$PLAYER_PADRAO" = "cvlc" ] && echo "ON" || echo "OFF" ) \
        "ffplay" "ffplay (FFmpeg)" $( [ "$PLAYER_PADRAO" = "ffplay" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    [ -n "$novo_player" ] && PLAYER_PADRAO="$novo_player"

    # Checkbox: vídeo sem áudio
    local audio_sel
    audio_sel=$(whiptail --title "Áudio do player" --checklist \
        "Espaço marca, Enter confirma:" 10 55 1 \
        "SEM_AUDIO" "Sem áudio (vídeo mudo)" $( [ "${SEM_AUDIO:-0}" = "1" ] && echo "ON" || echo "OFF" ) \
        3>&1 1>&2 2>&3)
    if echo "$audio_sel" | grep -q "SEM_AUDIO"; then
        SEM_AUDIO="1"
    else
        SEM_AUDIO="0"
    fi

    # Preserva PREVIEW_ATIVO se já existir no config
    local preview_keep="${PREVIEW_ATIVO:-0}"
    [ -f "$CONFIG_FILE" ] && preview_keep=$(grep '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || echo "$preview_keep")

    cat <<EOF > "$CONFIG_FILE"
TELA_PADRAO="$TELA_PADRAO"
OSD_PADRAO="$OSD_PADRAO"
VOL_PADRAO="$VOL_PADRAO"
DIR_PADRAO="$DIR_PADRAO"
PLAYLIST_DIR_PADRAO="$PLAYLIST_DIR_PADRAO"
PLAYER_PADRAO="$PLAYER_PADRAO"
SEM_AUDIO="$SEM_AUDIO"
PREVIEW_ATIVO="$preview_keep"
EOF
    whiptail --title "Sucesso" --msgbox "Configurações salvas com sucesso em:\n$CONFIG_FILE\n\nPlayer: $PLAYER_PADRAO\nSem áudio: $([ "$SEM_AUDIO" = "1" ] && echo "SIM" || echo "NÃO")" 12 55
}

