}

# Sincroniza a posição real do fzf, inclusive Page Down/Page Up/Home/End.
# {n} é o índice zero-based do item atualmente focado; {2} é a linha inteira.
eazy_sync_cursor() {
    local idx="${1:-}" linha="${2:-}" item=""
    idx=$(printf '%s' "$idx" | LC_ALL=C tr -cd '0-9')
    [ -n "$idx" ] || return 0
    TMP=$((idx + 1))
    if ! eazy_eh_navegacao "$linha"; then
        item=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    fi
    IFS='|' read -r _old_tmp _old_alvo _old_item _old_dir _old_modo < "$TMP_FILE" 2>/dev/null || true
    printf "%s|%s|%s|%s|%s\n" "$TMP" "${_old_alvo:-$ALVO}" "$item" "${_old_dir:-$ULTIMO_DIR}" "${_old_modo:-${MODO_PLAYLIST:-0}}" > "$TMP_FILE"
}

obter_lista_rapida() {
    local C_DIR='\033[1;34m'
    local C_VID='\033[1;36m'
    local C_AUD='\033[1;33m'
    local C_IMG='\033[1;35m'
    local C_ZIP='\033[1;31m'
    local C_SIZE='\033[0;32m'
    local C_RESET='\033[0m'

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar aos Arquivos" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        if [ -s "$DOWNLOAD_QUEUE" ]; then
            while IFS='|' read -r engine link pass; do
                [ -z "$link" ] && continue
                local exib_link="$link"
                [ ${#exib_link} -gt 35 ] && exib_link="${exib_link:0:35}.."
                local exib_pass="Nenhuma"
                if [ -n "$pass" ]; then
                    exib_pass="••••••"
                fi
                printf "000000000000001\t%b📥 [%s] %-30s%b\t%b[Senha: %s]%b\t%s\n" \
                    "$C_VID" "$engine" "$exib_link" "$C_RESET" "$C_AUD" "$exib_pass" "$C_RESET" "$link"
            done < "$DOWNLOAD_QUEUE"
        fi
        return
    fi

    if [ "$MODO_PLAYLIST" -eq 1 ] && [ -f "$ARQUIVO_PLAYLIST_ABERTO" ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar aos Arquivos" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        # Diretório base da playlist (para resolver caminhos relativos)
        local pl_dir
        pl_dir=$(dirname "$ARQUIVO_PLAYLIST_ABERTO")

        while IFS= read -r item || [ -n "$item" ]; do
            [ -z "$item" ] && continue
            [[ "$item" =~ ^# ]] && continue
            # Remove \r de arquivos Windows
            item="${item%$'\r'}"

            # Resolve caminho: absoluto fica, relativo resolve a partir da pasta do .m3u
            local item_res="$item"
            if [[ "$item" != /* ]]; then
                item_res="$pl_dir/$item"
            fi
            # Normaliza ./
            item_res="${item_res//\/\.\//\/}"

                        local tamanho=0
            local mb="-- MB"
            local tipo_icone="🎬"
            local tipo_cor="$C_VID"
            local existe=0
            if [ -e "$item_res" ]; then
                existe=1
                tamanho=$(tamanho_caminho "$item_res")
                mb=$(awk -v b="$tamanho" 'BEGIN {printf "%.1f", b / 1048576}')
                if [ -d "$item_res" ]; then
                    tipo_icone="📁"
                    tipo_cor="$C_DIR"
                fi
            else
                mb="?"
            fi

            local nome_exib
            nome_exib=$(basename "$item_res")
            if [ ${#nome_exib} -gt 38 ]; then
                nome_exib="${nome_exib:0:38}.."
            fi
            # Indica arquivo ausente
            if [ "$existe" -eq 0 ]; then
                nome_exib="⚠ $nome_exib"
            fi

            local ext="${item_res##*.}"
            ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

            if [ "$existe" -eq 1 ] && [ -d "$item_res" ]; then
                tipo_icone="📁"
                tipo_cor="$C_DIR"
            elif [[ "$ext" =~ ^(mp3|m4a|wav|flac)$ ]]; then
                tipo_icone="🎵"
            elif [[ "$ext" =~ ^(webp|jpg|jpeg|png|gif)$ ]]; then
                tipo_icone="🖼️"
            elif [[ "$ext" =~ ^(zip|tar|gz|bz2|xz|rar|7z)$ ]]; then
                tipo_icone="📦"
            fi

            # Guarda o caminho resolvido (absoluto) no campo final para play/delete
            printf "%015d\t%b%s %-40s%b\t%b[%s MB]%b\t%s\n" \
                "$tamanho" "$tipo_cor" "$tipo_icone" "$nome_exib" "$C_RESET" "$C_SIZE" "$mb" "$C_RESET" "$item_res"
        done < "$ARQUIVO_PLAYLIST_ABERTO"
        return
    fi

    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar (Sair de Duplicados)" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        if [ -s "$DUP_FILE" ]; then
            # VERMELHO = amostra F12 fixa | AMARELO = seleção interativa (Tab/Ctrl-A/X/R)
            # Comparação sempre por caminho absoluto (evita ✓ no lugar errado após invert)
            awk -F'\t' \
                -v c_red=$'\033[1;31m' \
                -v c_yel=$'\033[1;33m' \
                -v c_dim=$'\033[0;90m' \
                -v c_size="$C_SIZE" \
                -v c_reset="$C_RESET" \
                -v selected_file="$DUP_SELECTED_FILE" \
                -v fixed_file="$DUP_FIXED_FILE" '
            BEGIN {
                grupo = 0; anterior = ""
                if (selected_file != "") {
                    while ((getline escolhido < selected_file) > 0) {
                        if (escolhido != "") amarelo[escolhido] = 1
                    }
                    close(selected_file)
                }
                if (fixed_file != "") {
                    while ((getline escolhido < fixed_file) > 0) {
                        if (escolhido != "") vermelho[escolhido] = 1
                    }
                    close(fixed_file)
                }
            }
            function abs_path(p,   cmd, out) {
                if (p == "") return p
                if (substr(p, 1, 1) == "/") return p
                cmd = "readlink -f -- \"" p "\" 2>/dev/null"
                cmd | getline out
                close(cmd)
                return (out != "" ? out : p)
            }
            {
                hash = $1; tam = $2; caminho = $3
                if (hash != anterior) { grupo++; anterior = hash }
                caminho_abs = abs_path(caminho)

                # Marcas: R=fixo (F12)  Y=seleção normal  ambas possíveis
                m_r = (caminho_abs in vermelho) || (caminho in vermelho)
                m_y = (caminho_abs in amarelo)  || (caminho in amarelo)
                if (m_r && m_y) {
                    marca = c_red "●" c_yel "✓ " c_reset
                } else if (m_r) {
                    marca = c_red "●  " c_reset
                } else if (m_y) {
                    marca = c_yel "✓  " c_reset
                } else {
                    marca = "   "
                }

                nome_exib = caminho
                if (length(nome_exib) > 38) {
                    nome_exib = "..." substr(nome_exib, length(nome_exib) - 35)
                }
                mb = sprintf("%.1f", tam / 1048576)

                printf "%015d\t%s🔁 G%02d %-34s%s\t%s[%s MB]%s\t%s\n",
                    tam, marca, grupo, nome_exib, c_reset, c_size, mb, c_reset, caminho
            }' "$DUP_FILE"
        fi
        return
    fi

    if [ "${MODO_BUSCA:-0}" -eq 1 ]; then
        # Cada execução começa sem sinal residual de cancelamento.
        rm -f "${EAZY_BUSCA_CANCEL_FILE:-/tmp/eazy_search_cancel_$$}" "${EAZY_BUSCA_CANCEL_PID_FILE:-}" 2>/dev/null || true
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" "◀ Voltar (Sair da Busca)" "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"

        local -a ext_arr_busca
        construir_iname_array ext_arr_busca "$EXT_BUSCA"

        local tmp_busca cache_key cache_file
        cache_key=$(chave_cache_busca)
        cache_file="${BUSCA_CACHE_DIR}/${cache_key}.tsv"
        tmp_busca="/tmp/eazy_busca_raw_$$"

        # Pesquisa salva: usa o resultado congelado até o usuário pedir remake.
        if [ -n "${BUSCA_SNAPSHOT_FILE:-}" ] && [ "${BUSCA_REMAKE:-0}" -ne 1 ] && [ -f "$BUSCA_SNAPSHOT_FILE" ]; then
            local n_snapshot
            n_snapshot=$(wc -l < "$BUSCA_SNAPSHOT_FILE" 2>/dev/null | tr -cd '0-9')
            n_snapshot=${n_snapshot:-0}
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;33m'"📌 Resultado salvo — $n_snapshot arquivo(s) (sem remake)"$'\033[0m'
            eazy_busca_msg ""
            cp -f "$BUSCA_SNAPSHOT_FILE" "$tmp_busca" 2>/dev/null || cat "$BUSCA_SNAPSHOT_FILE" > "$tmp_busca"
        # Buffer de busca: reutiliza resultado enquanto o eazy estiver aberto
        elif [ -s "$cache_file" ] && [ "${BUSCA_REMAKE:-0}" -ne 1 ]; then
            local n_cache
            n_cache=$(wc -l < "$cache_file" 2>/dev/null | tr -cd '0-9')
            n_cache=${n_cache:-0}
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;32m'"⚡ Cache de busca — $n_cache arquivo(s) (instantâneo)"$'\033[0m'
            eazy_busca_msg ""
            cp -f "$cache_file" "$tmp_busca" 2>/dev/null || cat "$cache_file" > "$tmp_busca"
        else
            : > "$tmp_busca"
            BUSCA_REMAKE=0

            # Segmentos: 0-9, A-Z, outros — barra atualiza ANTES e DEPOIS de cada um
            local letras=({0..9} {A..Z})
            local total_seg=$((${#letras[@]} + 1))
            local idx=0 total_achados=0
            local let seg_tmp n_seg pct
            local size_args=()
            [ -n "${BUSCA_TAM_MIN:-}" ] && size_args+=("-size" "+${BUSCA_TAM_MIN}c")
            [ -n "${BUSCA_TAM_MAX:-}" ] && size_args+=("-size" "-${BUSCA_TAM_MAX}c")

            local titulo="🔍 Busca segmentada [${EXT_BUSCA:-todas}]"
            [ -n "${BUSCA_TAM_LABEL:-}" ] && titulo="$titulo  tam:$BUSCA_TAM_LABEL"
            [ -n "${BUSCA_CONTEUDO:-}" ] && titulo="$titulo  txt:«${BUSCA_CONTEUDO:0:16}»"
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;36m'"$titulo"$'\033[0m'
            eazy_busca_msg $'\033[0;90m'"   segmentos: 0-9 → A-Z → outros"$'\033[0m'

            for let in "${letras[@]}"; do
                pct=$((idx * 100 / total_seg))
                eazy_busca_progresso "$pct" "$let" "..." "$total_achados" "scan..."
                seg_tmp="/tmp/eazy_busca_seg_$$"
                find . -type f \( "${ext_arr_busca[@]}" \) "${size_args[@]}" \
                    -iname "${let}*" -printf "%s\t%T@\t%y\t%f\t%p\n" 2>/dev/null > "$seg_tmp"
                n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9')
                n_seg=${n_seg:-0}
                cat "$seg_tmp" >> "$tmp_busca"
                rm -f "$seg_tmp"
                total_achados=$((total_achados + n_seg))
                idx=$((idx + 1))
                pct=$((idx * 100 / total_seg))
                eazy_busca_progresso "$pct" "$let" "$n_seg" "$total_achados" "ok"
            done

            pct=$((idx * 100 / total_seg))
            eazy_busca_progresso "$pct" "outros" "..." "$total_achados" "scan..."
            seg_tmp="/tmp/eazy_busca_seg_$$"
            find . -type f \( "${ext_arr_busca[@]}" \) "${size_args[@]}" \
                ! -iname "[0-9]*" ! -iname "[A-Za-z]*" \
                -printf "%s\t%T@\t%y\t%f\t%p\n" 2>/dev/null > "$seg_tmp"
            n_seg=$(wc -l < "$seg_tmp" 2>/dev/null | tr -cd '0-9')
            n_seg=${n_seg:-0}
            cat "$seg_tmp" >> "$tmp_busca"
            rm -f "$seg_tmp"
            total_achados=$((total_achados + n_seg))
            eazy_busca_progresso 100 "outros" "$n_seg" "$total_achados" "ok"
            eazy_busca_msg ""
            eazy_busca_msg $'\033[1;32m'"✓ Busca concluída — $total_achados arquivo(s)"$'\033[0m'
            eazy_busca_msg ""

            # Filtro por conteúdo (grep) com barra própria
            if [ -n "${BUSCA_CONTEUDO:-}" ]; then
                local tmp_filtro="/tmp/eazy_busca_grep_$$"
                : > "$tmp_filtro"
                local n_grep=0 n_total gi=0
                n_total=$(wc -l < "$tmp_busca" 2>/dev/null | tr -cd '0-9')
                n_total=${n_total:-1}
                [ "$n_total" -lt 1 ] && n_total=1
                eazy_busca_progresso 0 "grep" 0 "$n_total" "iniciando..."
                while IFS=$'\t' read -r bytes mtime tipo nome caminho; do
                    gi=$((gi + 1))
                    [ -z "$caminho" ] && continue
                    if eazy_busca_cancelada; then
                        rm -f "$tmp_filtro"
                        eazy_busca_cancelar_parar
                        return 130
                    fi
                    local conteudo_ok=0
                    if eazy_conteudo_match "$BUSCA_CONTEUDO" "$caminho"; then
                        conteudo_ok=1
                    fi
                    if [ "$conteudo_ok" -eq 1 ]; then
                        printf "%s\t%s\t%s\t%s\t%s\n" "$bytes" "$mtime" "$tipo" "$nome" "$caminho" >> "$tmp_filtro"
                        n_grep=$((n_grep + 1))
                    elif eazy_busca_cancelada; then
                        rm -f "$tmp_filtro"
                        eazy_busca_cancelar_parar
                        return 130
                    fi
                    if [ $((gi % 15)) -eq 0 ] || [ "$gi" -eq "$n_total" ]; then
                        eazy_busca_progresso "$((gi * 100 / n_total))" "grep" "$n_grep" "$gi" "/$n_total"
                    fi
                done < "$tmp_busca"
                mv "$tmp_filtro" "$tmp_busca"
                eazy_busca_msg ""
                eazy_busca_msg $'\033[1;32m'"✓ Conteúdo — $n_grep hit(s)"$'\033[0m'
                eazy_busca_msg ""
            fi

            if eazy_busca_cancelada; then
                eazy_busca_msg ""
                eazy_busca_msg $'\033[1;33mBusca cancelada por Esc.\033[0m'
                return 130
            fi

            # Grava no buffer da sessão
            mkdir -p "$BUSCA_CACHE_DIR" 2>/dev/null || true
            cp -f "$tmp_busca" "$cache_file" 2>/dev/null || cat "$tmp_busca" > "$cache_file"
        fi

        awk -F'\t' \
            -v c_vid="$C_VID" -v c_aud="$C_AUD" -v c_img="$C_IMG" -v c_zip="$C_ZIP" \
            -v c_size="$C_SIZE" -v c_reset="$C_RESET" -v modo="$MODO_ATUAL" \
            -v tmin="${BUSCA_TAM_MIN:-0}" -v tmax="${BUSCA_TAM_MAX:-0}" '
        {
            bytes = $1 + 0
            if (tmin > 0 && bytes <= tmin) next
            if (tmax > 0 && bytes >= tmax) next

            mtime = $2
            nome = $4
            caminho = $5
            sub(/^\.\//, "", caminho)

            nome_exib = caminho
            if (length(nome_exib) > 45) {
                nome_exib = "..." substr(nome_exib, length(nome_exib) - 41)
            }
            mb = sprintf("%.1f", bytes / 1048576)
            chave = (modo == "data") ? int(mtime) : bytes
            info = (modo == "data") ? strftime("%d/%m/%y %H:%M", int(mtime)) : mb " MB"

            n = split(nome, ext_arr, ".")
            ext = tolower(ext_arr[n])

            if (ext ~ /^(m3u|pls)$/) {
                printf "%015d\t%s📜 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(mp3|m4a|wav|flac)$/) {
                printf "%015d\t%s🎵 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(webp|jpg|jpeg|png|gif)$/) {
                printf "%015d\t%s🖼️ %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_img, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else if (ext ~ /^(zip|tar|gz|bz2|xz|rar|7z)$/) {
                printf "%015d\t%s📦 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_zip, nome_exib, c_reset, c_size, info, c_reset, caminho
            } else {
                printf "%015d\t%s🎬 %-45s%s\t%s[%s]%s\t%s\n",
                    chave, c_vid, nome_exib, c_reset, c_size, info, c_reset, caminho
            }
        }' "$tmp_busca"
        rm -f "$tmp_busca"
        return
    fi

    if [ "$(pwd)" != "/" ]; then
        printf "000000000000000\t%b📁 %-40s%b\t%b[%-6s]%b\t..\n" \
            "$C_DIR" ".." "$C_RESET" "$C_SIZE" "-- MB" "$C_RESET"
    fi

    local -a find_args=("." "-maxdepth" "1" "-mindepth" "1" "(" "-type" "d")

    case "$FILTRO_ATUAL" in
        videos)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp4" "-o" "-iname" "*.mp3" "-o" "-iname" "*.wmv" "-o" "-iname" "*.flv" "-o" "-iname" "*.mkv" "-o" \
                "-iname" "*.avi" "-o" "-iname" "*.mov" "-o" "-iname" "*.webm" "-o" "-iname" "*.m4v" ")")
            ;;
        audios)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp3" "-o" "-iname" "*.m4a" "-o" "-iname" "*.wav" "-o" \
                "-iname" "*.flac" ")")
            ;;
        imgs)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.webp" "-o" "-iname" "*.jpg" "-o" "-iname" "*.jpeg" "-o" \
                "-iname" "*.png" "-o" "-iname" "*.gif" ")")
            ;;
        compactados)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.zip" "-o" "-iname" "*.tar" "-o" "-iname" "*.gz" "-o" \
                "-iname" "*.bz2" "-o" "-iname" "*.xz" "-o" "-iname" "*.rar" "-o" \
                "-iname" "*.7z" ")")
            ;;
        todos)
            find_args+=("-o" "-type" "f")
            ;;
        ambos|*)
            find_args+=("-o" "-type" "f" "(" \
                "-iname" "*.mp4" "-o" "-iname" "*.mp3" "-o" "-iname" "*.wmv" "-o" "-iname" "*.flv" "-o" \
                "-iname" "*.mkv" "-o" "-iname" "*.mov" "-o" \
                "-iname" "*.m4v" "-o" "-iname" "*.m4a" "-o" "-iname" "*.avi" "-o" "-iname" "*.wav" "-o" \
                "-iname" "*.flac" "-o" "-iname" "*.webm" "-o" "-iname" "*.webp" "-o" \
                "-iname" "*.jpg" "-o" "-iname" "*.jpeg" "-o" "-iname" "*.png" "-o" \
                "-iname" "*.gif" "-o" "-iname" "*.zip" "-o" "-iname" "*.tar" "-o" \
                "-iname" "*.gz" "-o" "-iname" "*.bz2" "-o" "-iname" "*.xz" "-o" \
                "-iname" "*.rar" "-o" "-iname" "*.7z" "-o" "-iname" "*.m3u" "-o" \
                "-iname" "*.pls" "-o" "-iname" "*.txt" ")")
            ;;
    esac
    find_args+=(")")

    find "${find_args[@]}" -printf "%s\t%T@\t%y\t%f\t%p\n" 2>/dev/null | awk -F'\t' \
        -v c_dir="$C_DIR" -v c_vid="$C_VID" -v c_aud="$C_AUD" -v c_img="$C_IMG" -v c_zip="$C_ZIP" \
        -v c_size="$C_SIZE" -v c_reset="$C_RESET" -v modo="$MODO_ATUAL" '
    {
        bytes = $1
        mtime = $2
        tipo = $3
        nome = $4
        caminho = $5

        sub(/^\.\//, "", caminho)
        nome_exib = (length(nome) > 38) ? substr(nome, 1, 38) ".." : nome
        mb = sprintf("%.1f", bytes / 1048576)

        chave = (modo == "data") ? int(mtime) : bytes
        info = (modo == "data") ? strftime("%d/%m/%y %H:%M", int(mtime)) : mb " MB"

        n = split(nome, ext_arr, ".")
        ext = tolower(ext_arr[n])

        if (tipo == "d") {
            printf "%015d\t%s📁 %-40s%s\t%s[%-9s]%s\t%s\n",
                chave, c_dir, nome_exib "/", c_reset, c_size, (modo == "data" ? info : "-- MB"), c_reset, caminho
        } else if (ext ~ /^(m3u|pls)$/) {
            printf "%015d\t%s📜 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else if (ext ~ /^(mp3|m4a|wav|flac)$/) {
            printf "%015d\t%s🎵 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_aud, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else if (ext ~ /^(webp|jpg|jpeg|png|gif)$/) {
            printf "%015d\t%s🖼️ %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_img, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else if (ext ~ /^(zip|tar|gz|bz2|xz|rar|7z)$/) {
            printf "%015d\t%s📦 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_zip, nome_exib, c_reset, c_size, info, c_reset, caminho
        } else {
            printf "%015d\t%s🎬 %-40s%s\t%s[%s]%s\t%s\n",
                chave, c_vid, nome_exib, c_reset, c_size, info, c_reset, caminho
        }
    }'
}

# Converte caminho relativo para absoluto (robusto)
caminho_absoluto() {
    local p="$1"
    [ -z "$p" ] && return
    # Já é absoluto?
    if [[ "$p" == /* ]]; then
        printf '%s\n' "$p"
        return
    fi
    # realpath se existir, senão fallback
    if command -v realpath &>/dev/null; then
        realpath -m -- "$p" 2>/dev/null || printf '%s/%s\n' "$(pwd)" "${p#./}"
    else
        local base
        base=$(pwd)
        p="${p#./}"
        printf '%s/%s\n' "$base" "$p"
    fi
}

# --- Editor de notas rápidas ---
# Usa o mini editor visual fornecido no projeto; não depende de Vim, vi ou nano.
# Ctrl-N cria nota; Ctrl-S salva e abre outra; Esc salva e sai.
abrir_editor_notas() {
    local nota
    mkdir -p "$NOTES_DIR" 2>/dev/null || {
        whiptail --title "Notas" --msgbox "Não foi possível criar: $NOTES_DIR" 8 60
        return 1
    }
    nota=""
    [ -s "$LAST_NOTE_FILE" ] && nota=$(head -n1 "$LAST_NOTE_FILE")
    if [ -z "$nota" ] || [ ! -f "$nota" ]; then
        nota="$NOTES_DIR/nota.txt"
        touch "$nota" 2>/dev/null || return 1
    fi
    printf '%s\n' "$nota" > "$LAST_NOTE_FILE"
    if [ ! -x "$EAZY_NOTES_EDITOR" ]; then
        whiptail --title "Editor de notas" --msgbox "Mini editor não encontrado:\n$EAZY_NOTES_EDITOR" 8 70
        return 1
    fi
    (
        cd "$NOTES_DIR" || exit 1
        EAZY_NOTES_DIR="$NOTES_DIR" EAZY_LAST_NOTE="$LAST_NOTE_FILE" EAZY_EXPORT_DIR="$HOME/Documentos/Easy-Notes" "$EAZY_NOTES_EDITOR" "$nota"
    )
    local ultima_salva
    ultima_salva=""
    [ -s "$LAST_NOTE_FILE" ] && ultima_salva=$(head -n1 "$LAST_NOTE_FILE")
    if [ -z "$ultima_salva" ] || [ ! -f "$ultima_salva" ]; then
        if [ -f "$nota" ]; then
            printf '%s\n' "$nota" > "$LAST_NOTE_FILE"
        else
            local criada
            criada=$(find "$NOTES_DIR" -maxdepth 1 -type f -name '*.txt' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
            [ -n "$criada" ] && printf '%s\n' "$criada" > "$LAST_NOTE_FILE"
        fi
    fi
}

# --- Detecta se arquivo é texto (para visualização read-only) ---
eh_arquivo_texto() {
    local f="$1"
    [ ! -f "$f" ] && return 1
    local ext
    ext=$(echo "${f##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        txt|md|log|conf|cfg|ini|json|xml|csv|sh|bash|py|c|h|cpp|hpp|js|ts|html|htm|css|yaml|yml|toml|nfo|srt|ass|ssa|cue|m3u|pls|lst|org|rst|tex|sql|r|rb|go|rs|java|kt|swift|php|pl|lua|vim|diff|patch|gitignore|dockerfile|makefile|readme|license|changelog)
            return 0
            ;;
    esac
    # Fallback: MIME text/*
    if command -v file &>/dev/null; then
        local mime
        mime=$(file -b --mime-type -- "$f" 2>/dev/null)
        [[ "$mime" == text/* ]] && return 0
        [[ "$mime" == application/json ]] && return 0
        [[ "$mime" == application/xml ]] && return 0
        [[ "$mime" == application/javascript ]] && return 0
    fi
    return 1
}

mostrar_texto() {
    local f="$1" rc
    [ ! -f "$f" ] && return 1
    clear
    if command -v whiptail &>/dev/null; then
        whiptail --title "$(basename "$f") — leitura" --textbox "$f" 28 100 --scrolltext
        rc=$?
        restaurar_terminal
        return "$rc"
    fi
    cat -- "$f"
    printf '\nPressione Enter para voltar ou Esc para cancelar... '
    local tecla
    IFS= read -r -n1 -s tecla || true
    printf '\n'
    [ "$tecla" = $'\e' ] && return 1
    return 0
}

# Preview do fzf (caminho = último campo da linha TAB)
eazy_preview() {
    local linha="$1"
    local path
    path=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    path="${path#./}"

    # Linha de voltar / vazia
    if [ -z "$path" ] || [[ "$path" =~ \.\.$ ]] || [[ "$path" == ".." ]]; then
        printf "📁 Diretório pai / voltar\n"
        return
    fi

    # URL (fila de download)
    if [[ "$path" =~ ^https?:// ]]; then
        printf "🔗 LINK\n\n%s\n" "$path"
        return
    fi

    if [ -d "$path" ]; then
        printf "📁 PASTA\n%s\n\n" "$path"
        printf "Conteúdo (até 20 itens):\n"
        ls -lah -- "$path" 2>/dev/null | head -n 21
        return
    fi

    if [ ! -e "$path" ]; then
        printf "⚠ Arquivo não encontrado:\n%s\n" "$path"
        return
    fi

    if [ ! -f "$path" ]; then
        printf "❓ %s\n" "$path"
        return
    fi

    local nome tamanho human tipo ext
    nome=$(basename -- "$path")
    tamanho=$(stat -c%s -- "$path" 2>/dev/null || echo 0)
    human=$(awk -v b="$tamanho" 'BEGIN {
        if (b>=1073741824) printf "%.2f GB", b/1073741824
        else if (b>=1048576) printf "%.2f MB", b/1048576
        else if (b>=1024) printf "%.1f KB", b/1024
        else printf "%d B", b
    }')
    tipo=$(file -b -- "$path" 2>/dev/null | head -c 80)
    ext=$(echo "${nome##*.}" | tr '[:upper:]' '[:lower:]')

    printf "📄 %s\n" "$nome"
    printf "━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "Caminho : %s\n" "$path"
    printf "Tamanho : %s (%s bytes)\n" "$human" "$tamanho"
    printf "Tipo    : %s\n" "$tipo"

    # Mídia: duração, resolução, codec
    if command -v ffprobe &>/dev/null; then
        if [[ "$ext" =~ ^(mp4|mkv|avi|webm|mov|m4v|wmv|flv|mp3|m4a|wav|flac|ogg|opus|aac)$ ]]; then
            local dur w h vcodec acodec br
            dur=$(ffprobe -v quiet -show_entries format=duration -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            br=$(ffprobe -v quiet -show_entries format=bit_rate -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            w=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=width -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            h=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=height -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            vcodec=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=codec_name -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            acodec=$(ffprobe -v quiet -select_streams a:0 -show_entries stream=codec_name -of default=nk=1:nw=1 -- "$path" 2>/dev/null)

            printf "\n🎬 MÍDIA\n"
            if [ -n "$dur" ] && [ "$dur" != "N/A" ]; then
                awk -v d="$dur" 'BEGIN {
                    s=int(d); h=int(s/3600); m=int((s%3600)/60); sec=s%60
                    if (h>0) printf "Duração : %d:%02d:%02d\n", h, m, sec
                    else printf "Duração : %d:%02d\n", m, sec
                }'
            fi
            [ -n "$w" ] && [ -n "$h" ] && [ "$w" != "N/A" ] && printf "Res     : %sx%s\n" "$w" "$h"
            [ -n "$vcodec" ] && [ "$vcodec" != "N/A" ] && printf "Vídeo   : %s\n" "$vcodec"
            [ -n "$acodec" ] && [ "$acodec" != "N/A" ] && printf "Áudio   : %s\n" "$acodec"
            if [ -n "$br" ] && [ "$br" != "N/A" ]; then
                awk -v b="$br" 'BEGIN {printf "Bitrate : %.0f kbps\n", b/1000}'
            fi
        fi
    fi

    # Texto: primeiras linhas
    if [[ "$ext" =~ ^(txt|md|log|json|xml|csv|sh|py|c|h|js|html|css|yml|yaml|toml|conf|cfg|ini|nfo|srt|ass)$ ]]; then
        printf "\n📝 PRÉVIA\n"
        head -n 25 -- "$path" 2>/dev/null
    elif [[ "$ext" =~ ^(jpg|jpeg|png|gif|webp|bmp|tiff|tif|svg)$ ]]; then
        printf "\n🖼  IMAGEM\n"
        if command -v identify &>/dev/null; then
            identify -format "Res: %wx%h  |  %m  |  %b\n" -- "$path" 2>/dev/null
        elif command -v ffprobe &>/dev/null; then
            w=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=width -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            h=$(ffprobe -v quiet -select_streams v:0 -show_entries stream=height -of default=nk=1:nw=1 -- "$path" 2>/dev/null)
            [ -n "$w" ] && printf "Res: %sx%s\n" "$w" "$h"
        fi
        # Miniatura no terminal (chafa > viu > catimg > convert)
        local cols="${FZF_PREVIEW_COLUMNS:-40}"
        local lines="${FZF_PREVIEW_LINES:-20}"
        if command -v chafa &>/dev/null; then
            chafa -f symbols --symbols vhalf --size "${cols}x${lines}" -- "$path" 2>/dev/null
        elif command -v viu &>/dev/null; then
            viu -w "$cols" -h "$lines" -- "$path" 2>/dev/null
        elif command -v catimg &>/dev/null; then
            catimg -w "$cols" -- "$path" 2>/dev/null
        elif command -v convert &>/dev/null; then
            convert -- "$path" -resize "${cols}x${lines}" -colors 16 sixel:- 2>/dev/null \
                || printf "(instale 'chafa' para miniatura: sudo apt install chafa)\n"
        else
            printf "(instale 'chafa' para miniatura no preview)\n"
        fi
    fi
}

# Script Lua do mpv: marcar / apagar durante a reprodução
preparar_script_mpv_exclusao() {
    mkdir -p "$MPV_SCRIPT_DIR" 2>/dev/null || true
    local script="$MPV_SCRIPT_DIR/eazy_mark_delete.lua"
    cat > "$script" <<'LUA'
-- eazy: marcar / excluir durante a reprodução (mpv)
local mark_file = os.getenv("EAZY_MARK_DELETE") or ""

local function append_mark(path)
    if not path or path == "" or mark_file == "" then return false end
    -- evita duplicata
    local exists = false
    local rf = io.open(mark_file, "r")
    if rf then
        for line in rf:lines() do
            if line == path then exists = true; break end
        end
        rf:close()
    end
    if exists then
        mp.osd_message("EAZY: já marcado para exclusão", 1.5)
        return true
    end
    local f = io.open(mark_file, "a")
    if not f then
        mp.osd_message("EAZY: falha ao marcar", 2)
        return false
    end
    f:write(path .. "\n")
    f:close()
    return true
end

local function current_path()
    return mp.get_property("path")
end

-- d = marcar para exclusão (apaga depois, ao sair do player)
mp.add_key_binding("d", "eazy-mark-delete", function()
    local path = current_path()
    if append_mark(path) then
        mp.osd_message("EAZY: marcado para exclusão\n" .. (path or ""), 2)
    end
end)

-- D (Shift+d) = marcar e ir para o próximo da playlist
mp.add_key_binding("D", "eazy-mark-and-next", function()
    local path = current_path()
    if append_mark(path) then
        mp.osd_message("EAZY: marcado → próximo", 1.5)
        mp.command("playlist-next")
    end
end)

-- Ctrl+DEL = marcar (mesmo que d)
mp.add_key_binding("Ctrl+DEL", "eazy-mark-delete-ctrl", function()
    local path = current_path()
    if append_mark(path) then
        mp.osd_message("EAZY: marcado para exclusão", 2)
    end
end)

mp.osd_message("EAZY: [d] marcar exclusão  [D] marcar+próximo", 3)
LUA
    echo "$script"
}

# Após o player: processa arquivos marcados para exclusão
processar_marcados_exclusao() {
    [ ! -s "$MARK_DELETE_FILE" ] && return 0
    # dedup
    local tmpm="/tmp/eazy_mark_uniq_$$"
    sort -u "$MARK_DELETE_FILE" > "$tmpm" 2>/dev/null
    mv "$tmpm" "$MARK_DELETE_FILE"

    local n
    n=$(grep -c '^' "$MARK_DELETE_FILE" 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9'); n=${n:-0}
    [ "$n" -eq 0 ] && return 0

    local lista_msg="" i=0
    while IFS= read -r linha && [ "$i" -lt 8 ]; do
        [ -z "$linha" ] && continue
        lista_msg="${lista_msg}\n• $(basename -- "$linha")"
        i=$((i + 1))
    done < "$MARK_DELETE_FILE"
    [ "$n" -gt 8 ] && lista_msg="${lista_msg}\n… e mais $((n - 8))"

    if whiptail --title "Marcados para exclusão ($n)" --yesno \
"Arquivos marcados durante o player:$lista_msg

Apagar do disco agora?
(Não = mantém a lista para depois)" 16 65; then
        local ok=0 falha=0
        while IFS= read -r arq; do
            [ -z "$arq" ] && continue
            if [ -e "$arq" ]; then
                if rm -rf -- "$arq" 2>/dev/null; then
                    ok=$((ok + 1))
                else
                    falha=$((falha + 1))
                fi
            fi
        done < "$MARK_DELETE_FILE"
        : > "$MARK_DELETE_FILE"
        whiptail --title "Exclusão" --msgbox "Apagados: $ok\nFalhas: $falha" 9 40
    else
        # pergunta se limpa a lista
        if whiptail --title "Lista" --yesno "Manter os $n itens na lista de exclusão?" 9 50 --defaultno; then
            : # mantém
        else
            : > "$MARK_DELETE_FILE"
        fi
    fi
}

# Monta parâmetros do player conforme PLAYER_PADRAO e TELA_ATUAL
montar_param_player() {
    local mute_extra=""
    case "${PLAYER_PADRAO:-mpv}" in
        mplayer)
            if [ "$TELA_ATUAL" = "fs" ]; then
                PARAM_PLAYER="-fs -volume $VOL_PADRAO"
            else
                PARAM_PLAYER="-volume $VOL_PADRAO"
            fi
            [ "${SEM_AUDIO:-0}" = "1" ] && PARAM_PLAYER="$PARAM_PLAYER -nosound"
            ;;
        cvlc)
            # VLC CLI — volume 0-256 aprox; fullscreen via --fullscreen
            local vol_vlc
            vol_vlc=$(awk -v v="${VOL_PADRAO:-100}" 'BEGIN {printf "%d", v * 2.56}')
            if [ "$TELA_ATUAL" = "fs" ]; then
                PARAM_PLAYER="--fullscreen --play-and-exit --no-video-title-show --volume=$vol_vlc"
            else
                PARAM_PLAYER="--play-and-exit --no-video-title-show --volume=$vol_vlc"
            fi
            [ "${SEM_AUDIO:-0}" = "1" ] && PARAM_PLAYER="$PARAM_PLAYER --no-audio"
            ;;
        ffplay)
            # ffplay — volume 0.0-1.0; -autoexit
            local vol_ff
            vol_ff=$(awk -v v="${VOL_PADRAO:-100}" 'BEGIN {printf "%.2f", v/100}')
            if [ "$TELA_ATUAL" = "fs" ]; then
                PARAM_PLAYER="-fs -autoexit -volume $vol_ff -loglevel error"
            else
                PARAM_PLAYER="-autoexit -volume $vol_ff -loglevel error"
            fi
            [ "${SEM_AUDIO:-0}" = "1" ] && PARAM_PLAYER="$PARAM_PLAYER -an"
            ;;
        *)
            # mpv + legendas + script de marcação para exclusão
            if [ "$TELA_ATUAL" = "fs" ]; then
                PARAM_PLAYER="--fullscreen --osd-level=$OSD_PADRAO --volume=$VOL_PADRAO --sub-auto=fuzzy --sub-visibility=yes"
            else
                PARAM_PLAYER="--autofit=70% --force-window=immediate --osd-level=$OSD_PADRAO --volume=$VOL_PADRAO --sub-auto=fuzzy --sub-visibility=yes"
            fi
            [ "${SEM_AUDIO:-0}" = "1" ] && PARAM_PLAYER="$PARAM_PLAYER --mute=yes --volume=0"
            local mpv_script
            mpv_script=$(preparar_script_mpv_exclusao)
            if [ -f "$mpv_script" ]; then
                PARAM_PLAYER="$PARAM_PLAYER --script=$mpv_script"
            fi
            export EAZY_MARK_DELETE="$MARK_DELETE_FILE"
            mkdir -p "$CONFIG_DIR" 2>/dev/null || true
            touch "$MARK_DELETE_FILE"
            ;;
    esac
}

# Registra arquivo no histórico (máx. 200 entradas, mais recente no topo)
registrar_historico() {
    local arq="$1"
    [ -z "$arq" ] || [ ! -e "$arq" ] && return
    local abs
    abs=$(caminho_absoluto "$arq")
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    touch "$HISTORY_FILE"
    # Remove duplicata anterior e coloca no topo
    grep -vxF -- "$abs" "$HISTORY_FILE" > "${HISTORY_FILE}.tmp" 2>/dev/null || true
    { printf '%s\n' "$abs"; cat "${HISTORY_FILE}.tmp" 2>/dev/null; } > "$HISTORY_FILE"
    rm -f "${HISTORY_FILE}.tmp"
    # Limita a 200
    if [ "$(wc -l < "$HISTORY_FILE" 2>/dev/null | tr -cd '0-9')" -gt 200 ] 2>/dev/null; then
        head -n 200 "$HISTORY_FILE" > "${HISTORY_FILE}.tmp" && mv "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
    fi
}

eh_playlist_m3u() {
    local f="$1" ext
    [ -f "$f" ] || return 1
    ext="${f##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    [ "$ext" = "m3u" ]
}

# Abre uma playlist no navegador interno, sem iniciar o player imediatamente.
abrir_playlist_no_navegador() {
    local lista="$1" dir_atual
    [ -f "$lista" ] || return 1
    dir_atual="$(pwd -P)"
    salvar_posicao_dir "$dir_atual" "${TMP:-1}" "$(readlink -f -- "$lista" 2>/dev/null || echo "$lista")"
    ARQUIVO_PLAYLIST_ABERTO="$(readlink -f -- "$lista" 2>/dev/null || echo "$lista")"
    MODO_PLAYLIST=1
    MODO_BUSCA=0
    MODO_DUP=0
    MODO_DOWNLOAD=0
    TMP=1
    ULTIMO_ARQUIVO=""
    carregar_posicao_dir "$ARQUIVO_PLAYLIST_ABERTO"
    registrar_status
}

# Toca um único arquivo
tocar_arquivo() {
    local arq="$1"
    [ -z "$arq" ] && return 1
    registrar_historico "$arq"
    montar_param_player
    case "${PLAYER_PADRAO:-mpv}" in
        mplayer)
            if command -v mplayer &>/dev/null; then
                # shellcheck disable=SC2086
                mplayer $PARAM_PLAYER -- "$arq"
            else
                whiptail --title "Player" --msgbox "mplayer não encontrado.\nInstale: sudo apt install mplayer\nOu mude em F9 / --config." 9 55
            fi
            ;;
        cvlc)
            if command -v cvlc &>/dev/null; then
                # shellcheck disable=SC2086
                cvlc $PARAM_PLAYER -- "$arq"
            else
                whiptail --title "Player" --msgbox "cvlc não encontrado.\nInstale: sudo apt install vlc\nOu mude em F9 / --config." 9 55
            fi
            ;;
        ffplay)
            if command -v ffplay &>/dev/null; then
                # shellcheck disable=SC2086
                ffplay $PARAM_PLAYER -- "$arq"
            else
                whiptail --title "Player" --msgbox "ffplay não encontrado.\nInstale: sudo apt install ffmpeg\nOu mude em F9 / --config." 9 55
            fi
            ;;
        *)
            if command -v mpv &>/dev/null; then
                # shellcheck disable=SC2086
                mpv $PARAM_PLAYER -- "$arq"
                processar_marcados_exclusao
            else
                whiptail --title "Player" --msgbox "mpv não encontrado.\nInstale: sudo apt install mpv\nOu mude em F9 / --config." 9 55
            fi
            ;;
    esac
}

# Toca uma playlist (arquivo com lista de caminhos)
# $2 = "shuffle" para ordem aleatória
tocar_lista() {
    local lista="$1"
    local modo="${2:-}"
    [ ! -s "$lista" ] && return 1

    local lista_play="$lista"
    if [ "$modo" = "shuffle" ]; then
        lista_play="/tmp/eazy_shuffle_$$"
        grep -v '^#' "$lista" | grep -v '^[[:space:]]*$' | shuf > "$lista_play"
        [ ! -s "$lista_play" ] && { rm -f "$lista_play"; return 1; }
    fi

    # Histórico: primeiro item da lista
    local primeiro
    primeiro=$(grep -v '^#' "$lista_play" | grep -v '^[[:space:]]*$' | head -n1)
    [ -n "$primeiro" ] && registrar_historico "$primeiro"

    montar_param_player
    case "${PLAYER_PADRAO:-mpv}" in
        mplayer)
            if command -v mplayer &>/dev/null; then
                # shellcheck disable=SC2086
                mplayer $PARAM_PLAYER -playlist "$lista_play"
            else
                whiptail --title "Player" --msgbox "mplayer não encontrado." 8 50
            fi
            ;;
        cvlc)
            if command -v cvlc &>/dev/null; then
                # shellcheck disable=SC2086
                cvlc $PARAM_PLAYER --playlist "$lista_play"
            else
                whiptail --title "Player" --msgbox "cvlc não encontrado.\nInstale: sudo apt install vlc" 8 50
            fi
            ;;
        ffplay)
            # ffplay não tem playlist nativa — toca item a item
            if command -v ffplay &>/dev/null; then
                while IFS= read -r item || [ -n "$item" ]; do
                    [ -z "$item" ] && continue
                    [[ "$item" =~ ^# ]] && continue
                    [ ! -e "$item" ] && continue
                    # shellcheck disable=SC2086
                    ffplay $PARAM_PLAYER -- "$item" || break
                done < "$lista_play"
            else
                whiptail --title "Player" --msgbox "ffplay não encontrado.\nInstale: sudo apt install ffmpeg" 8 50
            fi
            ;;
        *)
            if command -v mpv &>/dev/null; then
                # shellcheck disable=SC2086
                mpv --playlist="$lista_play" $PARAM_PLAYER
                processar_marcados_exclusao
            else
                whiptail --title "Player" --msgbox "mpv não encontrado." 8 50
            fi
            ;;
    esac
    [ "$lista_play" != "$lista" ] && rm -f "$lista_play"
}

salvar_playlist() {
    local destino nome_tmp dir_destino lista_origem
    # Ctrl-S dentro de uma playlist deve salvar a lista que está aberta.
    # PLAYLIST_FILE pode continuar apontando para a fila padrão quando a
    # navegação veio de uma lista temporária personalizada.
    lista_origem=$(arquivo_playlist_ativo)
    if [ ! -s "$lista_origem" ]; then
        whiptail --title "Salvar Playlist" --msgbox "A playlist temporária está vazia.\nUse INSERT para adicionar arquivos antes de salvar." 8 60
        return
    fi

    # Garante que a pasta padrão existe
    mkdir -p "$PLAYLIST_DIR_PADRAO" 2>/dev/null || true

    # 1) Pasta de destino (padrão = PLAYLIST_DIR_PADRAO)
    dir_destino=$(whiptail --title "Salvar Playlist — Pasta" \
        --inputbox "Pasta onde salvar a playlist:\n(Enter = pasta padrão de playlists)" 11 70 "$PLAYLIST_DIR_PADRAO" \
        3>&1 1>&2 2>&3)
    [ -z "$dir_destino" ] && return

    # Expande ~ se o usuário digitar
    dir_destino="${dir_destino/#\~/$HOME}"

    if [ ! -d "$dir_destino" ]; then
        if whiptail --title "Pasta não existe" --yesno "A pasta não existe:\n$dir_destino\n\nCriar agora?" 10 60; then
            mkdir -p "$dir_destino" || {
                whiptail --title "Erro" --msgbox "Não foi possível criar a pasta." 8 50
                return
            }
        else
            return
        fi
    fi

    # 2) Nome do arquivo
    nome_tmp=$(whiptail --title "Salvar Playlist — Nome" \
        --inputbox "Nome da playlist:" 9 60 "playlist.m3u" \
        3>&1 1>&2 2>&3)
    [ -z "$nome_tmp" ] && return

    [[ "$nome_tmp" != *.* ]] && nome_tmp="${nome_tmp}.m3u"
    destino="$dir_destino/$nome_tmp"

    # 3) Grava com caminhos ABSOLUTOS
    if [ -e "$destino" ]; then
        while IFS= read -r item; do
            [ -z "$item" ] && continue
            [[ "$item" =~ ^# ]] && continue
            item_abs=$(caminho_absoluto "$item")
            if ! grep -Fxq -- "$item_abs" "$destino" 2>/dev/null; then
                printf '%s\n' "$item_abs" >> "$destino"
            fi
        done < "$lista_origem"
    else
        {
            printf '%s\n' '#EXTM3U'
            while IFS= read -r item; do
                [ -z "$item" ] && continue
                [[ "$item" =~ ^# ]] && continue
                caminho_absoluto "$item"
            done < "$lista_origem"
        } > "$destino"
    fi

    whiptail --title "Playlist salva" --msgbox "Playlist salva com sucesso:\n$destino\n\n(Todos os caminhos estão em formato absoluto)" 11 70
}

confirmar_e_excluir() {
    local selecao="$1"
    local modo_extra="${2:-}"   # "disco" = CTRL+DEL → apaga do HD também
    local total_itens
    total_itens=$(echo "$selecao" | grep -v '^[[:space:]]*$' | wc -l)
    total_itens=$(echo "$total_itens" | LC_ALL=C tr -cd '0-9')
    total_itens=${total_itens:-0}

    [ "$total_itens" -eq 0 ] && return

    if [ "${MODO_DOWNLOAD:-0}" -eq 1 ]; then
        echo -e "\n\033[1;33m--------------------------------------------------\033[0m"
        echo -e "\033[1;33m⚠️ REMOVER DA FILA DE DOWNLOADS\033[0m"
        echo -e "Deseja remover os itens selecionados da fila?"
        read -p "Digite (s/N) para confirmar: " resp

        if [[ "$resp" =~ ^[Ss]$ ]]; then
            echo "$selecao" | awk -F '\t' '{print $NF}' | while read -r item_link; do
                [ -z "$item_link" ] && continue
                grep -v "|$item_link|" "$DOWNLOAD_QUEUE" > "${DOWNLOAD_QUEUE}.tmp" && mv "${DOWNLOAD_QUEUE}.tmp" "$DOWNLOAD_QUEUE"
            done
            echo -e "\033[1;32mRemovido(s) da fila de downloads com sucesso!\033[0m"
            sleep 1
        fi
        return
    fi

    # Playlist / fila temp: DEL = só da lista | CTRL+DEL = lista + disco
    if [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ "$modo_extra" != "disco" ]; then
        echo -e "\n\033[1;33m--------------------------------------------------\033[0m"
        if [[ "$ARQUIVO_PLAYLIST_ABERTO" == *temp_playlist_* ]]; then
            echo -e "\033[1;33m⚠️ REMOVER DA FILA TEMPORÁRIA\033[0m"
            echo -e "Os arquivos NÃO serão apagados do disco — só saem desta fila."
            echo -e "\033[0;90mPara apagar do disco: ALT+D\033[0m"
        else
            echo -e "\033[1;33m⚠️ REMOVER DA PLAYLIST\033[0m"
            echo -e "Os arquivos NÃO serão apagados do disco — só saem desta playlist."
            echo -e "\033[0;90mPara apagar do disco: ALT+D\033[0m"
        fi
        read -p "Confirma remover da lista? (s/N): " resp

        if [[ "$resp" =~ ^[Ss]$ ]]; then
            pl_dir=$(dirname "$ARQUIVO_PLAYLIST_ABERTO")
            tmp_pl="${ARQUIVO_PLAYLIST_ABERTO}.tmp"
            sel_tmp="/tmp/eazy_pl_del_$$"
            echo "$selecao" | awk -F '\t' 'NF {print $NF}' > "$sel_tmp"

            : > "$tmp_pl"
            while IFS= read -r linha || [ -n "$linha" ]; do
                linha="${linha%$'\r'}"
                if [ -z "$linha" ] || [[ "$linha" =~ ^# ]]; then
                    printf '%s\n' "$linha" >> "$tmp_pl"
                    continue
                fi
                linha_res="$linha"
                if [[ "$linha" != /* ]]; then
                    linha_res="$pl_dir/$linha"
                fi
                linha_res="${linha_res//\/\.\//\/}"
                if grep -Fxq -- "$linha_res" "$sel_tmp" 2>/dev/null || \
                   grep -Fxq -- "$linha" "$sel_tmp" 2>/dev/null; then
                    continue
                fi
                printf '%s\n' "$linha" >> "$tmp_pl"
            done < "$ARQUIVO_PLAYLIST_ABERTO"

            mv "$tmp_pl" "$ARQUIVO_PLAYLIST_ABERTO"
            rm -f "$sel_tmp"
            echo -e "\033[1;32mRemovido(s) da playlist/fila com sucesso!\033[0m"
            sleep 1
        fi
        return
    fi

    # ALT+D em playlist: remove da lista E apaga do disco (confirmação clara)
    if [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ "$modo_extra" = "disco" ]; then
        local sel_tmp="/tmp/eazy_pl_del_disk_$$"
        echo "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$' > "$sel_tmp"
        local n bytes_sel=0 p t n_dirs=0 n_files=0
        n=$(grep -c '^' "$sel_tmp" 2>/dev/null | tr -cd '0-9')
        n=${n:-0}
        [ "$n" -eq 0 ] && { rm -f "$sel_tmp"; return; }

        while IFS= read -r p; do
            [ -z "$p" ] && continue
            if [ -d "$p" ]; then n_dirs=$((n_dirs + 1))
            elif [ -f "$p" ]; then n_files=$((n_files + 1)); fi
            t=$(tamanho_caminho "$p")
            t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
            bytes_sel=$((bytes_sel + t))
        done < "$sel_tmp"
        local tam_h
        tam_h=$(formatar_bytes_label "$bytes_sel")

        echo -e "\n\033[1;31m--------------------------------------------------\033[0m"
        echo -e "\033[1;31m⚠️ APAGAR DO DISCO (permanente)\033[0m"
        echo -e "\033[1;33mIsso VAI:\033[0m"
        echo -e "  1) Apagar os arquivos/pastas do HD (não vai para a lixeira)"
        echo -e "  2) Remover as entradas desta playlist/fila"
        echo -e "\033[1;33mItens: $n  (arquivos: $n_files | pastas: $n_dirs)\033[0m"
        echo -e "\033[1;33mEspaço a liberar: $tam_h\033[0m"
        if [ "$n" -eq 1 ]; then
            echo -e "Apagar permanentemente:\n  \033[1;37m$(head -n1 "$sel_tmp")\033[0m"
        else
            echo -e "Apagar permanentemente \033[1;33m$n\033[0m item(ns):"
            head -n 8 "$sel_tmp" | while read -r l; do echo "  - $l"; done
            [ "$n" -gt 8 ] && echo "  ... e mais $((n - 8))"
        fi
        read -p "Confirma? (s/N): " resp
        if [[ ! "$resp" =~ ^[Ss]$ ]]; then
            rm -f "$sel_tmp"
            echo -e "\033[1;33mCancelado.\033[0m"
            sleep 0.5
            return
        fi

        while IFS= read -r arq; do
            [ -z "$arq" ] && continue
            rm -rf -- "$arq" 2>/dev/null && echo -e "  \033[1;32m✓\033[0m $arq" || echo -e "  \033[1;31m✗\033[0m $arq"
        done < "$sel_tmp"

        # Remove da playlist também
        pl_dir=$(dirname "$ARQUIVO_PLAYLIST_ABERTO")
        tmp_pl="${ARQUIVO_PLAYLIST_ABERTO}.tmp"
        : > "$tmp_pl"
        while IFS= read -r linha || [ -n "$linha" ]; do
            linha="${linha%$'\r'}"
            if [ -z "$linha" ] || [[ "$linha" =~ ^# ]]; then
                printf '%s\n' "$linha" >> "$tmp_pl"
                continue
            fi
            linha_res="$linha"
            if [[ "$linha" != /* ]]; then
                linha_res="$pl_dir/$linha"
            fi
            if grep -Fxq -- "$linha_res" "$sel_tmp" 2>/dev/null || \
               grep -Fxq -- "$linha" "$sel_tmp" 2>/dev/null; then
                continue
            fi
            printf '%s\n' "$linha" >> "$tmp_pl"
        done < "$ARQUIVO_PLAYLIST_ABERTO"
        mv "$tmp_pl" "$ARQUIVO_PLAYLIST_ABERTO"
        rm -f "$sel_tmp"
        echo -e "\033[1;32mConcluído (disco + lista).\033[0m"
        sleep 1
        return
    fi

    # --- Exclusão do disco (tela principal, busca ou duplicados) ---
    # Uma única confirmação + tamanho total (pastas via du)
    local alvos_tmp="/tmp/eazy_del_$$"
    echo "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$' > "$alvos_tmp"
    total_itens=$(grep -c '^' "$alvos_tmp" 2>/dev/null || echo 0)
    total_itens=$(echo "$total_itens" | tr -cd '0-9')
    total_itens=${total_itens:-0}
    [ "$total_itens" -eq 0 ] && { rm -f "$alvos_tmp"; return; }

    local bytes_sel=0 p t n_dirs=0 n_files=0
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        if [ -d "$p" ]; then
            n_dirs=$((n_dirs + 1))
        elif [ -f "$p" ]; then
            n_files=$((n_files + 1))
        fi
        t=$(tamanho_caminho "$p")
        t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
        bytes_sel=$((bytes_sel + t))
    done < "$alvos_tmp"
    local tam_h
    tam_h=$(formatar_bytes_label "$bytes_sel")

    echo -e "\n\033[1;31m--------------------------------------------------\033[0m"
    if [ "${MODO_DUP:-0}" -eq 1 ]; then
        echo -e "\033[1;31m⚠️ DUPLICADOS — APAGAR DO DISCO (permanente)\033[0m"
    else
        echo -e "\033[1;31m⚠️ APAGAR DO DISCO (permanente)\033[0m"
    fi
    echo -e "\033[1;33mIsso VAI apagar os itens do HD (não vai para a lixeira).\033[0m"
    echo -e "\033[1;33mItens: $total_itens  (arquivos: $n_files | pastas: $n_dirs)\033[0m"
    echo -e "\033[1;33mEspaço a liberar: $tam_h\033[0m"

    if [ "$total_itens" -eq 1 ]; then
        local alvo_del
        alvo_del=$(head -n1 "$alvos_tmp")
        echo -e "Apagar permanentemente:\n  \033[1;37m$alvo_del\033[0m"
    else
        echo -e "Apagar permanentemente \033[1;33m$total_itens\033[0m item(ns):"
        head -n 8 "$alvos_tmp" | while read -r l; do echo "  - $l"; done
        [ "$total_itens" -gt 8 ] && echo "  ... e mais $((total_itens - 8))"
    fi
    read -p "Confirma? (s/N): " resp

    if [[ "$resp" =~ ^[Ss]$ ]]; then
        while IFS= read -r item; do
            [ -z "$item" ] && continue
            rm -rf -- "$item" 2>/dev/null && echo -e "  \033[1;32m✓\033[0m $item" || echo -e "  \033[1;31m✗\033[0m $item"
            # Se estiver em modo duplicados, remove também da lista de dups
            if [ "${MODO_DUP:-0}" -eq 1 ] && [ -f "$DUP_FILE" ]; then
                grep -vF "$item" "$DUP_FILE" > "${DUP_FILE}.tmp" 2>/dev/null && mv "${DUP_FILE}.tmp" "$DUP_FILE"
                eazy_dup_salvar_lista
            fi
        done < "$alvos_tmp"
        echo -e "\033[1;32mConcluído.\033[0m"
        sleep 1
    else
        echo -e "\033[1;33mCancelado.\033[0m"
        sleep 0.5
    fi
    rm -f "$alvos_tmp"
}

# --- Compactar seleção (zip/7z, senha opcional) ---
compactar_selecao() {
    local selecao="$1"
    local itens n
    itens=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$')
    n=$(printf '%s\n' "$itens" | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9'); n=${n:-0}
    [ "$n" -eq 0 ] && {
        whiptail --title "Compactar" --msgbox "Nenhum item selecionado.\nUse TAB/ESPAÇO para marcar." 8 50
        return
    }

    local formato
    formato=$(whiptail --title "Formato" --radiolist "Formato do arquivo:" 12 50 3 \
        "zip" "ZIP (compatível)" "ON" \
        "7z"  "7-Zip (melhor compressão)" "OFF" \
        "tar.gz" "tar.gz (sem senha)" "OFF" \
        3>&1 1>&2 2>&3)
    [ -z "$formato" ] && return

    local nome_out
    nome_out=$(whiptail --title "Nome do arquivo" \
        --inputbox "Nome do arquivo de saída (sem extensão):" 10 60 "arquivo_$(date +%Y%m%d_%H%M)" \
        3>&1 1>&2 2>&3)
    [ -z "$nome_out" ] && return
    nome_out="${nome_out%.*}"

    local senha=""
    if [ "$formato" != "tar.gz" ]; then
        senha=$(whiptail --title "Senha (opcional)" \
            --passwordbox "Senha para proteger o arquivo\n(deixe vazio = sem senha):" 10 55 \
            3>&1 1>&2 2>&3)
    fi

    local out_file
    case "$formato" in
        zip)    out_file="${nome_out}.zip" ;;
        7z)     out_file="${nome_out}.7z" ;;
        tar.gz) out_file="${nome_out}.tar.gz" ;;
    esac

    if [ -e "$out_file" ]; then
        if ! whiptail --title "Sobrescrever?" --yesno "Já existe:\n$out_file\n\nSobrescrever?" 10 55; then
            return
        fi
        rm -f -- "$out_file"
    fi

    # Estimativa: tamanho dos itens (pior caso, pouca compressão) + folga
    local detalhe necessario
    detalhe=$(printf '%s\n' "$itens" | montar_detalhe_espaco)
    necessario=$(printf '%s\n' "$itens" | somar_selecao_bytes)
    verificar_espaco_disco "$necessario" "." "Compactar → $out_file" "$detalhe" || return

    echo -e "\n\033[1;36m📦 Compactando $n item(ns) → $out_file\033[0m"
    local lista_tmp="/tmp/eazy_zip_$$"
    : > "$lista_tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        # caminhos relativos ao cwd para o zip
        printf '%s\n' "${p#./}" >> "$lista_tmp"
    done <<< "$itens"

    local ok=0
    case "$formato" in
        zip)
            if command -v zip &>/dev/null; then
                if [ -n "$senha" ]; then
                    zip -r -P "$senha" "$out_file" -@ < "$lista_tmp" && ok=1
                else
                    zip -r "$out_file" -@ < "$lista_tmp" && ok=1
                fi
            else
                echo -e "\033[1;31m'zip' não instalado. sudo apt install zip\033[0m"
            fi
            ;;
        7z)
            if command -v 7z &>/dev/null; then
                if [ -n "$senha" ]; then
                    7z a -y -p"$senha" -mhe=on "$out_file" $(cat "$lista_tmp") && ok=1
                else
                    7z a -y "$out_file" $(cat "$lista_tmp") && ok=1
                fi
            else
                echo -e "\033[1;31m'7z' não instalado. sudo apt install p7zip-full\033[0m"
            fi
            ;;
        tar.gz)
            tar -czf "$out_file" -T "$lista_tmp" && ok=1
            ;;
    esac
    rm -f "$lista_tmp"

    if [ "$ok" -eq 1 ]; then
        echo -e "\033[1;32m✓ Criado: $out_file\033[0m"
        whiptail --title "Sucesso" --msgbox "Arquivo criado:\n$(pwd)/$out_file" 9 60
    else
        echo -e "\033[1;31m✗ Falha na compactação.\033[0m"
        read -p "Enter para continuar..."
    fi
}

# Extrair seleção (com senha opcional)
descompactar_selecao() {
    local selecao="$1"
    local itens
    itens=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$')
    [ -z "$itens" ] && {
        whiptail --title "Extrair" --msgbox "Nenhum arquivo selecionado." 7 45
        return
    }

    local senha
    senha=$(whiptail --title "Senha (opcional)" \
        --passwordbox "Senha se o arquivo estiver protegido\n(deixe vazio se não houver):" 10 55 \
        3>&1 1>&2 2>&3)

    # Estimativa de extração: ~2,5× o tamanho do arquivo (conteúdo expandido)
    local detalhe="" necessario=0 arq t est
    while IFS= read -r arq; do
        [ -z "$arq" ] || [ ! -f "$arq" ] && continue
        t=$(tamanho_caminho "$arq")
        t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
        est=$((t * 5 / 2))
        [ "$est" -lt "$t" ] && est=$t
        necessario=$((necessario + est))
        detalhe="${detalhe}${est}|${arq} (estim. extraído)"$'\n'
    done <<< "$itens"
    verificar_espaco_disco "$necessario" "." "Descompactar" "$detalhe" || return

    while IFS= read -r arq; do
        [ -z "$arq" ] || [ ! -f "$arq" ] && continue
        # Recheca por arquivo (vários arquivos grandes em sequência)
        t=$(tamanho_caminho "$arq")
        t=$(echo "$t" | tr -cd '0-9'); t=${t:-0}
        est=$((t * 5 / 2))
        verificar_espaco_disco "$est" "." "Extrair $(basename -- "$arq")" "${est}|${arq}" || {
            echo -e "\033[1;33mPulando restante por falta de espaço.\033[0m"
            break
        }
        extrair_com_senha "$arq" "$senha"
    done <<< "$itens"
    read -r -p "Pressione Enter para continuar..."
}

# Editar arquivo (\$EDITOR ou nano)
editar_selecao() {
    local selecao="$1"
    local arq
    arq=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$' | head -n1)
    [ -z "$arq" ] || [ ! -f "$arq" ] && {
        whiptail --title "Editar" --msgbox "Selecione um arquivo válido." 7 45
        return
    }
    local editor="${EDITOR:-${VISUAL:-}}"
    if [ -z "$editor" ]; then
        if command -v nano &>/dev/null; then editor="nano"
        elif command -v vim &>/dev/null; then editor="vim"
        elif command -v vi &>/dev/null; then editor="vi"
        else
            whiptail --title "Erro" --msgbox "Nenhum editor encontrado (nano/vim).\nDefina \$EDITOR." 8 50
            return
        fi
    fi
    $editor -- "$arq"
}

# Renomear arquivo(s) ou pasta(s)
renomear_selecao() {
    local selecao="$1"
    local itens n
    itens=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$')
    n=$(printf '%s\n' "$itens" | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9'); n=${n:-0}
    [ "$n" -eq 0 ] && {
        whiptail --title "Renomear" --msgbox "Nenhum item selecionado.\nUse TAB/ESPAÇO para marcar." 8 50
        return
    }

    # Um único item: renomear direto
    if [ "$n" -eq 1 ]; then
        local origem nome_atual dir_base novo_nome destino
        origem=$(printf '%s\n' "$itens" | head -n1)
        origem=$(caminho_absoluto "$origem")
        [ ! -e "$origem" ] && {
            whiptail --title "Erro" --msgbox "Item não encontrado:\n$origem" 8 55
            return
        }
        nome_atual=$(basename -- "$origem")
        dir_base=$(dirname -- "$origem")
        novo_nome=$(whiptail --title "Renomear" \
            --inputbox "Nome atual:\n$nome_atual\n\nNovo nome:" 12 70 "$nome_atual" \
            3>&1 1>&2 2>&3)
        [ -z "$novo_nome" ] && return
        # impede path traversal no nome
        novo_nome=$(basename -- "$novo_nome")
        [ "$novo_nome" = "$nome_atual" ] && return
        destino="$dir_base/$novo_nome"
        if [ -e "$destino" ]; then
            whiptail --title "Erro" --msgbox "Já existe um item com esse nome:\n$destino" 9 55
            return
        fi
        if mv -- "$origem" "$destino" 2>/dev/null; then
            ULTIMO_ARQUIVO="$destino"
            registrar_status
            whiptail --title "Renomeado" --msgbox "✓ $nome_atual\n→ $novo_nome" 9 55
        else
            whiptail --title "Erro" --msgbox "Falha ao renomear (permissão?)." 8 45
        fi
        return
    fi

    # Vários itens: prefixo / sufixo / numerar
    local modo
    modo=$(whiptail --title "Renomear $n itens" --menu \
        "Vários itens selecionados. Escolha o modo:" 14 60 4 \
        "1" "Adicionar PREFIXO a todos" \
        "2" "Adicionar SUFIXO (antes da extensão)" \
        "3" "Numerar em sequência (001, 002...)" \
        "0" "Cancelar" \
        3>&1 1>&2 2>&3)
    [ -z "$modo" ] || [ "$modo" = "0" ] && return

    local texto=""
    if [ "$modo" = "1" ] || [ "$modo" = "2" ]; then
        texto=$(whiptail --title "Texto" --inputbox "Digite o texto a aplicar:" 10 55 \
            3>&1 1>&2 2>&3)
        [ -z "$texto" ] && return
    fi

    local ok=0 falha=0
    local i=1
    while IFS= read -r origem; do
        [ -z "$origem" ] && continue
        origem=$(caminho_absoluto "$origem")
        [ ! -e "$origem" ] && { falha=$((falha+1)); continue; }
        local dir_base nome_atual base ext destino novo
        dir_base=$(dirname -- "$origem")
        nome_atual=$(basename -- "$origem")
        if [[ "$nome_atual" == *.* ]] && [ -f "$origem" ]; then
            ext=".${nome_atual##*.}"
            base="${nome_atual%.*}"
        else
            ext=""
            base="$nome_atual"
        fi
        case "$modo" in
            1) novo="${texto}${nome_atual}" ;;
            2) novo="${base}${texto}${ext}" ;;
            3) novo=$(printf "%03d_%s" "$i" "$nome_atual") ;;
        esac
        destino="$dir_base/$novo"
        if [ -e "$destino" ]; then
            echo -e "\033[1;33mPulado (já existe): $novo\033[0m"
            falha=$((falha+1))
        elif mv -- "$origem" "$destino" 2>/dev/null; then
            ok=$((ok+1))
            ULTIMO_ARQUIVO="$destino"
        else
            falha=$((falha+1))
        fi
        i=$((i+1))
    done <<< "$itens"
    registrar_status
    whiptail --title "Renomear" --msgbox "Concluído.\n\n✓ Renomeados: $ok\n✗ Falhas/pulados: $falha" 10 45
}

# Executar script
executar_selecao() {
    local selecao="$1"
    local arq
    arq=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$' | head -n1)
    [ -z "$arq" ] || [ ! -f "$arq" ] && {
        whiptail --title "Executar" --msgbox "Selecione um arquivo." 7 40
        return
    }
    local ext nome
    nome=$(basename -- "$arq")
    ext=$(echo "${nome##*.}" | tr '[:upper:]' '[:lower:]')

    if ! whiptail --title "Executar?" --yesno "Executar:\n$arq\n\nContinuar?" 10 60; then
        return
    fi

    echo -e "\n\033[1;36m▶ Executando: $nome\033[0m\n"
    case "$ext" in
        sh|bash)  bash -- "$arq" ;;
        py|py3)   python3 -- "$arq" 2>/dev/null || python -- "$arq" ;;
        pl)       perl -- "$arq" ;;
        rb)       ruby -- "$arq" ;;
        js)       node -- "$arq" 2>/dev/null || js -- "$arq" ;;
        *)
            if [ -x "$arq" ]; then
                "$arq"
            else
                bash -- "$arq"
            fi
            ;;
    esac
    local rc=$?
    echo ""
    echo -e "\033[1;33mCódigo de saída: $rc\033[0m"
    read -p "Pressione Enter para continuar..."
}

# --- Leitor e conversor de PDF/imagem/vídeo ---
eh_arquivo_imagem() {
    local f="$1" ext
    [ -f "$f" ] || return 1
    ext=$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')
    [[ "$ext" =~ ^(jpg|jpeg|png|bmp|gif|webp|tif|tiff)$ ]]
}

mostrar_imagem_com_pausa() {
    local img="$1"
    [ -f "$img" ] || return 1
    clear
    if command -v chafa >/dev/null 2>&1; then
        chafa --format symbols --size "${COLUMNS:-100}x${LINES:-30}" -- "$img" 2>/dev/null || true
        printf '\nImagem: %s\n' "$img"
        printf '\nPressione Enter para voltar ou Esc para cancelar... '
        local tecla
        IFS= read -r -n1 -s tecla || true
        printf '\n'
        [ "$tecla" = $'\e' ] && return 1
    elif command -v xdg-open >/dev/null 2>&1; then
        local pid tecla
        xdg-open "$img" >/dev/null 2>&1 &
        pid=$!
        printf 'Imagem aberta. Pressione Enter para voltar ou Esc para fechar... '
        IFS= read -r -n1 -s tecla || true
        printf '\n'
        if [ "$tecla" = $'\e' ]; then
            kill "$pid" 2>/dev/null || true
            return 1
        fi
    else
        whiptail --title 'Imagem' --msgbox "Nenhum visualizador disponível. Instale chafa ou use xdg-open." 9 70
    fi
}

selecionar_arquivo_conversao() {
    local titulo="$1" tipo="$2" multi="${3:-0}" lista
    case "$tipo" in
        video) lista=$(find . -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.avi' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.mpg' -o -iname '*.mpeg' \) -printf '%p\n' 2>/dev/null) ;;
        imagem) lista=$(find . -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.bmp' -o -iname '*.gif' -o -iname '*.webp' -o -iname '*.tif' -o -iname '*.tiff' \) -printf '%p\n' 2>/dev/null) ;;
        pdf) lista=$(find . -maxdepth 1 -type f -iname '*.pdf' -printf '%p\n' 2>/dev/null) ;;
        *) lista=$(find . -maxdepth 1 -type f -printf '%p\n' 2>/dev/null) ;;
    esac
    [ -n "$lista" ] || { whiptail --title 'Conversões' --msgbox 'Nenhum arquivo compatível encontrado nesta pasta.' 9 65; return 1; }
    if [ "$multi" -eq 1 ]; then
        printf '%s\n' "$lista" | sed 's|^\./||' | sort | fzf --multi --height=80% --border --prompt="$titulo ❯ " --header='TAB/ESPAÇO: marcar | ENTER: confirmar | ESC: cancelar'
    else
        printf '%s\n' "$lista" | sed 's|^\./||' | sort | fzf --height=80% --border --prompt="$titulo ❯ " --header='ENTER: escolher | ESC: cancelar'
    fi
}

converter_video_video() {
    local src out
    command -v ffmpeg >/dev/null 2>&1 || { whiptail --title 'Conversão de vídeo' --msgbox 'ffmpeg não está instalado.\n\nInstale: sudo apt install ffmpeg' 9 70; return 1; }
    src=$(selecionar_arquivo_conversao 'Vídeo de entrada' video) || return
    [ -f "$src" ] || return
    out=$(whiptail --inputbox 'Arquivo de vídeo de saída (ex.: saida.mp4, saida.avi):' 10 80 "${src%.*}_convertido.mp4" 3>&1 1>&2 2>&3) || return
    [ -n "$out" ] || return
    if ffmpeg -hide_banner -i "$src" -y "$out" >/tmp/eazy-ffmpeg.log 2>&1; then
        whiptail --title 'Conversão de vídeo' --msgbox "Vídeo convertido:\n$out" 9 70
    else
        whiptail --title 'Conversão de vídeo' --msgbox "Falha na conversão.\n\n$(tail -n 8 /tmp/eazy-ffmpeg.log)" 14 80
    fi
}

converter_imagem_imagem() {
    local src out
    if command -v magick >/dev/null 2>&1; then :; elif command -v convert >/dev/null 2>&1; then :; else
        whiptail --title 'Conversão de imagem' --msgbox 'ImageMagick não está instalado.\n\nInstale: sudo apt install imagemagick' 9 70; return 1
    fi
    src=$(selecionar_arquivo_conversao 'Imagem de entrada' imagem) || return
    [ -f "$src" ] || return
    out=$(whiptail --inputbox 'Imagem de saída (ex.: saida.png, saida.jpg):' 10 80 "${src%.*}_convertida.png" 3>&1 1>&2 2>&3) || return
    [ -n "$out" ] || return
    if command -v magick >/dev/null 2>&1; then magick "$src" "$out" >/dev/null 2>&1; else convert "$src" "$out" >/dev/null 2>&1; fi
    if [ -f "$out" ]; then whiptail --title 'Conversão de imagem' --msgbox "Imagem convertida:\n$out" 9 70; else whiptail --title 'Conversão de imagem' --msgbox 'Falha na conversão da imagem.' 9 60; fi
}

converter_imagem_pdf() {
    local out
    local -a imagens=()
    command -v img2pdf >/dev/null 2>&1 || { whiptail --title 'Imagens → PDF' --msgbox 'img2pdf não está instalado.\n\nInstale: sudo apt install img2pdf' 9 70; return 1; }
    mapfile -t imagens < <(selecionar_arquivo_conversao 'Selecione imagens para o PDF' imagem 1)
    [ "${#imagens[@]}" -gt 0 ] || return
    out=$(whiptail --inputbox 'Nome do PDF de saída:' 10 75 "$(pwd)/convertido.pdf" 3>&1 1>&2 2>&3) || return
    [ -n "$out" ] || return
    if img2pdf "${imagens[@]}" -o "$out" >/dev/null 2>&1; then
        whiptail --title 'Imagens → PDF' --msgbox "PDF criado com ${#imagens[@]} imagem(ns):\n$out" 10 75
    else
        whiptail --title 'Imagens → PDF' --msgbox 'Falha ao criar o PDF.' 9 60
    fi
}

converter_pdf_imagem() {
    local pdf
    pdf=$(selecionar_arquivo_conversao 'Selecione o PDF' pdf) || return
    [ -f "$pdf" ] || return
    pdf_para_imagens "$pdf"
}

# --- Leitor e conversor de PDF ---
eh_arquivo_pdf() {
    local f="$1" mime
    [ -f "$f" ] || return 1
    [[ "${f##*.}" =~ ^[Pp][Dd][Ff]$ ]] && return 0
    if command -v file >/dev/null 2>&1; then
        mime=$(file -b --mime-type -- "$f" 2>/dev/null || true)
        [ "$mime" = "application/pdf" ] && return 0
    fi
    return 1
}

pdf_exigir_ferramenta() {
    local cmd="$1" pacote="$2"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        whiptail --title "Ferramenta ausente" --msgbox "$cmd não está instalado.\n\nInstale com:\nsudo apt install $pacote" 10 70
        return 1
    fi
}

pdf_ler_texto() {
    local pdf="$1" out
    pdf_exigir_ferramenta pdftotext poppler-utils || return 1
    out="${pdf%.*}.txt"
    if pdftotext -layout -- "$pdf" "$out" 2>/dev/null; then
        mostrar_texto "$out"
    else
        whiptail --title "PDF" --msgbox "Não foi possível extrair texto de:\n$pdf" 9 70
    fi
}

pdf_para_html() {
    local pdf="$1" outdir base
    pdf_exigir_ferramenta pdftohtml poppler-utils || return 1
    base="${pdf%.*}"
    outdir=$(whiptail --inputbox "Pasta de saída do HTML:" 10 70 "${base}_html" 3>&1 1>&2 2>&3) || return
    [ -n "$outdir" ] || return
    mkdir -p -- "$outdir"
    if pdftohtml -s -noframes -- "$pdf" "$outdir/$(basename "$base").html" >/dev/null 2>&1; then
        whiptail --title "PDF → HTML" --msgbox "HTML criado em:\n$outdir" 9 70
    else
        whiptail --title "PDF → HTML" --msgbox "Falha ao converter o PDF para HTML." 9 70
    fi
}

pdf_para_imagens() {
    local pdf="$1" outdir base
    pdf_exigir_ferramenta pdftoppm poppler-utils || return 1
    base="${pdf%.*}"
    outdir=$(whiptail --inputbox "Pasta de saída das imagens:" 10 70 "${base}_img" 3>&1 1>&2 2>&3) || return
    [ -n "$outdir" ] || return
    mkdir -p -- "$outdir"
    if pdftoppm -png -- "$pdf" "$outdir/pagina" >/dev/null 2>&1; then
        whiptail --title "PDF → Imagens" --msgbox "Imagens PNG criadas em:\n$outdir" 9 70
    else
        whiptail --title "PDF → Imagens" --msgbox "Falha ao converter o PDF para imagens." 9 70
    fi
}

imagens_para_pdf() {
    local dir out
    local -a imagens=()
    pdf_exigir_ferramenta img2pdf img2pdf || return 1
    dir=$(whiptail --inputbox "Pasta com imagens (PNG/JPG):" 10 70 "$(pwd)" 3>&1 1>&2 2>&3) || return
    [ -d "$dir" ] || { whiptail --title "Imagens → PDF" --msgbox "Pasta não encontrada:\n$dir" 9 65; return 1; }
    mapfile -d '' imagens < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) -print0 | sort -z)
    [ "${#imagens[@]}" -gt 0 ] || { whiptail --title "Imagens → PDF" --msgbox "Nenhuma imagem PNG/JPG encontrada em:\n$dir" 9 70; return 1; }
    out=$(whiptail --inputbox "Nome do PDF de saída:" 10 70 "$dir/convertido.pdf" 3>&1 1>&2 2>&3) || return
    [ -n "$out" ] || return
    if img2pdf "${imagens[@]}" -o "$out" >/dev/null 2>&1; then
        whiptail --title "Imagens → PDF" --msgbox "PDF criado com ${#imagens[@]} imagem(ns):\n$out" 10 75
    else
        whiptail --title "Imagens → PDF" --msgbox "Falha ao criar o PDF." 9 60
    fi
}

menu_conversoes() {
    local opcao
    opcao=$(whiptail --title 'Conversões multimídia' --menu 'Escolha o tipo de conversão:' 18 82 8 \
        '1' 'Vídeo → Vídeo (ffmpeg: MP4/AVI/MKV...)' \
        '2' 'Imagem → Imagem (JPG/PNG/BMP/JPEG...)' \
        '3' 'Imagens → PDF (img2pdf)' \
        '4' 'PDF → Imagens PNG (pdftoppm)' \
        '5' 'PDF → Texto / HTML' \
        '0' 'Voltar' 3>&1 1>&2 2>&3) || return
    case "$opcao" in
        1) converter_video_video ;;
        2) converter_imagem_imagem ;;
        3) converter_imagem_pdf ;;
        4) converter_pdf_imagem ;;
        5)
            local pdf escolha
            pdf=$(whiptail --inputbox 'Arquivo PDF:' 10 70 '' 3>&1 1>&2 2>&3) || return
            eh_arquivo_pdf "$pdf" || return
            escolha=$(whiptail --title 'PDF' --menu 'Conversão:' 12 60 3 '1' 'PDF → texto' '2' 'PDF → HTML' '0' 'Voltar' 3>&1 1>&2 2>&3) || return
            case "$escolha" in 1) pdf_ler_texto "$pdf" ;; 2) pdf_para_html "$pdf" ;; esac
            ;;
    esac
}

menu_pdf() {
    local pdf="$1" opcao
    eh_arquivo_pdf "$pdf" || return 1
    opcao=$(whiptail --title "PDF — $(basename "$pdf")" --menu "Escolha uma operação:" 15 78 6 \
        "1" "Ler texto no terminal" \
        "2" "Converter PDF → HTML" \
        "3" "Converter PDF → imagens PNG" \
        "4" "Abrir com leitor gráfico do sistema" \
        "0" "Voltar" 3>&1 1>&2 2>&3) || return
    case "$opcao" in
        1) pdf_ler_texto "$pdf" ;;
        2) pdf_para_html "$pdf" ;;
        3) pdf_para_imagens "$pdf" ;;
        4) command -v xdg-open >/dev/null 2>&1 && xdg-open "$pdf" >/dev/null 2>&1 || whiptail --title "PDF" --msgbox "Instale um leitor gráfico ou use a opção de leitura de texto." 9 70 ;;
    esac
}

# Menu de ações sobre a seleção (como INSERT, mas escolhe o que fazer)
