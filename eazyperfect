    : > "${DUP_FILE:-/dev/null}" 2>/dev/null || true
    : > "${DUP_SELECTED_FILE:-/dev/null}" 2>/dev/null || true
    : > "${DUP_FIXED_FILE:-/dev/null}" 2>/dev/null || true
