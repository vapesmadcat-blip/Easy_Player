    [ -s "$DUP_LISTA" ] || return 1
    mkdir -p "$(dirname "$DUP_FILE")" 2>/dev/null || true
    cp -f -- "$DUP_LISTA" "$DUP_FILE" 2>/dev/null || return 1
    return 0
}

eazy_dup_lista_tem_itens() {
    [ -n "${DUP_LISTA:-}" ] && [ -s "$DUP_LISTA" ]
}

eazy_dup_limpar_lista() {
