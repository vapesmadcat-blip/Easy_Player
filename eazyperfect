EXT_TODAS="${TODAS_EXT[*]}"
EXT_BUSCA=""
EXT_DUP=""
BUSCA_TAM_MIN=""   # bytes; vazio = sem mínimo
BUSCA_TAM_MAX=""   # bytes; vazio = sem máximo
BUSCA_TAM_LABEL="" # texto amigável p/ o prompt
BUSCA_CONTEUDO=""  # texto a buscar dentro dos arquivos (grep -i)

atualizar_fila_atual
touch "$PLAYLIST_1" "$PLAYLIST_2" "$PLAYLIST_3"
touch "$DOWNLOAD_QUEUE"
touch "$DOWNLOAD_PASSWORDS"
touch "$SELECTED_FILE"
touch "$HISTORY_FILE"
export TMP_FILE PLAYLIST_FILE DOWNLOAD_QUEUE DOWNLOAD_PASSWORDS SELECTED_FILE DUP_FILE DUP_SELECTED_FILE DUP_FIXED_FILE DUP_MANUAL_FILE CONFIG_DIR
LISTA_FZF_FILE="/tmp/eazy_lista_fzf_$$"
export LISTA_FZF_FILE

# Linha de navegação (.. / Voltar) — nunca filtrada, nunca selecionável nas ações
eazy_eh_navegacao() {
    local linha="$1"
    local campo2 campo_fim
    campo2=$(printf '%s\n' "$linha" | awk -F '\t' '{print $2}')
    campo_fim=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    [[ "$campo_fim" == ".." ]] && return 0
    [[ "$campo2" == *'◀ Voltar'* ]] && return 0
    [[ "$campo2" == *'📁 ..'* ]] && return 0
    [[ "$campo2" == *'📁  ..'* ]] && return 0
    return 1
}

# Remove linhas de navegação de uma seleção (TAB/ctrl-a/etc.)
eazy_sem_navegacao() {
    local linha
    while IFS= read -r linha || [ -n "$linha" ]; do
        [ -z "$linha" ] && continue
        eazy_eh_navegacao "$linha" && continue
        printf '%s\n' "$linha"
    done
}

# Seleção normal persistente entre diretórios.
# SELECTED_FILE contém arquivos absolutos; SELECTED_DIRS_FILE contém diretórios
# escolhidos diretamente e serve para distinguir Enter simples de seleção explícita.
SELECTED_DIRS_FILE="${SELECTED_FILE}.dirs"
SELECTED_LOCAL_FILE="${SELECTED_FILE}.local"
touch "$SELECTED_DIRS_FILE" "$SELECTED_LOCAL_FILE" 2>/dev/null || true
export SELECTED_DIRS_FILE SELECTED_LOCAL_FILE

arquivo_selecao_global() {
    local linha="$1" p
    p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
    [ -n "$p" ] || return 1
    eazy_eh_navegacao "$linha" && return 1
    caminho_absoluto "$p"
}

adicionar_selecao_global() {
    local p="$1"
    [ -e "$p" ] || return 0
    grep -Fxq -- "$p" "$SELECTED_FILE" 2>/dev/null || printf '%s\n' "$p" >> "$SELECTED_FILE"
}

remover_selecao_global() {
    local p="$1" tmp="${SELECTED_FILE}.tmp"
    grep -Fxv -- "$p" "$SELECTED_FILE" 2>/dev/null > "$tmp" || : > "$tmp"
    mv -f -- "$tmp" "$SELECTED_FILE"
}

expandir_diretorio_selecao() {
    local dir="$1" p
    [ -d "$dir" ] || return 0
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    grep -Fxq -- "$dir" "$SELECTED_DIRS_FILE" 2>/dev/null || printf '%s\n' "$dir" >> "$SELECTED_DIRS_FILE"
    while IFS= read -r -d '' p; do
        adicionar_selecao_global "$p"
    done < <(find "$dir" -type f -print0 2>/dev/null)
}

remover_selecao_diretorio() {
    local dir="$1" tmp="${SELECTED_FILE}.tmp" dirs_tmp="${SELECTED_DIRS_FILE}.tmp"
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    grep -Fxv -- "$dir" "$SELECTED_DIRS_FILE" 2>/dev/null > "$dirs_tmp" || : > "$dirs_tmp"
    mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [[ "$p" == "$dir"/* ]] || printf '%s\n' "$p"
    done < "$SELECTED_FILE" > "$tmp"
    mv -f -- "$tmp" "$SELECTED_FILE"
}

adicionar_selecao_local() {
    local p="$1" tmp="${SELECTED_LOCAL_FILE}.tmp"
    [ -z "$p" ] && return 0
    p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    grep -Fxq -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null || printf '%s\n' "$p" >> "$SELECTED_LOCAL_FILE"
}

remover_selecao_local() {
    local p="$1" tmp="${SELECTED_LOCAL_FILE}.tmp"
    p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
    grep -Fxv -- "$p" "$SELECTED_LOCAL_FILE" 2>/dev/null > "$tmp" || : > "$tmp"
    mv -f -- "$tmp" "$SELECTED_LOCAL_FILE"
}

reconstruir_selecao_local() {
    local dir="$(pwd -P)" p p_abs
    : > "$SELECTED_LOCAL_FILE"
    while IFS= read -r p; do
        [ -f "$p" ] || continue
        p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        [ "$(dirname -- "$p_abs")" = "$dir" ] && adicionar_selecao_local "$p_abs"
    done < "$SELECTED_FILE"
    while IFS= read -r p; do
        [ -d "$p" ] || continue
        p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        [ "$(dirname -- "$p_abs")" = "$dir" ] && adicionar_selecao_local "$p_abs"
    done < "$SELECTED_DIRS_FILE"
}

eazy_toggle_global_item() {
    local linha="$1" p
    p=$(arquivo_selecao_global "$linha") || return 0
    if [ -d "$p" ]; then
        p=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        if grep -Fxq -- "$p" "$SELECTED_DIRS_FILE" 2>/dev/null; then
            remover_selecao_diretorio "$p"
            remover_selecao_local "$p"
        else
            expandir_diretorio_selecao "$p"
            adicionar_selecao_local "$p"
        fi
    elif [ -f "$p" ]; then
        if grep -Fxq -- "$p" "$SELECTED_FILE" 2>/dev/null; then
            remover_selecao_global "$p"
            remover_selecao_local "$p"
        else
            adicionar_selecao_global "$p"
            adicionar_selecao_local "$p"
        fi
    fi
}

# Varre cada linha que o fzf devolveu como selecionada.
# Exclusivo da seleção normal: não usa nem toca em DUP_SELECTED_FILE.
eazy_commit_fzf_selected() {
    local linha p
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        if [ -d "$p" ]; then
            expandir_diretorio_selecao "$p"
        elif [ -f "$p" ]; then
            adicionar_selecao_global "$p"
        fi
    done
}

eazy_select_visible_global() {
    local linha p
    [ -f "$LISTA_FZF_FILE" ] || return 0
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        if [ -d "$p" ]; then
            expandir_diretorio_selecao "$p"
        elif [ -f "$p" ]; then
            adicionar_selecao_global "$p"
        fi
    done < "$LISTA_FZF_FILE"
}

eazy_clear_local_selection() {
    local dir="$(pwd -P)" tmp="${SELECTED_FILE}.tmp" p
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [ "$(dirname -- "$p")" = "$dir" ] || printf '%s\n' "$p"
    done < "$SELECTED_FILE" > "$tmp"
    mv -f -- "$tmp" "$SELECTED_FILE"
    local dirs_tmp="${SELECTED_DIRS_FILE}.tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        [[ "$p" == "$dir" || "$p" == "$dir"/* ]] || printf '%s\n' "$p"
    done < "$SELECTED_DIRS_FILE" > "$dirs_tmp"
    mv -f -- "$dirs_tmp" "$SELECTED_DIRS_FILE"
}

# Reconstrói a seleção do diretório atual a partir do conjunto devolvido pelo fzf.
# Preserva seleções de outras pastas e não acessa o estado de duplicados.
eazy_remark_local_selection() {
    local linha p p_abs dir
    dir=$(pwd -P)
    eazy_clear_local_selection
    : > "$SELECTED_LOCAL_FILE"
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(arquivo_selecao_global "$linha") || continue
        p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
        if [ -d "$p_abs" ]; then
            [ "$(dirname -- "$p_abs")" = "$dir" ] || continue
            expandir_diretorio_selecao "$p_abs"
            adicionar_selecao_local "$p_abs"
        elif [ -f "$p_abs" ]; then
            [ "$(dirname -- "$p_abs")" = "$dir" ] || continue
            adicionar_selecao_global "$p_abs"
            adicionar_selecao_local "$p_abs"
        fi
    done
}

# Monta lista de reprodução para Alt+Enter:
# usa a multi-seleção do fzf + a seleção persistente (SELECTED_FILE),
# porque reload (Ctrl-A/X etc.) apaga as marcas do fzf mas mantém a persistência.
eazy_playlist_alt_enter() {
    local dest="$1" linha p p_abs
    : > "$dest"
    [ -n "$dest" ] || return 1
    # 1) itens devolvidos pelo fzf (multi-select da sessão)
    while IFS= read -r linha; do
        [ -z "$linha" ] && continue
        p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
        [ -z "$p" ] && continue
        eazy_eh_navegacao "$linha" 2>/dev/null && continue
        [[ "$p" =~ \.\.$ ]] && continue
        p_abs=$(caminho_absoluto "$p" 2>/dev/null || printf '%s' "$p")
        p_abs=$(readlink -f -- "$p_abs" 2>/dev/null || printf '%s' "$p_abs")
        [ -f "$p_abs" ] || continue
        grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
    done
    # 2) seleção persistente global (fonte da verdade após reload)
    if [ -f "${SELECTED_FILE:-}" ]; then
        while IFS= read -r p; do
            [ -z "$p" ] && continue
            p_abs=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
            [ -f "$p_abs" ] || continue
            grep -Fxq -- "$p_abs" "$dest" 2>/dev/null || printf '%s\n' "$p_abs" >> "$dest"
        done < "$SELECTED_FILE"
    fi
}

# Expande a seleção com a persistência (mesma regra do Alt+Enter).
# INSERT, Del, Ctrl-K/Y/U/E usam isto — não altera Duplicados.
eazy_expandir_escolha_acoes() {
    local entrada="$1" tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/eazy-sel-acoes.XXXXXX") || {
        printf '%s\n' "$entrada"
        return 1
    }
    printf '%s\n' "$entrada" | eazy_playlist_alt_enter "$tmp"
    if [ -s "$tmp" ]; then
        cat "$tmp"
    else
        printf '%s\n' "$entrada"
    fi
    rm -f "$tmp"
}

eazy_clear_global_confirm() {
    if whiptail --title "Limpar seleção global" --yesno \
        "Zerar toda a seleção global?\n\nTodos os arquivos marcados em todos os diretórios serão desmarcados." 10 65; then
        : > "$SELECTED_FILE"
        : > "$SELECTED_DIRS_FILE"
    fi
}

# Inverte a seleção persistente dos itens visíveis (respeita filtro {q}).
# Não mexe em Duplicados. Usado pelo Ctrl-R do navegador normal.
eazy_invert_visible_global() {
    local q="${1:-}" line
    [ "${MODO_DUP:-0}" -eq 1 ] && return 0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        eazy_toggle_global_item "$line"
    done < <(eazy_lista_filtrada "$q")
}

# F12 (fora de duplicados): monta bind de load que reaplica multi-select
# manual do fzf nos itens já persistentes do diretório/filtro atual.
# Visual: ✓ no texto (persistente) + marcador do fzf (manual).
eazy_build_preselect_load_bind() {
    local q="${1:-}" cursor="${2:-1}" line p p_abs pos=0 actions="" final_pos
    cursor=$(printf '%s' "$cursor" | tr -cd '0-9')
    cursor=${cursor:-1}
    [ "$cursor" -lt 1 ] && cursor=1
    reconstruir_selecao_local
    while IFS= read -r line; do
        pos=$((pos + 1))
        p=$(printf '%s\n' "$line" | awk -F '\t' '{print $NF}')
        [ -n "$p" ] || continue
        eazy_eh_navegacao "$line" && continue
        p_abs=$(caminho_absoluto "$p" 2>/dev/null || printf '%s' "$p")
        p_abs=$(readlink -f -- "$p_abs" 2>/dev/null || printf '%s' "$p_abs")
        if grep -Fxq -- "$p_abs" "${SELECTED_LOCAL_FILE:-/dev/null}" 2>/dev/null \
            || grep -Fxq -- "$p_abs" "${SELECTED_DIRS_FILE:-/dev/null}" 2>/dev/null \
            || grep -Fxq -- "$p_abs" "${SELECTED_FILE:-/dev/null}" 2>/dev/null; then
            if [ -n "$actions" ]; then
                actions="${actions}+pos(${pos})+select"
            else
                actions="pos(${pos})+select"
            fi
        fi
    done < <(eazy_lista_filtrada "$q")
    final_pos=$cursor
    [ "$pos" -gt 0 ] && [ "$final_pos" -gt "$pos" ] && final_pos=$pos
    if [ -n "$actions" ]; then
        printf 'load:%s+pos(%s)' "$actions" "$final_pos"
    else
        printf 'load:pos(%s)' "$final_pos"
    fi
}

# Lista para o fzf: navegação sempre no topo; filtro só no restante
# Highlight amarelo nas letras que batem com o filtro (como o fzf nativo fazia)
eazy_lista_filtrada() {
    local q="${1:-}"
    local f="${LISTA_FZF_FILE:-}"
    [ -z "$f" ] || [ ! -f "$f" ] && return 0

    # 1) sempre as linhas de navegação
    awk -F '\t' '
        $NF == ".." { print; next }
        $2 ~ /◀ Voltar/ { print; next }
        $2 ~ /📁 \.\./ { print; next }
    ' "$f"

    # 2) demais itens — filtro + highlight (verde base + amarelo no match)
    awk -F '\t' -v q="$q" -v OFS='\t' -v selected_file="${SELECTED_FILE:-}" -v selected_dirs_file="${SELECTED_DIRS_FILE:-}" -v base_dir="$(pwd -P)" '
    BEGIN {
        # Match: amarelo brilhante no fundo preto do terminal
        HL = "\033[1;93m"
        OFF = "\033[0m"
        while (selected_file != "" && (getline p < selected_file) > 0) sel[p] = 1
        close(selected_file)
        while (selected_dirs_file != "" && (getline p < selected_dirs_file) > 0) dirs[p] = 1
        close(selected_dirs_file)
    }
    function path_abs(p,    x) {
        if (p ~ /^\//) return p
        x = p
        sub(/^\.\//, "", x)
        return base_dir "/" x
    }
    function is_selected(p,    a) {
        a = path_abs(p)
        return ((a in sel) || (a in dirs))
    }
    function mark_row(p, s) {
        if (is_selected(p)) return "✓ " s
        return s
    }
    function strip_ansi(s) {
        gsub(/\033\[[0-9;]*m/, "", s)
        return s
    }
    function lower(s) { return tolower(s) }
    # Cor base do item (verde, ciano, etc.) a partir do campo original
    function cor_base(s) {
        if (s ~ /32m/) return "\033[1;32m"   # verde
        if (s ~ /36m/) return "\033[1;36m"   # ciano
        if (s ~ /35m/) return "\033[1;35m"   # magenta
        if (s ~ /34m/) return "\033[1;34m"   # azul
        if (s ~ /33m/) return "\033[1;33m"   # amarelo base
        if (s ~ /31m/) return "\033[1;31m"   # vermelho
        return "\033[0m"
    }
    function hi_tok(plain, tok, base,    lp, lt, out, i, pre, mid, rest) {
        if (tok == "" || plain == "") return plain
        lp = lower(plain)
        lt = lower(tok)
        out = ""
        rest = plain
        while ((i = index(lp, lt)) > 0) {
            pre = substr(rest, 1, i - 1)
            mid = substr(rest, i, length(tok))
            # trecho normal na cor base (ex: verde) + match em amarelo + volta ao base
            out = out base pre OFF HL mid OFF base
            rest = substr(rest, i + length(tok))
            lp = lower(rest)
        }
        return out rest
    }
    function hi_all(plain, base,    n, i, s) {
        s = plain
        n = split(q, toks, /[[:space:]]+/)
        for (i = 1; i <= n; i++) {
            if (toks[i] == "") continue
            s = hi_tok(s, toks[i], base)
        }
        return base s OFF
    }
    $NF == ".." { next }
    $2 ~ /◀ Voltar/ { next }
    $2 ~ /📁 \.\./ { next }
    {
        if (q == "") { $2 = mark_row($NF, $2); print; next }
        nome_plain = strip_ansi($2)
        path_plain = strip_ansi($NF)
        hay = lower(nome_plain) " " lower(path_plain)
        n = split(lower(q), toks, /[[:space:]]+/)
        ok = 1
        for (i = 1; i <= n; i++) {
            if (toks[i] == "") continue
            if (index(hay, toks[i]) == 0) { ok = 0; break }
        }
        if (!ok) next
        base = cor_base($2)
        $2 = mark_row($NF, hi_all(nome_plain, base))
        print
    }
    ' "$f"
}
