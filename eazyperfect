    local selecao="$1"
    local n
    n=$(printf '%s\n' "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$' | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9'); n=${n:-0}
    if [ "$n" -eq 0 ]; then
        whiptail --title "Ações" --msgbox "Nada selecionado.\nUse TAB/ESPAÇO para marcar arquivos." 8 50
        return
    fi

    local acao
    acao=$(whiptail --title "Ações ($n item(ns))" --menu \
        "O que fazer com a seleção?" 19 58 10 \
        "1" "▶  Tocar / Abrir" \
        "2" "📦 Compactar (zip/7z + senha)" \
        "3" "📂 Extrair / Descompactar" \
        "4" "✏️  Editar (editor de texto)" \
        "5" "⚡ Executar script" \
        "6" "🏷  Renomear" \
        "7" "📋 Copiar para pasta..." \
        "8" "📁 Mover para pasta..." \
        "9" "➕ Adicionar à Fila (INSERT)" \
        "M" "🛠️  Manutenção" \
        "P" "🔒 Proteção" \
        "C" "🔄 Conversões" \
        "S" "🖥️  Sistema" \
        "H" "💿 HD / Disco" \
        "A" "🔊 Som / Áudio" \
        "V" "🎬 Vídeo" \
        "W" "💾 SWAP" \
        "Z" "🗂️  Dirs Vazios" \
        "0" "Cancelar" \
        3>&1 1>&2 2>&3)
    [ -z "$acao" ] || [ "$acao" = "0" ] && return

    case "$acao" in
        S)
            # Sistema
            menu_manutencao_sistema
            ;;
        H)
            # HD/Disco
            menu_manutencao_sistema  # Usa o mesmo menu (opção 3 é análise)
            ;;
        A)
            # Som/Áudio
            menu_gerenciar_som
            ;;
        V)
            # Vídeo
            menu_otimizar_video
            ;;
        W)
            # SWAP
            menu_gerenciar_swap
            ;;
        Z)
            # Diretórios Vazios
            limpar_vazios "$(pwd)"
            ;;
        M)
            menu_manutencao
            ;;
        C)
            menu_conversoes
            ;;
        P)
            # Proteção com senha
            op=$(whiptail --title "🔒 Proteção" --menu "" 10 50 3 \
                "1" "Proteger pasta" \
                "2" "Ver protegidas" \
                "0" "Cancelar" \
                3>&1 1>&2 2>&3)
            case "$op" in
                1)
                    senha=$(whiptail --passwordbox "Senha:" 9 50 3>&1 1>&2 2>&3)
                    if [ -n "$senha" ]; then
                        hash=$(echo -n "$senha" | sha256sum | cut -d' ' -f1)
                        echo "$(pwd -P):$hash" >> "$PASTA_PROTEGIDA_CONFIG"
                        whiptail --title "✓" --msgbox "Protegida!" 8 50
                    fi
                    ;;
                2)
                    [ -f "$PASTA_PROTEGIDA_CONFIG" ] && whiptail --textbox "$PASTA_PROTEGIDA_CONFIG" 12 70
                    ;;
            esac
            ;;
        1)
            # Tocar: reutiliza lógica de multi-seleção
            local playlist_sel="/tmp/eazy_sel_play_$$"
            : > "$playlist_sel"
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                p=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$p" ] || [[ "$p" =~ \.\.$ ]] && continue
                p_abs=$(caminho_absoluto "$p")
                [ -f "$p_abs" ] && printf '%s\n' "$p_abs" >> "$playlist_sel"
            done <<< "$selecao"
            if [ -s "$playlist_sel" ]; then
                total=$(grep -c '^' "$playlist_sel")
                if [ "$total" -gt 1 ]; then
                    ULTIMO_ARQUIVO=$(tail -n1 "$playlist_sel")
                    registrar_status
                    tocar_lista "$playlist_sel"
                else
                    tocado=$(head -n1 "$playlist_sel")
                    ULTIMO_ARQUIVO="$tocado"
                    registrar_status
                    if eh_arquivo_pdf "$tocado"; then
                        menu_pdf "$tocado"
                    elif eh_arquivo_texto "$tocado"; then
                        mostrar_texto "$tocado"
                    elif eh_arquivo_imagem "$tocado"; then
                        mostrar_imagem_com_pausa "$tocado"
                    else
                        tocar_arquivo "$tocado"
                    fi
                fi
            fi
            rm -f "$playlist_sel"
            ;;
        2) compactar_selecao "$selecao" ;;
        3) descompactar_selecao "$selecao" ;;
        4) editar_selecao "$selecao" ;;
        5) executar_selecao "$selecao" ;;
        6) renomear_selecao "$selecao" ;;
        7) copiar_arquivos "$selecao" ;;
        8) mover_arquivos "$selecao" ;;
        9)
            # INSERT
            quantidade_adicionada=0
            while IFS= read -r linha; do
                [ -z "$linha" ] && continue
                item=$(printf '%s\n' "$linha" | awk -F '\t' '{print $NF}')
                [ -z "$item" ] || [[ "$item" =~ \.\.$ ]] && continue
                item_abs=$(caminho_absoluto "$item")
                if ! grep -Fxq -- "$item_abs" "$PLAYLIST_FILE" 2>/dev/null; then
                    printf '%s\n' "$item_abs" >> "$PLAYLIST_FILE"
                    quantidade_adicionada=$((quantidade_adicionada + 1))
                fi
            done <<< "$selecao"
            total_fila=$(grep -c '^' "$PLAYLIST_FILE" 2>/dev/null || echo 0)
            whiptail --title "Fila" --msgbox "Adicionados: $quantidade_adicionada\nTotal na fila: $total_fila" 9 45
            ;;
    esac
    printf '\n'
    read -r -p "Pressione Enter para voltar ao menu de ações..." _ || true
}

# Copia arquivos selecionados para um destino
# Navegador de destino: lista pastas + "aqui" + "criar pasta" + digitar caminho
# $1 = título da ação (Copiar / Mover)  $2 = qtd itens
# Imprime o caminho escolhido em stdout; vazio = cancelou
escolher_destino() {
    local titulo="${1:-Destino}"
    local nitens="${2:-0}"
    local preferido="${3:-}"
    local cursor dir escolha nome nova dig
    cursor="$(pwd)"
    [ -d "$preferido" ] && cursor="$(cd -- "$preferido" && pwd -P)"

    while true; do
        dir="$cursor"
        # Monta lista: ações especiais + subpastas
        escolha=$(
            {
                printf '%s\n' "✅  ${titulo} AQUI  →  $dir"
                printf '%s\n' "📁  Criar nova pasta aqui…"
                printf '%s\n' "⌨️   Digitar caminho…"
                if [ "$dir" != "/" ]; then
                    printf '%s\n' "⬆   ..  (subir)"
                fi
                # Subdiretórios (não ocultos primeiro, depois todos legíveis)
                find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null | LC_ALL=C sort
                find "$dir" -mindepth 1 -maxdepth 1 -type d -name '.*' -printf '%f\n' 2>/dev/null | LC_ALL=C sort
            } | fzf --prompt="$titulo ($nitens)  $dir ❯ " \
                    --header="Enter: abrir pasta | ações no topo | Esc: cancelar" \
                    --layout=reverse --border=rounded --height=80% \
                    --info=inline --no-multi
        ) || return 1

        [ -z "$escolha" ] && return 1

        case "$escolha" in
            "✅"*)
                printf '%s\n' "$dir"
                return 0
                ;;
            "📁"*)
                nova=$(whiptail --title "Nova pasta" \
                    --inputbox "Nome da pasta em:\n$dir" 10 60 \
                    3>&1 1>&2 2>&3) || continue
                [ -z "$nova" ] && continue
                # Remove barras do nome
                nova=$(printf '%s' "$nova" | tr -d '/')
                if mkdir -p -- "$dir/$nova" 2>/dev/null; then
                    cursor="$dir/$nova"
                else
                    whiptail --title "Erro" --msgbox "Não foi possível criar:\n$dir/$nova" 9 55
                fi
                ;;
            "⌨️"*)
                dig=$(whiptail --title "Caminho de destino" \
                    --inputbox "Digite o caminho completo:" 10 70 "$dir" \
                    3>&1 1>&2 2>&3) || continue
                [ -z "$dig" ] && continue
                dig="${dig/#\~/$HOME}"
                if [ -d "$dig" ]; then
                    cursor=$(cd -- "$dig" && pwd -P)
                else
                    if whiptail --title "Pasta não existe" --yesno "Criar e usar?\n$dig" 9 60; then
                        mkdir -p -- "$dig" 2>/dev/null || {
                            whiptail --title "Erro" --msgbox "Falha ao criar pasta." 8 40
                            continue
                        }
                        cursor=$(cd -- "$dig" && pwd -P)
                    fi
                fi
                ;;
            "⬆"*|..)
                cursor=$(cd -- "$dir/.." && pwd -P)
                ;;
            *)
                # Nome de subpasta
                nome="$escolha"
                if [ -d "$dir/$nome" ]; then
                    cursor=$(cd -- "$dir/$nome" && pwd -P)
                fi
                ;;
        esac
    done
}

copiar_arquivos() {
    local selecao="$1"
    local dest itens n
    itens=$(echo "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$')
    n=$(echo "$itens" | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9')
    n=${n:-0}
    [ "$n" -eq 0 ] && {
        whiptail --title "Copiar" --msgbox "Nenhum arquivo selecionado.\nUse TAB/ESPAÇO para marcar." 8 50
        return
    }

    local ultimo_destino=""
    [ -s "$LAST_COPY_DEST_FILE" ] && ultimo_destino=$(head -n1 "$LAST_COPY_DEST_FILE")
    dest=$(escolher_destino "Copiar" "$n" "$ultimo_destino") || return
    [ -z "$dest" ] || [ ! -d "$dest" ] && return
    printf '%s\n' "$dest" > "$LAST_COPY_DEST_FILE"

    local detalhe necessario
    detalhe=$(printf '%s\n' "$itens" | montar_detalhe_espaco)
    necessario=$(printf '%s\n' "$itens" | somar_selecao_bytes)
    verificar_espaco_disco "$necessario" "$dest" "Copiar" "$detalhe" || return

    echo -e "\n\033[1;36m📋 Copiando $n item(ns) → $dest\033[0m"
    local ok=0 falha=0
    while IFS= read -r item; do
        [ -z "$item" ] && continue
        item_abs=$(caminho_absoluto "$item")
        if cp -a -- "$item_abs" "$dest/" 2>/dev/null; then
            echo -e "  \033[1;32m✓\033[0m $(basename "$item_abs")"
            ok=$((ok + 1))
        else
            echo -e "  \033[1;31m✗\033[0m $(basename "$item_abs")"
            falha=$((falha + 1))
        fi
    done <<< "$itens"
    echo -e "\033[1;32mCopiados: $ok\033[0m | \033[1;31mFalhas: $falha\033[0m"
    sleep 1.5
}

# Move arquivos selecionados para um destino
mover_arquivos() {
    local selecao="$1"
    local dest itens n
    itens=$(echo "$selecao" | awk -F '\t' 'NF {print $NF}' | grep -v '\.\.$')
    n=$(echo "$itens" | grep -c '^' 2>/dev/null || echo 0)
    n=$(echo "$n" | tr -cd '0-9')
    n=${n:-0}
    [ "$n" -eq 0 ] && {
        whiptail --title "Mover" --msgbox "Nenhum arquivo selecionado.\nUse TAB/ESPAÇO para marcar." 8 50
        return
    }

    local ultimo_destino=""
    [ -s "$LAST_MOVE_DEST_FILE" ] && ultimo_destino=$(head -n1 "$LAST_MOVE_DEST_FILE")
    dest=$(escolher_destino "Mover" "$n" "$ultimo_destino") || return
    [ -z "$dest" ] || [ ! -d "$dest" ] && return
    printf '%s\n' "$dest" > "$LAST_MOVE_DEST_FILE"

    # Move entre filesystems diferentes precisa do mesmo espaço que cópia
    local src_dev dst_dev
    src_dev=$(df -P . 2>/dev/null | tail -1 | awk '{print $1}')
    dst_dev=$(df -P "$dest" 2>/dev/null | tail -1 | awk '{print $1}')
    if [ -n "$src_dev" ] && [ -n "$dst_dev" ] && [ "$src_dev" != "$dst_dev" ]; then
        local detalhe necessario
        detalhe=$(printf '%s\n' "$itens" | montar_detalhe_espaco)
        necessario=$(printf '%s\n' "$itens" | somar_selecao_bytes)
        verificar_espaco_disco "$necessario" "$dest" "Mover (outro disco)" "$detalhe" || return
    fi

    echo -e "\n\033[1;33m📦 Movendo $n item(ns) → $dest\033[0m"
    local ok=0 falha=0
    while IFS= read -r item; do
        [ -z "$item" ] && continue
        item_abs=$(caminho_absoluto "$item")
        if mv -- "$item_abs" "$dest/" 2>/dev/null; then
            echo -e "  \033[1;32m✓\033[0m $(basename "$item_abs")"
            ok=$((ok + 1))
            if [ "${MODO_DUP:-0}" -eq 1 ] && [ -f "$DUP_FILE" ]; then
                grep -vF "$item_abs" "$DUP_FILE" > "${DUP_FILE}.tmp" 2>/dev/null && mv "${DUP_FILE}.tmp" "$DUP_FILE"
                eazy_dup_salvar_lista
            fi
        else
            echo -e "  \033[1;31m✗\033[0m $(basename "$item_abs")"
            falha=$((falha + 1))
        fi
    done <<< "$itens"
    echo -e "\033[1;32mMovidos: $ok\033[0m | \033[1;31mFalhas: $falha\033[0m"
    sleep 1.5
}

