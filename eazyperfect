                echo -e "\\n${GREEN}=== Otimizações avançadas finalizadas ===${NC}"
                pause
                ;;
            0) return 0 ;;
            *) echo -e "${RED}Opção inválida!${NC}"; pause ;;
        esac
    done
}

# ------------------------------------------------------------
