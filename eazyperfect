                clean_disk
                set_cpu_performance
                echo -e "\\n${GREEN}=== Otimização completa finalizada ===${NC}"
                pause
                ;;
            5) clear; trim_ssd; pause ;;
            6) clear; optimize_kernel; pause ;;
