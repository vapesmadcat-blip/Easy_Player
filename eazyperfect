    local dir="$1" pos="$2" item="${3:-}"
    [ -z "$dir" ] && return
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    touch "$POSITIONS_FILE"
    # remove entrada antiga deste dir
    grep -vF "|${dir}|" "$POSITIONS_FILE" 2>/dev/null | grep -v "^${dir}|" > "${POSITIONS_FILE}.tmp" 2>/dev/null || true
    # formato: DIR|POS|ITEM
    printf '%s|%s|%s\n' "$dir" "$pos" "$item" >> "${POSITIONS_FILE}.tmp"
    # limpa linhas vazias e mantém últimas 500 pastas
    grep -v '^$' "${POSITIONS_FILE}.tmp" 2>/dev/null | tail -n 500 > "$POSITIONS_FILE"
    rm -f "${POSITIONS_FILE}.tmp"
}

carregar_posicao_dir() {
    # define TMP e ULTIMO_ARQUIVO a partir do mapa de posições
    local dir="$1"
    [ -z "$dir" ] || [ ! -f "$POSITIONS_FILE" ] && { TMP="${TMP:-1}"; return; }
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    local linha pos item
    linha=$(awk -F'|' -v d="$dir" '$1 == d {line=$0} END {print line}' "$POSITIONS_FILE" 2>/dev/null)
    [ -z "$linha" ] && { TMP="${TMP:-1}"; return; }
    pos=$(echo "$linha" | cut -d'|' -f2)
    item=$(echo "$linha" | cut -d'|' -f3-)
    pos=$(echo "${pos:-1}" | tr -cd '0-9'); pos=${pos:-1}
    TMP="$pos"
    [ -n "$item" ] && ULTIMO_ARQUIVO="$item"
}

salvar_filtro_dir() {
    local dir="$1" filtro="${2:-}"
    [ -n "$dir" ] || return
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    touch "$FILTER_POSITIONS_FILE"
    awk -F '\t' -v d="$dir" '$1 != d' "$FILTER_POSITIONS_FILE" 2>/dev/null > "${FILTER_POSITIONS_FILE}.tmp" || true
    printf '%s\t%s\n' "$dir" "$filtro" >> "${FILTER_POSITIONS_FILE}.tmp"
    tail -n 500 "${FILTER_POSITIONS_FILE}.tmp" > "$FILTER_POSITIONS_FILE"
    rm -f "${FILTER_POSITIONS_FILE}.tmp"
}

carregar_filtro_dir() {
    local dir="$1" linha
    [ -n "$dir" ] || return
    dir=$(readlink -f -- "$dir" 2>/dev/null || echo "$dir")
    linha=$(awk -F '\t' -v d="$dir" '$1 == d {line=$0} END {print line}' "$FILTER_POSITIONS_FILE" 2>/dev/null)
    if [ -n "$linha" ]; then
        FZF_QUERY="${linha#*$'\t'}"
        FZF_QUERY=$(printf '%s' "$FZF_QUERY" | sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g; s/\r//g')
    else
        FZF_QUERY=""
    fi
}

# Salva sessão completa (ao sair ou periodicamente)
salvar_sessao() {
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    local cwd
    cwd=$(pwd)
    # Posição atual: cada playlist tem seu próprio cursor persistente.
    local posicao_chave="$cwd"
    if [ "${MODO_PLAYLIST:-0}" -eq 1 ] && [ -f "${ARQUIVO_PLAYLIST_ABERTO:-}" ]; then
        posicao_chave="$(readlink -f -- "$ARQUIVO_PLAYLIST_ABERTO" 2>/dev/null || echo "$ARQUIVO_PLAYLIST_ABERTO")"
    fi
    salvar_posicao_dir "$posicao_chave" "${TMP:-1}" "${ULTIMO_ARQUIVO:-}"
    cat > "$SESSION_FILE" <<EOF
EAZY_CWD=$(printf '%q' "$cwd")
MODO_ATUAL=$(printf '%q' "${MODO_ATUAL:-tamanho}")
FILTRO_ATUAL=$(printf '%q' "${FILTRO_ATUAL:-ambos}")
FILTRO_ANTERIOR=$(printf '%q' "${FILTRO_ANTERIOR:-ambos}")
TELA_ATUAL=$(printf '%q' "${TELA_ATUAL:-fs}")
PREVIEW_ATIVO=$(printf '%q' "${PREVIEW_ATIVO:-0}")
ULTIMO_ARQUIVO=$(printf '%q' "${ULTIMO_ARQUIVO:-}")
DIRETORIO_ANTERIOR=$(printf '%q' "${DIRETORIO_ANTERIOR:-}")
TMP=$(printf '%q' "${TMP:-1}")
EOF
    # preview também no config permanente
    if [ -f "$CONFIG_FILE" ]; then
        if grep -q '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s|^PREVIEW_ATIVO=.*|PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"|" "$CONFIG_FILE"
        else
            echo "PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"" >> "$CONFIG_FILE"
        fi
    else
        echo "PREVIEW_ATIVO=\"${PREVIEW_ATIVO:-0}\"" > "$CONFIG_FILE"
    fi
}

carregar_sessao() {
    [ ! -f "$SESSION_FILE" ] && return 1
    # shellcheck disable=SC1090
    source "$SESSION_FILE" 2>/dev/null || return 1
    if [ -n "${EAZY_CWD:-}" ] && [ -d "$EAZY_CWD" ]; then
        cd "$EAZY_CWD" || true
    fi
    MODO_ATUAL="${MODO_ATUAL:-tamanho}"
    FILTRO_ATUAL="${FILTRO_ATUAL:-ambos}"
    FILTRO_ANTERIOR="${FILTRO_ANTERIOR:-ambos}"
    TELA_ATUAL="${TELA_ATUAL:-$TELA_PADRAO}"
    PREVIEW_ATIVO="${PREVIEW_ATIVO:-0}"
    TMP="${TMP:-1}"
    DIRETORIO_ANTERIOR="${DIRETORIO_ANTERIOR:-}"
    [ -n "$DIRETORIO_ANTERIOR" ] && [ ! -d "$DIRETORIO_ANTERIOR" ] && DIRETORIO_ANTERIOR=""
    # posição salva da pasta
    carregar_posicao_dir "$(pwd)"
    return 0
}

toggle_preview_persistente() {
    if [ "${PREVIEW_ATIVO:-0}" = "1" ]; then
        PREVIEW_ATIVO="0"
    else
        PREVIEW_ATIVO="1"
    fi
    # grava imediatamente
    if [ -f "$CONFIG_FILE" ]; then
        if grep -q '^PREVIEW_ATIVO=' "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s|^PREVIEW_ATIVO=.*|PREVIEW_ATIVO=\"$PREVIEW_ATIVO\"|" "$CONFIG_FILE"
        else
            echo "PREVIEW_ATIVO=\"$PREVIEW_ATIVO\"" >> "$CONFIG_FILE"
        fi
    else
        mkdir -p "$CONFIG_DIR" 2>/dev/null || true
        echo "PREVIEW_ATIVO=\"$PREVIEW_ATIVO\"" > "$CONFIG_FILE"
    fi
}

# Cache de busca em RAM/disco temporário — dura só enquanto o script roda
BUSCA_CACHE_DIR="/tmp/eazy_busca_cache_$$"
mkdir -p "$BUSCA_CACHE_DIR" 2>/dev/null || true

chave_cache_busca() {
    # chave estável: pasta + extensões + tamanho + conteúdo
    local base
    base="$(pwd)|${EXT_BUSCA:-}|${BUSCA_TAM_MIN:-}|${BUSCA_TAM_MAX:-}|${BUSCA_CONTEUDO:-}"
    if command -v md5sum &>/dev/null; then
        printf '%s' "$base" | md5sum | awk '{print $1}'
    elif command -v sha256sum &>/dev/null; then
        printf '%s' "$base" | sha256sum | awk '{print $1}'
    else
        # fallback simples
        printf '%s' "$base" | cksum | awk '{print $1}'
    fi
}

# Restaura sessão anterior (cwd, filtro, preview, cursor)
# Prioridade: argumento de caminho > sessão > DIR_PADRAO
# Uso: eazy /mnt/videos   |   eazy ~/Downloads   |   eazy ./pasta   |   eazy filme.mp4
ARG_CAMINHO=""
ARG_ERRO=""
if [ -n "${1:-}" ] && [[ "$1" != --* ]]; then
    _arg="$1"
    # Expande ~ no início
    case "$_arg" in
        "~/"*) _arg="$HOME/${_arg#~/}" ;;
        "~")   _arg="$HOME" ;;
    esac
    # Resolve relativo → absoluto quando existir
    if [ -d "$_arg" ]; then
        ARG_CAMINHO=$(cd -- "$_arg" 2>/dev/null && pwd -P || readlink -f -- "$_arg" 2>/dev/null || echo "$_arg")
    elif [ -f "$_arg" ]; then
        ARG_CAMINHO=$(readlink -f -- "$_arg" 2>/dev/null || echo "$_arg")
        # se readlink falhar, monta abs a partir do dir
        if [ ! -e "$ARG_CAMINHO" ]; then
            _dir=$(cd -- "$(dirname -- "$_arg")" 2>/dev/null && pwd -P)
            ARG_CAMINHO="${_dir}/$(basename -- "$_arg")"
        fi
    elif [ -e "$_arg" ]; then
        ARG_CAMINHO=$(readlink -f -- "$_arg" 2>/dev/null || echo "$_arg")
    else
        ARG_ERRO="$_arg"
    fi
fi

if [ -n "$ARG_CAMINHO" ]; then
    # Caminho na linha de comando tem prioridade sobre a sessão
    if [ -d "$ARG_CAMINHO" ]; then
        cd -- "$ARG_CAMINHO" || {
            echo -e "\033[1;31meazy: não foi possível entrar em:\033[0m $ARG_CAMINHO" >&2
            ARG_CAMINHO=""
        }
        ULTIMO_ARQUIVO=""
    elif [ -f "$ARG_CAMINHO" ]; then
        cd -- "$(dirname -- "$ARG_CAMINHO")" || true
        ULTIMO_ARQUIVO=$(basename -- "$ARG_CAMINHO")
    fi
    # Preferências da sessão (filtro/preview), sem sobrescrever o cwd
    if [ -n "$ARG_CAMINHO" ] && [ -f "$SESSION_FILE" ]; then
        # shellcheck disable=SC1090
        source "$SESSION_FILE" 2>/dev/null || true
        PREVIEW_ATIVO="${PREVIEW_ATIVO:-0}"
        MODO_ATUAL="${MODO_ATUAL:-tamanho}"
        FILTRO_ATUAL="${FILTRO_ATUAL:-ambos}"
        TELA_ATUAL="${TELA_ATUAL:-$TELA_PADRAO}"
    fi
elif [ -n "$ARG_ERRO" ]; then
    echo -e "\033[1;31meazy: caminho não encontrado:\033[0m $ARG_ERRO" >&2
    echo -e "\033[0;90mAbrindo sessão/pasta padrão…\033[0m" >&2
    if ! carregar_sessao; then
        [ -d "$DIR_PADRAO" ] && cd -- "$DIR_PADRAO" || true
    fi
elif ! carregar_sessao; then
    if [ -d "$DIR_PADRAO" ]; then
        cd -- "$DIR_PADRAO" || true
    fi
fi

