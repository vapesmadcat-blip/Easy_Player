# --- DIAGNÓSTICO DO SISTEMA (DISPONÍVEL DENTRO DO F9) ---
mostrar_overview_sistema() {
    local tmp os_name kernel desktop PRETTY_NAME NAME VERSION_ID
    tmp=$(mktemp "${TMPDIR:-/tmp}/eazy-overview.XXXXXX") || return 1

    if [ -r /etc/os-release ]; then
        os_name=$(awk -F= '$1 == "PRETTY_NAME" {gsub(/^"|"$/, "", $2); print $2; exit}' /etc/os-release 2>/dev/null)
        os_name="${os_name:-Linux}"
    else
        os_name="Linux"
    fi
    kernel=$(uname -srmo 2>/dev/null || echo "indisponível")
    desktop="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-indisponível}}"

    {
        printf '%s\n' 'eazy — OVERVIEW DO SISTEMA'
        printf '%s\n' '========================================'
        printf 'Sistema operacional : %s\n' "$os_name"
        printf 'Kernel              : %s\n' "$kernel"
        printf 'Hostname            : %s\n' "$(hostname 2>/dev/null || echo indisponível)"
        printf 'Ambiente gráfico    : %s\n' "$desktop"
        printf 'Shell               : %s\n' "${SHELL:-indisponível}"
        printf '\n%s\n' 'MEMÓRIA RAM'
        if command -v free >/dev/null 2>&1; then
            free -h
        elif [ -r /proc/meminfo ]; then
            grep -E '^(MemTotal|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo
        else
            printf '%s\n' 'Informação indisponível.'
        fi

        printf '\n%s\n' 'HD / ARMAZENAMENTO'
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -e7 -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS,MODEL 2>/dev/null || true
        else
            printf '%s\n' 'lsblk não está instalado.'
        fi
        printf '\n%s\n' 'USO DOS SISTEMAS DE ARQUIVOS'
        if command -v df >/dev/null 2>&1; then
            df -hT -x tmpfs -x devtmpfs -x squashfs 2>/dev/null | tail -n +1 | sed -n '1,20p'
        fi
        printf '\n%s\n' 'DRIVES REMOVÍVEIS / INTERFACE'
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -e7 -o NAME,TRAN,RM,SIZE,TYPE,MOUNTPOINTS 2>/dev/null | awk 'NR == 1 || $3 == "1" || $2 != ""'
        else
            printf '%s\n' 'Informação indisponível.'
        fi

        printf '\n%s\n' 'ÁUDIO — SERVIDOR, SAÍDAS E ENTRADAS'
        if command -v wpctl >/dev/null 2>&1; then
            wpctl status 2>/dev/null || true
        elif command -v pactl >/dev/null 2>&1; then
            pactl info 2>/dev/null || true
            pactl list short sinks 2>/dev/null || true
            pactl list short sources 2>/dev/null || true
        elif command -v aplay >/dev/null 2>&1 || command -v arecord >/dev/null 2>&1; then
            command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null || true
            command -v arecord >/dev/null 2>&1 && arecord -l 2>/dev/null || true
        else
            printf '%s\n' 'Nenhuma ferramenta de áudio encontrada.'
        fi

        printf '\n%s\n' 'VÍDEO — GPU, DRIVER E MONITORES'
        if command -v lspci >/dev/null 2>&1; then
            lspci -nnk 2>/dev/null | awk '
                /Audio device|Multimedia audio controller|VGA compatible controller|3D controller|Display controller/ {show=1; n=0}
                show {print; n++}
                show && n >= 4 {show=0}
            '
        else
            printf '%s\n' 'lspci não está instalado.'
        fi
        if [ -d /sys/class/drm ]; then
            printf '\nMonitores detectados:\n'
            for connector in /sys/class/drm/*/status; do
                [ -f "$connector" ] || continue
                printf '  %s: %s\n' "$(basename "$(dirname "$connector")")" "$(cat "$connector" 2>/dev/null)"
            done
        fi
        if command -v lsmod >/dev/null 2>&1; then
            printf '\nMódulos gráficos/áudio carregados:\n'
            lsmod | grep -E '^(snd|sof|i915|amdgpu|radeon|nouveau|nvidia|vc4|xe)' | head -n 30 || true
        fi
    } > "$tmp"

    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "eazy — Overview do sistema" --textbox "$tmp" 32 112 --scrolltext
    else
        cat "$tmp"
    fi
    rm -f "$tmp"
}

