# ============================================================
# SUDO + DRY RUN
# ============================================================
restaurar_terminal() {
    stty sane 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    printf '\033[0m'
}

solicitar_senha_sudo() {
    local senha ret
    if sudo -n true 2>/dev/null; then
        return 0
    fi
    if ! command -v whiptail >/dev/null 2>&1; then
        echo -e "${YELLOW}sudo requer senha, mas o whiptail não está disponível.${NC}" >&2
        restaurar_terminal
        return 1
    fi
    senha=$(whiptail --title "Autenticação sudo" --passwordbox \
        "Digite sua senha para autorizar a próxima operação privilegiada:\n\nA senha não será exibida nem gravada." 10 70 3>&1 1>&2 2>&3)
    ret=$?
    restaurar_terminal
    [ "$ret" -eq 0 ] || return 1
    [ -n "$senha" ] || return 1
    if printf '%s\n' "$senha" | sudo -S -p '' -v >/dev/null 2>&1; then
        unset senha
        return 0
    fi
    unset senha
    whiptail --title "Senha sudo" --msgbox "Senha incorreta ou sudo não autorizado." 8 60 2>/dev/null || true
    restaurar_terminal
    return 1
}

executar_com_sudo() {
    local cmd="$1" desc="${2:-Executando comando}" dry_msg="${3:-}" ret
    if [ "${DRY_RUN:-0}" = "1" ]; then
        echo -e "${YELLOW}[DRY RUN] $desc${NC}"
        [ -n "$dry_msg" ] && echo -e "${YELLOW}[DRY RUN] $dry_msg${NC}"
        echo -e "${YELLOW}[DRY RUN] Comando: $cmd${NC}"
        return 0
    fi
    if [[ "$cmd" =~ ^(sudo |apt|apt-get|dnf|pacman|zypper|apk|swapoff|swapon|fallocate|dd |mount|umount|systemctl|journalctl|smartctl|sysctl|mkswap|tee ) ]]; then
        solicitar_senha_sudo || return 1
        # -n garante que o comando não tente abrir prompt no terminal depois.
        sudo -n bash -c "$cmd" 2>&1
        ret=$?
        restaurar_terminal
        return "$ret"
    fi
    eval "$cmd" 2>&1
    return $?
}

tem_sudo_sem_senha() {
    sudo -n true 2>/dev/null
}

eazy_pausa_terminal() {
    local mensagem="${1:-Pressione Enter para continuar...}"
    if [ -t 0 ]; then
        printf '\n\033[1;36m%s\033[0m\n' "$mensagem"
        IFS= read -r _eazy_pause || true
    fi
}

operacao_com_sudo() {
    local cmd="$1"
    local desc="${2:-Operação}"
    local dry_msg="${3:-}"
    clear 2>/dev/null || printf '\033c'
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}🔧 $desc${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    if [ "${DRY_RUN:-0}" = "1" ]; then
        echo -e "${YELLOW}[DRY RUN] Simulando: $desc${NC}"
        [ -n "$dry_msg" ] && echo -e "${YELLOW}[DRY RUN] $dry_msg${NC}"
        echo -e "${YELLOW}[DRY RUN] Comando: $cmd${NC}"
        echo -e "${GREEN}✅ [DRY RUN] Concluído (sem alterações)${NC}"
        eazy_pausa_terminal "DRY-RUN concluído. Pressione Enter para voltar."
        return 0
    fi

    local output ret
    output=$(executar_com_sudo "$cmd" "$desc" "$dry_msg")
    ret=$?
    if [ "$ret" -eq 0 ]; then
        echo -e "${GREEN}✅ $desc concluída com sucesso!${NC}"
        [ -n "$output" ] && echo "$output"
    else
        echo -e "${RED}❌ Falha na operação (código $ret)${NC}"
        [ -n "$output" ] && echo "$output"
        fi
    eazy_pausa_terminal "$desc concluída. Pressione Enter para voltar."
    return "$ret"
}

toggle_dry_run() {
    if [ "${DRY_RUN:-0}" = "1" ]; then
        DRY_RUN="0"
        export DRY_RUN
        whiptail --title "DRY RUN" --msgbox "Modo DRY RUN DESLIGADO\n\nAs operações agora farão alterações reais." 10 55
    else
        DRY_RUN="1"
        export DRY_RUN
        whiptail --title "DRY RUN" --msgbox "Modo DRY RUN LIGADO 🔄\n\nOperações serão só simuladas (nada é apagado/alterado).\n\nÚtil para testar o que seria feito." 12 60
    fi
}

# --- PERSISTÊNCIA DE SELEÇÃO (por pasta) ---
# Adiciona persistência de itens marcados (Tab/Espaço) por pasta.
# Arquivos: $CONFIG_DIR/selection_<sha>.list (um caminho absoluto por linha)
SELECTED_FILE="${SELECTED_FILE:-$CONFIG_DIR/selected}"

# Gera caminho do arquivo de persistência para uma pasta
selection_store_file_for_dir() {
    local dir="${1:-$(pwd -P)}" hash out
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    if command -v sha1sum >/dev/null 2>&1; then
        hash=$(printf '%s' "$dir" | sha1sum 2>/dev/null | cut -d' ' -f1)
    else
        hash=$(printf '%s' "$dir" | cksum | awk '{print $1}')
    fi
    out="$CONFIG_DIR/selection_${hash}.list"
    printf '%s' "$out"
}

# Carrega seleção persistida (somente caminhos existentes) para $SELECTED_FILE
carregar_selecao_persistente() {
    local dir="${1:-$(pwd -P)}" file tmp
    file=$(selection_store_file_for_dir "$dir")
    mkdir -p "$(dirname -- "$SELECTED_FILE")" 2>/dev/null || true
    : > "$SELECTED_FILE"
    [ -f "$file" ] || return 0
    tmp="${SELECTED_FILE}.tmp"
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        if [ -e "$p" ]; then
            # normaliza para absoluto se função caminho_absoluto existir
            if declare -f caminho_absoluto >/dev/null 2>&1; then
                caminho_absoluto "$p"
            else
                # fallback: readlink -f ou python
                if command -v readlink >/dev/null 2>&1; then
                    readlink -f -- "$p"
                elif command -v python3 >/dev/null 2>&1; then
                    python3 -c "import os,sys; print(os.path.abspath(sys.argv[1]))" -- "$p"
                else
                    printf '%s' "$p"
                fi
            fi
        fi
    done < "$file" | sort -u > "$tmp" 2>/dev/null || :
    mv -f "$tmp" "$SELECTED_FILE" 2>/dev/null || true
}

# Salva seleção atual ($SELECTED_FILE) no arquivo de persistência da pasta
salvar_selecao_persistente() {
    local dir="${1:-$(pwd -P)}" file tmp
    file=$(selection_store_file_for_dir "$dir")
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    tmp="${file}.tmp"
    touch "$SELECTED_FILE" 2>/dev/null || true
    sort -u "$SELECTED_FILE" 2>/dev/null > "$tmp" || : > "$tmp"
    mv -f "$tmp" "$file" 2>/dev/null || true
}

limpar_selecao_persistente() {
    local dir="${1:-$(pwd -P)}" file
    file=$(selection_store_file_for_dir "$dir")
    [ -f "$file" ] && rm -f -- "$file"
}

# Override cd built-in inside this script so that switching directories
# saves the selection for the previous folder and loads selection for the new one.
cd() {
    local prev
    prev="$(pwd -P)"
    # save selection from previous dir
    salvar_selecao_persistente "$prev" 2>/dev/null || true
    # call builtin cd
    builtin cd "$@" || return $? 
    # load selection for new dir
    carregar_selecao_persistente "$(pwd -P)" 2>/dev/null || true
}

# Ensure we save selection on exit
_eazy_persist_on_exit() {
    salvar_selecao_persistente "$(pwd -P)" 2>/dev/null || true
}

# install EXIT trap if not present
if ! trap -p EXIT | grep -q _eazy_persist_on_exit 2>/dev/null; then
    trap _eazy_persist_on_exit EXIT
fi
# --- FIM PERSISTÊNCIA ---


