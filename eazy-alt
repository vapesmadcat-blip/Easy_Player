# --- Alertas sonoros ---
# Usa o sino do terminal, sem exigir beep/paplay; erros também tentam o sino visual.
eazy_beep() {
    printf '\a' > /dev/tty 2>/dev/null || printf '\a' >&2
}
whiptail() {
    local texto="$*" rc
    command whiptail "$@"
    rc=$?
    case "$texto" in
        *Erro*|*erro*|*Falha*|*falha*|"*não encontrado*"|"*Não foi possível*"|"*inválid*") eazy_beep ;;
    esac
    return "$rc"
}
